{"w":"falls","t":"bağlaç","m":"eğer; -se","s":["wenn"],"a":[],"e":[["Falls es regnet, bleiben wir zu Hause.","","Yağmur yağarsa evde kalırız."],["Ruf mich an, falls du Hilfe brauchst.","","Yardıma ihtiyacın olursa beni ara."]]}
{"w":"sobald","t":"bağlaç","m":"-r -mez; -ince","s":["sowie"],"a":[],"e":[["Ich rufe dich an, sobald ich ankomme.","","Varır varmaz seni ararım."],["Sobald der Bus kommt, steigen wir ein.","","Otobüs gelir gelmez bineriz."]]}
{"w":"solange","t":"bağlaç","m":"-dığı sürece","s":[],"a":[],"e":[["Du kannst bleiben, solange du willst.","","İstediğin sürece kalabilirsin."],["Solange es regnet, bleibe ich hier.","","Yağmur yağdığı sürece burada kalırım."]]}
{"w":"statt","t":"edat","m":"yerine","s":["anstatt"],"a":[],"e":[["Statt Kaffee trinke ich Tee.","","Kahve yerine çay içiyorum."],["Statt eines Autos kaufe ich ein Fahrrad.","","Araba yerine bir bisiklet alıyorum."]]}
{"w":"entlang","t":"edat","m":"boyunca","s":[],"a":[],"e":[["Wir gehen den Fluss entlang.","","Nehir boyunca yürüyoruz."],["Entlang der Straße stehen viele Bäume.","","Cadde boyunca birçok ağaç var."]]}
{"w":"trotz","t":"edat","m":"-e rağmen","s":["ungeachtet"],"a":["wegen"],"e":[["Trotz des Regens gehen wir spazieren.","","Yağmura rağmen yürüyüşe çıkıyoruz."],["Er arbeitet trotz seiner Krankheit.","","O, hastalığına rağmen çalışıyor."]]}
