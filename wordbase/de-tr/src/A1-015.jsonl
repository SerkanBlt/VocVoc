{"w":"Ziel","t":"isim (nötr)","m":"hedef; amaç; varış noktası","s":[],"a":[],"e":[["Mein Ziel ist ein guter Job.","","Hedefim iyi bir iş."],["Wir sind am Ziel.","","Varış noktasındayız."]]}
{"w":"Gleis","t":"isim (nötr)","m":"hat; peron","s":["Bahnsteig"],"a":[],"e":[["Der Zug fährt auf Gleis drei ab.","","Tren üçüncü hattan kalkıyor."],["Auf welchem Gleis kommt der Zug?","","Tren hangi hattan geliyor?"]]}
{"w":"sonst","t":"zarf","m":"yoksa; başka; aksi halde","s":[],"a":[],"e":[["Beeil dich, sonst kommen wir zu spät.","","Acele et, yoksa geç kalırız."],["Brauchen Sie sonst noch etwas?","","Başka bir şeye ihtiyacınız var mı?"]]}
{"w":"niemals","t":"zarf","m":"asla; hiçbir zaman","s":["nie"],"a":["immer"],"e":[["Ich habe niemals Fleisch gegessen.","","Hiç et yemedim."],["Er kommt niemals zu spät.","","O asla geç kalmaz."]]}
{"w":"deshalb","t":"zarf","m":"bu yüzden; bundan dolayı","s":["deswegen"],"a":[],"e":[["Ich bin müde, deshalb gehe ich ins Bett.","","Yorgunum, bu yüzden yatıyorum."],["Es regnet, deshalb bleibe ich zu Hause.","","Yağmur yağıyor, bu yüzden evde kalıyorum."]]}
{"w":"weniger","t":"zarf","m":"daha az","s":[],"a":["mehr"],"e":[["Ich esse jetzt weniger Fleisch.","","Artık daha az et yiyorum."],["Heute habe ich weniger Zeit.","","Bugün daha az vaktim var."]]}
{"w":"zuerst","t":"zarf","m":"önce; ilk olarak","s":["zunächst"],"a":["zuletzt"],"e":[["Zuerst esse ich, dann gehe ich.","","Önce yerim, sonra giderim."],["Wer kommt zuerst dran?","","İlk sıra kimde?"]]}
{"w":"danach","t":"zarf","m":"ondan sonra; sonrasında","s":["dann"],"a":["davor"],"e":[["Wir essen und gehen danach ins Kino.","","Yemek yiyoruz, sonrasında sinemaya gidiyoruz."],["Danach bin ich sehr müde.","","Sonrasında çok yorgunum."]]}
{"w":"außerdem","t":"zarf","m":"ayrıca; bunun dışında","s":["zudem"],"a":[],"e":[["Das Hotel ist billig, außerdem liegt es zentral.","","Otel ucuz, ayrıca merkezde."],["Ich habe Hunger und außerdem Durst.","","Acıktım ve ayrıca susadım."]]}
{"w":"vorher","t":"zarf","m":"önceden; daha önce","s":["früher"],"a":["nachher"],"e":[["Ruf mich bitte vorher an.","","Lütfen önceden ara."],["Das wusste ich vorher nicht.","","Bunu daha önce bilmiyordum."]]}
{"w":"nochmal","t":"zarf","m":"bir kez daha; tekrar","s":["noch einmal"],"a":[],"e":[["Können Sie das bitte nochmal sagen?","","Bunu bir kez daha söyleyebilir misiniz?"],["Ich probiere es nochmal.","","Bir kez daha deniyorum."]]}
{"w":"egal","t":"sıfat","m":"fark etmez; umurumda değil","s":["gleichgültig"],"a":[],"e":[["Mir ist es egal, was wir essen.","","Ne yediğimiz fark etmez."],["Das ist doch egal!","","Bu fark etmez ki!"]]}
{"w":"prima","t":"sıfat","m":"harika; çok iyi","s":["toll","super"],"a":["schlecht"],"e":[["Das Wetter ist heute prima.","","Bugün hava harika."],["Das ist eine prima Idee!","","Bu harika bir fikir!"]]}
