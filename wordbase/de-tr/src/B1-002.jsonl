{"w":"Besichtigung","t":"isim (dişil)","m":"gezip görme; ziyaret","s":[],"a":[],"e":[["Die Besichtigung des Schlosses kostet zehn Euro.","","Şatonun gezilmesi on avro tutuyor."],["Wir machen morgen eine Besichtigung der Wohnung.","","Yarın daireyi gezip göreceğiz."]]}
{"w":"Stadtrundfahrt","t":"isim (dişil)","m":"şehir turu","s":[],"a":[],"e":[["Wir buchen eine Stadtrundfahrt mit dem Bus.","","Otobüsle bir şehir turu ayırtıyoruz."],["Die Stadtrundfahrt beginnt am Hauptbahnhof.","","Şehir turu ana gardan başlıyor."]]}
{"w":"Postkarte","t":"isim (dişil)","m":"kartpostal","s":[],"a":[],"e":[["Ich schicke dir eine Postkarte aus dem Urlaub.","","Sana tatilden bir kartpostal gönderirim."],["Auf der Postkarte ist ein Foto vom Meer.","","Kartpostalda denizin bir fotoğrafı var."]]}
{"w":"Sehnsucht","t":"isim (dişil)","m":"özlem; hasret","s":["Verlangen"],"a":[],"e":[["Er hat Sehnsucht nach seiner Heimat.","","Memleketine özlem duyuyor."],["Die Sehnsucht nach dem Meer wird immer größer.","","Denize duyduğu özlem giderek büyüyor."]]}
{"w":"Reklame","t":"isim (dişil)","m":"reklam","s":["Werbung"],"a":[],"e":[["Im Fernsehen läuft zu viel Reklame.","","Televizyonda çok fazla reklam var."],["Die Reklame für das neue Handy ist überall.","","Yeni telefonun reklamı her yerde."]]}
{"w":"Tastatur","t":"isim (dişil)","m":"klavye","s":[],"a":[],"e":[["Meine Tastatur funktioniert nicht mehr.","","Klavyem artık çalışmıyor."],["Auf der Tastatur fehlt eine Taste.","","Klavyede bir tuş eksik."]]}
{"w":"Batterie","t":"isim (dişil)","m":"pil; batarya; akü","s":[],"a":[],"e":[["Die Batterie in der Uhr ist leer.","","Saatteki pil bitti."],["Das Auto braucht eine neue Batterie.","","Arabanın yeni bir akü alması gerekiyor."]]}
{"w":"Steckdose","t":"isim (dişil)","m":"priz","s":[],"a":[],"e":[["Wo ist hier eine Steckdose für mein Handy?","","Telefonum için burada priz nerede?"],["Im Bad gibt es nur eine Steckdose.","","Banyoda yalnızca bir priz var."]]}
