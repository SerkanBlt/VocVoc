{"w":"Cola","t":"isim (dişil)","m":"kola","s":[],"a":[],"e":[["Ich möchte eine Cola, bitte.","","Bir kola istiyorum lütfen."],["Zu viel Cola ist nicht gesund.","","Çok fazla kola sağlıklı değil."]]}
{"w":"Kneipe","t":"isim (dişil)","m":"birahane; meyhane","s":["Lokal"],"a":[],"e":[["Wir treffen uns heute Abend in der Kneipe.","","Bu akşam birahanede buluşuyoruz."],["Die Kneipe an der Ecke ist immer voll.","","Köşedeki birahane hep dolu."]]}
{"w":"Disco","t":"isim (dişil)","m":"diskotek","s":["Diskothek"],"a":[],"e":[["Am Samstag gehen wir in die Disco.","","Cumartesi diskoya gidiyoruz."],["Die Disco macht um zehn Uhr auf.","","Diskotek saat onda açılıyor."]]}
{"w":"Bühne","t":"isim (dişil)","m":"sahne","s":[],"a":[],"e":[["Die Sängerin steht auf der Bühne.","","Şarkıcı sahnede duruyor."],["Hinter der Bühne warten die Schauspieler.","","Sahnenin arkasında oyuncular bekliyor."]],"x":[["über die Bühne gehen","","gerçekleşmek; sorunsuz geçmek","Das Fest ist ohne Probleme über die Bühne gegangen.","","Şenlik sorunsuz gerçekleşti."]]}
