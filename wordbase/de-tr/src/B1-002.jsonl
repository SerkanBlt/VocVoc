{"w":"Zahnpasta","t":"isim (dişil)","m":"diş macunu","s":[],"a":[],"e":[["Die Zahnpasta ist leer.","","Diş macunu bitti."],["Kauf bitte neue Zahnpasta.","","Lütfen yeni diş macunu al."]]}
