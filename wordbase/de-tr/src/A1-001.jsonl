{"w":"guten Morgen","t":"kalıp","m":"günaydın","s":[],"a":["gute Nacht"],"e":[["Guten Morgen, Frau Weber!","gutın morgın, frau vebır!","Günaydın, Bayan Weber!"],["Guten Morgen! Hast du gut geschlafen?","gutın morgın! hast du gut gışlafın?","Günaydın! İyi uyudun mu?"]],"x":[["guten Morgen sagen","gutın morgın zagın","günaydın demek","Ich sage meinem Nachbarn immer guten Morgen.","ih zagı maynım nahbarn imır gutın morgın","Komşuma her zaman günaydın derim."]]}
{"w":"guten Tag","t":"kalıp","m":"merhaba; iyi günler","s":["hallo"],"a":["auf Wiedersehen"],"e":[["Guten Tag, ich möchte einen Kaffee.","gutın tak, ih möhtı aynın kafe.","İyi günler, bir kahve istiyorum."],["Guten Tag! Wie kann ich Ihnen helfen?","gutın tak! vi kan ih inın helfın?","Merhaba! Size nasıl yardımcı olabilirim?"]]}
{"w":"guten Abend","t":"kalıp","m":"iyi akşamlar","s":[],"a":[],"e":[["Guten Abend, meine Damen und Herren.","gutın abınt, maynı damın unt herın.","İyi akşamlar, bayanlar ve baylar."],["Wir sagen den Gästen guten Abend.","vir zagın den gestın gutın abınt.","Konuklara iyi akşamlar deriz."]]}
{"w":"gute Nacht","t":"kalıp","m":"iyi geceler","s":[],"a":["guten Morgen"],"e":[["Gute Nacht, Mama!","gutı naht, mama!","İyi geceler, anne!"],["Ich sage den Kindern gute Nacht.","ih zagı den kindırn gutı naht.","Çocuklara iyi geceler derim."]]}
{"w":"auf Wiedersehen","t":"kalıp","m":"hoşça kalın; güle güle","s":["tschüss"],"a":["guten Tag"],"e":[["Auf Wiedersehen, Herr Müller!","auf vidırzen, her mülır!","Hoşça kalın, Bay Müller!"],["Danke und auf Wiedersehen!","dankı unt auf vidırzen!","Teşekkürler, hoşça kalın!"]]}
{"w":"bis bald","t":"kalıp","m":"görüşürüz; yakında görüşmek üzere","s":["bis später"],"a":[],"e":[["Bis bald, ich rufe dich an.","bis balt, ih rufı dih an.","Görüşürüz, seni arayacağım."],["Tschüss und bis bald!","çüs unt bis balt!","Hoşça kal, görüşürüz!"]]}
{"w":"bis morgen","t":"kalıp","m":"yarın görüşürüz; yarına kadar","s":[],"a":[],"e":[["Bis morgen, schlaf gut!","bis morgın, şlaf gut!","Yarın görüşürüz, iyi uykular!"],["Die Arbeit ist bis morgen fertig.","di arbayt ist bis morgın fertih.","İş yarına kadar hazır olur."]]}
{"w":"bitte schön","t":"kalıp","m":"rica ederim; buyurun","s":[],"a":[],"e":[["Danke! — Bitte schön.","dankı! — bitı şön.","Teşekkürler! — Rica ederim."],["Bitte schön, hier ist Ihr Kaffee.","bitı şön, hir ist ir kafe.","Buyurun, kahveniz burada."]]}
{"w":"danke schön","t":"kalıp","m":"çok teşekkürler","s":["vielen Dank"],"a":[],"e":[["Danke schön für das Geschenk!","dankı şön für das gışenk!","Hediye için çok teşekkürler!"],["Danke schön, das ist sehr nett.","dankı şön, das ist zer net.","Çok teşekkürler, bu çok nazik."]]}
{"w":"tut mir leid","t":"kalıp","m":"üzgünüm; özür dilerim","s":["Entschuldigung"],"a":[],"e":[["Tut mir leid, ich bin zu spät.","tut mir layt, ih bin tsu şpet.","Özür dilerim, geç kaldım."],["Es tut mir leid, dass du krank bist.","es tut mir layt, das du krank bist.","Hasta olduğuna üzüldüm."]]}
{"w":"wie geht's","t":"kalıp","m":"nasılsın","s":["wie geht es dir"],"a":[],"e":[["Hallo Anna, wie geht's?","halo ana, vi gets?","Merhaba Anna, nasılsın?"],["Na, wie geht's dir heute?","na, vi gets dir hoytı?","Eee, bugün nasılsın?"]]}
{"w":"gern geschehen","t":"kalıp","m":"rica ederim; bir şey değil","s":[],"a":[],"e":[["Danke für die Hilfe! — Gern geschehen.","dankı für di hilfı! — gern gışen.","Yardım için teşekkürler! — Rica ederim."],["Gern geschehen, das mache ich gern.","gern gışen, das mahı ih gern.","Rica ederim, bunu seve seve yaparım."]]}
{"w":"viel Glück","t":"kalıp","m":"iyi şanslar; bol şans","s":[],"a":[],"e":[["Viel Glück bei der Prüfung!","fil glük bay der prüfunk!","Sınavda bol şans!"],["Ich wünsche dir viel Glück.","ih vünşı dir fil glük.","Sana bol şans diliyorum."]]}
{"w":"alles Gute","t":"kalıp","m":"en iyi dilekler; her şey gönlünce olsun","s":[],"a":[],"e":[["Alles Gute zum Geburtstag!","alıs gutı tsum gıburtstak!","Doğum günün kutlu olsun!"],["Wir wünschen dir alles Gute.","vir vünşın dir alıs gutı.","Sana her şeyin en iyisini diliyoruz."]]}
{"w":"herzlich willkommen","t":"kalıp","m":"hoş geldiniz","s":[],"a":[],"e":[["Herzlich willkommen in Berlin!","hertslih vilkomın in berlin!","Berlin'e hoş geldiniz!"],["Herzlich willkommen, nehmen Sie Platz.","hertslih vilkomın, nemın zi plats.","Hoş geldiniz, buyurun oturun."]]}
{"w":"zum Beispiel","t":"kalıp","m":"örneğin; mesela","s":["beispielsweise"],"a":[],"e":[["Ich mag Obst, zum Beispiel Äpfel.","ih mak opst, tsum bayşpil epfıl.","Meyveyi severim, örneğin elma."],["Viele Länder, zum Beispiel Italien, sind schön.","filı lendır, tsum bayşpil italyın, zint şön.","Birçok ülke, örneğin İtalya, güzeldir."]]}
{"w":"zu Hause","t":"kalıp","m":"evde","s":[],"a":[],"e":[["Ich bin heute zu Hause.","ih bin hoytı tsu hauzı.","Bugün evdeyim."],["Zu Hause essen wir zusammen.","tsu hauzı esın vir tsuzamın.","Evde birlikte yeriz."]],"x":[["sich wie zu Hause fühlen","zih vi tsu hauzı fülın","kendini evinde hissetmek","Bei dir fühle ich mich wie zu Hause.","bay dir fülı ih mih vi tsu hauzı","Sende kendimi evimde hissediyorum."]]}
{"w":"nach Hause","t":"kalıp","m":"eve","s":[],"a":[],"e":[["Ich gehe jetzt nach Hause.","ih geı yetst nah hauzı.","Şimdi eve gidiyorum."],["Wann kommst du nach Hause?","van komst du nah hauzı?","Eve ne zaman geliyorsun?"]],"x":[["auf dem Weg nach Hause","auf dem vek nah hauzı","eve giderken","Auf dem Weg nach Hause kaufe ich Brot.","auf dem vek nah hauzı kaufı ih brot","Eve giderken ekmek alırım."]]}
{"w":"es gibt","t":"kalıp","m":"var","s":[],"a":[],"e":[["Es gibt hier ein Café.","es gipt hir ayn kafe.","Burada bir kafe var."],["Heute gibt es Suppe.","hoytı gipt es zupı.","Bugün çorba var."]]}
{"w":"hallo","t":"ünlem","m":"merhaba; alo","s":["hi"],"a":["tschüss"],"e":[["Hallo, wie heißt du?","halo, vi hayst du?","Merhaba, adın ne?"],["Hallo? Ist da jemand?","halo? ist da yemant?","Alo? Orada biri var mı?"]]}
{"w":"tschüss","t":"ünlem","m":"hoşça kal; görüşürüz","s":["ciao","auf Wiedersehen"],"a":["hallo"],"e":[["Tschüss, bis morgen!","çüs, bis morgın!","Hoşça kal, yarın görüşürüz!"],["Ich muss gehen. Tschüss!","ih mus gen. çüs!","Gitmem lazım. Hoşça kal!"]]}
{"w":"danke","t":"ünlem","m":"teşekkürler","s":["vielen Dank"],"a":[],"e":[["Danke für alles!","dankı für alıs!","Her şey için teşekkürler!"],["Möchtest du Tee? — Nein, danke.","möhtıst du te? — nayn, dankı.","Çay ister misin? — Hayır, teşekkürler."]]}
{"w":"bitte","t":"ünlem","m":"lütfen; buyurun; efendim?","s":[],"a":[],"e":[["Einen Kaffee, bitte.","aynın kafe, bitı.","Bir kahve, lütfen."],["Bitte? Ich habe Sie nicht verstanden.","bitı? ih habı zi niht ferştandın.","Efendim? Sizi anlamadım."]],"x":[["wie bitte?","vi bitı","efendim? (anlamadım)","Wie bitte? Können Sie das wiederholen?","vi bitı? könın zi das vidırholın?","Efendim? Bunu tekrarlayabilir misiniz?"]]}
{"w":"ja","t":"zarf","m":"evet","s":[],"a":["nein"],"e":[["Ja, das stimmt.","ya, das ştimt.","Evet, doğru."],["Das ist ja schön!","das ist ya şön!","Ne güzel!"]],"x":[["ja oder nein","ya odır nayn","evet ya da hayır","Sag einfach ja oder nein.","zak aynfah ya odır nayn","Sadece evet ya da hayır de."]]}
{"w":"nein","t":"zarf","m":"hayır","s":[],"a":["ja"],"e":[["Nein, danke.","nayn, dankı.","Hayır, teşekkürler."],["Nein, ich komme nicht mit.","nayn, ih komı niht mit.","Hayır, ben gelmiyorum."]]}
{"w":"doch","t":"zarf","m":"evet (olumsuza karşı); yine de","s":[],"a":[],"e":[["Hast du keinen Hunger? — Doch!","hast du kaynın hungır? — doh!","Acıkmadın mı? — Acıktım!"],["Es regnet, aber ich gehe doch raus.","es regnıt, abır ih geı doh raus.","Yağmur yağıyor, ama yine de dışarı çıkıyorum."]]}
{"w":"nicht","t":"zarf","m":"değil; -me","s":[],"a":[],"e":[["Ich weiß es nicht.","ih vays es niht.","Bilmiyorum."],["Das ist nicht teuer.","das ist niht toyır.","Bu pahalı değil."]],"x":[["nicht mehr","niht mer","artık ... değil","Er wohnt nicht mehr hier.","er vont niht mer hir","O artık burada oturmuyor."],["gar nicht","gar niht","hiç","Das gefällt mir gar nicht.","das gıfelt mir gar niht","Bu hiç hoşuma gitmiyor."]]}
{"w":"ich","t":"zamir","m":"ben","s":[],"a":[],"e":[["Ich bin Student.","ih bin ştudent.","Ben öğrenciyim."],["Ich habe zwei Brüder.","ih habı tsvay brüdır.","İki erkek kardeşim var."]]}
{"w":"du","t":"zamir","m":"sen","s":[],"a":[],"e":[["Du bist mein Freund.","du bist mayn froynt.","Sen benim arkadaşımsın."],["Kommst du morgen?","komst du morgın?","Yarın geliyor musun?"]]}
{"w":"er","t":"zamir","m":"o (erkek)","s":[],"a":[],"e":[["Er wohnt in Wien.","er vont in vin.","O Viyana'da oturuyor."],["Wo ist der Bus? Er kommt gleich.","vo ist der bus? er komt glayh.","Otobüs nerede? Birazdan gelir."]]}
{"w":"sie","t":"zamir","m":"o (kadın); onlar","s":[],"a":[],"e":[["Sie heißt Lena.","zi hayst lena.","Onun adı Lena."],["Sie spielen im Garten.","zi şpilın im gartın.","Onlar bahçede oynuyor."]]}
{"w":"es","t":"zamir","m":"o (nötr); (soyut özne)","s":[],"a":[],"e":[["Es ist kalt.","es ist kalt.","Hava soğuk."],["Das Kind ist klein, es schläft.","das kint ist klayn, es şleft.","Çocuk küçük, uyuyor."]]}
{"w":"wir","t":"zamir","m":"biz","s":[],"a":[],"e":[["Wir wohnen in Köln.","vir vonın in köln.","Biz Köln'de oturuyoruz."],["Wir sind müde.","vir zint müdı.","Yorgunuz."]]}
{"w":"ihr","t":"zamir","m":"siz (çoğul, samimi)","s":[],"a":[],"e":[["Ihr seid meine Freunde.","ir zayt maynı froyndı.","Siz benim arkadaşlarımsınız."],["Wo wart ihr gestern?","vo vart ir gestırn?","Dün neredeydiniz?"]]}
{"w":"man","t":"zamir","m":"insan; biri; (genel özne)","s":[],"a":[],"e":[["Hier darf man nicht rauchen.","hir darf man niht rauhın.","Burada sigara içilmez."],["Wie schreibt man das?","vi şraypt man das?","Bu nasıl yazılır?"]]}
{"w":"sich","t":"zamir","m":"kendini; kendine","s":[],"a":[],"e":[["Er wäscht sich die Hände.","er veşt zih di hendı.","O ellerini yıkıyor."],["Sie freut sich auf die Ferien.","zi froyt zih auf di feryın.","Tatili dört gözle bekliyor."]],"x":[["sich freuen auf","zih froyın auf","dört gözle beklemek","Ich freue mich auf das Wochenende.","ih froyı mih auf das vohınendı","Hafta sonunu dört gözle bekliyorum."]]}
{"w":"sein","t":"fiil","m":"olmak","s":[],"a":[],"e":[["Ich bin müde.","ih bin müdı.","Yorgunum."],["Ich will Arzt sein.","ih vil artst zayn.","Doktor olmak istiyorum."]]}
{"w":"haben","t":"fiil","m":"sahip olmak; -i olmak","s":[],"a":[],"e":[["Ich habe einen Hund.","ih habı aynın hunt.","Bir köpeğim var."],["Hast du Hunger?","hast du hungır?","Acıktın mı?"]],"x":[["Hunger haben","hungır habın","acıkmak","Wir haben Hunger.","vir habın hungır","Acıktık."],["Zeit haben","tsayt habın","vakti olmak","Hast du morgen Zeit?","hast du morgın tsayt?","Yarın vaktin var mı?"]]}
{"w":"werden","t":"fiil","m":"olmak (dönüşmek); -ecek","s":[],"a":[],"e":[["Es wird dunkel.","es virt dunkıl.","Hava kararıyor."],["Ich werde Lehrer.","ih verdı lerır.","Öğretmen olacağım."]]}
{"w":"können","t":"fiil","m":"-ebilmek; bilmek","s":[],"a":[],"e":[["Ich kann gut schwimmen.","ih kan gut şvimın.","İyi yüzebilirim."],["Kannst du Deutsch sprechen?","kanst du doyç şprehın?","Almanca konuşabilir misin?"]]}
{"w":"wissen","t":"fiil","m":"bilmek","s":[],"a":[],"e":[["Weißt du, wo er wohnt?","vayst du, vo er vont?","Onun nerede oturduğunu biliyor musun?"],["Wir wissen die Antwort.","vir visın di antvort.","Cevabı biliyoruz."]],"x":[["Bescheid wissen","bışayt visın","haberdar olmak","Ich weiß schon Bescheid.","ih vays şon bışayt","Zaten haberim var."]]}
{"w":"müssen","t":"fiil","m":"zorunda olmak; -meli","s":[],"a":[],"e":[["Ich muss jetzt gehen.","ih mus yetst gen.","Şimdi gitmeliyim."],["Müssen wir heute arbeiten?","müsın vir hoytı arbaytın?","Bugün çalışmak zorunda mıyız?"]]}
{"w":"wollen","t":"fiil","m":"istemek; -mek istemek","s":[],"a":[],"e":[["Ich will nach Hause.","ih vil nah hauzı.","Eve gitmek istiyorum."],["Was wollt ihr essen?","vas volt ir esın?","Ne yemek istiyorsunuz?"]]}
{"w":"sollen","t":"fiil","m":"-meli; -mesi gerekmek","s":[],"a":[],"e":[["Du sollst mehr schlafen.","du zolst mer şlafın.","Daha çok uyumalısın."],["Was soll ich kaufen?","vas zol ih kaufın?","Ne almalıyım?"]]}
{"w":"dürfen","t":"fiil","m":"izni olmak; -ebilmek (izin)","s":[],"a":[],"e":[["Darf ich hier sitzen?","darf ih hir zitsın?","Burada oturabilir miyim?"],["Hier dürfen wir nicht parken.","hir dürfın vir niht parkın.","Burada park etmemiz yasak."]]}
{"w":"mögen","t":"fiil","m":"sevmek; hoşlanmak","s":[],"a":[],"e":[["Ich mag Schokolade.","ih mak şokoladı.","Çikolatayı severim."],["Magst du Katzen?","makst du katsın?","Kedileri sever misin?"]]}
{"w":"möchten","t":"fiil","m":"istemek (nazik); -mek isterim","s":[],"a":[],"e":[["Ich möchte einen Tee, bitte.","ih möhtı aynın te, bitı.","Bir çay istiyorum, lütfen."],["Möchten Sie noch etwas?","möhtın zi noh etvas?","Başka bir şey ister misiniz?"]]}
{"w":"der","t":"belirleyici","m":"belirli artikel (eril)","s":[],"a":[],"e":[["Der Mann trinkt Kaffee.","der man trinkt kafe.","Adam kahve içiyor."],["Wo ist der Bahnhof?","vo ist der banhof?","Gar nerede?"]]}
{"w":"ein","t":"belirleyici","m":"bir (belirsiz artikel)","s":[],"a":[],"e":[["Ich habe ein Auto.","ih habı ayn auto.","Bir arabam var."],["Das ist eine gute Idee.","das ist aynı gutı ide.","Bu iyi bir fikir."]]}
{"w":"kein","t":"belirleyici","m":"hiç; değil (isimle)","s":[],"a":[],"e":[["Ich habe kein Geld.","ih habı kayn gelt.","Param yok."],["Wir haben keine Zeit.","vir habın kaynı tsayt.","Vaktimiz yok."]],"x":[["kein Problem","kayn problem","sorun değil","Kein Problem, ich helfe dir.","kayn problem, ih helfı dir","Sorun değil, sana yardım ederim."]]}
