{"w":"mein","t":"belirleyici","m":"benim","s":[],"a":[],"e":[["Das ist mein Bruder.","das ist mayn brudır.","Bu benim erkek kardeşim."],["Meine Mutter kocht gern.","maynı mutır kokt gern.","Annem yemek yapmayı sever."]]}
{"w":"dein","t":"belirleyici","m":"senin","s":[],"a":[],"e":[["Wo ist dein Handy?","vo ist dayn hendi?","Telefonun nerede?"],["Ist das deine Tasche?","ist das daynı taşı?","Bu senin çantan mı?"]]}
{"w":"unser","t":"belirleyici","m":"bizim","s":[],"a":[],"e":[["Unser Haus ist klein.","unzır haus ist klayn.","Evimiz küçük."],["Das sind unsere Kinder.","das zint unzırı kindır.","Bunlar bizim çocuklarımız."]]}
{"w":"euer","t":"belirleyici","m":"sizin (çoğul, samimi)","s":[],"a":[],"e":[["Wo ist euer Auto?","vo ist oyır auto?","Arabanız nerede?"],["Eure Wohnung ist schön.","oyrı vonunk ist şön.","Daireniz güzel."]]}
{"w":"dieser","t":"belirleyici","m":"bu","s":[],"a":[],"e":[["Dieser Film ist gut.","dizır film ist gut.","Bu film iyi."],["Ich nehme diesen Kuchen.","ih nemı dizın kuhın.","Bu pastayı alıyorum."]]}
{"w":"jeder","t":"belirleyici","m":"her; her bir","s":[],"a":[],"e":[["Jeder Mensch ist anders.","yedır menş ist andırs.","Her insan farklıdır."],["Ich laufe jeden Tag.","ih laufı yedın tak.","Her gün koşarım."]],"x":[["jeden Tag","yedın tak","her gün","Er ruft jeden Tag an.","er ruft yedın tak an","Her gün arıyor."]]}
{"w":"alle","t":"belirleyici","m":"hepsi; bütün; herkes","s":[],"a":[],"e":[["Alle Kinder spielen draußen.","alı kindır şpilın drausın.","Bütün çocuklar dışarıda oynuyor."],["Sind alle da?","zint alı da?","Herkes burada mı?"]]}
{"w":"welcher","t":"belirleyici","m":"hangi","s":[],"a":[],"e":[["Welcher Bus fährt zum Bahnhof?","velhır bus fert tsum banhof?","Hangi otobüs gara gidiyor?"],["Welche Farbe magst du?","velhı farbı makst du?","Hangi rengi seviyorsun?"]]}
{"w":"viele","t":"belirleyici","m":"çok; birçok","s":[],"a":["wenige"],"e":[["Hier wohnen viele Leute.","hir vonın filı loytı.","Burada çok insan yaşıyor."],["Ich habe viele Freunde.","ih habı filı froyndı.","Çok arkadaşım var."]]}
{"w":"wer","t":"zamir","m":"kim","s":[],"a":[],"e":[["Wer ist das?","ver ist das?","Bu kim?"],["Wer kommt mit ins Kino?","ver komt mit ins kino?","Sinemaya kim geliyor?"]]}
{"w":"was","t":"zamir","m":"ne","s":[],"a":[],"e":[["Was machst du?","vas mahst du?","Ne yapıyorsun?"],["Was kostet das Brot?","vas kostıt das brot?","Ekmek ne kadar?"]],"x":[["was für ein","vas für ayn","nasıl bir; ne biçim","Was für ein schöner Tag!","vas für ayn şönır tak!","Ne güzel bir gün!"]]}
{"w":"etwas","t":"zamir","m":"bir şey; biraz","s":["irgendetwas"],"a":["nichts"],"e":[["Ich brauche etwas Zeit.","ih brauhı etvas tsayt.","Biraz zamana ihtiyacım var."],["Möchtest du etwas trinken?","möhtıst du etvas trinkın?","Bir şey içmek ister misin?"]]}
{"w":"nichts","t":"zamir","m":"hiçbir şey","s":[],"a":["etwas","alles"],"e":[["Ich sehe nichts.","ih zeı nihts.","Hiçbir şey görmüyorum."],["Das macht nichts.","das maht nihts.","Önemli değil."]],"x":[["gar nichts","gar nihts","hiçbir şey","Er weiß gar nichts.","er vays gar nihts","Hiçbir şey bilmiyor."]]}
{"w":"wie","t":"zarf","m":"nasıl; ne kadar","s":[],"a":[],"e":[["Wie heißt du?","vi hayst du?","Adın ne?"],["Wie alt bist du?","vi alt bist du?","Kaç yaşındasın?"]],"x":[["wie viel","vi fil","ne kadar","Wie viel kostet das?","vi fil kostıt das?","Bu ne kadar?"]]}
{"w":"wo","t":"zarf","m":"nerede","s":[],"a":[],"e":[["Wo wohnst du?","vo vonst du?","Nerede oturuyorsun?"],["Wo ist die Toilette?","vo ist di toaletı?","Tuvalet nerede?"]]}
{"w":"wann","t":"zarf","m":"ne zaman","s":[],"a":[],"e":[["Wann kommst du?","van komst du?","Ne zaman geliyorsun?"],["Wann beginnt der Film?","van bıgint der film?","Film ne zaman başlıyor?"]]}
{"w":"warum","t":"zarf","m":"neden; niçin","s":["wieso","weshalb"],"a":[],"e":[["Warum weinst du?","varum vaynst du?","Neden ağlıyorsun?"],["Warum nicht?","varum niht?","Neden olmasın?"]]}
{"w":"woher","t":"zarf","m":"nereden","s":[],"a":[],"e":[["Woher kommst du?","voher komst du?","Nereden geliyorsun?"],["Woher weißt du das?","voher vayst du das?","Bunu nereden biliyorsun?"]]}
{"w":"wohin","t":"zarf","m":"nereye","s":[],"a":[],"e":[["Wohin gehst du?","vohin gest du?","Nereye gidiyorsun?"],["Wohin fährt dieser Zug?","vohin fert dizır tsuk?","Bu tren nereye gidiyor?"]]}
{"w":"und","t":"bağlaç","m":"ve","s":[],"a":[],"e":[["Ich esse Brot und Käse.","ih esı brot unt kezı.","Ekmek ve peynir yerim."],["Es regnet und es ist kalt.","es regnıt unt es ist kalt.","Yağmur yağıyor ve hava soğuk."]]}
{"w":"oder","t":"bağlaç","m":"veya; ya da","s":[],"a":[],"e":[["Tee oder Kaffee?","te odır kafe?","Çay mı kahve mi?"],["Kommst du oder bleibst du?","komst du odır blaypst du?","Geliyor musun yoksa kalıyor musun?"]]}
{"w":"aber","t":"bağlaç","m":"ama; fakat","s":["jedoch"],"a":[],"e":[["Ich bin müde, aber glücklich.","ih bin müdı, abır glüklih.","Yorgunum ama mutluyum."],["Das ist gut, aber teuer.","das ist gut, abır toyır.","Bu iyi ama pahalı."]]}
{"w":"weil","t":"bağlaç","m":"çünkü; -diği için","s":[],"a":[],"e":[["Ich bleibe zu Hause, weil ich krank bin.","ih blaybı tsu hauzı, vayl ih krank bin.","Hasta olduğum için evde kalıyorum."],["Ich lerne Deutsch, weil ich in Berlin wohne.","ih lernı doyç, vayl ih in berlin vonı.","Berlin'de yaşadığım için Almanca öğreniyorum."]]}
{"w":"dass","t":"bağlaç","m":"ki; -diğini","s":[],"a":[],"e":[["Ich glaube, dass er recht hat.","ih glaubı, das er reht hat.","Haklı olduğunu düşünüyorum."],["Es ist schön, dass du da bist.","es ist şön, das du da bist.","Burada olman güzel."]]}
{"w":"wenn","t":"bağlaç","m":"eğer; -ince; -diğinde","s":[],"a":[],"e":[["Wenn es regnet, bleiben wir hier.","ven es regnıt, blaybın vir hir.","Yağmur yağarsa burada kalırız."],["Ich lache, wenn ich dich sehe.","ih lahı, ven ih dih zeı.","Seni gördüğümde gülerim."]]}
{"w":"denn","t":"bağlaç","m":"çünkü; ya (vurgu)","s":[],"a":[],"e":[["Ich gehe heim, denn ich bin müde.","ih geı haym, den ih bin müdı.","Eve gidiyorum, çünkü yorgunum."],["Wo bist du denn?","vo bist du den?","Sen neredesin ya?"]]}
{"w":"null","t":"sayı","m":"sıfır","s":[],"a":[],"e":[["Es ist null Grad.","es ist nul grat.","Hava sıfır derece."],["Die Nummer beginnt mit null.","di numır bıgint mit nul.","Numara sıfırla başlıyor."]]}
{"w":"eins","t":"sayı","m":"bir","s":[],"a":[],"e":[["Eins, zwei, drei!","ayns, tsvay, dray!","Bir, iki, üç!"],["Das Spiel steht eins zu eins.","das şpil ştet ayns tsu ayns.","Maç bire bir."]]}
{"w":"zwei","t":"sayı","m":"iki","s":[],"a":[],"e":[["Ich habe zwei Katzen.","ih habı tsvay katsın.","İki kedim var."],["Wir treffen uns um zwei.","vir trefın uns um tsvay.","Saat ikide buluşuyoruz."]]}
{"w":"drei","t":"sayı","m":"üç","s":[],"a":[],"e":[["Drei Äpfel, bitte.","dray epfıl, bitı.","Üç elma, lütfen."],["Das Kind ist drei Jahre alt.","das kint ist dray yarı alt.","Çocuk üç yaşında."]]}
{"w":"vier","t":"sayı","m":"dört","s":[],"a":[],"e":[["Der Tisch hat vier Beine.","der tiş hat fir baynı.","Masanın dört ayağı var."],["Es ist vier Uhr.","es ist fir ur.","Saat dört."]]}
{"w":"fünf","t":"sayı","m":"beş","s":[],"a":[],"e":[["Ich brauche fünf Minuten.","ih brauhı fünf minutın.","Beş dakikaya ihtiyacım var."],["Fünf mal drei ist fünfzehn.","fünf mal dray ist fünftsen.","Beş çarpı üç on beştir."]]}
{"w":"sechs","t":"sayı","m":"altı","s":[],"a":[],"e":[["Sechs Eier, bitte.","zeks ayır, bitı.","Altı yumurta, lütfen."],["Wir essen um sechs.","vir esın um zeks.","Altıda yemek yeriz."]]}
{"w":"sieben","t":"sayı","m":"yedi","s":[],"a":[],"e":[["Die Woche hat sieben Tage.","di vohı hat zibın tagı.","Haftada yedi gün var."],["Mein Sohn ist sieben.","mayn zon ist zibın.","Oğlum yedi yaşında."]]}
{"w":"acht","t":"sayı","m":"sekiz","s":[],"a":[],"e":[["Ich stehe um acht auf.","ih şteı um aht auf.","Sekizde kalkarım."],["Wir sind acht Personen.","vir zint aht perzonın.","Sekiz kişiyiz."]]}
{"w":"neun","t":"sayı","m":"dokuz","s":[],"a":[],"e":[["Neun Euro, bitte.","noyn oyro, bitı.","Dokuz avro, lütfen."],["Der Zug kommt um neun.","der tsuk komt um noyn.","Tren dokuzda geliyor."]]}
{"w":"zehn","t":"sayı","m":"on","s":[],"a":[],"e":[["Noch zehn Minuten.","noh tsen minutın.","Daha on dakika."],["Ich bin zehn Jahre alt.","ih bin tsen yarı alt.","On yaşındayım."]]}
{"w":"elf","t":"sayı","m":"on bir","s":[],"a":[],"e":[["Eine Mannschaft hat elf Spieler.","aynı manşaft hat elf şpilır.","Bir takımda on bir oyuncu var."],["Es ist elf Uhr.","es ist elf ur.","Saat on bir."]]}
{"w":"zwölf","t":"sayı","m":"on iki","s":[],"a":[],"e":[["Ein Dutzend hat zwölf Stück.","ayn dutsınt hat tsvölf ştük.","Bir düzinede on iki adet var."],["Um zwölf essen wir.","um tsvölf esın vir.","On ikide yemek yeriz."]]}
{"w":"dreizehn","t":"sayı","m":"on üç","s":[],"a":[],"e":[["Er ist dreizehn Jahre alt.","er ist draytsen yarı alt.","O on üç yaşında."],["Wir wohnen in Zimmer dreizehn.","vir vonın in tsimır draytsen.","On üç numaralı odada kalıyoruz."]]}
{"w":"vierzehn","t":"sayı","m":"on dört","s":[],"a":[],"e":[["Ich habe vierzehn Tage Urlaub.","ih habı firtsen tagı urlaup.","On dört gün iznim var."],["Sie ist vierzehn.","zi ist firtsen.","O on dört yaşında."]]}
{"w":"fünfzehn","t":"sayı","m":"on beş","s":[],"a":[],"e":[["Der Bus kommt in fünfzehn Minuten.","der bus komt in fünftsen minutın.","Otobüs on beş dakikaya geliyor."],["Fünfzehn Euro, bitte.","fünftsen oyro, bitı.","On beş avro, lütfen."]]}
{"w":"sechzehn","t":"sayı","m":"on altı","s":[],"a":[],"e":[["Ich werde bald sechzehn.","ih verdı balt zehtsen.","Yakında on altı yaşına giriyorum."],["Sechzehn Schüler sind da.","zehtsen şülır zint da.","On altı öğrenci burada."]]}
{"w":"siebzehn","t":"sayı","m":"on yedi","s":[],"a":[],"e":[["Meine Schwester ist siebzehn.","maynı şvestır ist siptsen.","Kız kardeşim on yedi yaşında."],["Es sind siebzehn Grad.","es zint siptsen grat.","Hava on yedi derece."]]}
{"w":"achtzehn","t":"sayı","m":"on sekiz","s":[],"a":[],"e":[["Mit achtzehn ist man erwachsen.","mit ahtsen ist man ervaksın.","On sekiz yaşında insan yetişkin olur."],["Achtzehn Gäste kommen.","ahtsen gestı komın.","On sekiz konuk geliyor."]]}
{"w":"neunzehn","t":"sayı","m":"on dokuz","s":[],"a":[],"e":[["Er ist neunzehn Jahre alt.","er ist noyntsen yarı alt.","O on dokuz yaşında."],["Ich wohne in Zimmer neunzehn.","ih vonı in tsimır noyntsen.","On dokuz numaralı odada kalıyorum."]]}
{"w":"zwanzig","t":"sayı","m":"yirmi","s":[],"a":[],"e":[["Das kostet zwanzig Euro.","das kostıt tsvantsih oyro.","Bu yirmi avro."],["Ich bin zwanzig Jahre alt.","ih bin tsvantsih yarı alt.","Yirmi yaşındayım."]]}
{"w":"dreißig","t":"sayı","m":"otuz","s":[],"a":[],"e":[["Das dauert dreißig Minuten.","das dauırt draysih minutın.","Bu otuz dakika sürer."],["Er ist über dreißig.","er ist übır draysih.","O otuzun üzerinde."]]}
{"w":"vierzig","t":"sayı","m":"kırk","s":[],"a":[],"e":[["Er ist vierzig Jahre alt.","er ist firtsih yarı alt.","O kırk yaşında."],["Wir sind vierzig Leute.","vir zint firtsih loytı.","Biz kırk kişiyiz."]]}
{"w":"fünfzig","t":"sayı","m":"elli","s":[],"a":[],"e":[["Das Hemd kostet fünfzig Euro.","das hemt kostıt fünftsih oyro.","Gömlek elli avro."],["Die Hälfte ist fünfzig Prozent.","di helftı ist fünftsih protsent.","Yarısı yüzde elli demektir."]]}
