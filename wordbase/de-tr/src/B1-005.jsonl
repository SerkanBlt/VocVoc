{"w":"jederzeit","t":"zarf","m":"her zaman; istediğin an","s":[],"a":[],"e":[["Du kannst mich jederzeit anrufen.","","Beni istediğin zaman arayabilirsin."],["Die Bibliothek ist jederzeit offen.","","Kütüphane her an açık."]]}
{"w":"nirgendwo","t":"zarf","m":"hiçbir yerde","s":["nirgends"],"a":["überall"],"e":[["Ich finde meinen Schlüssel nirgendwo.","","Anahtarımı hiçbir yerde bulamıyorum."],["Nirgendwo ist es so schön wie hier.","","Hiçbir yer burası kadar güzel değil."]]}
{"w":"irgendwann","t":"zarf","m":"bir gün; bir zaman","s":[],"a":[],"e":[["Irgendwann besuche ich dich in Wien.","","Bir gün seni Viyana'da ziyaret ederim."],["Er wird irgendwann anrufen.","","Bir ara arayacak."]]}
{"w":"irgendwohin","t":"zarf","m":"bir yere","s":[],"a":[],"e":[["Lass uns irgendwohin fahren, wo es ruhig ist.","","Sakin bir yere gidelim."],["Er will irgendwohin in den Süden ziehen.","","Güneyde bir yere taşınmak istiyor."]]}
{"w":"soeben","t":"zarf","m":"az önce; şimdi","s":["gerade"],"a":[],"e":[["Der Zug ist soeben abgefahren.","","Tren az önce kalktı."],["Ich habe soeben deine Nachricht gelesen.","","Mesajını az önce okudum."]]}
{"w":"wohl","t":"zarf","m":"herhalde; sanırım; iyi","s":["vermutlich"],"a":[],"e":[["Er ist wohl schon zu Hause.","","Herhalde çoktan evde."],["Ich fühle mich hier sehr wohl.","","Burada kendimi çok iyi hissediyorum."]]}
{"w":"halt","t":"zarf","m":"işte; ne yapalım; yani","s":[],"a":[],"e":[["Das ist halt so.","","İşte böyle, ne yapalım."],["Dann nehmen wir halt den Bus.","","O zaman otobüse bineriz yani."]]}
{"w":"bloß","t":"zarf","m":"sadece; yeter ki","s":["nur"],"a":[],"e":[["Ich habe bloß eine Frage.","","Sadece bir sorum var."],["Wo ist er bloß?","","Nerede acaba?"]]}
{"w":"nahezu","t":"zarf","m":"neredeyse; hemen hemen","s":["fast"],"a":[],"e":[["Das Stadion war nahezu leer.","","Stadyum neredeyse boştu."],["Nahezu alle Gäste sind gekommen.","","Neredeyse bütün konuklar geldi."]]}
{"w":"stets","t":"zarf","m":"daima; her zaman","s":["immer"],"a":[],"e":[["Sie ist stets freundlich.","","O daima güler yüzlüdür."],["Er kommt stets pünktlich.","","Her zaman dakik gelir."]]}
{"w":"meist","t":"zarf","m":"çoğunlukla; çoğu zaman","s":["meistens"],"a":[],"e":[["Ich stehe meist um sechs Uhr auf.","","Çoğunlukla altıda kalkarım."],["Am Sonntag schlafen wir meist lange.","","Pazar günleri çoğu zaman uzun uyuruz."]]}
{"w":"öfter","t":"zarf","m":"daha sık; sık sık","s":[],"a":[],"e":[["Du solltest öfter Sport machen.","","Daha sık spor yapmalısın."],["Ich besuche meine Oma jetzt öfter.","","Artık babaannemi daha sık ziyaret ediyorum."]]}
{"w":"gelegentlich","t":"zarf","m":"ara sıra; arada bir","s":["manchmal"],"a":[],"e":[["Wir treffen uns gelegentlich zum Essen.","","Ara sıra yemek için buluşuyoruz."],["Gelegentlich regnet es im Sommer.","","Yazın arada bir yağmur yağar."]]}
{"w":"dauernd","t":"zarf","m":"sürekli; durmadan","s":["ständig"],"a":[],"e":[["Das Telefon klingelt dauernd.","","Telefon sürekli çalıyor."],["Er beschwert sich dauernd über das Wetter.","","Durmadan havadan şikâyet ediyor."]]}
{"w":"ständig","t":"zarf","m":"sürekli; daimi","s":["dauernd"],"a":[],"e":[["Sie ist ständig müde.","","O sürekli yorgun."],["Die Kinder streiten ständig.","","Çocuklar sürekli kavga ediyor."]]}
{"w":"nochmals","t":"zarf","m":"bir kez daha; tekrar","s":["noch einmal"],"a":[],"e":[["Können Sie das nochmals erklären?","","Bunu bir kez daha açıklayabilir misiniz?"],["Ich danke Ihnen nochmals für Ihre Hilfe.","","Yardımınız için size bir kez daha teşekkür ederim."]]}
{"w":"erneut","t":"zarf","m":"yeniden; tekrar","s":["wieder"],"a":[],"e":[["Das Gerät ist erneut ausgefallen.","","Cihaz yeniden bozuldu."],["Er hat erneut versucht, sie anzurufen.","","Onu tekrar aramayı denedi."]]}
{"w":"zugleich","t":"zarf","m":"aynı zamanda; hem de","s":["gleichzeitig"],"a":[],"e":[["Sie ist Lehrerin und zugleich Mutter von drei Kindern.","","O öğretmen ve aynı zamanda üç çocuk annesi."],["Das ist schön und zugleich traurig.","","Bu güzel ve aynı zamanda üzücü."]]}
{"w":"gleichzeitig","t":"zarf","m":"aynı anda; eş zamanlı","s":["zugleich"],"a":[],"e":[["Wir sind gleichzeitig angekommen.","","Aynı anda vardık."],["Man kann nicht alles gleichzeitig machen.","","Her şeyi aynı anda yapamazsın."]]}
{"w":"nebenbei","t":"zarf","m":"yanında; arada; lafın arasında","s":[],"a":[],"e":[["Sie arbeitet nebenbei als Kellnerin.","","Yan iş olarak garsonluk yapıyor."],["Er hat das nur nebenbei erwähnt.","","Bunu sadece lafın arasında söyledi."]]}
{"w":"vorbei","t":"zarf","m":"geçmiş; bitmiş; yanından","s":["zu Ende"],"a":[],"e":[["Der Sommer ist leider vorbei.","","Yaz maalesef bitti."],["Der Bus fährt am Bahnhof vorbei.","","Otobüs garın yanından geçiyor."]]}
{"w":"hinzu","t":"zarf","m":"ek olarak; üstüne","s":[],"a":[],"e":[["Dazu kommt noch, dass es regnet.","","Buna bir de yağmur yağıyor olması ekleniyor."],["Zu den Kosten kommen noch die Steuern hinzu.","","Maliyetlere bir de vergiler ekleniyor."]]}
{"w":"voran","t":"zarf","m":"ileri; önde","s":[],"a":[],"e":[["Die Arbeit geht gut voran.","","İş iyi ilerliyor."],["Der Hund läuft voran, wir folgen.","","Köpek önde koşuyor, biz takip ediyoruz."]]}
{"w":"voraus","t":"zarf","m":"önde; ileride","s":[],"a":[],"e":[["Die Kinder sind schon voraus gegangen.","","Çocuklar çoktan önden gitti."],["Meine Schwester ist mir im Studium voraus.","","Kız kardeşim üniversitede benden ilerde."]]}
{"w":"vorwärts","t":"zarf","m":"ileri; ileriye doğru","s":[],"a":["rückwärts"],"e":[["Er macht zwei Schritte vorwärts.","","İki adım ileri atıyor."],["Wir kommen nur langsam vorwärts.","","Sadece yavaş ilerliyoruz."]]}
{"w":"weiterhin","t":"zarf","m":"bundan sonra da; hâlâ","s":[],"a":[],"e":[["Wir bleiben weiterhin in Kontakt.","","Bundan sonra da görüşmeye devam edeceğiz."],["Das Wetter bleibt weiterhin schön.","","Hava güzel kalmaya devam ediyor."]]}
{"w":"weshalb","t":"zarf","m":"neden; bu yüzden","s":["warum"],"a":[],"e":[["Weshalb bist du so spät gekommen?","","Neden bu kadar geç geldin?"],["Ich weiß nicht, weshalb er traurig ist.","","Neden üzgün olduğunu bilmiyorum."]]}
{"w":"womit","t":"zarf","m":"neyle; ne ile","s":[],"a":[],"e":[["Womit schreibst du den Brief?","","Mektubu neyle yazıyorsun?"],["Ich weiß nicht, womit ich ihm helfen kann.","","Ona neyle yardım edebileceğimi bilmiyorum."]]}
{"w":"wofür","t":"zarf","m":"ne için; neye","s":[],"a":[],"e":[["Wofür brauchst du das Geld?","","Bu paraya ne için ihtiyacın var?"],["Wofür interessierst du dich?","","Neyle ilgileniyorsun?"]]}
{"w":"worüber","t":"zarf","m":"ne hakkında; neyi","s":[],"a":[],"e":[["Worüber habt ihr gesprochen?","","Ne hakkında konuştunuz?"],["Worüber freust du dich so?","","Neye bu kadar seviniyorsun?"]]}
{"w":"woran","t":"zarf","m":"neye; neyi","s":[],"a":[],"e":[["Woran denkst du gerade?","","Şu an ne düşünüyorsun?"],["Woran erkennt man einen guten Apfel?","","İyi bir elma neyle anlaşılır?"]]}
{"w":"worauf","t":"zarf","m":"neyi; neye","s":[],"a":[],"e":[["Worauf wartest du noch?","","Daha neyi bekliyorsun?"],["Worauf freust du dich am meisten?","","En çok neye seviniyorsun?"]]}
{"w":"wovon","t":"zarf","m":"neyden; ne hakkında","s":[],"a":[],"e":[["Wovon träumst du?","","Ne hayal ediyorsun?"],["Wovon lebt er eigentlich?","","O aslında neyle geçiniyor?"]]}
{"w":"wozu","t":"zarf","m":"ne için; niçin","s":[],"a":[],"e":[["Wozu brauchst du so viel Papier?","","Bu kadar kâğıda ne için ihtiyacın var?"],["Wozu soll das gut sein?","","Bu ne işe yarar?"]]}
{"w":"dadurch","t":"zarf","m":"bu sayede; bu yüzden","s":["deshalb"],"a":[],"e":[["Er hat viel gelernt und dadurch die Prüfung bestanden.","","Çok çalıştı ve bu sayede sınavı geçti."],["Dadurch spart man viel Zeit.","","Bu sayede çok zaman kazanılır."]]}
{"w":"dahin","t":"zarf","m":"oraya; o zamana kadar","s":[],"a":[],"e":[["Fährst du auch dahin?","","Sen de oraya mı gidiyorsun?"],["Bis dahin ist es noch lange hin.","","O zamana daha çok var."]]}
{"w":"darauf","t":"zarf","m":"üzerine; buna; ardından","s":[],"a":[],"e":[["Das Buch liegt darauf.","","Kitap onun üzerinde duruyor."],["Ich freue mich darauf.","","Buna seviniyorum."]]}
{"w":"daran","t":"zarf","m":"ona; bunun üzerinde","s":[],"a":[],"e":[["Ich denke oft daran.","","Sık sık bunu düşünüyorum."],["Er arbeitet seit Wochen daran.","","Haftalardır bunun üzerinde çalışıyor."]]}
{"w":"darin","t":"zarf","m":"içinde; bunun içinde","s":[],"a":[],"e":[["Die Tasche ist schwer, was ist darin?","","Çanta ağır, içinde ne var?"],["Darin liegt das Problem.","","Sorun burada yatıyor."]]}
{"w":"darüber","t":"zarf","m":"bunun hakkında; üstünde","s":[],"a":[],"e":[["Wir müssen darüber sprechen.","","Bunun hakkında konuşmamız gerek."],["Darüber hängt ein Bild.","","Onun üstünde bir resim asılı."]]}
{"w":"darunter","t":"zarf","m":"altında; arasında","s":[],"a":[],"e":[["Das Haus hat drei Etagen, darunter ein Keller.","","Evin üç katı var, altında bir bodrum var."],["Viele Gäste kamen, darunter auch mein Chef.","","Birçok konuk geldi, aralarında patronum da vardı."]]}
{"w":"davor","t":"zarf","m":"önünde; ondan önce","s":[],"a":[],"e":[["Ich habe Angst davor.","","Ondan korkuyorum."],["Das Haus ist alt, davor steht ein Baum.","","Ev eski, önünde bir ağaç duruyor."]]}
{"w":"dazu","t":"zarf","m":"buna; bunun yanında","s":[],"a":[],"e":[["Möchtest du dazu einen Tee?","","Yanında çay ister misin?"],["Ich habe keine Lust dazu.","","Buna canım istemiyor."]]}
{"w":"dazwischen","t":"zarf","m":"arasında; ortasında","s":[],"a":[],"e":[["Die Häuser sind alt, dazwischen steht ein Baum.","","Evler eski, aralarında bir ağaç duruyor."],["Er arbeitet und macht dazwischen Pause.","","Çalışıyor ve arada mola veriyor."]]}
{"w":"hierfür","t":"zarf","m":"bunun için; bunun karşılığında","s":[],"a":[],"e":[["Hierfür brauchst du einen Ausweis.","","Bunun için kimliğe ihtiyacın var."],["Hierfür bin ich nicht zuständig.","","Buna ben bakmıyorum."]]}
{"w":"hierbei","t":"zarf","m":"bu sırada; burada","s":[],"a":[],"e":[["Hierbei ist Vorsicht wichtig.","","Bu sırada dikkatli olmak önemli."],["Hierbei helfe ich dir gern.","","Bu konuda sana memnuniyetle yardım ederim."]]}
{"w":"hiermit","t":"zarf","m":"bununla; işbu","s":[],"a":[],"e":[["Hiermit bestätige ich den Termin.","","Bununla randevuyu onaylıyorum."],["Hiermit sind wir fertig.","","Bununla işimiz bitti."]]}
{"w":"einander","t":"zamir","m":"birbirini; birbirine","s":[],"a":[],"e":[["Die Kinder helfen einander.","","Çocuklar birbirine yardım ediyor."],["Wir kennen einander schon lange.","","Birbirimizi uzun zamandır tanıyoruz."]]}
{"w":"derjenige","t":"zamir","m":"o kişi; olan kişi","s":[],"a":[],"e":[["Derjenige, der das gemacht hat, soll sich melden.","","Bunu yapan kişi çıkıp söylesin."],["Diejenigen, die kommen wollen, melden sich bitte.","","Gelmek isteyenler lütfen haber versin."]]}
{"w":"derselbe","t":"zamir","m":"aynı; aynısı","s":[],"a":["ein anderer"],"e":[["Wir haben dasselbe Auto.","","Aynı arabaya sahibiz."],["Es ist immer dasselbe mit ihm.","","Onunla hep aynı şey."]]}
