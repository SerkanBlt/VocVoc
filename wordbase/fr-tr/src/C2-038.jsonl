{"w":"gobelin","t":"isim (eril)","m":"goblin (cin); Gobelin duvar halısı","s":["lutin","tapisserie"],"a":[],"e":[["Le gobelin cache son trésor dans la grotte.","lö goblen kaş son trezor dan la grot","Goblin hazinesini mağarada saklıyor."],["Cette tapisserie est un gobelin du dix-septième siècle.","set tapisri e ten goblen dü diz setyem syekl","Bu duvar halısı on yedinci yüzyıldan kalma bir Gobelin."]]}
{"w":"croupier","t":"isim (eril)","m":"krupiye","s":["donneur"],"a":["joueur"],"e":[["Le croupier distribue les cartes.","lö krupye distribü le kart","Krupiye kartları dağıtıyor."],["Le croupier annonce le numéro gagnant.","lö krupye anons lö nümero ganyan","Krupiye kazanan numarayı duyuruyor."]]}
{"w":"réouverture","t":"isim (dişil)","m":"yeniden açılış","s":["reprise"],"a":["fermeture"],"e":[["La réouverture du musée est prévue lundi.","la reuvertür dü müze e prevü lendi","Müzenin yeniden açılışı pazartesi için planlanıyor."],["Les commerçants attendent la réouverture.","le komersan atand la reuvertür","Esnaf yeniden açılışı bekliyor."]]}
{"w":"recouvrement","t":"isim (eril)","m":"tahsilat; kaplama","s":["perception","couverture"],"a":["paiement"],"e":[["Le recouvrement des impôts est difficile.","lö rökuvröman de zenpo e difisil","Vergi tahsilatı zor."],["Le recouvrement des dettes prend du temps.","lö rökuvröman de det pran dü tan","Borçların tahsili zaman alıyor."]]}
{"w":"carnivore","t":"sıfat","m":"etçil","s":["prédateur"],"a":["herbivore","végétarien"],"e":[["Le lion est un animal carnivore.","lö lyon e ten animal karnivor","Aslan etçil bir hayvandır."],["Cette plante carnivore attrape les mouches.","set plant karnivor atrap le muş","Bu etçil bitki sinekleri yakalıyor."]]}
{"w":"abois","t":"isim (eril)","m":"köşeye sıkışmış hal (çoğul)","s":["détresse"],"a":[],"e":[["Le cerf est aux abois.","lö ser e to zabua","Geyik köşeye sıkışmış."],["Le gouvernement est aux abois.","lö guvernöman e to zabua","Hükümet köşeye sıkışmış durumda."]],"x":[["aux abois","o zabua","köşeye sıkışmış","L'entreprise est aux abois.","lantröpriz e to zabua","Şirket köşeye sıkışmış durumda."]]}
{"w":"confiserie","t":"isim (dişil)","m":"şekerleme dükkânı; şekerlemeler","s":["bonbonnerie","sucreries"],"a":[],"e":[["Les enfants adorent la confiserie.","le zanfan ador la konfizri","Çocuklar şekerlemelere bayılıyor."],["Elle ouvre une confiserie en ville.","el uvr ün konfizri an vil","Şehirde bir şekerleme dükkânı açıyor."]]}
{"w":"siroter","t":"fiil","m":"yudumlamak","s":["savourer","déguster"],"a":["avaler"],"e":[["Il sirote un verre de vin.","il sirot en ver dö ven","Bir kadeh şarabı yudumluyor."],["Elle sirote son café tranquillement.","el sirot son kafe trankilman","Kahvesini sakin sakin yudumluyor."]]}
{"w":"calligraphie","t":"isim (dişil)","m":"kaligrafi; güzel yazı","s":["belle écriture"],"a":["griffonnage"],"e":[["Il apprend la calligraphie chinoise.","il apran la kaligrafi şinuaz","Çin kaligrafisi öğreniyor."],["Cette calligraphie est magnifique.","set kaligrafi e manyifik","Bu kaligrafi muhteşem."]]}
{"w":"médiéval","t":"sıfat","m":"ortaçağa ait","s":["gothique","ancien"],"a":["moderne","contemporain"],"e":[["Ils visitent une ville médiévale.","il vizit ün vil medyeval","Ortaçağdan kalma bir şehri geziyorlar."],["Cette église médiévale date du douzième siècle.","set egliz medyeval dat dü duzyem syekl","Bu ortaçağ kilisesi on ikinci yüzyıldan kalma."]]}
{"w":"ancrer","t":"fiil","m":"demirlemek; yerleştirmek","s":["amarrer","fixer"],"a":["lever l'ancre"],"e":[["Le capitaine ancre le bateau dans le port.","lö kapiten ankr lö bato dan lö por","Kaptan gemiyi limanda demirliyor."],["Cette idée s'ancre dans les mentalités.","set ide sankr dan le mantalite","Bu fikir zihniyetlere yerleşiyor."]]}
{"w":"toison","t":"isim (dişil)","m":"yapağı; post","s":["laine","pelage"],"a":[],"e":[["La toison du mouton est épaisse.","la tuazon dü muton e tepes","Koyunun yapağısı kalın."],["Le héros cherche la Toison d'or.","lö ero şerş la tuazon dor","Kahraman Altın Postu arıyor."]]}
{"w":"orbe","t":"isim (eril)","m":"küre; yörünge (edebî)","s":["sphère","globe"],"a":[],"e":[["L'orbe du soleil brille.","lorb dü solay briy","Güneşin küresi parlıyor."],["Un orbe de lumière apparaît.","en norb dö lümyer aparet","Bir ışık küresi beliriyor."]]}
{"w":"productivité","t":"isim (dişil)","m":"verimlilik","s":["rendement","efficacité"],"a":["improductivité"],"e":[["La productivité de l'usine augmente.","la prodüktivite dö lüzin ogmant","Fabrikanın verimliliği artıyor."],["Il cherche à améliorer sa productivité.","il şerş a ameliyore sa prodüktivite","Verimliliğini artırmaya çalışıyor."]]}
{"w":"crinière","t":"isim (dişil)","m":"yele","s":["chevelure","poils"],"a":[],"e":[["Le lion secoue sa crinière.","lö lyon sökü sa krinyer","Aslan yelesini silkiyor."],["Le cheval a une belle crinière noire.","lö şöval a ün bel krinyer nuar","Atın güzel siyah bir yelesi var."]]}
{"w":"destinataire","t":"isim (eril/dişil)","m":"alıcı","s":["receveur","bénéficiaire"],"a":["expéditeur"],"e":[["Le destinataire reçoit la lettre.","lö destinater rösua la letr","Alıcı mektubu alıyor."],["L'adresse du destinataire est incomplète.","ladres dü destinater e tenkonplet","Alıcının adresi eksik."]]}
{"w":"favoriser","t":"fiil","m":"kayırmak; elverişli kılmak","s":["avantager","encourager"],"a":["défavoriser","gêner"],"e":[["Cette loi favorise les petites entreprises.","set lua favoriz le pötit antröpriz","Bu yasa küçük işletmeleri destekliyor."],["Le beau temps favorise la récolte.","lö bo tan favoriz la rekolt","Güzel hava hasadı kolaylaştırıyor."]]}
{"w":"écriteau","t":"isim (eril)","m":"tabela; levha","s":["panneau","pancarte"],"a":[],"e":[["Un écriteau interdit l'entrée.","en nekrito enterdi lantre","Bir tabela girişi yasaklıyor."],["Il lit l'écriteau sur la porte.","il li lekrito sür la port","Kapıdaki tabelayı okuyor."]]}
{"w":"abstraction","t":"isim (dişil)","m":"soyutlama; hesaba katmama","s":["conceptualisation","idée"],"a":["concret"],"e":[["L'abstraction est difficile pour un enfant.","labstraksyon e difisil pur en nanfan","Soyutlama bir çocuk için zordur."],["L'artiste travaille sur l'abstraction.","lartist travay sür labstraksyon","Sanatçı soyutlama üzerine çalışıyor."]],"x":[["faire abstraction de","fer apstraksyon dö","göz ardı etmek","Elle fait abstraction du bruit pour travailler.","el fe apstraksyon dü brüi pur travaye","Çalışmak için gürültüyü görmezden geliyor."]]}
{"w":"saule","t":"isim (eril)","m":"söğüt","s":[],"a":[],"e":[["Le saule pleureur borde la rivière.","lö sol plörör bord la rivyer","Salkım söğüt nehrin kıyısında duruyor."],["Il s'assoit sous un saule.","il sasua su zen sol","Bir söğüdün altına oturuyor."]]}
{"w":"vestibule","t":"isim (eril)","m":"giriş holü","s":["hall","entrée"],"a":[],"e":[["Le vestibule mène au salon.","lö vestibül men o salon","Giriş holü salona açılıyor."],["Elle accroche son manteau dans le vestibule.","el akroş son manto dan lö vestibül","Paltosunu giriş holüne asıyor."]]}
{"w":"panoramique","t":"sıfat","m":"panoramik","s":["large","vaste"],"a":[],"e":[["Ils admirent la vue panoramique.","il zadmir la vü panoramik","Panoramik manzaraya hayran kalıyorlar."],["L'ascenseur panoramique monte lentement.","lasansör panoramik mont lantman","Panoramik asansör yavaşça yükseliyor."]]}
{"w":"tonique","t":"sıfat","m":"canlandırıcı; güçlendirici","s":["stimulant","fortifiant"],"a":["déprimant","mou"],"e":[["Cette boisson est tonique.","set buason e tonik","Bu içecek canlandırıcı."],["Elle prend une douche tonique.","el pran ün duş tonik","Canlandırıcı bir duş alıyor."]]}
{"w":"attelage","t":"isim (eril)","m":"koşum takımı; bağlantı","s":["harnais","remorque"],"a":[],"e":[["L'attelage traverse le village.","latlaj traver lö vilaj","Koşum takımı köyü geçiyor."],["Il vérifie l'attelage de la remorque.","il verifi latlaj dö la römork","Römorkun bağlantısını kontrol ediyor."]]}
{"w":"nuageux","t":"sıfat","m":"bulutlu","s":["couvert","gris"],"a":["dégagé","ensoleillé"],"e":[["Le ciel est nuageux aujourd'hui.","lö syel e nüajö ojurdüi","Gökyüzü bugün bulutlu."],["Une journée nuageuse s'annonce.","ün jurne nüajöz sanons","Bulutlu bir gün geliyor."]]}
{"w":"frêne","t":"isim (eril)","m":"dişbudak","s":[],"a":[],"e":[["Le frêne est un arbre robuste.","lö fren e ten arbr robüst","Dişbudak sağlam bir ağaçtır."],["Le manche est en bois de frêne.","lö manş e tan bua dö fren","Sap dişbudak ağacından yapılmış."]]}
{"w":"éloquent","t":"sıfat","m":"belagatli; anlamlı","s":["persuasif","expressif"],"a":["muet","confus"],"e":[["Il fait un discours éloquent.","il fe en diskur elokan","Belagatli bir konuşma yapıyor."],["Ce silence est éloquent.","sö silans e telokan","Bu sessizlik çok şey anlatıyor."]]}
{"w":"labrador","t":"isim (eril)","m":"labrador köpeği","s":["chien de chasse"],"a":[],"e":[["Le labrador joue avec les enfants.","lö labrador ju avek le zanfan","Labrador çocuklarla oynuyor."],["Ce labrador est très gentil.","sö labrador e tre janti","Bu labrador çok sevimli."]]}
{"w":"fournée","t":"isim (dişil)","m":"fırın dolusu; grup","s":["cuisson","vague"],"a":[],"e":[["Le boulanger sort une fournée de pain.","lö bulanje sor ün furne dö pen","Fırıncı bir fırın dolusu ekmek çıkarıyor."],["Une nouvelle fournée de recrues arrive.","ün nuvel furne dö rökrü ariv","Yeni bir acemi grubu geliyor."]]}
{"w":"comptage","t":"isim (eril)","m":"sayım","s":["dénombrement","calcul"],"a":[],"e":[["Le comptage des voix dure toute la nuit.","lö kontaj de vua dür tut la nüi","Oyların sayımı bütün gece sürüyor."],["Le comptage du stock est terminé.","lö kontaj dü stok e termine","Stok sayımı tamamlandı."]]}
{"w":"camée","t":"isim (eril)","m":"kameo","s":["pierre gravée"],"a":[],"e":[["Elle porte un camée ancien.","el port en kame ansyen","Eski bir kameo takıyor."],["Le camée représente un visage de femme.","lö kame röprezant en vizaj dö fam","Kameo bir kadın yüzünü tasvir ediyor."]]}
{"w":"objectivité","t":"isim (dişil)","m":"nesnellik","s":["impartialité","neutralité"],"a":["subjectivité"],"e":[["Le juge garde son objectivité.","lö jüj gard son objektivite","Hâkim nesnelliğini koruyor."],["Elle manque d'objectivité.","el mank dobjektivite","Nesnellikten yoksun."]]}
{"w":"louable","t":"sıfat","m":"övgüye değer","s":["méritoire","honorable"],"a":["blâmable"],"e":[["Son effort est louable.","son efor e luabl","Çabası övgüye değer."],["C'est une intention louable.","se tün entansyon luabl","Bu övgüye değer bir niyet."]]}
{"w":"redécorer","t":"fiil","m":"yeniden dekore etmek","s":["rénover","réaménager"],"a":[],"e":[["Ils redécorent le salon.","il redekor lö salon","Salonu yeniden dekore ediyorlar."],["Elle redécore sa chambre chaque année.","el redekor sa şanbr şak ane","Odasını her yıl yeniden dekore ediyor."]]}
{"w":"intestinal","t":"sıfat","m":"bağırsakla ilgili","s":["digestif"],"a":[],"e":[["Il souffre d'une infection intestinale.","il sufr dün enfeksyon entestinal","Bağırsak enfeksiyonu geçiriyor."],["La flore intestinale est importante.","la flor entestinal e tenportant","Bağırsak florası önemlidir."]]}
{"w":"croître","t":"fiil","m":"büyümek; artmak","s":["grandir","augmenter"],"a":["diminuer","décroître"],"e":[["Les plantes croissent vite au printemps.","le plant kruas vit o prentan","Bitkiler ilkbaharda hızlı büyür."],["La population croît chaque année.","la popülasyon krua şak ane","Nüfus her yıl artıyor."]]}
{"w":"persil","t":"isim (eril)","m":"maydanoz","s":[],"a":[],"e":[["Il hache du persil frais.","il aş dü persi fre","Taze maydanoz doğruyor."],["Le persil parfume la sauce.","lö persi parfüm la sos","Maydanoz sosu kokulandırıyor."]]}
{"w":"boa","t":"isim (eril)","m":"boa yılanı; tüy atkı","s":["serpent","écharpe de plumes"],"a":[],"e":[["Le boa étouffe sa proie.","lö boa etuf sa prua","Boa avını boğuyor."],["Elle porte un boa de plumes.","el port en boa dö plüm","Tüyden bir atkı takıyor."]]}
{"w":"cerisier","t":"isim (eril)","m":"kiraz ağacı","s":[],"a":[],"e":[["Le cerisier fleurit en avril.","lö serizye flöri an avril","Kiraz ağacı nisanda çiçek açıyor."],["Le cerisier du jardin donne beaucoup de fruits.","lö serizye dü jarden don boku dö früi","Bahçedeki kiraz ağacı çok meyve veriyor."]]}
{"w":"mimosa","t":"isim (eril)","m":"mimoza","s":[],"a":[],"e":[["Le mimosa fleurit en hiver.","lö mimoza flöri an iver","Mimoza kışın çiçek açar."],["Ils offrent un bouquet de mimosa.","il zofr en buke dö mimoza","Bir demet mimoza hediye ediyorlar."]]}
{"w":"déconcertant","t":"sıfat","m":"şaşırtıcı; afallatıcı","s":["troublant","surprenant"],"a":["rassurant","prévisible"],"e":[["Cette réponse est déconcertante.","set repons e dekonsertan","Bu cevap afallatıcı."],["Il a un comportement déconcertant.","il a en komportöman dekonsertan","Şaşırtıcı bir davranışı var."]]}
{"w":"immaculé","t":"sıfat","m":"lekesiz; tertemiz","s":["pur","impeccable"],"a":["souillé","taché"],"e":[["Sa chemise est immaculée.","sa şömiz e timaküle","Gömleği lekesiz."],["Le blanc immaculé de la neige est éblouissant.","lö blan imaküle dö la nej e tebluisan","Karın lekesiz beyazı göz kamaştırıyor."]]}
{"w":"morfler","t":"fiil","m":"dayak yemek; zarar görmek (konuşma dili)","s":["encaisser","écoper"],"a":["s'en sortir"],"e":[["Il a morflé pendant la bagarre.","il a morfle pandan la bagar","Kavga sırasında dayak yedi."],["On a bien morflé hier.","on a byen morfle yer","Dün epey zarar gördük."]]}
{"w":"conformer","t":"fiil","m":"uydurmak; uymak","s":["adapter","se soumettre"],"a":["désobéir","contredire"],"e":[["Il se conforme aux règles.","il sö konform o regl","Kurallara uyuyor."],["Elle conforme son travail aux normes.","el konform son travay o norm","İşini standartlara uydurur."]]}
{"w":"officieux","t":"sıfat","m":"yarı resmî","s":["non officiel","tacite"],"a":["officiel"],"e":[["Le gouvernement publie un chiffre officieux.","lö guvernöman pübli en şifr ofisyö","Hükümet yarı resmî bir rakam yayımlıyor."],["Une source officieuse confirme la nouvelle.","ün surs ofisyöz konfirm la nuvel","Yarı resmî bir kaynak haberi doğruluyor."]]}
{"w":"suffoquer","t":"fiil","m":"boğulmak; nefesi kesilmek","s":["étouffer","haleter"],"a":["respirer"],"e":[["Il suffoque dans la fumée.","il süfok dan la füme","Dumanın içinde nefes alamıyor."],["Elle suffoque de colère.","el süfok dö koler","Öfkeden nefesi kesiliyor."]]}
{"w":"pacificateur","t":"isim (eril)","m":"barışı sağlayan kişi; yatıştırıcı","s":["conciliateur","médiateur"],"a":["provocateur"],"e":[["Le pacificateur apaise les tensions.","lö pasifikatör apez le tansyon","Barışı sağlayan kişi gerginlikleri yatıştırıyor."],["Ce pacificateur négocie la paix.","sö pasifikatör negosi la pe","Bu arabulucu barış için görüşüyor."]]}
{"w":"corniche","t":"isim (dişil)","m":"kıyı yolu; saçak silmesi","s":["route côtière","moulure"],"a":[],"e":[["La route de la corniche longe la mer.","la rut dö la korniş lonj la mer","Kıyı yolu denizi boyluyor."],["Ils se promènent sur la corniche.","il sö promen sür la korniş","Kıyı yolunda yürüyüş yapıyorlar."]]}
{"w":"saoul","t":"sıfat","m":"sarhoş","s":["ivre","soûl"],"a":["sobre"],"e":[["Il est complètement saoul.","il e konpletman su","Tamamen sarhoş."],["Elle rentre saoule.","el rantr sul","Sarhoş halde eve dönüyor."]]}
{"w":"mécène","t":"isim (eril)","m":"hamî; sanat koruyucusu","s":["bienfaiteur","protecteur"],"a":[],"e":[["Le mécène finance un musée.","lö mesen finans en müze","Hamî bir müzeyi finanse ediyor."],["Cette entreprise est un mécène de l'art.","set antröpriz e ten mesen dö lar","Bu şirket sanatın hamisi."]]}
