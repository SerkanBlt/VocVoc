{"w":"t-shirt","t":"isim (eril)","m":"tişört","s":[],"a":[],"e":[["Je porte un t-shirt blanc.","jö port en tişört blan","Beyaz bir tişört giyiyorum."],["Ce t-shirt est trop petit.","sö tişört e tro pöti","Bu tişört çok küçük."]]}
{"w":"jouet","t":"isim (eril)","m":"oyuncak","s":[],"a":[],"e":[["Le bébé a un nouveau jouet.","lö bebe a en nuvo jue","Bebeğin yeni bir oyuncağı var."],["Les enfants rangent leurs jouets.","le zanfan ranj lör jue","Çocuklar oyuncaklarını topluyor."]]}
{"w":"dessert","t":"isim (eril)","m":"tatlı","s":[],"a":[],"e":[["Qu'est-ce que vous prenez comme dessert ?","kes kö vu pröne kom deser","Tatlı olarak ne alıyorsunuz?"],["Le dessert est un gâteau.","lö deser e ten gato","Tatlı bir pasta."]]}
{"w":"Espagne","t":"isim (dişil)","m":"İspanya","s":[],"a":[],"e":[["Madrid est en Espagne.","madrid e tan espany","Madrid İspanya'da."],["Nous passons nos vacances en Espagne.","nu pason no vakans an espany","Tatilimizi İspanya'da geçiriyoruz."]]}
{"w":"juillet","t":"isim (eril)","m":"temmuz","s":[],"a":[],"e":[["Le quatorze juillet est la fête nationale.","lö katorz jüiye e la fet nasyonal","On dört Temmuz ulusal bayramdır."],["En juillet, il fait très chaud.","an jüiye, il fe tre şo","Temmuzda hava çok sıcaktır."]]}
{"w":"sel","t":"isim (eril)","m":"tuz","s":[],"a":[],"e":[["Passe-moi le sel, s'il te plaît.","pas mua lö sel, sil tö ple","Tuzu uzat, lütfen."],["Il y a trop de sel dans la soupe.","il i a tro dö sel dan la sup","Çorbada çok tuz var."]]}
{"w":"quinze","t":"sayı","m":"on beş","s":[],"a":[],"e":[["Il y a quinze élèves.","il i a kenz elev","On beş öğrenci var."],["Je pars dans quinze jours.","jö par dan kenz jur","İki hafta sonra yola çıkıyorum."]]}
{"w":"avril","t":"isim (eril)","m":"nisan","s":[],"a":[],"e":[["Avril est un mois du printemps.","avril e ten mua dü pranan","Nisan bir ilkbahar ayıdır."],["Ma sœur est née en avril.","ma sör e ne an avril","Ablam nisanda doğdu."]]}
{"w":"Canada","t":"isim (eril)","m":"Kanada","s":[],"a":[],"e":[["Le Canada est très grand.","lö kanada e tre gran","Kanada çok büyük."],["On parle français au Canada.","on parl franse o kanada","Kanada'da Fransızca konuşulur."]]}
{"w":"plante","t":"isim (dişil)","m":"bitki","s":[],"a":[],"e":[["J'ai beaucoup de plantes dans le salon.","je boku dö plant dan lö salon","Salonda çok bitkim var."],["Il arrose la plante.","il aroz la plant","Bitkiyi suluyor."]]}
{"w":"menu","t":"isim (eril)","m":"menü","s":[],"a":[],"e":[["Je prends le menu du jour.","jö pran lö mönü dü jur","Günün menüsünü alıyorum."],["Le menu est à douze euros.","lö mönü e ta duz öro","Menü on iki avro."]]}
{"w":"ticket","t":"isim (eril)","m":"bilet; fiş","s":[],"a":[],"e":[["Je garde le ticket.","jö gard lö tike","Fişi saklıyorum."],["Un ticket de métro, s'il vous plaît.","en tike dö metro, sil vu ple","Bir metro bileti, lütfen."]]}
{"w":"maths","t":"isim (dişil)","m":"matematik","s":[],"a":[],"e":[["J'ai un examen de maths demain.","je en negzamen dö mat dömen","Yarın matematik sınavım var."],["Mon fils aime les maths.","mon fis em le mat","Oğlum matematiği seviyor."]]}
{"w":"basket","t":"isim (eril)","m":"basketbol","s":[],"a":[],"e":[["Mon frère joue au basket.","mon frer ju o basket","Erkek kardeşim basketbol oynuyor."],["Le basket est un sport d'équipe.","lö basket e ten spor dekip","Basketbol bir takım sporudur."]]}
{"w":"trente","t":"sayı","m":"otuz","s":[],"a":[],"e":[["Il a trente ans.","il a trant an","Otuz yaşında."],["Il y a trente jours en avril.","il i a trant jur an avril","Nisanda otuz gün var."]]}
{"w":"feuille","t":"isim (dişil)","m":"yaprak; kâğıt (sayfa)","s":[],"a":[],"e":[["Les feuilles tombent en automne.","le föy tonb an oton","Sonbaharda yapraklar dökülür."],["Donne-moi une feuille de papier.","don mua ün föy dö papye","Bana bir kâğıt ver."]]}
{"w":"juin","t":"isim (eril)","m":"haziran","s":[],"a":[],"e":[["Juin est le mois de la fête de la musique.","jüen e lö mua dö la fet dö la müzik","Haziran müzik bayramı ayıdır."],["En juin, il fait beau.","an jüen, il fe bo","Haziranda hava güzeldir."]]}
{"w":"octobre","t":"isim (eril)","m":"ekim","s":[],"a":[],"e":[["En octobre, il pleut souvent.","an oktobr, il plö suvan","Ekimde sık sık yağmur yağar."],["Mon fils est né en octobre.","mon fis e ne an oktobr","Oğlum ekimde doğdu."]]}
{"w":"texte","t":"isim (eril)","m":"metin","s":[],"a":[],"e":[["Lis ce texte, s'il te plaît.","li sö tekst, sil tö ple","Bu metni oku, lütfen."],["Le texte est court.","lö tekst e kur","Metin kısa."]]}
{"w":"gris","t":"sıfat","m":"gri","s":[],"a":[],"e":[["Le ciel est gris aujourd'hui.","lö siyel e gri ojurdüi","Gökyüzü bugün gri."],["Mon chat est gris.","mon şa e gri","Kedim gri."]]}
{"w":"canard","t":"isim (eril)","m":"ördek","s":[],"a":[],"e":[["Le canard nage dans le lac.","lö kanar naj dan lö lak","Ördek gölde yüzüyor."],["J'aime le canard à l'orange.","jem lö kanar a loranj","Portakallı ördeği severim."]]}
{"w":"chaussette","t":"isim (dişil)","m":"çorap","s":[],"a":[],"e":[["Je mets mes chaussettes.","jö me me şoset","Çoraplarımı giyiyorum."],["Ces chaussettes sont blanches.","se şoset son blanş","Bu çoraplar beyaz."]]}
{"w":"panier","t":"isim (eril)","m":"sepet","s":[],"a":[],"e":[["Je mets les pommes dans le panier.","jö me le pom dan lö panye","Elmaları sepete koyuyorum."],["Le panier est plein.","lö panye e plen","Sepet dolu."]]}
{"w":"nièce","t":"isim (dişil)","m":"kız yeğen","s":[],"a":["neveu"],"e":[["Ma nièce a huit ans.","ma niyes a üit an","Yeğenim sekiz yaşında."],["Voici ma nièce Léa.","vuasi ma niyes lea","İşte yeğenim Léa."]]}
{"w":"meuble","t":"isim (eril)","m":"mobilya; eşya","s":[],"a":[],"e":[["Nous achetons un nouveau meuble.","nu zaşeton en nuvo möbl","Yeni bir mobilya alıyoruz."],["Ce meuble est très vieux.","sö möbl e tre vyö","Bu mobilya çok eski."]]}
{"w":"nuage","t":"isim (eril)","m":"bulut","s":[],"a":[],"e":[["Il y a un grand nuage dans le ciel.","il i a en gran nüaj dan lö siyel","Gökyüzünde büyük bir bulut var."],["Aujourd'hui, il y a des nuages.","ojurdüi, il i a de nüaj","Bugün bulut var."]]}
{"w":"zoo","t":"isim (eril)","m":"hayvanat bahçesi","s":[],"a":[],"e":[["Nous allons au zoo dimanche.","nu zalon o zo dimanş","Pazar günü hayvanat bahçesine gidiyoruz."],["Les enfants adorent le zoo.","le zanfan ador lö zo","Çocuklar hayvanat bahçesine bayılıyor."]]}
{"w":"assiette","t":"isim (dişil)","m":"tabak","s":[],"a":[],"e":[["Mets l'assiette sur la table.","me lasyet sür la tabl","Tabağı masaya koy."],["Mon assiette est vide.","mon asyet e vid","Tabağım boş."]]}
{"w":"capitale","t":"isim (dişil)","m":"başkent","s":[],"a":[],"e":[["Quelle est la capitale de l'Italie ?","kel e la kapital dö litali","İtalya'nın başkenti neresi?"],["Rome est une belle capitale.","rom e tün bel kapital","Roma güzel bir başkenttir."]]}
{"w":"drap","t":"isim (eril)","m":"çarşaf","s":[],"a":[],"e":[["Je change les draps du lit.","jö şanj le dra dü li","Yatağın çarşaflarını değiştiriyorum."],["Le drap est blanc.","lö dra e blan","Çarşaf beyaz."]]}
{"w":"novembre","t":"isim (eril)","m":"kasım","s":[],"a":[],"e":[["En novembre, il fait froid.","an novanbr, il fe frua","Kasımda hava soğuktur."],["Nous sommes le dix novembre.","nu som lö dis novanbr","Kasımın onundayız."]]}
{"w":"tiroir","t":"isim (eril)","m":"çekmece","s":[],"a":[],"e":[["Les clés sont dans le tiroir.","le kle son dan lö tiruar","Anahtarlar çekmecede."],["Ouvre le tiroir, s'il te plaît.","uvr lö tiruar, sil tö ple","Çekmeceyi aç, lütfen."]]}
{"w":"tennis","t":"isim (eril)","m":"tenis","s":[],"a":[],"e":[["Je joue au tennis le samedi.","jö ju o tenis lö samdi","Cumartesi günleri tenis oynarım."],["Elle a une raquette de tennis.","el a ün raket dö tenis","Bir tenis raketi var."]]}
{"w":"oignon","t":"isim (eril)","m":"soğan","s":[],"a":[],"e":[["Je coupe un oignon.","jö kup en onyon","Bir soğan kesiyorum."],["La soupe à l'oignon est bonne.","la sup a lonyon e bon","Soğan çorbası güzel."]]}
{"w":"suisse","t":"sıfat","m":"İsviçreli; İsviçre","s":[],"a":[],"e":[["Il est suisse.","il e süis","O İsviçreli."],["Le chocolat suisse est très bon.","lö şokola süis e tre bon","İsviçre çikolatası çok güzel."]]}
{"w":"euro","t":"isim (eril)","m":"avro","s":[],"a":[],"e":[["J'ai cinquante euros.","je senkant öro","Elli avrom var."],["L'euro est la monnaie de la France.","lörö e la mone dö la frans","Avro Fransa'nın para birimidir."]]}
{"w":"légume","t":"isim (eril)","m":"sebze","s":[],"a":[],"e":[["Je mange des légumes tous les jours.","jö manj de legüm tu le jur","Her gün sebze yerim."],["La carotte est un légume.","la karot e ten legüm","Havuç bir sebzedir."]]}
{"w":"voisine","t":"isim (dişil)","m":"komşu (kadın)","s":[],"a":[],"e":[["Ma voisine est très gentille.","ma vuazin e tre jantiy","Komşum çok nazik."],["Je parle avec ma voisine.","jö parl avek ma vuazin","Komşumla konuşuyorum."]]}
{"w":"automne","t":"isim (eril)","m":"sonbahar","s":[],"a":[],"e":[["L'automne est ma saison préférée.","loton e ma sezon prefere","Sonbahar en sevdiğim mevsim."],["En automne, il pleut souvent.","an oton, il plö suvan","Sonbaharda sık sık yağmur yağar."]]}
{"w":"frite","t":"isim (dişil)","m":"patates kızartması","s":[],"a":[],"e":[["Je mange des frites avec du poulet.","jö manj de frit avek dü pule","Tavukla patates kızartması yiyorum."],["Les enfants aiment les frites.","le zanfan zem le frit","Çocuklar patates kızartmasını sever."]]}
{"w":"dentiste","t":"isim (eril)","m":"diş hekimi","s":[],"a":[],"e":[["J'ai rendez-vous chez le dentiste.","je randevu şe lö dantist","Diş hekiminde randevum var."],["Le dentiste regarde mes dents.","lö dantist rögard me dan","Diş hekimi dişlerime bakıyor."]]}
{"w":"cinquième","t":"sıfat","m":"beşinci","s":[],"a":[],"e":[["Il habite au cinquième étage.","il abit o senkyem etaj","Beşinci katta oturuyor."],["C'est la cinquième fois.","se la senkyem fua","Bu beşinci kez."]]}
{"w":"recette","t":"isim (dişil)","m":"tarif","s":[],"a":[],"e":[["J'ai la recette du gâteau.","je la röset dü gato","Pastanın tarifi bende."],["Ma grand-mère donne sa recette.","ma gran mer don sa röset","Büyükannem tarifini veriyor."]]}
{"w":"pleuvoir","t":"fiil","m":"yağmur yağmak","s":[],"a":[],"e":[["Il va pleuvoir demain.","il va plövuar dömen","Yarın yağmur yağacak."],["Il peut pleuvoir ce soir.","il pö plövuar sö suar","Bu akşam yağmur yağabilir."]]}
{"w":"violet","t":"sıfat","m":"mor","s":[],"a":[],"e":[["Elle porte une écharpe violette.","el port ün eşarp viyolet","Mor bir atkı takıyor."],["Le violet est ma couleur préférée.","lö viyole e ma kulör prefere","Mor en sevdiğim renk."]]}
{"w":"petit-fils","t":"isim (eril)","m":"erkek torun","s":[],"a":[],"e":[["Ma grand-mère adore son petit-fils.","ma gran mer ador son pöti fis","Büyükannem torununu çok seviyor."],["Son petit-fils a cinq ans.","son pöti fis a senk an","Torunu beş yaşında."]]}
{"w":"steak","t":"isim (eril)","m":"biftek","s":[],"a":[],"e":[["Je prends un steak avec des frites.","jö pran en stek avek de frit","Patates kızartmasıyla biftek alıyorum."],["Le steak est très bon.","lö stek e tre bon","Biftek çok güzel."]]}
{"w":"août","t":"isim (eril)","m":"ağustos","s":[],"a":[],"e":[["En août, beaucoup de gens sont en vacances.","an ut, boku dö jan son tan vakans","Ağustosta birçok insan tatilde."],["Mon anniversaire est en août.","mon aniverser e tan ut","Doğum günüm ağustosta."]]}
{"w":"décembre","t":"isim (eril)","m":"aralık","s":[],"a":[],"e":[["Noël est en décembre.","noel e tan desanbr","Noel aralıkta."],["En décembre, il fait froid.","an desanbr, il fe frua","Aralıkta hava soğuktur."]]}
{"w":"pull","t":"isim (eril)","m":"kazak","s":[],"a":[],"e":[["Il fait froid, mets un pull.","il fe frua, me en pül","Hava soğuk, bir kazak giy."],["Ce pull est en laine.","sö pül e tan len","Bu kazak yünden."]]}
