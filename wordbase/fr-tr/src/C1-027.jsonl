{"w":"relire","t":"fiil","m":"yeniden okumak","s":["revoir","revérifier"],"a":[],"e":[["Il relit son devoir avant de le rendre.","il röli son dövuar avan dö lö randr","Ödevini teslim etmeden önce yeniden okuyor."],["Je relis ce roman chaque été.","jö röli sö roman şak ete","Bu romanı her yaz yeniden okuyorum."]]}
{"w":"fertile","t":"sıfat","m":"verimli","s":["fécond","productif"],"a":["stérile","aride"],"e":[["Cette terre est très fertile.","set ter e tre fertil","Bu toprak çok verimli."],["Il a une imagination fertile.","il a ün imajinasyon fertil","Zengin bir hayal gücü var."]]}
{"w":"vaillant","t":"sıfat","m":"yiğit; cesur","s":["courageux","brave"],"a":["lâche","peureux"],"e":[["Le vaillant soldat défend le fort.","lö vayan solda defan lö for","Yiğit asker kaleyi savunuyor."],["Elle reste vaillante malgré la fatigue.","el rest vayant malgre la fatig","Yorgunluğa rağmen yiğit kalıyor."]]}
{"w":"méprisable","t":"sıfat","m":"aşağılık","s":["ignoble","honteux"],"a":["admirable","respectable"],"e":[["C'est un acte méprisable.","se ten nakt meprizabl","Bu aşağılık bir eylem."],["Il se comporte de façon méprisable.","il sö konport dö fason meprizabl","Aşağılık bir şekilde davranıyor."]]}
{"w":"sédatif","t":"isim (eril)","m":"sakinleştirici","s":["calmant","tranquillisant"],"a":["stimulant"],"e":[["Le médecin donne un sédatif.","lö medsen don en sedatif","Doktor bir sakinleştirici veriyor."],["Ce sédatif aide à dormir.","sö sedatif ed a dormir","Bu sakinleştirici uyumaya yardım ediyor."]]}
{"w":"remarier","t":"fiil","m":"yeniden evlendirmek; yeniden evlenmek","s":["unir"],"a":["divorcer"],"e":[["Elle se remarie l'an prochain.","el sö römari lan proşen","Gelecek yıl yeniden evleniyor."],["Il veut se remarier.","il vö sö römarye","Yeniden evlenmek istiyor."]]}
{"w":"glauque","t":"sıfat","m":"kasvetli; yeşilimsi","s":["sinistre","sombre"],"a":["gai","lumineux"],"e":[["L'ambiance est glauque dans ce bar.","lanbyans e glok dan sö bar","Bu barın havası kasvetli."],["Il habite un quartier glauque.","il abit en kartye glok","Kasvetli bir mahallede oturuyor."]]}
{"w":"expédier","t":"fiil","m":"göndermek; (işi) çabuk bitirmek","s":["envoyer","poster"],"a":["recevoir"],"e":[["Il expédie un colis à sa mère.","il ekspedi en koli a sa mer","Annesine bir koli gönderiyor."],["Elle expédie le travail en dix minutes.","el ekspedi lö travay an di minüt","İşi on dakikada savuşturuyor."]]}
{"w":"incompréhensible","t":"sıfat","m":"anlaşılmaz","s":["obscur","inexplicable"],"a":["clair","compréhensible"],"e":[["Son explication est incompréhensible.","son eksplikasyon e tenkonpreansibl","Açıklaması anlaşılmaz."],["Ce texte reste incompréhensible.","sö tekst rest enkonpreansibl","Bu metin anlaşılmaz kalıyor."]]}
{"w":"exclusivement","t":"zarf","m":"yalnızca; sadece","s":["uniquement","seulement"],"a":["en partie"],"e":[["Il mange exclusivement des légumes.","il manj eksklüzivman de legüm","Yalnızca sebze yiyor."],["Cette salle est réservée exclusivement aux membres.","set sal e rezerve eksklüzivman o manbr","Bu salon yalnızca üyelere ayrılmış."]]}
{"w":"moisissure","t":"isim (dişil)","m":"küf","s":["champignon","rouille"],"a":[],"e":[["La moisissure couvre le mur.","la muazisür kuvr lö mür","Küf duvarı kaplıyor."],["Le pain est couvert de moisissure.","lö pen e kuvr dö muazisür","Ekmek küfle kaplı."]]}
{"w":"indulgent","t":"sıfat","m":"hoşgörülü","s":["clément","tolérant"],"a":["sévère","strict"],"e":[["Le juge est indulgent avec lui.","lö jüj e tendülgan avek lüi","Hâkim ona karşı hoşgörülü."],["Un parent indulgent pardonne tout.","en paran endülgan pardon tu","Hoşgörülü bir ebeveyn her şeyi bağışlar."]]}
{"w":"emprisonnement","t":"isim (eril)","m":"hapis","s":["détention","captivité"],"a":["libération"],"e":[["Il risque un an d'emprisonnement.","il risk en nan danprizonman","Bir yıl hapis riski taşıyor."],["L'emprisonnement dure dix ans.","lanprizonman dür di zan","Hapis on yıl sürüyor."]]}
{"w":"ferré","t":"sıfat","m":"demir kaplı; (bir konuda) iyi","s":["renforcé","calé"],"a":[],"e":[["Le cheval ferré marche sur la route.","lö şöval fere marş sür la rut","Nallı at yolda yürüyor."],["Il est ferré en histoire.","il e fere an istuar","Tarihte çok iyi."]]}
{"w":"débauche","t":"isim (dişil)","m":"sefahat; aşırılık","s":["excès","dérèglement"],"a":["sobriété","vertu"],"e":[["Il vit dans la débauche.","il viv dan la debos","Sefahat içinde yaşıyor."],["La débauche détruit sa santé.","la debos detrü sa sante","Sefahat sağlığını mahvediyor."]]}
{"w":"incliner","t":"fiil","m":"eğmek; meyletmek","s":["pencher","baisser"],"a":["redresser"],"e":[["Il incline la tête pour saluer.","il enklin la tet pur salüe","Selam vermek için başını eğiyor."],["Je m'incline devant son talent.","jö menklin dövan son talan","Yeteneği karşısında saygıyla eğiliyorum."]]}
{"w":"éminence","t":"isim (dişil)","m":"tepe; yüksek mevki","s":["colline","autorité"],"a":["creux"],"e":[["Le château se trouve sur une éminence.","lö şato sö truv sür ün eminans","Şato bir tepenin üzerinde."],["Son Éminence reçoit les visiteurs.","son eminans rösua le vizitör","Hazretleri ziyaretçileri kabul ediyor."]]}
{"w":"rigolade","t":"isim (dişil)","m":"şaka; eğlence","s":["blague","fête"],"a":["sérieux"],"e":[["On passe de bons moments de rigolade.","on pas dö bon momen dö rigolad","Eğlenceli anlar yaşıyoruz."],["Pour lui, tout est rigolade.","pur lüi tu e rigolad","Ona göre her şey şaka."]]}
{"w":"négligent","t":"sıfat","m":"ihmalkâr","s":["insouciant","distrait"],"a":["soigneux","attentif"],"e":[["Il est négligent avec ses affaires.","il e neglijan avek se zafer","Eşyalarına karşı ihmalkâr."],["Un employé négligent perd les documents.","en nanplüaye neglijan per le dokümen","İhmalkâr bir çalışan belgeleri kaybeder."]]}
{"w":"bienfaisance","t":"isim (dişil)","m":"hayırseverlik","s":["charité","générosité"],"a":[],"e":[["Elle fait de la bienfaisance.","el fe dö la byenfezans","Hayır işleri yapıyor."],["Le concert est organisé pour la bienfaisance.","lö konser e torganize pur la byenfezans","Konser hayır amacıyla düzenleniyor."]]}
{"w":"dictature","t":"isim (dişil)","m":"diktatörlük","s":["tyrannie","despotisme"],"a":["démocratie"],"e":[["Le pays vit sous une dictature.","lö pei viv su zün diktatür","Ülke bir diktatörlük altında yaşıyor."],["La dictature tombe après dix ans.","la diktatür tonb apre di zan","Diktatörlük on yıl sonra yıkılıyor."]]}
{"w":"acquisition","t":"isim (dişil)","m":"edinme; satın alma","s":["achat","obtention"],"a":["perte","vente"],"e":[["L'acquisition de la maison coûte cher.","lakizisyon dö la mezon kut şer","Evin satın alınması pahalıya mal oluyor."],["Il parle de l'acquisition du savoir.","il parl dö lakizisyon dü savuar","Bilginin edinilmesinden söz ediyor."]]}
{"w":"friandise","t":"isim (dişil)","m":"şekerleme; ağız tatlısı","s":["gourmandise","sucrerie"],"a":[],"e":[["Le chien reçoit une friandise.","lö şyen rösua ün friyandiz","Köpek bir ödül maması alıyor."],["Les enfants adorent les friandises.","le zanfan ador le friyandiz","Çocuklar şekerlemelere bayılır."]]}
{"w":"rétro","t":"sıfat","m":"retro; nostaljik","s":["vintage","ancien"],"a":["moderne","futuriste"],"e":[["Il aime le style rétro.","il em lö stil retro","Retro stili seviyor."],["Ce café a un décor rétro.","sö kafe a en dekor retro","Bu kafenin retro bir dekoru var."]]}
{"w":"rougir","t":"fiil","m":"kızarmak","s":["s'empourprer"],"a":["pâlir"],"e":[["Elle rougit de honte.","el ruji dö ont","Utançtan kızarıyor."],["Le ciel rougit au coucher du soleil.","lö syel ruji o kuşe dü soley","Gökyüzü gün batımında kızarıyor."]]}
{"w":"sombrer","t":"fiil","m":"batmak; çökmek","s":["couler","s'enfoncer"],"a":["émerger"],"e":[["Le navire sombre dans la tempête.","lö navir sonbr dan la tanpet","Gemi fırtınada batıyor."],["Il sombre dans la dépression.","il sonbr dan la depresyon","Depresyona batıyor."]]}
{"w":"téléspectateur","t":"isim (eril)","m":"televizyon izleyicisi","s":["spectateur"],"a":[],"e":[["Les téléspectateurs regardent le film.","le telespektatör rögard lö film","Televizyon izleyicileri filmi izliyor."],["Un téléspectateur écrit à la chaîne.","en telespektatör ekri a la şen","Bir izleyici kanala yazıyor."]]}
{"w":"rabaisser","t":"fiil","m":"aşağılamak; küçümsemek","s":["humilier","dénigrer"],"a":["valoriser","louer"],"e":[["Il rabaisse ses collègues.","il rabes se koleg","Meslektaşlarını küçümsüyor."],["Elle ne cherche pas à rabaisser les autres.","el nö şerş pa a rabese le zotr","Başkalarını aşağılamaya çalışmıyor."]]}
{"w":"propice","t":"sıfat","m":"elverişli; uygun","s":["favorable","adapté"],"a":["défavorable","hostile"],"e":[["C'est le moment propice pour parler.","se lö moman propis pur parle","Konuşmak için uygun an."],["Le terrain est propice à la culture.","lö teren e propis a la kültür","Arazi ekime elverişli."]]}
{"w":"repeindre","t":"fiil","m":"yeniden boyamak","s":["peindre","rénover"],"a":[],"e":[["Il repeint les murs du salon.","il röpen le mür dü salon","Salonun duvarlarını yeniden boyuyor."],["Elle repeint la porte en bleu.","el röpen la port an blö","Kapıyı mavi boyuyor."]]}
{"w":"cocotte","t":"isim (dişil)","m":"güveç; piliç (konuşma dili)","s":["marmite","poule"],"a":[],"e":[["La viande cuit dans la cocotte.","la vyand küi dan la kokot","Et güveçte pişiyor."],["Il achète une cocotte en fonte.","il aşet ün kokot an font","Dökme demirden bir güveç alıyor."]]}
{"w":"carpe","t":"isim (dişil)","m":"sazan","s":[],"a":[],"e":[["Il pêche une carpe dans l'étang.","il peş ün karp dan letan","Gölette bir sazan tutuyor."],["La carpe vit dans l'eau douce.","la karp viv dan lo dus","Sazan tatlı suda yaşar."]]}
{"w":"protestation","t":"isim (dişil)","m":"protesto","s":["contestation","réclamation"],"a":["approbation"],"e":[["La protestation grandit dans la rue.","la protestasyon grandi dan la rü","Protesto sokakta büyüyor."],["Il fait une protestation officielle.","il fe ün protestasyon ofisyel","Resmî bir protesto yapıyor."]]}
{"w":"pétale","t":"isim (eril)","m":"taç yaprağı","s":[],"a":[],"e":[["Un pétale tombe de la rose.","en petal tonb dö la roz","Gülden bir yaprak düşüyor."],["Elle sèche les pétales.","el seş le petal","Taç yapraklarını kurutuyor."]]}
{"w":"rugby","t":"isim (eril)","m":"ragbi","s":[],"a":[],"e":[["Il joue au rugby le week-end.","il ju o rügbi lö uikend","Hafta sonları ragbi oynuyor."],["Le rugby est un sport de contact.","lö rügbi e ten spor dö kontakt","Ragbi temaslı bir spordur."]]}
{"w":"tribal","t":"sıfat","m":"kabileye ait","s":[],"a":[],"e":[["Ce chant tribal est très ancien.","sö şan tribal e tre zansyen","Bu kabile şarkısı çok eski."],["Il étudie la culture tribale.","il etüdi la kültür tribal","Kabile kültürünü inceliyor."]]}
{"w":"retracer","t":"fiil","m":"izlemek; yeniden çizmek","s":["reconstituer","raconter"],"a":[],"e":[["Le film retrace sa vie.","lö film rötras sa vi","Film hayatını anlatıyor."],["Il retrace le trajet sur la carte.","il rötras lö traje sür la kart","Güzergâhı haritada yeniden çiziyor."]]}
{"w":"fixation","t":"isim (dişil)","m":"sabitleme; takıntı","s":["obsession","attache"],"a":[],"e":[["La fixation du cadre est solide.","la fiksasyon dü kadr e solid","Çerçevenin sabitlenmesi sağlam."],["Il a une fixation sur le travail.","il a ün fiksasyon sür lö travay","İşe takıntılı."]]}
{"w":"érable","t":"isim (eril)","m":"akçaağaç","s":[],"a":[],"e":[["Le sirop d'érable est sucré.","lö siro derabl e sükre","Akçaağaç şurubu tatlı."],["La feuille d'érable est rouge à l'automne.","la föy derabl e ruj a loton","Akçaağaç yaprağı sonbaharda kırmızıdır."]]}
{"w":"ambulant","t":"sıfat","m":"gezici","s":["itinérant","mobile"],"a":["sédentaire","fixe"],"e":[["Un marchand ambulant vend des glaces.","en marşan anbülan van de glas","Gezici bir satıcı dondurma satıyor."],["Le cirque ambulant arrive en ville.","lö sirk anbülan ariv an vil","Gezici sirk şehre geliyor."]]}
{"w":"puberté","t":"isim (dişil)","m":"ergenlik","s":["adolescence"],"a":[],"e":[["La puberté change le corps.","la püberte şanj lö kor","Ergenlik bedeni değiştirir."],["Il entre en puberté à douze ans.","il antr an püberte a duz an","On iki yaşında ergenliğe giriyor."]]}
{"w":"cuve","t":"isim (dişil)","m":"depo; küve","s":["réservoir","bac"],"a":[],"e":[["La cuve de vin est pleine.","la küv dö ven e plen","Şarap küvü dolu."],["La cuve de mazout est vide.","la küv dö mazut e vid","Mazot deposu boş."]]}
{"w":"juteux","t":"sıfat","m":"sulu","s":["succulent"],"a":["sec"],"e":[["Ce fruit est juteux.","sö früi e jütö","Bu meyve sulu."],["Le melon est juteux et sucré.","lö mölon e jütö e sükre","Kavun sulu ve tatlı."]]}
{"w":"bâche","t":"isim (dişil)","m":"branda; muşamba","s":["toile"],"a":[],"e":[["Il couvre la voiture avec une bâche.","il kuvr la vuatür avek ün baş","Arabayı brandayla örtüyor."],["La bâche protège du vent.","la baş protej dü van","Branda rüzgârdan koruyor."]]}
{"w":"drain","t":"isim (eril)","m":"dren","s":[],"a":[],"e":[["Le médecin pose un drain.","lö medsen poz en dren","Doktor bir dren yerleştiriyor."],["Le drain évacue le liquide.","lö dren evaküe lö likid","Dren sıvıyı dışarı atıyor."]]}
{"w":"plutonium","t":"isim (eril)","m":"plütonyum","s":[],"a":[],"e":[["Le plutonium est très dangereux.","lö plütonyom e tre danjörö","Plütonyum çok tehlikelidir."],["La centrale utilise du plutonium.","la santral ütiliz dü plütonyom","Santral plütonyum kullanıyor."]]}
{"w":"fiole","t":"isim (dişil)","m":"küçük şişe","s":["flacon"],"a":[],"e":[["Il verse le liquide dans une fiole.","il vers lö likid dan zün fyol","Sıvıyı küçük bir şişeye döküyor."],["La fiole contient un poison.","la fyol kontyen en puazon","Şişede bir zehir var."]]}
{"w":"étreinte","t":"isim (dişil)","m":"kucaklama","s":["embrassade","accolade"],"a":[],"e":[["Ils se serrent dans une longue étreinte.","il sö ser dan zün long etrent","Uzun bir kucaklaşmayla birbirlerine sarılıyorlar."],["Son étreinte est chaleureuse.","son etrent e şalöröz","Kucaklaması sıcak."]]}
{"w":"présentable","t":"sıfat","m":"göze hoş görünen; sunulabilir","s":["convenable","correct"],"a":["négligé"],"e":[["Il veut être présentable pour l'entretien.","il vö etr prezantabl pur lantretyen","Görüşme için derli toplu görünmek istiyor."],["Sa chambre n'est pas présentable.","sa şanbr ne pa prezantabl","Odası gösterilecek durumda değil."]]}
{"w":"adjudant","t":"isim (eril)","m":"başçavuş","s":["sous-officier"],"a":[],"e":[["L'adjudant donne les ordres.","lajüdan don le zordr","Başçavuş emirleri veriyor."],["Il devient adjudant après dix ans.","il dövyen ajüdan apre di zan","On yıl sonra başçavuş oluyor."]]}
