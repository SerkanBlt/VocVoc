{"w":"treuil","t":"isim (eril)","m":"vinç; ırgat","s":["cabestan","palan"],"a":[],"e":[["Le treuil soulève la charge.","lö tröy sulev la şarj","Vinç yükü kaldırıyor."],["Le marin enroule la corde sur le treuil.","lö maren anrul la kord sür lö tröy","Denizci halatı ırgata sarıyor."]]}
{"w":"bringue","t":"isim (dişil)","m":"eğlence; âlem (konuşma dili)","s":["fête","noce"],"a":[],"e":[["Ils font la bringue toute la nuit.","il fon la breng tut la nüi","Bütün gece âlem yapıyorlar."],["Après la bringue, il dort jusqu'à midi.","apre la breng il dor jüska midi","Eğlenceden sonra öğlene kadar uyuyor."]]}
{"w":"pluvieux","t":"sıfat","m":"yağmurlu","s":["humide","arrosé"],"a":["sec","ensoleillé"],"e":[["Le mois d'avril est pluvieux.","lö mua davril e plüvyö","Nisan ayı yağmurlu."],["Un temps pluvieux attriste la journée.","en tan plüvyö atrist la jurne","Yağmurlu hava günü hüzünlendiriyor."]]}
{"w":"persécuter","t":"fiil","m":"zulmetmek; eziyet etmek","s":["tourmenter","opprimer"],"a":["protéger"],"e":[["Le régime persécute les opposants.","lö rejim perseküt le zopozan","Rejim muhalifleri eziyet ediyor."],["Il se sent persécuté par ses voisins.","il sö san perseküte par se vuazen","Komşuları tarafından zulüm gördüğünü hissediyor."]]}
{"w":"ingratitude","t":"isim (dişil)","m":"nankörlük","s":["oubli","indifférence"],"a":["gratitude","reconnaissance"],"e":[["Son ingratitude blesse ses amis.","son engratitüd bles se zami","Nankörlüğü arkadaşlarını yaralıyor."],["Il pardonne son ingratitude.","il pardon son engratitüd","Nankörlüğünü bağışlıyor."]]}
