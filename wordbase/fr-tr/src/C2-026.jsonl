{"w":"cabale","t":"isim (dişil)","m":"entrika; komplo","s":["complot","intrigue"],"a":[],"e":[["Une cabale se forme contre le directeur.","ün kabal sö form kontr lö direktör","Müdüre karşı bir entrika kuruluyor."],["Il dénonce la cabale de ses ennemis.","il denons la kabal dö se zenemi","Düşmanlarının komplosunu ifşa ediyor."]]}
{"w":"accoutrement","t":"isim (eril)","m":"gülünç kılık","s":["déguisement","tenue ridicule"],"a":["élégance"],"e":[["Son accoutrement fait rire les enfants.","son akutröman fe rir le zanfan","Gülünç kılığı çocukları güldürüyor."],["Quel accoutrement ridicule !","kel akutröman ridikül","Ne gülünç bir kılık!"]]}
{"w":"mulet","t":"isim (eril)","m":"katır; kefal balığı","s":["bête de somme","poisson"],"a":[],"e":[["Le mulet porte les sacs de blé.","lö müle port le sak dö ble","Katır buğday çuvallarını taşıyor."],["Le mulet est un hybride d'âne et de jument.","lö müle e ten ibrid dan e dö jüman","Katır, eşek ile kısrağın melezidir."]]}
{"w":"myope","t":"sıfat","m":"miyop","s":[],"a":["hypermétrope"],"e":[["Il est myope depuis l'enfance.","il e miyop döpüi lanfans","Çocukluğundan beri miyop."],["Une personne myope porte des lunettes.","ün person miyop port de lünet","Miyop bir kişi gözlük takar."]],"x":[["myope comme une taupe","miyop kom ün top","kör gibi göremeyen","Sans ses lunettes, il est myope comme une taupe.","san se lünet il e miyop kom ün top","Gözlüğü olmadan köstebek gibi göremez."]]}
{"w":"cancéreux","t":"sıfat","m":"kanserli; kanserle ilgili","s":["tumoral","malin"],"a":["bénin","sain"],"e":[["Les cellules cancéreuses se multiplient.","le selül kanseröz sö mültipli","Kanserli hücreler çoğalıyor."],["Il a une tumeur cancéreuse.","il a ün tümör kanseröz","Kanserli bir tümörü var."]]}
{"w":"calice","t":"isim (eril)","m":"kadeh (ayin); çanak yaprak","s":["coupe","sépale"],"a":[],"e":[["Le prêtre lève le calice.","lö pretr lev lö kalis","Rahip kadehi kaldırıyor."],["Le calice de la fleur est vert.","lö kalis dö la flör e ver","Çiçeğin çanak yaprağı yeşil."]]}
