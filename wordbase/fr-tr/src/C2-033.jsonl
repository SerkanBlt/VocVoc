{"w":"jante","t":"isim (dişil)","m":"jant","s":["cercle de roue"],"a":[],"e":[["La jante de la roue est tordue.","la jant dö la ru e tordü","Tekerleğin jantı eğilmiş."],["Il remplace une jante en aluminium.","il ranplas ün jant an alüminyom","Alüminyum bir jant değiştiriyor."]]}
{"w":"choucroute","t":"isim (dişil)","m":"lahana turşusu yemeği (Alsace)","s":["chou fermenté"],"a":[],"e":[["La choucroute se mange avec des saucisses.","la şukrut sö manj avek de sosis","Lahana turşusu sosislerle yenir."],["Elle prépare une choucroute alsacienne.","el prepar ün şukrut alzasyen","Alsace usulü bir lahana turşusu yemeği hazırlıyor."]]}
