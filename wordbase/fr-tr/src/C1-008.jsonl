{"w":"sévèrement","t":"zarf","m":"sert biçimde","s":["durement","rigoureusement"],"a":["doucement"],"e":[["Le juge punit sévèrement le voleur.","lö jüj pün severman lö volör","Hâkim hırsızı ağır biçimde cezalandırıyor."],["Il juge sévèrement ses élèves.","il jüj severman se zelev","Öğrencilerini sert biçimde değerlendiriyor."]]}
{"w":"vrille","t":"isim (dişil)","m":"asma bıyığı; vidalı matkap; spiral","s":["spirale"],"a":[],"e":[["L'avion part en vrille.","lavyon par an vriy","Uçak spiral çizerek düşüyor."],["La plante s'accroche avec une vrille.","la plant sakroş avek ün vriy","Bitki bir sarmaşık teliyle tutunuyor."]]}
{"w":"introduction","t":"isim (dişil)","m":"giriş","s":["début","préface"],"a":["conclusion"],"e":[["L'introduction du livre est courte.","lentrodüksyon dü livr e kurt","Kitabın girişi kısa."],["Il fait l'introduction du débat.","il fe lentrodüksyon dü deba","Tartışmanın açılışını yapıyor."]]}
{"w":"impardonnable","t":"sıfat","m":"affedilemez","s":["inexcusable"],"a":["pardonnable"],"e":[["Son erreur est impardonnable.","son erör e tenpardonabl","Hatası affedilemez."],["C'est une faute impardonnable.","se tün fot enpardonabl","Bu affedilemez bir hata."]]}
{"w":"gouverner","t":"fiil","m":"yönetmek","s":["diriger","régner"],"a":["obéir"],"e":[["Il gouverne le pays depuis dix ans.","il guvern lö pei döpüi di zan","Ülkeyi on yıldır yönetiyor."],["Ce parti gouverne la région.","sö parti guvern la rejyon","Bu parti bölgeyi yönetiyor."]]}
{"w":"récompenser","t":"fiil","m":"ödüllendirmek","s":["remercier","gratifier"],"a":["punir"],"e":[["Le prof récompense les meilleurs élèves.","lö prof rekonpans le meyör zelev","Öğretmen en iyi öğrencileri ödüllendiriyor."],["Il récompense son chien avec un os.","il rekonpans son şyen avek en nos","Köpeğini bir kemikle ödüllendiriyor."]]}
{"w":"refrain","t":"isim (eril)","m":"nakarat","s":["rengaine"],"a":["couplet"],"e":[["Le refrain reste dans la tête.","lö röfren rest dan la tet","Nakarat kafada kalıyor."],["Tout le monde chante le refrain.","tu lö mond şant lö röfren","Herkes nakaratı söylüyor."]]}
