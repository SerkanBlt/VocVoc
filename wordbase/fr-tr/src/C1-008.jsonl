{"w":"gaucher","t":"isim (eril)","m":"solak","s":[],"a":["droitier"],"e":[["Mon frère est gaucher.","mon frer e goşe","Kardeşim solak."],["Les gauchers écrivent de la main gauche.","le goşe ekriv dö la men goş","Solaklar sol elleriyle yazar."]]}
{"w":"vigueur","t":"isim (dişil)","m":"güç; dinçlik","s":["force","énergie"],"a":["faiblesse"],"e":[["Il défend son idée avec vigueur.","il defan son ide avek vigör","Fikrini güçlü bir şekilde savunuyor."],["La loi entre en vigueur demain.","la lua antr an vigör dömen","Yasa yarın yürürlüğe giriyor."]],"x":[["entrer en vigueur","antre an vigör","yürürlüğe girmek","Le nouveau règlement entre en vigueur lundi.","lö nuvo reglömman antr an vigör lendi","Yeni yönetmelik pazartesi yürürlüğe giriyor."]]}
{"w":"consolation","t":"isim (dişil)","m":"teselli","s":["réconfort"],"a":["chagrin"],"e":[["Il cherche une consolation.","il şerş ün konsolasyon","Bir teselli arıyor."],["Cette lettre est une grande consolation.","set letr e tün grand konsolasyon","Bu mektup büyük bir teselli."]]}
{"w":"orthographe","t":"isim (dişil)","m":"yazım; imla","s":["écriture"],"a":[],"e":[["Il corrige l'orthographe du texte.","il korij lortograf dü tekst","Metnin imlasını düzeltiyor."],["L'orthographe française est compliquée.","lortograf fransez e konplike","Fransızca imla karmaşık."]]}
{"w":"mire","t":"isim (dişil)","m":"nişan alma; test deseni","s":["cible"],"a":[],"e":[["Le tireur prend la mire.","lö tirör pran la mir","Nişancı nişan alıyor."],["Le téléviseur affiche la mire.","lö televizyör afiş la mir","Televizyon test desenini gösteriyor."]],"x":[["point de mire","puen dö mir","dikkat odağı","Il est le point de mire de la soirée.","il e lö puen dö mir dö la suare","Gecenin dikkat odağı o."]]}
