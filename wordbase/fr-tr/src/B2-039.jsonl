{"w":"acompte","t":"isim (eril)","m":"kapora; avans","s":["arrhes","avance"],"a":["solde"],"e":[["Il verse un acompte de cent euros.","il vers en nakont dö san zöro","Yüz avro kapora ödüyor."],["Elle demande un acompte au client.","el dömand en nakont o klian","Müşteriden avans istiyor."]],"x":[["verser un acompte","verse en akont","kapora vermek","Il verse un acompte pour la voiture.","il vers en akont pur la vuatür","Araba için kapora veriyor."]]}
