{"w":"alarmant","t":"sıfat","m":"endişe verici","s":["inquiétant","préoccupant"],"a":["rassurant"],"e":[["La situation est alarmante.","la sitüasyon e talarman","Durum endişe verici."],["Les chiffres sont alarmants.","le şifr son talarman","Rakamlar endişe verici."]]}
{"w":"attribut","t":"isim (eril)","m":"nitelik; sembol; yüklem tamlayıcısı","s":["caractéristique","symbole"],"a":[],"e":[["Le sceptre est l'attribut du roi.","lö septr e latribü dü rua","Asa kralın simgesidir."],["L'attribut s'accorde avec le sujet.","latribü sakord avek lö süje","Yüklem tamlayıcısı özneyle uyum sağlar."]]}
