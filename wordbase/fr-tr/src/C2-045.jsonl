{"w":"climatiseur","t":"isim (eril)","m":"klima","s":["air conditionné"],"a":["chauffage"],"e":[["Le climatiseur rafraîchit la pièce.","lö klimatizör rafreşi la pyes","Klima odayı serinletiyor."],["Il allume le climatiseur en été.","il alüm lö klimatizör an ete","Yazın klimayı açıyor."]]}
{"w":"ligature","t":"isim (dişil)","m":"bağlama (damar); bağ","s":["nœud","attache"],"a":[],"e":[["Le médecin fait une ligature de l'artère.","lö medsen fe tün ligatür dö larter","Doktor atardamarı bağlıyor."],["La ligature arrête l'hémorragie.","la ligatür aret lemoraji","Bağlama kanamayı durduruyor."]]}
{"w":"concocter","t":"fiil","m":"özenle hazırlamak; kurmak (plan)","s":["mijoter","préparer"],"a":[],"e":[["Il concocte un plat original.","il konkokt en pla orijinal","Özgün bir yemek hazırlıyor."],["Ils concoctent un plan secret.","il konkokt en plan sökre","Gizli bir plan kuruyorlar."]]}
{"w":"bastille","t":"isim (dişil)","m":"Bastille; kale, hapishane","s":["forteresse","prison"],"a":[],"e":[["La prise de la Bastille a lieu en 1789.","la priz dö la bastiy a lyö an mil set san katrövan nöf","Bastille'in alınışı 1789'da gerçekleşiyor."],["Il visite la place de la Bastille.","il vizit la plas dö la bastiy","Bastille Meydanı'nı geziyor."]]}
{"w":"guépard","t":"isim (eril)","m":"çita","s":["félin"],"a":[],"e":[["Le guépard court très vite.","lö gepar kur tre vit","Çita çok hızlı koşuyor."],["Le guépard chasse la gazelle.","lö gepar şas la gazel","Çita ceylanı avlıyor."]]}
{"w":"arrivant","t":"isim (eril)","m":"gelen kişi","s":["visiteur","nouveau venu"],"a":["partant"],"e":[["Les arrivants font la queue.","le zarivan fon la kö","Gelenler kuyruk oluşturuyor."],["L'arrivant cherche son bagage.","larivan şerş son bagaj","Gelen kişi bagajını arıyor."]]}
{"w":"aubergine","t":"isim (dişil)","m":"patlıcan","s":[],"a":[],"e":[["Elle cuisine une aubergine farcie.","el küizin ün oberjin farsi","Dolma patlıcan pişiriyor."],["L'aubergine grille sur le barbecue.","loberjin griy sür lö barbekü","Patlıcan mangalda kızarıyor."]]}
{"w":"maboul","t":"sıfat","m":"çatlak (argo)","s":["fou","timbré"],"a":["sensé"],"e":[["Il est complètement maboul.","il e konpletman mabul","Tamamen çatlak."],["Ce maboul parle tout seul.","sö mabul parl tu söl","Bu çatlak kendi kendine konuşuyor."]]}
{"w":"perdition","t":"isim (dişil)","m":"yok oluş; yıkım","s":["ruine","naufrage"],"a":["salut"],"e":[["Il est sur le chemin de la perdition.","il e sür lö şömen dö la perdisyon","Yıkımın yolunda ilerliyor."],["Le navire est en perdition.","lö navir e tan perdisyon","Gemi batmak üzere."]],"x":[["en perdition","an perdisyon","batmak üzere; tehlikede","Un bateau en perdition appelle à l'aide.","en bato an perdisyon apel a led","Batmak üzere olan bir tekne yardım istiyor."]]}
{"w":"capuchon","t":"isim (eril)","m":"kapüşon; kapak","s":["cagoule","bouchon"],"a":[],"e":[["Il met le capuchon de son manteau.","il me lö kapüşon dö son manto","Paltosunun kapüşonunu takıyor."],["Remets le capuchon sur le stylo.","römet lö kapüşon sür lö stilo","Kalemin kapağını yerine tak."]]}
{"w":"carbonisé","t":"sıfat","m":"kömürleşmiş","s":["brûlé","calciné"],"a":["intact"],"e":[["La forêt est carbonisée après l'incendie.","la fore e karbonize apre lensandi","Orman yangından sonra kömürleşmiş."],["Le pain carbonisé sent mauvais.","lö pen karbonize san move","Kömürleşmiş ekmek kötü kokuyor."]]}
{"w":"anorexique","t":"sıfat","m":"anoreksik","s":["maigre"],"a":["boulimique"],"e":[["Elle est devenue anorexique.","el e dövenü anoreksik","Anoreksik oldu."],["Une jeune fille anorexique reçoit des soins.","ün jön fiy anoreksik rösua de suen","Anoreksik bir genç kız tedavi görüyor."]]}
{"w":"exorciser","t":"fiil","m":"şeytan çıkarmak; zihinden atmak","s":["chasser","purifier"],"a":["posséder"],"e":[["Le prêtre exorcise la maison.","lö pretr egzorsiz la mezon","Rahip evden şeytan çıkarıyor."],["Il exorcise ses peurs en écrivant.","il egzorsiz se pör an ekrivan","Yazarak korkularından arınıyor."]]}
{"w":"prêcheur","t":"isim (eril)","m":"vaiz","s":["prédicateur","sermonneur"],"a":[],"e":[["Le prêcheur parle devant la foule.","lö preşör parl dövan la ful","Vaiz kalabalığın önünde konuşuyor."],["Ce prêcheur voyage de village en village.","sö preşör vuayaj dö vilaj an vilaj","Bu vaiz köy köy dolaşıyor."]],"x":[["prêcher dans le désert","preşe dan lö dezer","boşuna konuşmak","Il prêche dans le désert depuis des années.","il preş dan lö dezer döpüi de zane","Yıllardır boşuna konuşuyor."]]}
{"w":"sapé","t":"sıfat","m":"şık giyinmiş (konuşma dili)","s":["élégant","bien habillé"],"a":["débraillé"],"e":[["Il est bien sapé aujourd'hui.","il e byen sape ojurdüi","Bugün şık giyinmiş."],["Elle arrive toute sapée.","el ariv tut sape","Şık giyinmiş olarak geliyor."]]}
{"w":"falsification","t":"isim (dişil)","m":"sahtecilik","s":["contrefaçon","faux"],"a":["authenticité"],"e":[["La falsification des documents est un crime.","la falsifikasyon de dokümman e ten krim","Belge sahteciliği bir suçtur."],["Il est accusé de falsification.","il e takuze dö falsifikasyon","Sahtecilikle suçlanıyor."]]}
