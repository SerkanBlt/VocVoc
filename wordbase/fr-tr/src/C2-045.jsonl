{"w":"horrifié","t":"sıfat","m":"dehşete düşmüş","s":["épouvanté","terrifié"],"a":["rassuré","indifférent"],"e":[["Il reste horrifié devant la scène.","il rest orifye dövan la sen","Sahne karşısında dehşete düşmüş kalıyor."],["Elle est horrifiée par la nouvelle.","el e torifye par la nuvel","Haber karşısında dehşete düşmüş."]]}
{"w":"hâter","t":"fiil","m":"acele ettirmek; hızlandırmak","s":["accélérer","presser"],"a":["retarder","ralentir"],"e":[["Il hâte le pas.","il at lö pa","Adımlarını hızlandırıyor."],["Elle hâte son départ.","el at son depar","Gitmesini öne alıyor."]]}
{"w":"bagarreur","t":"sıfat","m":"kavgacı","s":["querelleur","batailleur"],"a":["pacifique","calme"],"e":[["Il est bagarreur depuis l'enfance.","il e bagarör döpüi lanfans","Çocukluğundan beri kavgacı."],["Un chien bagarreur attaque les autres.","en şyen bagarör atak le zotr","Kavgacı bir köpek diğerlerine saldırıyor."]]}
{"w":"inertie","t":"isim (dişil)","m":"atalet; hareketsizlik","s":["passivité","immobilité"],"a":["dynamisme"],"e":[["Elle reste dans l'inertie.","el rest dan linersi","Hareketsizlik içinde kalıyor."],["L'inertie d'un objet dépend de sa masse.","linersi den nobje depan dö sa mas","Bir cismin ataleti kütlesine bağlıdır."]]}
{"w":"aberration","t":"isim (dişil)","m":"saçmalık; anomali","s":["absurdité","anomalie"],"a":["logique"],"e":[["Cette décision est une aberration.","set desizyon e tün aberasyon","Bu karar bir saçmalık."],["Il parle d'une aberration de la nature.","il parl dün aberasyon dö la natür","Doğanın bir anomalisinden söz ediyor."]]}
{"w":"communément","t":"zarf","m":"genellikle; yaygın olarak","s":["couramment","habituellement"],"a":["rarement"],"e":[["Ce mot est communément utilisé.","sö mo e komüneman ütilize","Bu sözcük yaygın olarak kullanılıyor."],["Cet oiseau est communément appelé pie.","set uazo e komüneman apele pi","Bu kuşa genellikle saksağan denir."]]}
{"w":"captif","t":"sıfat","m":"tutsak; esir","s":["prisonnier","enfermé"],"a":["libre"],"e":[["L'oiseau captif cherche à s'échapper.","luazo kaptif şerş a seşape","Tutsak kuş kaçmaya çalışıyor."],["Il garde l'otage captif.","il gard lotaj kaptif","Rehineyi esir tutuyor."]]}
{"w":"nuisible","t":"sıfat","m":"zararlı","s":["nocif","néfaste"],"a":["utile","bénéfique"],"e":[["Cet insecte est nuisible pour les cultures.","set ensekt e nüizibl pur le kültür","Bu böcek ekinler için zararlı."],["Le bruit est nuisible à la santé.","lö brüi e nüizibl a la sante","Gürültü sağlığa zararlıdır."]]}
{"w":"polémique","t":"isim (dişil)","m":"tartışma; polemik","s":["controverse","débat"],"a":["consensus"],"e":[["Une polémique éclate au sujet de la loi.","ün polemik eklat o süje dö la lua","Yasa konusunda bir tartışma patlak veriyor."],["Le journaliste évite la polémique.","lö jurnalist evit la polemik","Gazeteci polemikten kaçınıyor."]]}
{"w":"poltron","t":"isim (eril)","m":"korkak","s":["lâche","peureux"],"a":["brave","courageux"],"e":[["Ce poltron s'enfuit au premier bruit.","sö poltron sanfüi o prömye brüi","Bu korkak ilk sesle kaçıyor."],["Ne sois pas poltron, saute !","nö sua pa poltron sot","Korkak olma, atla!"]]}
{"w":"attendrir","t":"fiil","m":"yumuşatmak; duygulandırmak","s":["émouvoir","toucher"],"a":["endurcir"],"e":[["Les larmes de l'enfant attendrissent sa mère.","le larm dö lanfan atandris sa mer","Çocuğun gözyaşları annesini yumuşatıyor."],["Le sourire du bébé m'attendrit.","lö surir dü bebe matandri","Bebeğin gülümsemesi beni duygulandırıyor."]]}
{"w":"astre","t":"isim (eril)","m":"gök cismi","s":["étoile","planète"],"a":[],"e":[["Le soleil est un astre brillant.","lö solay e ten astr briyan","Güneş parlak bir gök cismidir."],["L'astre de la nuit éclaire la mer.","lastr dö la nüi ekler la mer","Gecenin gök cismi denizi aydınlatıyor."]]}
{"w":"vizir","t":"isim (eril)","m":"vezir","s":["ministre","conseiller"],"a":["sultan"],"e":[["Le vizir conseille le sultan.","lö vizir konsey lö sültan","Vezir sultana danışmanlık yapıyor."],["Le grand vizir gouverne l'empire.","lö gran vizir guvern lanpir","Sadrazam imparatorluğu yönetiyor."]]}
{"w":"cannibalisme","t":"isim (eril)","m":"yamyamlık","s":["anthropophagie"],"a":[],"e":[["Le cannibalisme choque les explorateurs.","lö kanibalism şok le zeksploratör","Yamyamlık kaşifleri şoke ediyor."],["Cette tribu pratique le cannibalisme.","set trib pratik lö kanibalism","Bu kabile yamyamlık yapıyor."]]}
{"w":"galette","t":"isim (dişil)","m":"galet; ince yuvarlak kek","s":["crêpe","biscuit"],"a":[],"e":[["Elle mange une galette au beurre.","el manj ün galet o bör","Tereyağlı bir galet yiyor."],["On partage la galette des rois en janvier.","on partaj la galet de rua an janvye","Ocak ayında kral pastası paylaşılıyor."]]}
