{"w":"guichet","t":"isim (eril)","m":"gişe","s":["comptoir"],"a":[],"e":[["Il achète un billet au guichet.","il aşet en biye o gişe","Gişeden bir bilet alıyor."],["Le guichet ouvre à huit heures.","lö gişe uvr a üi tör","Gişe sekizde açılıyor."]],"x":[["guichet automatique","gişe otomatik","bankamatik","Il retire de l'argent au guichet automatique.","il rötir dö larjan o gişe otomatik","Bankamatikten para çekiyor."]]}
{"w":"violoncelle","t":"isim (eril)","m":"viyolonsel","s":[],"a":[],"e":[["Elle joue du violoncelle.","el ju dü viyolonsel","Viyolonsel çalıyor."],["Le violoncelle a un son profond.","lö viyolonsel a en son profon","Viyolonselin derin bir sesi var."]]}
