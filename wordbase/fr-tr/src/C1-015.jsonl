{"w":"millénaire","t":"isim (eril)","m":"bin yıl","s":["mille ans"],"a":[],"e":[["Cette ville existe depuis un millénaire.","set vil egzist döpüi en milener","Bu şehir bin yıldır var."],["Le troisième millénaire commence en l'an deux mille.","lö truazyem milener komans an lan dö mil","Üçüncü bin yıl iki binde başlıyor."]]}
{"w":"molécule","t":"isim (dişil)","m":"molekül","s":[],"a":[],"e":[["L'eau est une molécule simple.","lo e tün molekül sempl","Su basit bir moleküldür."],["Le chimiste étudie une molécule.","lö şimist etüdi ün molekül","Kimyager bir molekülü inceliyor."]]}
{"w":"étoffe","t":"isim (dişil)","m":"kumaş; yetenek","s":["tissu","matière"],"a":[],"e":[["Elle achète une étoffe de soie.","el aşet ün etof dö sua","İpek bir kumaş satın alıyor."],["Il a l'étoffe d'un chef.","il a letof dön şef","Bir lider olma yeteneği var."]],"x":[["avoir l'étoffe de","avuar letof dö","…ecek kabiliyette olmak","Il a l'étoffe d'un chef.","il a letof den şef","Lider olacak kabiliyette."]]}
{"w":"précoce","t":"sıfat","m":"erken gelişen; erken","s":["prématuré","en avance"],"a":["tardif"],"e":[["C'est un enfant précoce.","se ten anfan prekos","Bu erken gelişen bir çocuk."],["Le printemps est précoce cette année.","lö prentan e prekos set ane","İlkbahar bu yıl erken geldi."]]}
{"w":"séisme","t":"isim (eril)","m":"deprem","s":["tremblement de terre"],"a":[],"e":[["Un séisme frappe la région.","en seism frap la rejyon","Bir deprem bölgeyi vuruyor."],["Le séisme détruit des maisons.","lö seism detrü de mezon","Deprem evleri yıkıyor."]]}
{"w":"sortilège","t":"isim (eril)","m":"büyü","s":["sort","enchantement"],"a":[],"e":[["La sorcière lance un sortilège.","la sorsyer lans en sortilej","Cadı bir büyü yapıyor."],["Le sortilège se brise à minuit.","lö sortilej sö briz a minüi","Büyü gece yarısı bozuluyor."]]}
{"w":"barbier","t":"isim (eril)","m":"berber","s":[],"a":[],"e":[["Le barbier rase la barbe du client.","lö barbye raz la barb dü klian","Berber müşterinin sakalını tıraş ediyor."],["Il va chez le barbier chaque mois.","il va şe lö barbye şak mua","Her ay berbere gidiyor."]]}
{"w":"novice","t":"isim (eril)","m":"acemi","s":["débutant","apprenti"],"a":["expert","vétéran"],"e":[["Le novice apprend les règles.","lö novis aprand le regl","Acemi kuralları öğreniyor."],["Elle est novice dans ce métier.","el e novis dan sö metye","Bu meslekte acemi."]]}
