{"w":"crampe","t":"isim (dişil)","m":"kramp","s":[],"a":[],"e":[["Il a une crampe à la jambe.","il a ün kranp a la jamb","Bacağında kramp var."],["Cette crampe fait mal.","set kranp fe mal","Bu kramp acıtıyor."]],"x":[["avoir une crampe","avuar ün kranp","kramp girmek","Il a une crampe dans la jambe.","il a ün kranp dan la janb","Bacağına kramp girdi."]]}
