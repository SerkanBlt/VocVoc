{"w":"romantisme","t":"isim (eril)","m":"romantizm","s":[],"a":[],"e":[["Le romantisme naît au dix-neuvième siècle.","lö romantism ne o diz növyem syekl","Romantizm on dokuzuncu yüzyılda doğuyor."],["Il aime le romantisme des vieilles chansons.","il em lö romantism de viyey şanson","Eski şarkıların romantizmini seviyor."]]}
{"w":"méchanceté","t":"isim (dişil)","m":"kötülük","s":["cruauté","malveillance"],"a":["bonté","gentillesse"],"e":[["Sa méchanceté étonne tout le monde.","sa meşanste eton tu lö mond","Kötülüğü herkesi şaşırtıyor."],["Il agit par pure méchanceté.","il aji par pür meşanste","Saf kötülükten hareket ediyor."]]}
