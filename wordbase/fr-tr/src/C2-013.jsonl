{"w":"bougon","t":"sıfat","m":"hırçın; somurtkan","s":["grincheux","renfrogné"],"a":["jovial","aimable"],"e":[["Mon grand-père est un peu bougon.","mon gran per e ten pö bugon","Büyükbabam biraz hırçın."],["Il répond d'un ton bougon.","il repon den ton bugon","Somurtkan bir sesle cevap veriyor."]]}
{"w":"inceste","t":"isim (eril)","m":"ensest","s":[],"a":[],"e":[["L'inceste est un crime grave.","lensest e ten krim grav","Ensest ağır bir suçtur."],["La loi condamne l'inceste.","la lua kondan lensest","Yasa ensesti mahkûm ediyor."]]}
