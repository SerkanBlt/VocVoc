{"w":"fourrure","t":"isim (dişil)","m":"kürk","s":[],"a":[],"e":[["Elle porte un manteau de fourrure.","el port en manto dö furür","Kürk bir palto giyiyor."],["Le renard a une belle fourrure.","lö rönar a ün bel furür","Tilkinin güzel bir kürkü var."]]}
{"w":"mule","t":"isim (dişil)","m":"terlik (kadın); dişi katır","s":[],"a":[],"e":[["Elle porte des mules en soie.","el port de mül an sua","İpek terlikler giyiyor."],["La mule est un animal têtu.","la mül e ten animal tetü","Katır inatçı bir hayvandır."]]}
