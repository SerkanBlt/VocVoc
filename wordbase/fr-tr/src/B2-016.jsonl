{"w":"préfet","t":"isim (eril)","m":"vali","s":[],"a":[],"e":[["Le préfet visite la ville.","lö prefe vizit la vil","Vali şehri ziyaret ediyor."],["Le préfet prend une décision.","lö prefe pran ün desizyon","Vali bir karar alıyor."]]}
{"w":"installation","t":"isim (dişil)","m":"kurulum; tesis","s":["montage","équipement"],"a":["démontage"],"e":[["L'installation du logiciel est facile.","lenstalasyon dü lojisyel e fasil","Yazılımın kurulumu kolay."],["Les installations sportives sont modernes.","le zenstalasyon sportiv son modern","Spor tesisleri modern."]]}
