{"w":"spiritualité","t":"isim (dişil)","m":"maneviyat","s":["mysticisme","religiosité"],"a":["matérialisme"],"e":[["Il cherche la spiritualité dans la méditation.","il şerş la spirityüalite dan la meditasyon","Maneviyatı meditasyonda arıyor."],["La spiritualité guide sa vie.","la spirityüalite gid sa vi","Maneviyat hayatına yön veriyor."]]}
{"w":"menotter","t":"fiil","m":"kelepçelemek","s":["attacher","entraver"],"a":["libérer","détacher"],"e":[["Les policiers menottent le suspect.","le polisye mönot lö süspe","Polisler şüpheliyi kelepçeliyor."],["On l'a menotté avant de l'emmener.","on la mönote avan dö lanmöne","Götürülmeden önce kelepçelendi."]]}
{"w":"indolore","t":"sıfat","m":"acısız","s":["sans douleur"],"a":["douloureux"],"e":[["L'opération est indolore.","loperasyon e tendolor","Ameliyat acısız."],["Le vaccin est presque indolore.","lö vaksen e presk endolor","Aşı neredeyse acısız."]]}
{"w":"allaiter","t":"fiil","m":"emzirmek","s":["nourrir"],"a":["sevrer"],"e":[["Elle allaite son bébé.","el alet son bebe","Bebeğini emziriyor."],["Les mammifères allaitent leurs petits.","le mamifer alet lör pöti","Memeliler yavrularını emzirir."]]}
{"w":"chevron","t":"isim (eril)","m":"çatı kirişi; V şeklinde şerit","s":["poutre","galon"],"a":[],"e":[["Le toit repose sur des chevrons.","lö tua röpoz sür de şövron","Çatı kirişlerin üzerinde duruyor."],["Le sergent porte deux chevrons sur la manche.","lö serjan port dö şövron sür la manş","Çavuş koluna iki V şerit takıyor."]]}
{"w":"écarlate","t":"sıfat","m":"kıpkırmızı; al","s":["rouge vif","pourpre"],"a":["pâle"],"e":[["Elle devient écarlate de honte.","el dövyen ekarlat dö ont","Utançtan kıpkırmızı oluyor."],["Il porte une cape écarlate.","il port ün kap ekarlat","Al renkli bir pelerin giyiyor."]]}
{"w":"affoler","t":"fiil","m":"paniğe sürüklemek; telaşlandırmak","s":["effrayer","paniquer"],"a":["calmer","rassurer"],"e":[["Cette nouvelle affole les marchés.","set nuvel afol le marşe","Bu haber piyasaları paniğe sürüklüyor."],["La foule s'affole devant l'incendie.","la ful safol dövan lensandi","Kalabalık yangın karşısında paniğe kapılıyor."]]}
{"w":"majuscule","t":"isim (dişil)","m":"büyük harf","s":["capitale"],"a":["minuscule"],"e":[["Les noms propres prennent une majuscule.","le non propr pren ün majüskül","Özel isimler büyük harfle başlar."],["Il écrit son nom en majuscules.","il ekri son non an majüskül","Adını büyük harflerle yazıyor."]]}
{"w":"créancier","t":"isim (eril)","m":"alacaklı","s":["prêteur"],"a":["débiteur"],"e":[["Le créancier réclame son argent.","lö kreansye reklam son arjan","Alacaklı parasını istiyor."],["Elle rembourse ses créanciers.","el ranburs se kreansye","Alacaklılarına borcunu ödüyor."]]}
{"w":"solstice","t":"isim (eril)","m":"gündönümü","s":[],"a":["équinoxe"],"e":[["Le solstice d'été a lieu en juin.","lö solstis dete a lyö an jüen","Yaz gündönümü haziranda olur."],["On fête le solstice d'hiver.","on fet lö solstis diver","Kış gündönümü kutlanıyor."]]}
{"w":"abruti","t":"sıfat","m":"aptallaşmış; (argo) aptal","s":["hébété","imbécile"],"a":["éveillé","lucide"],"e":[["Il est complètement abruti par la fatigue.","il e konpletman abrüti par la fatig","Yorgunluktan tamamen aptallaşmış."],["Cet abruti m'a coupé la route.","set abrüti ma kupe la rut","Bu embesil önümü kesti."]]}
{"w":"mante","t":"isim (dişil)","m":"peygamber devesi (böcek)","s":["mante religieuse"],"a":[],"e":[["La mante religieuse dévore le mâle.","la mant röliyöz devor lö mal","Peygamber devesi erkeği yiyor."],["Une mante guette sa proie.","ün mant get sa prua","Bir peygamber devesi avını gözlüyor."]]}
{"w":"câliner","t":"fiil","m":"sevip okşamak","s":["caresser","dorloter"],"a":["brutaliser"],"e":[["Elle câline son chat.","el kalin son şa","Kedisini seviyor."],["Il câline ses enfants avant de dormir.","il kalin se zanfan avan dö dormir","Uyumadan önce çocuklarını okşuyor."]]}
{"w":"huer","t":"fiil","m":"yuhalamak","s":["siffler","conspuer"],"a":["applaudir","acclamer"],"e":[["La foule hue l'arbitre.","la ful ü larbitr","Kalabalık hakemi yuhalıyor."],["Les spectateurs huent l'équipe.","le spektatör ü lekip","Seyirciler takımı yuhalıyor."]]}
{"w":"mondain","t":"sıfat","m":"sosyetik; sosyeteye ait","s":["élégant","raffiné"],"a":["modeste","austère"],"e":[["Il mène une vie mondaine.","il men ün vi monden","Sosyetik bir hayat sürüyor."],["Elle fréquente les soirées mondaines.","el frekant le suare monden","Sosyetik davetlere gidiyor."]]}
{"w":"vicomte","t":"isim (eril)","m":"vikont","s":["noble"],"a":[],"e":[["Le vicomte vit dans un château.","lö vikont vi dan zen şato","Vikont bir şatoda yaşıyor."],["Le vicomte hérite du titre de son père.","lö vikont erit dü titr dö son per","Vikont babasının unvanını miras alıyor."]]}
{"w":"panse","t":"isim (dişil)","m":"göbek; işkembe (hayvan)","s":["ventre","estomac"],"a":[],"e":[["Il tapote sa panse après le repas.","il tapot sa pans apre lö röpa","Yemekten sonra göbeğine vuruyor."],["La panse de la vache est son premier estomac.","la pans dö la vaş e son prömye estoma","İneğin işkembesi ilk midesidir."]],"x":[["s'en mettre plein la panse","san metr plen la pans","tıka basa yemek","Ils s'en mettent plein la panse au buffet.","il san met plen la pans o büfe","Büfede tıka basa yiyorlar."]]}
{"w":"infériorité","t":"isim (dişil)","m":"aşağılık; geride olma","s":["faiblesse","désavantage"],"a":["supériorité"],"e":[["Il souffre d'un complexe d'infériorité.","il sufr den konpleks denferyorite","Aşağılık kompleksinden muzdarip."],["L'infériorité numérique inquiète l'équipe.","lenferyorite nümerik enkyet lekip","Sayısal geride olma takımı endişelendiriyor."]]}
{"w":"capoter","t":"fiil","m":"alabora olmak; suya düşmek (plan)","s":["chavirer","échouer"],"a":["réussir"],"e":[["La voiture capote sur la route.","la vuatür kapot sür la rut","Araba yolda alabora oluyor."],["Le projet capote à cause du budget.","lö proje kapot a koz dü büdje","Proje bütçe yüzünden suya düşüyor."]]}
{"w":"minime","t":"sıfat","m":"çok küçük; önemsiz","s":["négligeable","infime"],"a":["important","considérable"],"e":[["La différence est minime.","la diferans e minim","Fark çok küçük."],["Il y a un risque minime.","il ya en risk minim","Çok küçük bir risk var."]]}
{"w":"rembobiner","t":"fiil","m":"geri sarmak","s":["rebobiner","revenir en arrière"],"a":["avancer"],"e":[["Il rembobine la cassette.","il ranbobin la kaset","Kaseti geri sarıyor."],["Elle rembobine le film pour revoir la scène.","el ranbobin lö film pur rövuar la sen","Sahneyi yeniden izlemek için filmi geri sarıyor."]]}
{"w":"fantasmer","t":"fiil","m":"hayal kurmak; kafasında kurgulamak","s":["rêver","imaginer"],"a":[],"e":[["Il fantasme sur une vie de star.","il fantasm sür ün vi dö star","Yıldız gibi bir hayatın hayalini kuruyor."],["Elle fantasme sur ses prochaines vacances.","el fantasm sür se proşen vakans","Gelecek tatilinin hayalini kuruyor."]]}
{"w":"vrombissement","t":"isim (eril)","m":"uğultu; motor gürültüsü","s":["bourdonnement","ronflement"],"a":["silence"],"e":[["Le vrombissement du moteur réveille tout le quartier.","lö vronbisman dü motör revey tu lö kartye","Motor uğultusu bütün mahalleyi uyandırıyor."],["On entend le vrombissement d'un avion.","on antan lö vronbisman den navyon","Bir uçağın uğultusu duyuluyor."]]}
{"w":"légitimité","t":"isim (dişil)","m":"meşruiyet","s":["bien-fondé","légalité"],"a":["illégitimité"],"e":[["Le président défend sa légitimité.","lö prezidan defan sa lejitimite","Başkan meşruiyetini savunuyor."],["Ils contestent la légitimité du vote.","il kontest la lejitimite dü vot","Oylamanın meşruiyetini sorguluyorlar."]]}
{"w":"sphinx","t":"isim (eril)","m":"sfenks","s":[],"a":[],"e":[["Le sphinx garde le désert.","lö sfenks gard lö dezer","Sfenks çölü bekliyor."],["Le sphinx pose une énigme.","lö sfenks poz ün enigm","Sfenks bir bilmece soruyor."]]}
{"w":"pavot","t":"isim (eril)","m":"haşhaş; gelincik","s":["coquelicot"],"a":[],"e":[["Le pavot donne l'opium.","lö pavo don lopyom","Haşhaş afyon verir."],["Un champ de pavots rouges fleurit.","en şan dö pavo ruj flöri","Kırmızı haşhaşlarla dolu bir tarla çiçek açıyor."]]}
{"w":"décamper","t":"fiil","m":"toz olmak; sıvışmak","s":["fuir","déguerpir"],"a":["rester"],"e":[["Les voleurs décampent à la hâte.","le volör dekanp a la at","Hırsızlar apar topar sıvışıyor."],["Décampe d'ici !","dekanp disi","Toz ol buradan!"]]}
{"w":"rétrécir","t":"fiil","m":"daralmak; çekmek (kumaş)","s":["diminuer","se resserrer"],"a":["agrandir","élargir"],"e":[["Le pull rétrécit au lavage.","lö pül retresi o lavaj","Kazak yıkamada çekiyor."],["Les jours rétrécissent en hiver.","le jur retresis an iver","Günler kışın kısalıyor."]]}
{"w":"autochtone","t":"sıfat","m":"yerli","s":["indigène","natif"],"a":["étranger","immigré"],"e":[["La population autochtone défend ses terres.","la popülasyon otokton defan se ter","Yerli halk topraklarını savunuyor."],["Les langues autochtones disparaissent.","le lang otokton dispares","Yerli diller yok oluyor."]]}
{"w":"gravure","t":"isim (dişil)","m":"gravür; baskı resim","s":["estampe","illustration"],"a":[],"e":[["Il offre une gravure ancienne.","il ofr ün gravür ansyen","Eski bir gravür hediye ediyor."],["La gravure sur bois est un art.","la gravür sür bua e ten ar","Ahşap gravür bir sanattır."]]}
{"w":"insoutenable","t":"sıfat","m":"dayanılmaz","s":["insupportable","intolérable"],"a":["supportable","tolérable"],"e":[["La douleur est insoutenable.","la dulör e tensutnabl","Acı dayanılmaz."],["Il vit une situation insoutenable.","il vi ün sitüasyon ensutnabl","Dayanılmaz bir durum yaşıyor."]]}
{"w":"lingette","t":"isim (dişil)","m":"ıslak mendil","s":["serviette humide"],"a":[],"e":[["Elle nettoie la table avec une lingette.","el netua la tabl avek ün lenjet","Masayı ıslak mendille siliyor."],["Les lingettes pour bébé sont humides.","le lenjet pur bebe son tümid","Bebek mendilleri ıslaktır."]]}
{"w":"laque","t":"isim (dişil)","m":"saç spreyi; vernik","s":["vernis","fixateur"],"a":[],"e":[["Elle met de la laque sur ses cheveux.","el me dö la lak sür se şövö","Saçlarına sprey sıkıyor."],["Le meuble est recouvert de laque noire.","lö möbl e rökuver dö lak nuar","Mobilya siyah vernikle kaplanmış."]]}
{"w":"hippopotame","t":"isim (eril)","m":"su aygırı","s":[],"a":[],"e":[["L'hippopotame vit dans le fleuve.","lipopotam vi dan lö flöv","Su aygırı nehirde yaşar."],["Un hippopotame ouvre la gueule.","en nipopotam uvr la göl","Bir su aygırı ağzını açıyor."]]}
{"w":"bourde","t":"isim (dişil)","m":"gaf; hata","s":["gaffe","erreur"],"a":[],"e":[["Il commet une bourde en réunion.","il kome ün burd an reünyon","Toplantıda bir gaf yapıyor."],["Cette bourde coûte cher à l'entreprise.","set burd kut şer a lantröpriz","Bu gaf şirkete pahalıya mal oluyor."]]}
{"w":"survêtement","t":"isim (eril)","m":"eşofman","s":["jogging"],"a":[],"e":[["Il court en survêtement.","il kur an sürvetman","Eşofmanla koşuyor."],["Il porte un survêtement bleu.","il port en sürvetman blö","Mavi bir eşofman giyiyor."]]}
{"w":"chlorure","t":"isim (eril)","m":"klorür","s":["sel"],"a":[],"e":[["Le chlorure de sodium est du sel.","lö klorür dö sodyom e dü sel","Sodyum klorür tuzdur."],["Le chlorure se dissout dans l'eau.","lö klorür sö disu dan lo","Klorür suda çözünür."]]}
{"w":"égaler","t":"fiil","m":"eşit olmak; eşitlemek","s":["équivaloir","rivaliser avec"],"a":["surpasser","dépasser"],"e":[["Personne n'égale son talent.","person negal son talan","Kimse onun yeteneğine eşit değil."],["Il égale le record du monde.","il egal lö rökor dü mond","Dünya rekoruna eşitliyor."]]}
{"w":"poulpe","t":"isim (eril)","m":"ahtapot","s":["pieuvre"],"a":[],"e":[["Le poulpe a huit tentacules.","lö pulp a üit tantakül","Ahtapotun sekiz kolu var."],["Elle mange du poulpe grillé.","el manj dü pulp griye","Izgara ahtapot yiyor."]]}
{"w":"concessionnaire","t":"isim (eril/dişil)","m":"bayi; imtiyaz sahibi","s":["revendeur","distributeur"],"a":[],"e":[["Le concessionnaire vend des voitures neuves.","lö konsesyoner vand de vuatür növ","Bayi sıfır araba satıyor."],["Il appelle le concessionnaire pour le service.","il apel lö konsesyoner pur lö servis","Servis için bayiyi arıyor."]]}
{"w":"épier","t":"fiil","m":"gözetlemek; kollamak","s":["guetter","surveiller"],"a":["ignorer"],"e":[["Il épie ses voisins.","il epi se vuazen","Komşularını gözetliyor."],["Elle épie le moindre mouvement.","el epi lö muendr muvman","En küçük harekete bile göz kulak oluyor."]]}
{"w":"rugissement","t":"isim (eril)","m":"kükreme","s":["grondement","hurlement"],"a":["murmure"],"e":[["Le rugissement du lion fait trembler.","lö rüjisman dü lyon fe tranble","Aslanın kükremesi titretiyor."],["On entend un rugissement dans la nuit.","on antan en rüjisman dan la nüi","Gecenin içinde bir kükreme duyuluyor."]]}
{"w":"décadence","t":"isim (dişil)","m":"gerileme; çöküş","s":["déclin","chute"],"a":["essor","apogée"],"e":[["L'empire entre en décadence.","lanpir antr an dekadans","İmparatorluk çöküşe giriyor."],["La décadence morale inquiète les sages.","la dekadans moral enkyet le saj","Ahlaki çöküş bilgeleri endişelendiriyor."]]}
{"w":"envier","t":"fiil","m":"imrenmek; kıskanmak","s":["jalouser","convoiter"],"a":["plaindre"],"e":[["Il envie son frère.","il anvi son frer","Kardeşini kıskanıyor."],["Je n'envie pas ta situation.","jö nanvi pa ta sitüasyon","Senin durumuna imrenmiyorum."]],"x":[["n'avoir rien à envier à","navuar ryen a anvye a","…dan aşağı kalır yanı olmamak","Cette ville n'a rien à envier à Paris.","set vil na ryen a anvye a pari","Bu şehir Paris'ten aşağı kalmaz."]]}
{"w":"polyester","t":"isim (eril)","m":"polyester","s":[],"a":["coton"],"e":[["Cette chemise est en polyester.","set şömiz e tan poliyester","Bu gömlek polyester."],["Le polyester sèche très vite.","lö poliyester seş tre vit","Polyester çok çabuk kurur."]]}
{"w":"sellette","t":"isim (dişil)","m":"sanık sandalyesi; zor durum","s":["banc des accusés","situation délicate"],"a":[],"e":[["Le ministre est sur la sellette.","lö ministr e sür la selet","Bakan hedef tahtasında."],["Le chef reste sur la sellette après l'échec.","lö şef rest sür la selet apre leşek","Şef başarısızlıktan sonra hâlâ zor durumda."]],"x":[["être sur la sellette","etr sür la selet","zor durumda olmak; hedefte olmak","Le directeur est sur la sellette.","lö direktör e sür la selet","Müdür zor durumda."]]}
{"w":"turban","t":"isim (eril)","m":"kavuk; sarık","s":["coiffe"],"a":[],"e":[["Il porte un turban rouge.","il port en türban ruj","Kırmızı bir sarık takıyor."],["Le turban protège la tête du soleil.","lö türban protej la tet dü solay","Sarık başı güneşten koruyor."]]}
{"w":"contrebandier","t":"isim (eril)","m":"kaçakçı","s":["trafiquant","fraudeur"],"a":[],"e":[["Le contrebandier passe la frontière de nuit.","lö kontrbandye pas la frontyer dö nüi","Kaçakçı sınırı geceleyin geçiyor."],["La police arrête un contrebandier d'alcool.","la polis aret en kontrbandye dalkol","Polis bir alkol kaçakçısını yakalıyor."]]}
{"w":"écolier","t":"isim (eril)","m":"erkek öğrenci (ilkokul)","s":["élève"],"a":["écolière"],"e":[["L'écolier lit son livre à voix haute.","lekolye li son livr a vua ot","Öğrenci kitabını yüksek sesle okuyor."],["Chaque matin, l'écolier prend le bus.","şak maten lekolye pran lö büs","Her sabah öğrenci otobüse biniyor."]]}
{"w":"hippodrome","t":"isim (eril)","m":"at yarışı pisti","s":["champ de courses"],"a":[],"e":[["Ils parient sur les chevaux à l'hippodrome.","il pari sür le şöval a lipodrom","At yarışı pistinde atlara bahis oynuyorlar."],["L'hippodrome accueille les courses du dimanche.","lipodrom aköy le kurs dü dimanş","At yarışı pisti pazar yarışlarına ev sahipliği yapıyor."]]}
