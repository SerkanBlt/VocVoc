{"w":"galant","t":"sıfat","m":"nazik; kibar (özellikle kadınlara karşı)","s":["courtois","poli"],"a":["grossier","impoli"],"e":[["Il est galant avec les dames.","il e galan avek le dam","Hanımlara karşı kibar."],["Un homme galant ouvre la porte.","en nom galan uvr la port","Kibar bir adam kapıyı açıyor."]]}
{"w":"prospérité","t":"isim (dişil)","m":"refah; gönenç","s":["richesse","réussite"],"a":["misère","pauvreté"],"e":[["Le pays vit dans la prospérité.","lö pei viv dan la prosperite","Ülke refah içinde yaşıyor."],["Ils souhaitent la paix et la prospérité.","il suet la pe e la prosperite","Barış ve refah diliyorlar."]]}
{"w":"rigueur","t":"isim (dişil)","m":"titizlik; sertlik","s":["sévérité","exactitude"],"a":["laxisme","douceur"],"e":[["Il travaille avec rigueur.","il travay avek rigör","Titizlikle çalışıyor."],["La rigueur de l'hiver surprend.","la rigör dö liver sürpran","Kışın sertliği şaşırtıyor."]]}
{"w":"soigneusement","t":"zarf","m":"özenle; dikkatle","s":["minutieusement","consciencieusement"],"a":["négligemment"],"e":[["Il range soigneusement ses livres.","il ranj suanyözman se livr","Kitaplarını özenle diziyor."],["Elle plie soigneusement la robe.","el pli suanyözman la rob","Elbiseyi dikkatle katlıyor."]]}
{"w":"essuyer","t":"fiil","m":"silmek; kurulamak","s":["sécher","nettoyer"],"a":["mouiller"],"e":[["Il essuie la table avec un chiffon.","il esüi la tabl avek en şifon","Masayı bir bezle siliyor."],["Elle essuie ses larmes.","el esüi se larm","Gözyaşlarını siliyor."]]}
{"w":"interruption","t":"isim (dişil)","m":"kesinti; ara verme","s":["arrêt","pause"],"a":["continuation","suite"],"e":[["L'interruption du courant dure une heure.","lenterüpsyon dü kuran dür ün ör","Elektrik kesintisi bir saat sürüyor."],["Il parle sans interruption.","il parl san zenterüpsyon","Durmadan konuşuyor."]]}
{"w":"défensif","t":"sıfat","m":"savunma amaçlı; savunmacı","s":["protecteur"],"a":["offensif"],"e":[["Il adopte une position défensive.","il adopt ün pozisyon defansiv","Savunmacı bir tutum benimsiyor."],["Cette équipe a un jeu défensif.","set ekip a en jö defansif","Bu takım savunmacı oynuyor."]]}
{"w":"prairie","t":"isim (dişil)","m":"çayır; otlak","s":["pré","herbage"],"a":[],"e":[["Les vaches paissent dans la prairie.","le vaş pes dan la preri","İnekler çayırda otluyor."],["Une grande prairie entoure la ferme.","ün grand preri antur la ferm","Büyük bir çayır çiftliği çevreliyor."]]}
{"w":"sabotage","t":"isim (eril)","m":"sabotaj","s":["destruction"],"a":["réparation"],"e":[["Le sabotage arrête la production.","lö sabotaj aret la prodüksyon","Sabotaj üretimi durduruyor."],["La police suspecte un sabotage.","la polis süspekt en sabotaj","Polis bir sabotajdan şüpheleniyor."]]}
{"w":"exclusivité","t":"isim (dişil)","m":"tekel; özel hak; özel haber","s":["monopole","privilège"],"a":["partage"],"e":[["Ce magasin a l'exclusivité de la marque.","sö magazen a leksklüzivite dö la mark","Bu mağaza markanın tek satıcısı."],["Le journal publie une exclusivité.","lö jurnal pübli ün eksklüzivite","Gazete özel bir haber yayımlıyor."]]}
{"w":"impérial","t":"sıfat","m":"imparatorluğa ait; imparatorluk","s":[],"a":[],"e":[["Le palais impérial est immense.","lö pale enperyal e timans","İmparatorluk sarayı kocaman."],["La garde impériale défend l'empereur.","la gard enperyal defan lanperör","İmparatorluk muhafızları imparatoru koruyor."]]}
{"w":"tolérer","t":"fiil","m":"hoşgörmek; katlanmak","s":["accepter","supporter"],"a":["interdire","refuser"],"e":[["Il ne tolère pas le bruit.","il nö toler pa lö brüi","Gürültüye tahammül edemiyor."],["Elle tolère mal la chaleur.","el toler mal la şalör","Sıcağa pek dayanamıyor."]]}
{"w":"rame","t":"isim (dişil)","m":"kürek; metro kompozisyonu","s":["aviron"],"a":[],"e":[["Le rameur prend une rame.","lö ramör pran ün ram","Kürekçi bir kürek alıyor."],["La rame de métro arrive.","la ram dö metro ariv","Metro kompozisyonu geliyor."]]}
