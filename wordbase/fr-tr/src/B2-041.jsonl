{"w":"agriculture","t":"isim (dişil)","m":"tarım","s":[],"a":[],"e":[["L'agriculture nourrit le pays.","lagrikültür nuri lö pei","Tarım ülkeyi besliyor."],["Il travaille dans l'agriculture.","il travay dan lagrikültür","Tarım sektöründe çalışıyor."]]}
{"w":"infâme","t":"sıfat","m":"alçak; rezil","s":["ignoble","odieux"],"a":["honorable","noble"],"e":[["Il commet un acte infâme.","il komet en nakt enfam","Alçakça bir eylem işliyor."],["Ce roi infâme est détesté.","sö rua enfam e deteste","Bu alçak kral nefret ediliyor."]]}
{"w":"ouvertement","t":"zarf","m":"açıkça","s":["franchement","publiquement"],"a":["secrètement","discrètement"],"e":[["Il parle ouvertement de ses problèmes.","il parl uvertöman dö se problem","Sorunlarından açıkça söz ediyor."],["Elle critique ouvertement le chef.","el kritik uvertöman lö şef","Şefi açıkça eleştiriyor."]]}
{"w":"colombe","t":"isim (dişil)","m":"güvercin (beyaz); tarla güvercini","s":[],"a":[],"e":[["Une colombe blanche vole dans le ciel.","ün kolonb blanş vol dan lö syel","Beyaz bir güvercin gökyüzünde uçuyor."],["La colombe symbolise la paix.","la kolonb sembolis la pe","Güvercin barışı simgeler."]]}
{"w":"indéfiniment","t":"zarf","m":"sonsuza dek; süresiz olarak","s":["sans fin","éternellement"],"a":["brièvement","temporairement"],"e":[["Il attend indéfiniment.","il atan endefiniman","Süresiz bekliyor."],["On ne peut pas continuer indéfiniment.","on nö pö pa kontinüe endefiniman","Sonsuza dek devam edemeyiz."]]}
{"w":"ému","t":"sıfat","m":"duygulanmış; etkilenmiş","s":["touché","bouleversé"],"a":["indifférent","impassible"],"e":[["Il est ému par ce discours.","il e temü par sö diskur","Bu konuşmadan duygulanıyor."],["Elle parle d'une voix émue.","el parl dün vua emü","Duygulu bir sesle konuşuyor."]]}
{"w":"mûr","t":"sıfat","m":"olgun; pişmiş","s":["prêt","développé"],"a":["vert","immature"],"e":[["Cette poire est mûre.","set puar e mür","Bu armut olgun."],["Il est mûr pour prendre cette décision.","il e mür pur prandr set desizyon","Bu kararı almak için olgun."]]}
{"w":"tronc","t":"isim (eril)","m":"gövde; ağaç gövdesi","s":[],"a":[],"e":[["Le tronc de l'arbre est épais.","lö tron dö larbr e tepe","Ağacın gövdesi kalın."],["Il coupe le tronc avec une scie.","il kup lö tron avek ün si","Gövdeyi testereyle kesiyor."]]}
{"w":"mare","t":"isim (dişil)","m":"gölcük; su birikintisi","s":["étang","flaque"],"a":[],"e":[["Les canards nagent dans la mare.","le kanar naj dan la mar","Ördekler gölcükte yüzüyor."],["Une mare d'eau se forme devant la maison.","ün mar do sö form dövan la mezon","Evin önünde bir su birikintisi oluşuyor."]]}
{"w":"crapule","t":"isim (dişil)","m":"alçak; adi herif","s":["canaille","voyou"],"a":["honnête"],"e":[["Cette crapule vole les vieux.","set krapül vol le vyö","Bu alçak yaşlıları soyuyor."],["Il traite son voisin de crapule.","il tret son vuazen dö krapül","Komşusuna alçak diyor."]]}
{"w":"biche","t":"isim (dişil)","m":"dişi geyik","s":["cerf femelle"],"a":["cerf"],"e":[["La biche court dans la forêt.","la biş kur dan la fore","Dişi geyik ormanda koşuyor."],["Une biche et son faon boivent à la rivière.","ün biş e son fan buav a la rivyer","Bir dişi geyik ve yavrusu nehirden su içiyor."]]}
{"w":"soupçonner","t":"fiil","m":"şüphelenmek","s":["suspecter","douter"],"a":["croire","faire confiance"],"e":[["Il soupçonne son voisin.","il supson son vuazen","Komşusundan şüpheleniyor."],["Elle soupçonne un mensonge.","el supson en mansonj","Bir yalandan şüpheleniyor."]]}
{"w":"moule","t":"isim (eril)","m":"kalıp","s":["forme"],"a":[],"e":[["Il verse la pâte dans le moule.","il vers la pat dan lö mul","Hamuru kalıba döküyor."],["Ce moule sert à faire des gâteaux.","sö mul ser a fer de gato","Bu kalıp pasta yapmaya yarıyor."]]}
{"w":"immonde","t":"sıfat","m":"iğrenç; pis","s":["dégoûtant","répugnant"],"a":["propre","agréable"],"e":[["Cette odeur est immonde.","set odör e timond","Bu koku iğrenç."],["Il vit dans un endroit immonde.","il viv dan zen andrua imond","İğrenç bir yerde yaşıyor."]]}
{"w":"malsain","t":"sıfat","m":"sağlıksız; zararlı","s":["nuisible","dangereux"],"a":["sain","salubre"],"e":[["L'air de cette pièce est malsain.","ler dö set pyes e malsen","Bu odanın havası sağlıksız."],["Il mène une vie malsaine.","il men ün vi malsen","Sağlıksız bir hayat sürüyor."]]}
{"w":"restauration","t":"isim (dişil)","m":"restorasyon; yeme-içme sektörü","s":["rénovation","réparation"],"a":["destruction"],"e":[["La restauration du château dure des années.","la restorasyon dü şato dür de zane","Şatonun restorasyonu yıllar sürüyor."],["Il travaille dans la restauration.","il travay dan la restorasyon","Yeme-içme sektöründe çalışıyor."]]}
{"w":"consul","t":"isim (eril)","m":"konsolos","s":["diplomate"],"a":[],"e":[["Le consul aide les touristes.","lö konsül ed le turist","Konsolos turistlere yardım ediyor."],["Il rend visite au consul de France.","il ran vizit o konsül dö frans","Fransa konsolosunu ziyaret ediyor."]]}
{"w":"embarrasser","t":"fiil","m":"zor durumda bırakmak; utandırmak","s":["gêner","déranger"],"a":["aider","soulager"],"e":[["Sa question embarrasse le prof.","sa kestyon anbaras lö prof","Sorusu öğretmeni zor durumda bırakıyor."],["Il ne veut pas t'embarrasser.","il nö vö pa tanbarase","Seni utandırmak istemiyor."]]}
{"w":"meneur","t":"isim (eril)","m":"lider; elebaşı","s":["chef","leader"],"a":["suiveur"],"e":[["Le meneur dirige la manifestation.","lö mönör dirij la manifestasyon","Elebaşı gösteriyi yönetiyor."],["Ce meneur guide son équipe.","sö mönör gid son nekip","Bu lider takımına yol gösteriyor."]]}
{"w":"providence","t":"isim (dişil)","m":"ilahi takdir; kader","s":["destin","sort"],"a":[],"e":[["Ils attendent un miracle de la providence.","il zatan en mirakl dö la providans","Takdirden bir mucize bekliyorlar."],["Il croit en la providence.","il krua an la providans","Kadere inanıyor."]]}
{"w":"manœuvre","t":"isim (dişil)","m":"manevra","s":["opération","mouvement"],"a":[],"e":[["Le conducteur fait une manœuvre difficile.","lö kondüktör fe ün manövr difisil","Sürücü zor bir manevra yapıyor."],["L'armée prépare une grande manœuvre.","larme prepar ün grand manövr","Ordu büyük bir manevra hazırlıyor."]]}
{"w":"souffrant","t":"sıfat","m":"hasta; rahatsız","s":["malade","indisposé"],"a":["guéri","en forme"],"e":[["Il est souffrant depuis hier.","il e sufran döpüi yer","Dünden beri rahatsız."],["Le patient souffrant reste au lit.","lö pasyan sufran rest o li","Hasta yatakta kalıyor."]]}
{"w":"ridiculiser","t":"fiil","m":"alay etmek; gülünç duruma düşürmek","s":["moquer","railler"],"a":["respecter","louer"],"e":[["Il ridiculise son collègue.","il ridiküliz son koleg","Meslektaşıyla alay ediyor."],["Elle ne veut pas être ridiculisée.","el nö vö pa etr ridikülize","Gülünç duruma düşmek istemiyor."]]}
{"w":"blindé","t":"sıfat","m":"zırhlı; çelik kaplı","s":["renforcé","cuirassé"],"a":["fragile","vulnérable"],"e":[["Le président voyage dans une voiture blindée.","lö prezidan vuayaj dan zün vuatür blende","Başkan zırhlı bir araçla seyahat ediyor."],["La porte blindée protège la maison.","la port blende protej la mezon","Çelik kapı evi koruyor."]]}
{"w":"déni","t":"isim (eril)","m":"inkâr; reddetme","s":["refus","négation"],"a":["aveu","acceptation"],"e":[["Il vit dans le déni.","il viv dan lö deni","İnkâr içinde yaşıyor."],["Le déni de justice choque tout le monde.","lö deni dö jüstis şok tu lö mond","Adaletin reddi herkesi şoke ediyor."]]}
{"w":"souterrain","t":"sıfat","m":"yeraltı; gizli","s":["enterré","caché"],"a":["aérien","extérieur"],"e":[["Ils traversent un passage souterrain.","il travers en pasaj suteren","Yeraltı geçidinden geçiyorlar."],["Une rivière souterraine coule sous la ville.","ün rivyer suteren kul su la vil","Şehrin altından bir yeraltı nehri akıyor."]]}
{"w":"prodige","t":"isim (eril)","m":"harika; dâhi çocuk","s":["génie","merveille"],"a":[],"e":[["Cet enfant est un prodige.","set anfan e ten prodij","Bu çocuk bir dâhi."],["Le prodige du piano joue à dix ans.","lö prodij dü pyano ju a di zan","Piyano dâhisi on yaşında çalıyor."]]}
{"w":"caféine","t":"isim (dişil)","m":"kafein","s":[],"a":[],"e":[["Le café contient de la caféine.","lö kafe kontyen dö la kafein","Kahve kafein içerir."],["Trop de caféine empêche de dormir.","tro dö kafein anpeş dö dormir","Çok fazla kafein uyumayı engeller."]]}
{"w":"fourniture","t":"isim (dişil)","m":"tedarik; (çoğul) kırtasiye malzemesi","s":["approvisionnement","livraison"],"a":[],"e":[["La fourniture d'électricité est coupée.","la furnitür delektrisite e kupe","Elektrik tedariki kesildi."],["Il achète des fournitures scolaires.","il aşet de furnitür skoler","Okul malzemeleri alıyor."]]}
{"w":"rouillé","t":"sıfat","m":"paslı","s":["oxydé","corrodé"],"a":["neuf","brillant"],"e":[["Le clou est rouillé.","lö klu e ruye","Çivi paslı."],["Mon vélo rouillé grince.","mon velo ruye grens","Paslı bisikletim gıcırdıyor."]]}
{"w":"timbre","t":"isim (eril)","m":"pul; ses tınısı","s":[],"a":[],"e":[["Il colle un timbre sur l'enveloppe.","il kol en tenbr sür lanvlop","Zarfa bir pul yapıştırıyor."],["Le timbre de sa voix est doux.","lö tenbr dö sa vua e du","Sesinin tınısı yumuşak."]]}
{"w":"souple","t":"sıfat","m":"esnek; yumuşak","s":["flexible","élastique"],"a":["raide","rigide"],"e":[["Le tissu est très souple.","lö tisü e tre supl","Kumaş çok esnek."],["Elle est souple et agile.","el e supl e ajil","Esnek ve çevik."]]}
