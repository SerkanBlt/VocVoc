{"w":"abîme","t":"isim (eril)","m":"uçurum; derinlik","s":["gouffre","précipice"],"a":["sommet"],"e":[["Il tombe dans l'abîme.","il tonb dan labim","Uçuruma düşüyor."],["Ce pays est au bord de l'abîme.","sö pei e to bor dö labim","Bu ülke uçurumun kıyısında."]]}
{"w":"fermement","t":"zarf","m":"kararlılıkla; sıkıca","s":["solidement","résolument"],"a":["mollement","faiblement"],"e":[["Il refuse fermement.","il röfüz fermöman","Kesin bir dille reddediyor."],["Elle tient fermement la corde.","el tyen fermöman la kord","İpi sıkıca tutuyor."]]}
{"w":"escroquerie","t":"isim (dişil)","m":"dolandırıcılık","s":["fraude","arnaque"],"a":["honnêteté"],"e":[["Il est accusé d'escroquerie.","il e takuze deskrokri","Dolandırıcılıkla suçlanıyor."],["Cette escroquerie coûte cher aux victimes.","set eskrokri kut şer o viktim","Bu dolandırıcılık kurbanlara pahalıya mal oluyor."]]}
