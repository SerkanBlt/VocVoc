{"w":"négligé","t":"sıfat","m":"özensiz; bakımsız","s":["débraillé","sale"],"a":["soigné","impeccable"],"e":[["Il a un aspect négligé.","il a en naspe neglije","Bakımsız bir görünüşü var."],["Son travail est négligé.","son travay e neglije","İşi özensiz."]]}
{"w":"pendaison","t":"isim (dişil)","m":"asma; asılma","s":[],"a":[],"e":[["Le film montre une pendaison.","lö film montr ün pandezon","Film bir asma sahnesi gösteriyor."],["La pendaison de crémaillère aura lieu samedi.","la pandezon dö kremaye ora lyö samdi","Ev açılış partisi cumartesi yapılacak."]],"x":[["pendaison de crémaillère","pandezon dö kremaye","ev açılış partisi","On fait une pendaison de crémaillère samedi.","on fe ün pandezon dö kremaye samdi","Cumartesi ev açılış partisi yapıyoruz."]]}
{"w":"prudemment","t":"zarf","m":"ihtiyatla; dikkatle","s":["avec précaution","attentivement"],"a":["imprudemment"],"e":[["Il conduit prudemment.","il kondüi prüdaman","Dikkatli sürüyor."],["Elle avance prudemment sur la glace.","el avans prüdaman sür la glas","Buzun üzerinde dikkatle ilerliyor."]]}
{"w":"violemment","t":"zarf","m":"şiddetle","s":["brutalement","fortement"],"a":["doucement","calmement"],"e":[["La porte claque violemment.","la port klak viyolaman","Kapı şiddetle çarpıyor."],["Il frappe violemment la table.","il frap viyolaman la tabl","Masaya şiddetle vuruyor."]]}
