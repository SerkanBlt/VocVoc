{"w":"leurre","t":"isim (eril)","m":"yem; aldatmaca","s":["appât","piège"],"a":["vérité"],"e":[["Le pêcheur utilise un leurre.","lö peşör ütiliz en lör","Balıkçı sahte bir yem kullanıyor."],["Cette offre est un leurre.","set ofr e ten lör","Bu teklif bir aldatmaca."]]}
{"w":"moquette","t":"isim (dişil)","m":"halı kaplama; mokét","s":["tapis"],"a":[],"e":[["La moquette est très douce.","la moket e tre dus","Halı kaplama çok yumuşak."],["Ils posent de la moquette dans la chambre.","il poz dö la moket dan la şanbr","Odaya halı kaplama döşüyorlar."]]}
{"w":"barbare","t":"sıfat","m":"barbar; vahşi","s":["cruel","sauvage"],"a":["civilisé","doux"],"e":[["Cet acte est barbare.","set akt e barbar","Bu eylem barbarca."],["Les barbares attaquent la ville.","le barbar atak la vil","Barbarlar şehre saldırıyor."]]}
{"w":"projecteur","t":"isim (eril)","m":"projektör; spot ışığı","s":["spot","lampe"],"a":[],"e":[["Le projecteur éclaire la scène.","lö projektör ekler la sen","Projektör sahneyi aydınlatıyor."],["Il allume le projecteur du stade.","il alüm lö projektör dü stad","Stadyumun projektörünü yakıyor."]]}
{"w":"ouïe","t":"isim (dişil)","m":"işitme duyusu","s":["audition"],"a":[],"e":[["Il a l'ouïe fine.","il a lui fin","Kulağı çok iyi duyuyor."],["L'ouïe des chauves-souris est excellente.","lui de şov suri e ekselant","Yarasaların işitmesi mükemmel."]]}
