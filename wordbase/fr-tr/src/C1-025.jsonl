{"w":"portion","t":"isim (dişil)","m":"porsiyon; pay","s":["part","ration"],"a":["totalité"],"e":[["Il mange une grande portion de frites.","il manj ün grand porsyon dö frit","Büyük bir porsiyon patates kızartması yiyor."],["Chacun reçoit sa portion.","şaken rösua sa porsyon","Herkes kendi payını alıyor."]]}
{"w":"suspens","t":"isim (eril)","m":"gerilim; belirsizlik","s":["attente","mystère"],"a":[],"e":[["Le film laisse le public en suspens.","lö film les lö püblik an süspan","Film seyirciyi merakta bırakıyor."],["La décision reste en suspens.","la desizyon rest an süspan","Karar askıda kalıyor."]]}
{"w":"réparateur","t":"isim (eril)","m":"tamirci","s":["technicien"],"a":[],"e":[["Le réparateur change la pièce.","lö reparatör şanj la pyes","Tamirci parçayı değiştiriyor."],["Il appelle un réparateur de télévision.","il apel en reparatör dö televizyon","Bir televizyon tamircisi çağırıyor."]]}
{"w":"décolleté","t":"isim (eril)","m":"dekolte","s":[],"a":[],"e":[["Sa robe a un décolleté profond.","sa rob a en dekolte profon","Elbisesinin derin bir dekoltesi var."],["Le décolleté est trop large.","lö dekolte e tro larj","Dekolte çok geniş."]]}
{"w":"piller","t":"fiil","m":"yağmalamak","s":["voler","saccager"],"a":["protéger"],"e":[["Les soldats pillent le village.","le solda piy lö vilaj","Askerler köyü yağmalıyor."],["Des voleurs pillent la maison.","de volör piy la mezon","Hırsızlar evi yağmalıyor."]]}
{"w":"couronnement","t":"isim (eril)","m":"taç giyme; zirve","s":["sacre","apogée"],"a":["destitution"],"e":[["Le couronnement du roi a lieu demain.","lö kuronman dü rua a lyö dömen","Kralın taç giyme töreni yarın."],["Ce prix est le couronnement de sa carrière.","sö pri e lö kuronman dö sa karyer","Bu ödül kariyerinin zirvesi."]]}
{"w":"converti","t":"sıfat","m":"din değiştirmiş; dönüştürülmüş","s":["transformé"],"a":[],"e":[["Il est converti à une autre religion.","il e konverti a ün otr rölijyon","Başka bir dine geçmiş."],["Cette église est convertie en musée.","set egliz e konverti an müze","Bu kilise müzeye dönüştürülmüş."]]}
{"w":"semelle","t":"isim (dişil)","m":"ayakkabı tabanı","s":["talon"],"a":[],"e":[["La semelle de sa chaussure est usée.","la sömel dö sa şosür e tüze","Ayakkabısının tabanı aşınmış."],["Il achète des semelles en cuir.","il aşet de sömel an küir","Deri tabanlar satın alıyor."]]}
{"w":"agricole","t":"sıfat","m":"tarımsal","s":[],"a":[],"e":[["Il travaille dans une exploitation agricole.","il travay dan zün eksploatasyon agrikol","Bir tarım işletmesinde çalışıyor."],["Le matériel agricole coûte cher.","lö materyel agrikol kut şer","Tarım ekipmanı pahalı."]]}
{"w":"théoriquement","t":"zarf","m":"teoride; kuramsal olarak","s":["en principe"],"a":["pratiquement"],"e":[["Théoriquement, c'est possible.","teorikman se posibl","Teoride bu mümkün."],["Il connaît théoriquement le sujet.","il kone teorikman lö süje","Konuyu kuramsal olarak biliyor."]]}
{"w":"imperméable","t":"isim (eril)","m":"yağmurluk","s":["ciré"],"a":[],"e":[["Il met son imperméable sous la pluie.","il me son enpermeabl su la plüi","Yağmurda yağmurluğunu giyiyor."],["L'imperméable est trempé.","lenpermeabl e tranpe","Yağmurluk sırılsıklam."]]}
{"w":"traducteur","t":"isim (eril)","m":"çevirmen","s":["interprète"],"a":[],"e":[["Le traducteur travaille sur un roman.","lö tradüktör travay sür en roman","Çevirmen bir roman üzerinde çalışıyor."],["Elle cherche un traducteur turc.","el şerş en tradüktör türk","Bir Türk çevirmen arıyor."]]}
{"w":"fumeur","t":"isim (eril)","m":"sigara içen kişi","s":[],"a":["non-fumeur"],"e":[["Le fumeur allume une cigarette.","lö fümör alüm ün sigaret","Sigara içen kişi bir sigara yakıyor."],["La section fumeurs est fermée.","la seksyon fümör e ferme","Sigara içilen bölüm kapalı."]]}
{"w":"jardinage","t":"isim (eril)","m":"bahçıvanlık","s":[],"a":[],"e":[["Il aime le jardinage.","il em lö jardinaj","Bahçıvanlığı seviyor."],["Le jardinage détend après le travail.","lö jardinaj detan apre lö travay","Bahçıvanlık işten sonra rahatlatır."]]}
{"w":"lâcheté","t":"isim (dişil)","m":"korkaklık","s":["couardise","faiblesse"],"a":["courage","bravoure"],"e":[["Il fuit par lâcheté.","il füi par laşte","Korkaklıktan kaçıyor."],["Sa lâcheté déçoit ses amis.","sa laşte desua se zami","Korkaklığı arkadaşlarını hayal kırıklığına uğratıyor."]]}
{"w":"matricule","t":"isim (eril)","m":"sicil numarası","s":["numéro"],"a":[],"e":[["Le soldat donne son matricule.","lö solda don son matrikül","Asker sicil numarasını veriyor."],["Le matricule est écrit sur la carte.","lö matrikül e tekri sür la kart","Sicil numarası kartın üzerinde yazılı."]]}
{"w":"rhétorique","t":"isim (dişil)","m":"retorik; belagat","s":["éloquence","art oratoire"],"a":[],"e":[["Il maîtrise l'art de la rhétorique.","il metriz lar dö la retorik","Retorik sanatında ustalaşmış."],["Son discours est plein de rhétorique.","son diskur e plen dö la retorik","Konuşması retorikle dolu."]]}
{"w":"martyre","t":"isim (eril)","m":"şehitlik; büyük acı","s":["supplice","épreuve"],"a":[],"e":[["Il subit le martyre pour sa foi.","il sübi lö martir pur sa fua","İnancı uğruna şehitlik çekiyor."],["Cette attente est un martyre.","set atant e ten martir","Bu bekleyiş çile."]]}
{"w":"brésilien","t":"sıfat","m":"Brezilyalı","s":[],"a":[],"e":[["Il joue au football brésilien.","il ju o futbol brezilyen","Brezilya futbolu oynuyor."],["La musique brésilienne est joyeuse.","la müzik brezilyen e juayöz","Brezilya müziği neşeli."]]}
{"w":"suer","t":"fiil","m":"terlemek","s":["transpirer"],"a":[],"e":[["Il sue après la course.","il sü apre la kurs","Koşudan sonra terliyor."],["Elle sue à grosses gouttes.","el sü a gros gut","İri damlalar halinde terliyor."]]}
{"w":"funéraire","t":"sıfat","m":"cenazeyle ilgili","s":[],"a":[],"e":[["Ils choisissent un monument funéraire.","il şuazis en monüman fünerer","Bir mezar anıtı seçiyorlar."],["Il travaille dans une entreprise funéraire.","il travay dan zün antröpriz fünerer","Bir cenaze hizmetleri şirketinde çalışıyor."]]}
{"w":"grignoter","t":"fiil","m":"kemirmek; atıştırmak","s":["manger","mordiller"],"a":[],"e":[["Il grignote des biscuits devant la télé.","il grinyot de biskui dövan la tele","Televizyon karşısında bisküvi atıştırıyor."],["La souris grignote le fromage.","la suri grinyot lö fromaj","Fare peyniri kemiriyor."]]}
{"w":"girafe","t":"isim (dişil)","m":"zürafa","s":[],"a":[],"e":[["La girafe mange les feuilles hautes.","la jiraf manj le föy ot","Zürafa yüksekteki yaprakları yiyor."],["Un enfant regarde la girafe.","en nanfan rögard la jiraf","Bir çocuk zürafaya bakıyor."]]}
{"w":"inaccessible","t":"sıfat","m":"ulaşılmaz","s":["hors d'atteinte","isolé"],"a":["accessible"],"e":[["Le sommet est inaccessible en hiver.","lö some e tinaksesibl an niver","Zirveye kışın ulaşılamıyor."],["Ce village reste inaccessible.","sö vilaj rest inaksesibl","Bu köye ulaşılamıyor."]]}
{"w":"bombarder","t":"fiil","m":"bombalamak","s":["attaquer","pilonner"],"a":[],"e":[["L'avion bombarde la ville.","lavyon bonbard la vil","Uçak şehri bombalıyor."],["Ils bombardent le pont.","il bonbard lö pon","Köprüyü bombalıyorlar."]]}
{"w":"soprano","t":"isim (dişil)","m":"soprano","s":[],"a":[],"e":[["La soprano chante un air d'opéra.","la soprano şant en ner dopera","Soprano bir opera aryası söylüyor."],["Cette soprano a une voix puissante.","set soprano a ün vua püisant","Bu sopranonun güçlü bir sesi var."]]}
{"w":"belge","t":"sıfat","m":"Belçikalı","s":[],"a":[],"e":[["Il boit une bière belge.","il bua ün byer belj","Belçika birası içiyor."],["Le chocolat belge est célèbre.","lö şokola belj e selebr","Belçika çikolatası ünlüdür."]]}
{"w":"tondeuse","t":"isim (dişil)","m":"çim biçme makinesi","s":[],"a":[],"e":[["Il passe la tondeuse sur la pelouse.","il pas la tondöz sür la pölüz","Çimenlerin üzerinden çim biçme makinesini geçiriyor."],["La tondeuse fait du bruit.","la tondöz fe dü brüi","Çim biçme makinesi gürültü yapıyor."]]}
{"w":"basique","t":"sıfat","m":"temel; basit","s":["élémentaire","simple"],"a":["complexe","sophistiqué"],"e":[["C'est un modèle très basique.","se ten model tre bazik","Bu çok basit bir model."],["Il apprend les règles basiques.","il aprand le regl bazik","Temel kuralları öğreniyor."]]}
{"w":"inimaginable","t":"sıfat","m":"hayal edilemez","s":["inconcevable","incroyable"],"a":["probable"],"e":[["C'est un exploit inimaginable.","se ten neksplua inimajinabl","Bu hayal edilemez bir başarı."],["Une telle chose est inimaginable.","ün tel şoz e tinimajinabl","Böyle bir şey hayal edilemez."]]}
{"w":"neurone","t":"isim (eril)","m":"nöron","s":[],"a":[],"e":[["Le cerveau contient des milliards de neurones.","lö serveo kontyen de milyar dö nöron","Beyin milyarlarca nöron içerir."],["Un neurone envoie un signal.","en nöron anvua en sinyal","Bir nöron sinyal gönderiyor."]]}
{"w":"container","t":"isim (eril)","m":"konteyner","s":["conteneur"],"a":[],"e":[["Le container arrive au port.","lö kontenör ariv o por","Konteyner limana varıyor."],["Il loue un container pour le stockage.","il lu en kontenör pur lö stokaj","Depolamak için bir konteyner kiralıyor."]]}
{"w":"détaillé","t":"sıfat","m":"ayrıntılı","s":["précis","complet"],"a":["sommaire","vague"],"e":[["Il fait un rapport détaillé.","il fe en rapor detaye","Ayrıntılı bir rapor hazırlıyor."],["La description est très détaillée.","la deskripsyon e tre detaye","Tarif çok ayrıntılı."]]}
{"w":"détection","t":"isim (dişil)","m":"tespit","s":["repérage","découverte"],"a":[],"e":[["La détection du problème est rapide.","la deteksyon dü problem e rapid","Sorunun tespiti hızlı."],["Le radar assure la détection des avions.","lö radar asür la deteksyon de zavyon","Radar uçakların tespitini sağlıyor."]]}
{"w":"moralement","t":"zarf","m":"ahlaken; manen","s":[],"a":["physiquement"],"e":[["Il se sent moralement obligé d'aider.","il sö san moralman oblije dede","Ahlaken yardım etmek zorunda hissediyor."],["Elle soutient son ami moralement.","el sutyen son nami moralman","Arkadaşını manen destekliyor."]]}
{"w":"détonation","t":"isim (dişil)","m":"patlama sesi","s":["explosion","bruit"],"a":[],"e":[["On entend une détonation dans la nuit.","on natan ün detonasyon dan la nüi","Gecenin içinde bir patlama sesi duyuluyor."],["La détonation réveille tout le quartier.","la detonasyon revey tu lö kartye","Patlama sesi bütün mahalleyi uyandırıyor."]]}
{"w":"millimètre","t":"isim (eril)","m":"milimetre","s":[],"a":[],"e":[["La pluie atteint dix millimètres.","la plüi atent di milimetr","Yağmur on milimetreye ulaşıyor."],["Ce fil mesure un millimètre.","sö fil mözür en milimetr","Bu telin kalınlığı bir milimetre."]]}
{"w":"puéril","t":"sıfat","m":"çocukça","s":["enfantin","naïf"],"a":["mûr","sérieux"],"e":[["C'est une réaction puérile.","se tün reaksyon püeril","Bu çocukça bir tepki."],["Son comportement est puéril.","son konportman e püeril","Davranışı çocukça."]]}
{"w":"lavande","t":"isim (dişil)","m":"lavanta","s":[],"a":[],"e":[["Le champ de lavande sent bon.","lö şan dö lavand san bon","Lavanta tarlası güzel kokuyor."],["Elle met de la lavande dans l'armoire.","el me dö la lavand dan larmuar","Dolaba lavanta koyuyor."]]}
{"w":"lunatique","t":"sıfat","m":"değişken huylu","s":["changeant","capricieux"],"a":["stable","égal"],"e":[["Il est lunatique ce matin.","il e lünatik sö maten","Bu sabah huysuz."],["Un chef lunatique fatigue l'équipe.","en şef lünatik fatig lekip","Değişken huylu bir şef ekibi yoruyor."]]}
{"w":"receveur","t":"isim (eril)","m":"alıcı; alan kişi; vezne memuru","s":["bénéficiaire"],"a":["donneur"],"e":[["Le receveur du rein attend la greffe.","lö rösövör dü ren atan la gref","Böbrek alıcısı nakli bekliyor."],["Le receveur contrôle les billets.","lö rösövör kontrol le biye","Vezne memuru biletleri kontrol ediyor."]]}
{"w":"lièvre","t":"isim (eril)","m":"yaban tavşanı","s":[],"a":[],"e":[["Le lièvre court plus vite que le lapin.","lö lyevr kur plü vit kö lö lapen","Yaban tavşanı evcil tavşandan hızlı koşar."],["Le chasseur poursuit un lièvre.","lö şasör pursüi en lyevr","Avcı bir yaban tavşanını kovalıyor."]]}
{"w":"calcium","t":"isim (eril)","m":"kalsiyum","s":[],"a":[],"e":[["Le lait contient du calcium.","lö le kontyen dü kalsyom","Süt kalsiyum içerir."],["Le calcium renforce les os.","lö kalsyom ranfors le zo","Kalsiyum kemikleri güçlendirir."]]}
{"w":"lotion","t":"isim (dişil)","m":"losyon","s":["crème"],"a":[],"e":[["Il applique une lotion sur son visage.","il aplik ün losyon sür son vizaj","Yüzüne bir losyon sürüyor."],["Cette lotion adoucit la peau.","set losyon adus la po","Bu losyon cildi yumuşatıyor."]]}
{"w":"lys","t":"isim (eril)","m":"zambak","s":[],"a":[],"e":[["Le lys est une fleur blanche.","lö lis e tün flör blanş","Zambak beyaz bir çiçektir."],["Elle offre un bouquet de lys.","el ofr en buke dö lis","Bir demet zambak hediye ediyor."]]}
{"w":"rebondir","t":"fiil","m":"sekmek; yeniden canlanmak","s":["sauter","repartir"],"a":["s'écraser"],"e":[["La balle rebondit sur le mur.","la bal röbondi sür lö mür","Top duvardan sekiyor."],["L'économie rebondit après la crise.","lekonomi röbondi apre la kriz","Ekonomi krizden sonra toparlanıyor."]]}
{"w":"purger","t":"fiil","m":"temizlemek; cezasını çekmek","s":["vider","nettoyer"],"a":[],"e":[["Il purge le radiateur.","il pürj lö radyatör","Radyatörün havasını alıyor."],["Le condamné purge sa peine.","lö kondane pürj sa pen","Hükümlü cezasını çekiyor."]]}
{"w":"pensionnat","t":"isim (eril)","m":"yatılı okul","s":["internat"],"a":[],"e":[["Elle vit au pensionnat toute l'année.","el viv o pansyona tut lane","Bütün yıl yatılı okulda kalıyor."],["Le pensionnat accueille cent élèves.","lö pansyona akoy san zelev","Yatılı okul yüz öğrenci kabul ediyor."]]}
{"w":"génocide","t":"isim (eril)","m":"soykırım","s":["massacre"],"a":[],"e":[["Le monde condamne le génocide.","lö mond kondan lö jenosid","Dünya soykırımı kınıyor."],["Les survivants du génocide témoignent.","le sürvivan dü jenosid temuany","Soykırımdan sağ kalanlar tanıklık ediyor."]]}
{"w":"affaiblir","t":"fiil","m":"zayıflatmak","s":["fragiliser","diminuer"],"a":["renforcer","fortifier"],"e":[["La maladie affaiblit son corps.","la maladi afebli son kor","Hastalık vücudunu zayıflatıyor."],["Cette crise affaiblit le gouvernement.","set kriz afebli lö guvernömen","Bu kriz hükümeti zayıflatıyor."]]}
