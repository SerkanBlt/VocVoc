{"w":"analgésique","t":"isim (eril)","m":"ağrı kesici","s":["antidouleur","calmant"],"a":[],"e":[["Le médecin prescrit un analgésique.","lö medsen preskri en nanaljezik","Doktor bir ağrı kesici yazıyor."],["Il prend un analgésique pour son dos.","il pran en nanaljezik pur son do","Sırtı için bir ağrı kesici alıyor."]]}
{"w":"mûrir","t":"fiil","m":"olgunlaşmak; olmak (meyve, fikir)","s":["se développer","s'épanouir"],"a":["verdir"],"e":[["Les fruits mûrissent au soleil.","le früi mürüs o solay","Meyveler güneşte olgunlaşıyor."],["Cette idée mûrit dans sa tête.","set ide mürir dan sa tet","Bu fikir kafasında olgunlaşıyor."]]}
{"w":"camaraderie","t":"isim (dişil)","m":"arkadaşlık; dostluk bağı","s":["amitié","solidarité"],"a":["rivalité"],"e":[["Une grande camaraderie règne dans l'équipe.","ün gran kamaradri reny dan lekip","Takımda büyük bir arkadaşlık hâkim."],["Il apprécie la camaraderie des soldats.","il apresye la kamaradri de solda","Askerlerin arkadaşlığını takdir ediyor."]]}
{"w":"rattrapage","t":"isim (eril)","m":"telafi; yetiştirme","s":["récupération"],"a":[],"e":[["Il suit un cours de rattrapage.","il süi en kur dö ratrapaj","Telafi dersi alıyor."],["La session de rattrapage a lieu en septembre.","la sesyon dö ratrapaj a lyö an septanbr","Bütünleme oturumu eylülde yapılıyor."]]}
{"w":"mythique","t":"sıfat","m":"efsanevi","s":["légendaire","fabuleux"],"a":["réel"],"e":[["Le Titanic est un bateau mythique.","lö titanik e ten bato mitik","Titanik efsanevi bir gemidir."],["Ce stade mythique accueille la finale.","sö stad mitik aköy la final","Bu efsanevi stadyum finale ev sahipliği yapıyor."]]}
{"w":"lithium","t":"isim (eril)","m":"lityum","s":[],"a":[],"e":[["Cette pile contient du lithium.","set pil kontyen dü litiyom","Bu pil lityum içeriyor."],["Le lithium est un métal léger.","lö litiyom e ten metal leje","Lityum hafif bir metaldir."]]}
{"w":"céramique","t":"isim (dişil)","m":"seramik","s":["faïence","porcelaine"],"a":[],"e":[["Elle fabrique des bols en céramique.","el fabrik de bol an seramik","Seramikten kaseler yapıyor."],["La céramique résiste à la chaleur.","la seramik rezist a la şalör","Seramik sıcağa dayanıklıdır."]]}
{"w":"carrure","t":"isim (dişil)","m":"omuz genişliği; yapı; kişilik gücü","s":["stature","envergure"],"a":[],"e":[["Ce joueur a une belle carrure.","sö juör a ün bel karür","Bu oyuncunun omuzları geniş, yapılı."],["Il a la carrure d'un chef.","il a la karür den şef","Bir lidere yakışır bir duruşu var."]]}
{"w":"disculper","t":"fiil","m":"aklamak","s":["innocenter","blanchir"],"a":["accuser","incriminer"],"e":[["Les preuves disculpent l'accusé.","le pröv diskülp lakuze","Deliller sanığı aklıyor."],["Elle cherche à se disculper.","el şerş a sö diskülpe","Kendini aklamaya çalışıyor."]]}
{"w":"déshydratation","t":"isim (dişil)","m":"susuzluk; vücutta su kaybı","s":[],"a":["hydratation"],"e":[["La déshydratation menace les randonneurs.","la dezidratasyon menas le randonör","Susuzluk yürüyüşçüleri tehdit ediyor."],["Boire évite la déshydratation.","buar evit la dezidratasyon","Su içmek susuz kalmayı önler."]]}
{"w":"rôdeur","t":"isim (eril)","m":"ortalıkta dolaşan şüpheli kişi","s":["vagabond"],"a":[],"e":[["Un rôdeur observe la maison.","en rodör opserv la mezon","Şüpheli biri evi gözlüyor."],["Les voisins ont vu un rôdeur.","le vuazen zon vü en rodör","Komşular ortalıkta dolaşan birini görmüş."]]}
{"w":"décréter","t":"fiil","m":"kararname ile ilan etmek; kesin olarak karar vermek","s":["ordonner","proclamer"],"a":["abolir"],"e":[["Le gouvernement décrète l'état d'urgence.","lö guvernömman dekret leta dürjans","Hükümet olağanüstü hâl ilan ediyor."],["Il décrète que tout est fini.","il dekret kö tu te fini","Her şeyin bittiğine karar veriyor."]]}
{"w":"incantation","t":"isim (dişil)","m":"büyü sözü; ruhani formül","s":["formule magique","sortilège"],"a":[],"e":[["Le sorcier murmure une incantation.","lö sorsye mürmür ün enkantasyon","Büyücü bir büyü sözü mırıldanıyor."],["Elle récite l'incantation à voix basse.","el resit lenkantasyon a vua bas","Büyü sözünü alçak sesle okuyor."]]}
{"w":"bouffon","t":"isim (eril)","m":"soytarı; maskara","s":["clown","fou du roi"],"a":[],"e":[["Le bouffon amuse le roi.","lö bufon amüz lö rua","Soytarı kralı eğlendiriyor."],["Il joue le bouffon à chaque fête.","il ju lö bufon a şak fet","Her partide maskaralık yapıyor."]]}
{"w":"froisser","t":"fiil","m":"buruşturmak; gönlünü kırmak","s":["chiffonner","vexer"],"a":["lisser","flatter"],"e":[["Elle froisse la lettre dans sa main.","el fruas la letr dan sa men","Mektubu elinde buruşturuyor."],["Sa remarque a froissé mon père.","sa römark a fruase mon per","Sözü babamın gönlünü kırdı."]]}
{"w":"orchestrer","t":"fiil","m":"düzenlemek; yönetmek (perde arkasından)","s":["organiser","diriger"],"a":[],"e":[["Il orchestre toute l'opération.","il orkestr tut loperasyon","Bütün operasyonu o yönetiyor."],["Le parti orchestre une campagne.","lö parti orkestr ün kampany","Parti bir kampanya düzenliyor."]]}
{"w":"soupirant","t":"isim (eril)","m":"hayran; talip","s":["prétendant","amoureux"],"a":[],"e":[["Elle a un soupirant discret.","el a en supiran diskre","Sessiz bir hayranı var."],["Le soupirant offre des roses.","lö supiran ofr de roz","Talip güller sunuyor."]]}
{"w":"cynisme","t":"isim (eril)","m":"alaycı kayıtsızlık; küstahlık","s":["impudence","dérision"],"a":["sincérité"],"e":[["Son cynisme choque ses collègues.","son sinism şok se koleg","Alaycı tavrı iş arkadaşlarını şoke ediyor."],["Il parle avec cynisme de la mort.","il parl avek sinism dö la mor","Ölümden alaycı bir kayıtsızlıkla söz ediyor."]]}
{"w":"gravir","t":"fiil","m":"tırmanmak","s":["escalader","monter"],"a":["descendre"],"e":[["Ils gravissent la montagne en trois heures.","il gravis la montany an trua zör","Dağa üç saatte tırmanıyorlar."],["Elle gravit les marches lentement.","el gravi le marş lantman","Basamakları yavaşça çıkıyor."]],"x":[["gravir les échelons","gravir le zeşelon","kariyerde basamak basamak yükselmek","Il gravit les échelons de l'entreprise.","il gravi le zeşelon dö lantröpriz","Şirkette basamak basamak yükseliyor."]]}
{"w":"allocation","t":"isim (dişil)","m":"yardım ödeneği; tahsis","s":["aide","indemnité"],"a":[],"e":[["Elle reçoit une allocation familiale.","el rösua ün alokasyon familyal","Aile yardımı alıyor."],["L'allocation chômage dure deux ans.","lalokasyon şomaj dür dö zan","İşsizlik ödeneği iki yıl sürüyor."]]}
{"w":"tunique","t":"isim (dişil)","m":"tunik; uzun gömlek","s":[],"a":[],"e":[["Elle porte une tunique blanche.","el port ün tünik blanş","Beyaz bir tunik giyiyor."],["Le soldat romain porte une tunique rouge.","lö solda roman port ün tünik ruj","Romalı asker kırmızı bir tunik giyiyor."]]}
{"w":"poivron","t":"isim (eril)","m":"dolmalık biber","s":[],"a":[],"e":[["Je coupe un poivron rouge.","jö kup en puavron ruj","Bir kırmızı biberi doğruyorum."],["Le poivron vert est amer.","lö puavron ver e tamer","Yeşil biber acıdır."]]}
{"w":"raclure","t":"isim (dişil)","m":"kazıntı; (hakaret) alçak","s":["déchet","ordure"],"a":[],"e":[["Les raclures de bois jonchent le sol.","le raklür dö bua jonş lö sol","Ahşap kazıntıları yere dökülmüş."],["Il traite son voisin de raclure.","il tret son vuazen dö raklür","Komşusuna alçak diyor."]]}
{"w":"extravagant","t":"sıfat","m":"aşırı; gösterişli; garip","s":["excentrique","farfelu"],"a":["sobre","raisonnable"],"e":[["Elle porte un chapeau extravagant.","el port en şapo ekstravagan","Aşırı gösterişli bir şapka takıyor."],["Ses dépenses extravagantes inquiètent sa famille.","se depans ekstravagant enkyet sa famiy","Aşırı harcamaları ailesini endişelendiriyor."]]}
{"w":"insouciant","t":"sıfat","m":"kaygısız","s":["insoucieux","décontracté"],"a":["soucieux","anxieux"],"e":[["Les enfants sont insouciants.","le zanfan son tensusyan","Çocuklar kaygısız."],["Il mène une vie insouciante.","il men ün vi ensusyant","Kaygısız bir hayat sürüyor."]]}
{"w":"incorrigible","t":"sıfat","m":"ıslah olmaz","s":["indécrottable","impénitent"],"a":["docile"],"e":[["Ce garçon est incorrigible.","sö garson e tenkorijibl","Bu çocuk ıslah olmaz."],["C'est un menteur incorrigible.","se ten mantör enkorijibl","O ıslah olmaz bir yalancı."]]}
{"w":"dispersion","t":"isim (dişil)","m":"dağılma; saçılma","s":["éparpillement"],"a":["concentration","rassemblement"],"e":[["La dispersion des graines se fait par le vent.","la dispersyon de gren sö fe par lö van","Tohumların yayılması rüzgârla olur."],["La police ordonne la dispersion de la foule.","la polis ordon la dispersyon dö la ful","Polis kalabalığın dağılmasını emrediyor."]]}
{"w":"bordure","t":"isim (dişil)","m":"kenar; şerit","s":["bord","lisière"],"a":["centre"],"e":[["Une bordure de fleurs entoure le jardin.","ün bordür dö flör antur lö jarden","Bir çiçek şeridi bahçeyi çevreliyor."],["La maison est en bordure de forêt.","la mezon e tan bordür dö fore","Ev ormanın kenarında."]],"x":[["en bordure de","an bordür dö","kenarında","Elle habite en bordure de la ville.","el abit an bordür dö la vil","Şehrin kenarında oturuyor."]]}
{"w":"incitation","t":"isim (dişil)","m":"teşvik; kışkırtma","s":["encouragement","provocation"],"a":["dissuasion"],"e":[["L'incitation à la haine est interdite.","lensitasyon a la en e tenterdit","Nefreti körüklemek yasaktır."],["Le gouvernement propose une incitation fiscale.","lö guvernömman propoz ün ensitasyon fiskal","Hükümet bir vergi teşviki öneriyor."]]}
{"w":"lavement","t":"isim (eril)","m":"lavman","s":[],"a":[],"e":[["Le médecin prescrit un lavement.","lö medsen preskri en lavman","Doktor lavman yazıyor."],["Le lavement soulage la constipation.","lö lavman sulaj la konstipasyon","Lavman kabızlığı hafifletir."]]}
{"w":"pompeux","t":"sıfat","m":"şatafatlı; abartılı","s":["emphatique","grandiloquent"],"a":["simple","sobre"],"e":[["Il fait un discours pompeux.","il fe en diskur ponpö","Şatafatlı bir konuşma yapıyor."],["Ce style pompeux m'ennuie.","sö stil ponpö manüi","Bu abartılı üslup beni sıkıyor."]]}
{"w":"alentour","t":"zarf","m":"çevrede; etrafta","s":["autour","aux environs"],"a":[],"e":[["Il n'y a personne alentour.","il ni ya person alantur","Çevrede kimse yok."],["Les champs alentour sont verts.","le şan alantur son ver","Çevredeki tarlalar yeşil."]]}
{"w":"dérailler","t":"fiil","m":"raydan çıkmak; saçmalamak","s":["divaguer","délirer"],"a":[],"e":[["Le train déraille près de la gare.","lö tren deray pre dö la gar","Tren garın yakınında raydan çıkıyor."],["Il commence à dérailler.","il komans a deraye","Saçmalamaya başlıyor."]]}
{"w":"étroitement","t":"zarf","m":"sıkı sıkıya; yakından","s":["intimement","strictement"],"a":["lâchement","vaguement"],"e":[["Ils collaborent étroitement.","il kolabor etruatman","Yakın iş birliği yapıyorlar."],["Les deux affaires sont étroitement liées.","le dö zafer son tetruatman liye","İki olay sıkı sıkıya bağlantılı."]]}
{"w":"perspicacité","t":"isim (dişil)","m":"kavrayış; sezgi gücü","s":["clairvoyance","finesse"],"a":["naïveté"],"e":[["Sa perspicacité surprend ses collègues.","sa perspikasite sürpran se koleg","Kavrayışı iş arkadaşlarını şaşırtıyor."],["Il analyse avec perspicacité.","il analiz avek perspikasite","Keskin bir sezgiyle analiz ediyor."]]}
{"w":"chômeur","t":"isim (eril)","m":"işsiz","s":["demandeur d'emploi"],"a":["travailleur","salarié"],"e":[["Le nombre de chômeurs augmente.","lö nonbr dö şomör ogmant","İşsiz sayısı artıyor."],["Ce chômeur cherche du travail.","sö şomör şerş dü travay","Bu işsiz iş arıyor."]]}
{"w":"piston","t":"isim (eril)","m":"piston; torpil","s":["coup de pouce","protection"],"a":[],"e":[["Le piston monte et descend dans le cylindre.","lö piston mont e desan dan lö silendr","Piston silindirin içinde inip çıkıyor."],["Il a eu le poste grâce à un piston.","il a ü lö post gras a en piston","İşi bir torpil sayesinde aldı."]],"x":[["avoir du piston","avuar dü piston","torpili olmak","Il a du piston au ministère.","il a dü piston o minister","Bakanlıkta torpili var."]]}
{"w":"brousse","t":"isim (dişil)","m":"çalılık; savan","s":["savane","maquis"],"a":["ville"],"e":[["Le guide connaît la brousse africaine.","lö gid kone la brus afriken","Rehber Afrika çalılıklarını biliyor."],["Ils vivent dans la brousse.","il viv dan la brus","Çalılık bölgede yaşıyorlar."]]}
{"w":"phéromone","t":"isim (dişil)","m":"feromon","s":[],"a":[],"e":[["Les insectes émettent des phéromones.","le zensekt emet de feromon","Böcekler feromon salgılar."],["Cette phéromone attire les mâles.","set feromon atir le mal","Bu feromon erkekleri çekiyor."]]}
{"w":"toxicomane","t":"isim (eril)","m":"uyuşturucu bağımlısı","s":["drogué"],"a":[],"e":[["Le toxicomane suit une cure.","lö toksikoman süi ün kür","Uyuşturucu bağımlısı bir tedavi görüyor."],["Elle aide les toxicomanes.","el ed le toksikoman","Uyuşturucu bağımlılarına yardım ediyor."]]}
{"w":"disciplinaire","t":"sıfat","m":"disiplin ile ilgili","s":["punitif"],"a":[],"e":[["Il reçoit une sanction disciplinaire.","il rösua ün sanksyon disiplinner","Disiplin cezası alıyor."],["Le conseil disciplinaire se réunit.","lö konsey disiplinner sö reüni","Disiplin kurulu toplanıyor."]]}
{"w":"scierie","t":"isim (dişil)","m":"kereste fabrikası","s":[],"a":[],"e":[["Mon oncle travaille dans une scierie.","mon onkl travay dan zün siri","Amcam bir kereste fabrikasında çalışıyor."],["La scierie coupe les troncs.","la siri kup le tron","Kereste fabrikası kütükleri kesiyor."]]}
{"w":"ascendant","t":"isim (eril)","m":"üstünlük; etki; ata","s":["emprise","influence"],"a":["descendant"],"e":[["Il a un ascendant sur son frère.","il a en nasandan sür son frer","Kardeşi üzerinde etkisi var."],["Elle a de l'ascendant sur lui.","el a dö lasandan sür lüi","Onun üzerinde üstünlüğü var."]],"x":[["prendre l'ascendant","prandr lasandan","üstünlük kurmak","Il prend l'ascendant sur ses rivaux.","il pran lasandan sür se rivo","Rakipleri üzerinde üstünlük kuruyor."]]}
{"w":"resserrer","t":"fiil","m":"sıkılaştırmak; daraltmak","s":["serrer","renforcer"],"a":["desserrer","relâcher"],"e":[["Il resserre sa cravate.","il röser sa kravat","Kravatını sıkılaştırıyor."],["Les deux pays resserrent leurs liens.","le dö pey röser lör lyen","İki ülke bağlarını sıkılaştırıyor."]]}
{"w":"coccinelle","t":"isim (dişil)","m":"uğur böceği","s":[],"a":[],"e":[["Une coccinelle se pose sur ma main.","ün koksinel sö poz sür ma men","Bir uğur böceği elime konuyor."],["La coccinelle mange les pucerons.","la koksinel manj le püsron","Uğur böceği yaprak bitlerini yer."]]}
{"w":"babouin","t":"isim (eril)","m":"babun","s":[],"a":[],"e":[["Le babouin vit en groupe.","lö babuen vi tan grup","Babun grup halinde yaşar."],["Un babouin vole la nourriture.","en babuen vol la nuritür","Bir babun yiyecekleri çalıyor."]]}
{"w":"insinuation","t":"isim (dişil)","m":"ima; dolaylı suçlama","s":["allusion","sous-entendu"],"a":["franchise"],"e":[["Je n'aime pas ses insinuations.","jö nem pa se zensinüasyon","İmalarından hoşlanmıyorum."],["Cette insinuation est blessante.","set ensinüasyon e blesant","Bu ima incitici."]]}
{"w":"flatterie","t":"isim (dişil)","m":"dalkavukluk; pohpohlama","s":["compliment","courbette"],"a":["critique","franchise"],"e":[["Elle ne résiste pas à la flatterie.","el nö rezist pa a la flatri","Pohpohlanmaya dayanamıyor."],["Sa flatterie cache une demande.","sa flatri kaş ün dömand","Dalkavukluğunun ardında bir istek var."]]}
{"w":"procession","t":"isim (dişil)","m":"alay; geçit töreni","s":["cortège","défilé"],"a":[],"e":[["La procession traverse le village.","la prosesyon traver lö vilaj","Alay köyü geçiyor."],["Une longue procession suit le cercueil.","ün long prosesyon süi lö serköy","Uzun bir alay tabutu izliyor."]]}
{"w":"insécurité","t":"isim (dişil)","m":"güvensizlik","s":["danger","précarité"],"a":["sécurité"],"e":[["L'insécurité dans ce quartier inquiète.","lensekürite dan sö kartye enkyet","Bu mahallede güvensizlik endişe yaratıyor."],["Le sentiment d'insécurité grandit.","lö santiman densekürite grandi","Güvensizlik duygusu büyüyor."]]}
