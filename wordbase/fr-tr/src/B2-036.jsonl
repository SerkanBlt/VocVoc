{"w":"stockage","t":"isim (eril)","m":"depolama","s":["entreposage","rangement"],"a":["déstockage"],"e":[["Le stockage des données coûte cher.","lö stokaj de done kut şer","Verilerin depolanması pahalı."],["Ils manquent de place de stockage.","il mank dö plas dö stokaj","Depolama alanları yetersiz."]]}
{"w":"battement","t":"isim (eril)","m":"vuruş; atış","s":["pulsation","rythme"],"a":[],"e":[["On entend le battement du cœur.","on natan lö batman dü kör","Kalp atışı duyuluyor."],["Le battement des ailes est rapide.","lö batman de zel e rapid","Kanat çırpışı hızlı."]]}
{"w":"choquant","t":"sıfat","m":"şok edici","s":["scandaleux","indécent"],"a":["acceptable","agréable"],"e":[["Cette image est choquante.","set imaj e şokant","Bu görüntü şok edici."],["Ses propos sont choquants.","se propo son şokant","Sözleri şok edici."]]}
{"w":"supplément","t":"isim (eril)","m":"ek; ilave ücret","s":["extra","complément"],"a":["réduction"],"e":[["Il paie un supplément pour le bagage.","il pe en süpleman pur lö bagaj","Bagaj için ek ücret ödüyor."],["Ce supplément coûte dix euros.","sö süpleman kut di zöro","Bu ek ücret on avro."]]}
{"w":"ampleur","t":"isim (dişil)","m":"boyut; genişlik","s":["étendue","importance"],"a":[],"e":[["L'ampleur des dégâts est grande.","lanplör de dega e grand","Hasarın boyutu büyük."],["Le projet prend de l'ampleur.","lö proje pran dö lanplör","Proje büyüyor."]]}
{"w":"précipiter","t":"fiil","m":"aceleye getirmek; fırlatmak","s":["hâter","jeter"],"a":["retarder","ralentir"],"e":[["Il se précipite vers la porte.","il sö presipit ver la port","Kapıya doğru atılıyor."],["Ne précipite pas la décision.","nö presipit pa la desizyon","Kararı aceleye getirme."]]}
{"w":"savant","t":"isim (eril)","m":"bilgin; âlim","s":["scientifique","érudit"],"a":["ignorant"],"e":[["Le savant publie ses recherches.","lö savan pübli se röşerş","Bilgin araştırmalarını yayımlıyor."],["Ce savant découvre un nouveau médicament.","sö savan dekuvr en nuvo medikaman","Bu bilgin yeni bir ilaç keşfediyor."]]}
{"w":"prédateur","t":"isim (eril)","m":"yırtıcı hayvan; avcı","s":[],"a":["proie"],"e":[["Le lion est un grand prédateur.","lö lyon e ten gran predatör","Aslan büyük bir yırtıcıdır."],["Le prédateur suit sa proie.","lö predatör süiv sa prua","Yırtıcı avını izliyor."]]}
{"w":"interdire","t":"fiil","m":"yasaklamak","s":["défendre","prohiber"],"a":["autoriser","permettre"],"e":[["La loi interdit de fumer ici.","la lua enterdi dö füme isi","Yasa burada sigara içmeyi yasaklıyor."],["Ils interdisent l'accès au parc.","il enterdiz lakse o park","Parka girişi yasaklıyorlar."]]}
{"w":"imitation","t":"isim (dişil)","m":"taklit","s":["copie","reproduction"],"a":["original","création"],"e":[["Ce sac est une imitation.","sö sak e tün imitasyon","Bu çanta bir taklit."],["Il fait une imitation de son prof.","il fe tün imitasyon dö son prof","Öğretmeninin taklidini yapıyor."]]}
{"w":"antique","t":"sıfat","m":"antik; eski","s":["ancien","vieux"],"a":["moderne","récent"],"e":[["Il achète un meuble antique.","il aşet en möbl antik","Antika bir mobilya alıyor."],["La Grèce antique est célèbre.","la gres antik e selebr","Antik Yunanistan ünlüdür."]]}
{"w":"ramper","t":"fiil","m":"sürünmek","s":["se traîner","glisser"],"a":["se redresser"],"e":[["Le serpent rampe dans l'herbe.","lö serpan ranp dan lerb","Yılan otların arasında sürünüyor."],["Le bébé rampe vers son jouet.","lö bebe ranp ver son jue","Bebek oyuncağına doğru emekliyor."]]}
{"w":"divertir","t":"fiil","m":"eğlendirmek","s":["amuser","distraire"],"a":["ennuyer"],"e":[["Le clown divertit les enfants.","lö klun diverti le zanfan","Palyaço çocukları eğlendiriyor."],["Ce jeu me divertit.","sö jö mö diverti","Bu oyun beni eğlendiriyor."]]}
{"w":"antiquité","t":"isim (dişil)","m":"antik çağ; antika","s":["passé lointain","objet ancien"],"a":[],"e":[["Il étudie l'histoire de l'Antiquité.","il etüdi listuar dö lantikite","Antik Çağ tarihini okuyor."],["Il vend des antiquités.","il van de zantikite","Antika eşya satıyor."]]}
{"w":"réveillon","t":"isim (eril)","m":"yılbaşı/Noel gecesi yemeği","s":[],"a":[],"e":[["Ils fêtent le réveillon en famille.","il fet lö reveyon an famiy","Yılbaşı gecesini ailecek kutluyorlar."],["Le réveillon du Nouvel An dure toute la nuit.","lö reveyon dü nuvel an dür tut la nüi","Yılbaşı gecesi bütün gece sürüyor."]]}
{"w":"facilité","t":"isim (dişil)","m":"kolaylık; yatkınlık","s":["aisance","simplicité"],"a":["difficulté"],"e":[["Il apprend avec facilité.","il aprand avek fasilite","Kolaylıkla öğreniyor."],["Elle a une grande facilité pour les langues.","el a ün grand fasilite pur le lang","Dillere büyük bir yatkınlığı var."]]}
{"w":"façade","t":"isim (dişil)","m":"cephe; dış görünüş","s":["devant","apparence"],"a":["arrière"],"e":[["La façade de l'immeuble est blanche.","la fasad dö limöbl e blanş","Binanın cephesi beyaz."],["Son sourire est une façade.","son surir e tün fasad","Gülümsemesi bir maske."]]}
{"w":"remédier","t":"fiil","m":"çare bulmak; gidermek","s":["réparer","corriger"],"a":[],"e":[["Il remédie au problème rapidement.","il remedye o problem rapidman","Soruna çabucak çare buluyor."],["Comment remédier à cette erreur ?","koman remedye a set erör","Bu hata nasıl giderilir?"]]}
{"w":"mutuelle","t":"isim (dişil)","m":"tamamlayıcı sağlık sigortası","s":["assurance santé"],"a":[],"e":[["Il paie sa mutuelle chaque mois.","il pe sa mütüel şak mua","Tamamlayıcı sigortasını her ay ödüyor."],["La mutuelle rembourse les soins dentaires.","la mütüel ranburs le suen danter","Sigorta diş tedavilerini karşılıyor."]]}
{"w":"danois","t":"sıfat","m":"Danimarkalı","s":[],"a":[],"e":[["Il parle danois.","il parl danua","Danca konuşuyor."],["Le design danois est élégant.","lö dizayn danua e telegan","Danimarka tasarımı zarif."]]}
{"w":"héroïque","t":"sıfat","m":"kahramanca","s":["courageux","vaillant"],"a":["lâche"],"e":[["C'est un acte héroïque.","se ten nakt eroik","Bu kahramanca bir eylem."],["Il mène une lutte héroïque.","il men ün lüt eroik","Kahramanca bir mücadele veriyor."]]}
{"w":"clause","t":"isim (dişil)","m":"madde; şart","s":["article","condition"],"a":[],"e":[["Cette clause est importante.","set kloz e tenportant","Bu madde önemli."],["Il lit chaque clause du contrat.","il li şak kloz dü kontra","Sözleşmenin her maddesini okuyor."]]}
{"w":"tarif","t":"isim (eril)","m":"tarife; ücret","s":["prix","coût"],"a":[],"e":[["Le tarif du train augmente.","lö tarif dü tren ogmant","Tren ücreti artıyor."],["Il demande le tarif pour une nuit.","il dömand lö tarif pur ün nüi","Bir gecelik ücreti soruyor."]]}
{"w":"hanter","t":"fiil","m":"musallat olmak; aklından çıkmamak","s":["obséder","tourmenter"],"a":[],"e":[["Un fantôme hante le château.","en fantom ant lö şato","Bir hayalet şatoya musallat oluyor."],["Ce souvenir le hante.","sö suvnir lö ant","Bu anı ona rahat vermiyor."]]}
{"w":"mystique","t":"sıfat","m":"mistik; gizemli","s":["spirituel","mystérieux"],"a":["rationnel"],"e":[["Il vit une expérience mystique.","il viv ün eksperyans mistik","Mistik bir deneyim yaşıyor."],["Ce lieu a une atmosphère mystique.","sö lyö a ün atmosfer mistik","Bu yerin mistik bir atmosferi var."]]}
{"w":"mouiller","t":"fiil","m":"ıslatmak","s":["tremper","humecter"],"a":["sécher"],"e":[["La pluie mouille mes vêtements.","la plüi muy me vetman","Yağmur giysilerimi ıslatıyor."],["Il se mouille les pieds.","il sö muy le pye","Ayaklarını ıslatıyor."]]}
{"w":"secourir","t":"fiil","m":"yardıma koşmak; kurtarmak","s":["aider","sauver"],"a":["abandonner"],"e":[["Les pompiers secourent les blessés.","le ponpye sökur le blese","İtfaiyeciler yaralılara yardıma koşuyor."],["Il secourt un enfant en danger.","il sökur en nanfan an danje","Tehlikedeki bir çocuğa yardım ediyor."]]}
{"w":"résurrection","t":"isim (dişil)","m":"diriliş","s":["renaissance","retour"],"a":["mort"],"e":[["Ils fêtent la résurrection à Pâques.","il fet la rezürreksyon a pak","Paskalya'da dirilişi kutluyorlar."],["La résurrection de la ville est lente.","la rezürreksyon dö la vil e lant","Şehrin yeniden dirilişi yavaş."]]}
{"w":"caresser","t":"fiil","m":"okşamak","s":["flatter","effleurer"],"a":["frapper"],"e":[["Elle caresse le chat.","el kares lö şa","Kediyi okşuyor."],["Il caresse les cheveux de son enfant.","il kares le şövö dö son nanfan","Çocuğunun saçını okşuyor."]]}
{"w":"limiter","t":"fiil","m":"sınırlamak","s":["restreindre","borner"],"a":["étendre","libérer"],"e":[["La loi limite la vitesse.","la lua limit la vites","Yasa hızı sınırlıyor."],["Il limite ses dépenses.","il limit se depans","Harcamalarını sınırlıyor."]]}
{"w":"vaguement","t":"zarf","m":"belli belirsiz; hafifçe","s":["légèrement","imprécisément"],"a":["clairement"],"e":[["Il se souvient vaguement de lui.","il sö suvyen vagman dö lüi","Onu belli belirsiz hatırlıyor."],["Elle sourit vaguement.","el suri vagman","Hafifçe gülümsüyor."]]}
{"w":"médaillon","t":"isim (eril)","m":"madalyon; kolye ucu","s":["pendentif"],"a":[],"e":[["Elle porte un médaillon en or.","el port en medayon an nor","Altın bir madalyon takıyor."],["Le médaillon contient une photo.","lö medayon kontyen ün foto","Madalyonun içinde bir fotoğraf var."]]}
{"w":"écossais","t":"sıfat","m":"İskoç","s":[],"a":[],"e":[["Il porte un kilt écossais.","il port en kilt ekose","İskoç eteği giyiyor."],["La musique écossaise est belle.","la müzik ekosez e bel","İskoç müziği güzel."]]}
{"w":"momie","t":"isim (dişil)","m":"mumya","s":[],"a":[],"e":[["Les touristes admirent la momie.","le turist admir la momi","Turistler mumyaya hayran kalıyor."],["Cette momie est très ancienne.","set momi e tre zansyen","Bu mumya çok eski."]]}
{"w":"frustrant","t":"sıfat","m":"sinir bozucu; hayal kırıklığı yaratan","s":["agaçant","décevant"],"a":["satisfaisant"],"e":[["C'est vraiment frustrant.","se vreman früstran","Bu gerçekten sinir bozucu."],["Cette attente est frustrante.","set atant e früstrant","Bu bekleyiş sinir bozucu."]]}
{"w":"dévouement","t":"isim (eril)","m":"fedakârlık; özveri","s":["abnégation","loyauté"],"a":["égoïsme"],"e":[["Il travaille avec dévouement.","il travay avek devuman","Özveriyle çalışıyor."],["Son dévouement est admirable.","son devuman e tadmirabl","Fedakârlığı hayranlık uyandırıcı."]]}
{"w":"remerciement","t":"isim (eril)","m":"teşekkür","s":["gratitude","merci"],"a":["reproche"],"e":[["Il écrit un mot de remerciement.","il ekri en mo dö römersiman","Bir teşekkür notu yazıyor."],["Elle reçoit des remerciements.","el rösua de römersiman","Teşekkür alıyor."]]}
{"w":"sultan","t":"isim (eril)","m":"sultan","s":[],"a":[],"e":[["Le sultan gouverne un grand empire.","lö sültan guvern en gran tanpir","Sultan büyük bir imparatorluğu yönetiyor."],["Le palais du sultan est magnifique.","lö pale dü sültan e manyifik","Sultanın sarayı muhteşem."]]}
{"w":"gazon","t":"isim (eril)","m":"çimen; çim","s":["pelouse"],"a":[],"e":[["Il tond le gazon.","il ton lö gazon","Çimleri biçiyor."],["Les enfants jouent sur le gazon.","le zanfan ju sür lö gazon","Çocuklar çimenlerde oynuyor."]]}
{"w":"spécialisé","t":"sıfat","m":"uzmanlaşmış","s":["qualifié","particulier"],"a":["général"],"e":[["Il travaille dans un magasin spécialisé.","il travay dan zen magazen spesyalize","Uzmanlaşmış bir mağazada çalışıyor."],["Elle suit une formation spécialisée.","el süi ün formasyon spesyalize","Uzmanlık eğitimi alıyor."]]}
{"w":"cueillir","t":"fiil","m":"toplamak; koparmak","s":["ramasser","récolter"],"a":["planter","semer"],"e":[["Elle cueille des fleurs dans le pré.","el köy de flör dan lö pre","Çayırda çiçek topluyor."],["Ils cueillent des fraises en juin.","il köy de frez an jüen","Haziranda çilek topluyorlar."]]}
{"w":"collant","t":"isim (eril)","m":"külotlu çorap; yapışkan","s":["bas","adhésif"],"a":[],"e":[["Elle met un collant noir.","el me en kolan nuar","Siyah bir külotlu çorap giyiyor."],["Ce ruban est très collant.","sö rüban e tre kolan","Bu bant çok yapışkan."]]}
{"w":"imminent","t":"sıfat","m":"yakın; eli kulağında","s":["proche","prochain"],"a":["lointain"],"e":[["Le départ est imminent.","lö depar e timinan","Hareket çok yakın."],["Un danger imminent menace la ville.","en danje iminan mönas la vil","Yakın bir tehlike şehri tehdit ediyor."]]}
{"w":"mercure","t":"isim (eril)","m":"cıva","s":[],"a":[],"e":[["Le thermomètre contient du mercure.","lö termometr kontyen dü merkür","Termometrenin içinde cıva var."],["Le mercure est un métal liquide.","lö merkür e ten metal likid","Cıva sıvı bir metaldir."]]}
{"w":"motivé","t":"sıfat","m":"motive olmuş; istekli","s":["déterminé","enthousiaste"],"a":["démotivé","indifférent"],"e":[["Il est très motivé pour réussir.","il e tre motive pur reüsir","Başarmak için çok motive."],["Une équipe motivée gagne plus souvent.","ün ekip motive gany plü suvan","Motive bir takım daha sık kazanır."]]}
{"w":"lingerie","t":"isim (dişil)","m":"iç çamaşırı","s":["sous-vêtement"],"a":[],"e":[["Elle achète de la lingerie en soie.","el aşet dö la lenjri an sua","İpek iç çamaşırı alıyor."],["Le magasin de lingerie ouvre à dix heures.","lö magazen dö lenjri uvr a di zör","İç çamaşırı mağazası onda açılıyor."]]}
{"w":"enfiler","t":"fiil","m":"geçirmek; giymek (aceleyle)","s":["mettre","passer"],"a":["enlever","retirer"],"e":[["Il enfile son manteau.","il anfil son manto","Paltosunu giyiyor."],["Elle enfile un fil dans l'aiguille.","el anfil en fil dan legüiy","İğneye bir iplik geçiriyor."]]}
{"w":"allergie","t":"isim (dişil)","m":"alerji","s":[],"a":[],"e":[["Il a une allergie aux noix.","il a ün alerji o nua","Cevize alerjisi var."],["Cette allergie cause des éruptions.","set alerji koz de zerüpsyon","Bu alerji döküntülere neden oluyor."]]}
{"w":"pencher","t":"fiil","m":"eğmek; eğilmek","s":["incliner","baisser"],"a":["redresser"],"e":[["Il penche la tête vers l'avant.","il panş la tet ver lavan","Başını öne eğiyor."],["La tour penche à gauche.","la tur panş a goş","Kule sola eğik."]]}
{"w":"concession","t":"isim (dişil)","m":"taviz; imtiyaz; bayilik","s":["compromis","privilège"],"a":["refus"],"e":[["Les deux parties font des concessions.","le dö parti fon de konsesyon","İki taraf taviz veriyor."],["Il gère une concession automobile.","il jer ün konsesyon otomobil","Bir otomobil bayiliği yönetiyor."]]}
