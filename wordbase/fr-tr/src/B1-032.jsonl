{"w":"réaliste","t":"sıfat","m":"gerçekçi","s":["pragmatique"],"a":["rêveur"],"e":[["Il est très réaliste.","il e tre realist","Çok gerçekçi."],["C'est un plan réaliste.","se ten plan realist","Bu gerçekçi bir plan."]]}
{"w":"vapeur","t":"isim (dişil)","m":"buhar","s":[],"a":[],"e":[["L'eau chaude produit de la vapeur.","lo şod prodüi dö la vapör","Sıcak su buhar üretiyor."],["Le train à vapeur est ancien.","lö tren a vapör e tansyen","Buharlı tren eski."]]}
{"w":"carré","t":"isim (eril)","m":"kare","s":[],"a":[],"e":[["Dessine un carré.","desin en kare","Bir kare çiz."],["Un carré a quatre côtés.","en kare a katr kote","Bir karenin dört kenarı var."]]}
{"w":"planning","t":"isim (eril)","m":"plan; program","s":["emploi du temps"],"a":[],"e":[["Le planning de la semaine est chargé.","lö planin dö la sömen e şarje","Haftanın programı yoğun."],["Il change le planning.","il şanj lö planin","Programı değiştiriyor."]]}
{"w":"renseigner","t":"fiil","m":"bilgi vermek","s":["informer"],"a":[],"e":[["Elle renseigne les touristes.","el ranseny le turist","Turistlere bilgi veriyor."],["Je me renseigne sur les horaires.","jö mö ranseny sür le zorer","Saatler hakkında bilgi alıyorum."]]}
{"w":"cycle","t":"isim (eril)","m":"döngü; devir","s":[],"a":[],"e":[["Le cycle de l'eau est simple.","lö sikl dö lo e senpl","Suyun döngüsü basit."],["Un cycle dure un mois.","en sikl dür en mua","Bir döngü bir ay sürüyor."]]}
{"w":"habituel","t":"sıfat","m":"alışılmış; her zamanki","s":["courant"],"a":["inhabituel"],"e":[["Il prend son café habituel.","il pran son kafe abitüel","Her zamanki kahvesini alıyor."],["C'est l'heure habituelle.","se lör abitüel","Bu her zamanki saat."]]}
{"w":"musical","t":"sıfat","m":"müzikal","s":[],"a":[],"e":[["Elle a une oreille musicale.","el a ün orey müzikal","Müzik kulağı var."],["Le spectacle musical commence.","lö spektakl müzikal komans","Müzikal gösteri başlıyor."]]}
{"w":"inspection","t":"isim (dişil)","m":"denetim","s":["contrôle","examen"],"a":[],"e":[["Un inspecteur fait une inspection.","en nenspektör fe tün enspeksyon","Bir müfettiş denetim yapıyor."],["L'inspection est une surprise.","lenspeksyon e tün sürpriz","Denetim bir sürpriz."]]}
{"w":"envisager","t":"fiil","m":"düşünmek; öngörmek","s":["prévoir"],"a":["écarter"],"e":[["Il envisage de partir.","il anvizaj dö parti","Gitmeyi düşünüyor."],["Elle envisage un changement.","el anvizaj en şanjman","Bir değişiklik düşünüyor."]]}
{"w":"affamé","t":"sıfat","m":"aç; açlıktan ölmüş","s":[],"a":["rassasié"],"e":[["Les enfants sont affamés.","le zanfan son tafame","Çocuklar açlıktan ölüyor."],["Le loup affamé attaque.","lö lu afame atak","Aç kurt saldırıyor."]]}
{"w":"bonus","t":"isim (eril)","m":"prim; ikramiye","s":["prime"],"a":["pénalité"],"e":[["Il reçoit un bonus.","il rösua en bonüs","Bir prim alıyor."],["Le bonus est de mille euros.","lö bonüs e dö mil öro","İkramiye bin avro."]]}
{"w":"démission","t":"isim (dişil)","m":"istifa","s":["départ"],"a":["licenciement"],"e":[["Il donne sa démission.","il don sa demisyon","İstifasını veriyor."],["La démission du ministre surprend.","la demisyon dü ministr sürpran","Bakanın istifası şaşırtıyor."]]}
{"w":"refus","t":"isim (eril)","m":"ret","s":["rejet"],"a":["acceptation"],"e":[["Son refus est clair.","son röfü e kler","Reddi açık."],["Il explique son refus.","il eksplik son röfü","Reddini açıklıyor."]]}
{"w":"mousse","t":"isim (dişil)","m":"köpük; yosun; mus","s":[],"a":[],"e":[["La mousse du savon est épaisse.","la mus dü savon e tepes","Sabunun köpüğü kalın."],["Elle mange une mousse au chocolat.","el manj ün mus o şokola","Çikolatalı mus yiyor."]]}
{"w":"supprimer","t":"fiil","m":"kaldırmak; silmek","s":["effacer"],"a":["ajouter"],"e":[["Il supprime le fichier.","il süprim lö fişye","Dosyayı siliyor."],["La ville supprime des lignes de bus.","la vil süprim de liny dö büs","Şehir otobüs hatlarını kaldırıyor."]]}
{"w":"suggestion","t":"isim (dişil)","m":"öneri","s":["proposition"],"a":[],"e":[["J'ai une suggestion.","je ün sügjestyon","Bir önerim var."],["Sa suggestion est bonne.","sa sügjestyon e bon","Önerisi iyi."]]}
{"w":"revivre","t":"fiil","m":"yeniden yaşamak; canlanmak","s":["renaître"],"a":["mourir"],"e":[["Il revit son enfance.","il röviv son anfans","Çocukluğunu yeniden yaşıyor."],["La ville revit au printemps.","la vil röviv o preten","Şehir baharda canlanıyor."]]}
{"w":"étouffer","t":"fiil","m":"boğmak; boğulmak","s":["asphyxier"],"a":[],"e":[["La fumée étouffe les gens.","la füme etuf le jan","Duman insanları boğuyor."],["Il étouffe dans la foule.","il etuf dan la ful","Kalabalıkta nefesi daralıyor."]]}
{"w":"comporter","t":"fiil","m":"içermek; (se comporter) davranmak","s":["comprendre"],"a":[],"e":[["Le livre comporte dix chapitres.","lö livr konport di şapitr","Kitap on bölüm içeriyor."],["Il se comporte bien.","il sö konport byen","İyi davranıyor."]]}
{"w":"colocataire","t":"isim (eril/dişil)","m":"ev arkadaşı","s":[],"a":[],"e":[["Mon colocataire est étudiant.","mon kolokater e etüdyan","Ev arkadaşım öğrenci."],["Il paie le loyer avec son colocataire.","il pe lö luaye avek son kolokater","Kirayı ev arkadaşıyla ödüyor."]]}
{"w":"pénétrer","t":"fiil","m":"girmek; nüfuz etmek","s":["entrer"],"a":["sortir"],"e":[["Le voleur pénètre dans la maison.","lö volör penetr dan la mezon","Hırsız eve giriyor."],["L'eau pénètre dans le sol.","lo penetr dan lö sol","Su toprağa sızıyor."]]}
{"w":"gelée","t":"isim (dişil)","m":"jöle; don (kırağı)","s":[],"a":[],"e":[["Elle étale de la gelée sur le pain.","el etal dö la jöle sür lö pen","Ekmeğe jöle sürüyor."],["La gelée blanche couvre l'herbe.","la jöle blanş kuvr lerb","Kırağı çimenleri kaplıyor."]]}
{"w":"ironie","t":"isim (dişil)","m":"ironi","s":["sarcasme"],"a":[],"e":[["Il parle avec ironie.","il parl avek ironi","İroniyle konuşuyor."],["Quelle ironie du sort !","kel ironi dü sor","Kaderin ne ironisi!"]]}
{"w":"comique","t":"sıfat","m":"komik","s":["drôle","amusant"],"a":["tragique"],"e":[["Ce film est très comique.","sö film e tre komik","Bu film çok komik."],["Il a un air comique.","il a en ner komik","Komik bir hali var."]]}
{"w":"procéder","t":"fiil","m":"ilerlemek; yöntem izlemek","s":["opérer"],"a":[],"e":[["Il procède avec soin.","il prosed avek suen","Özenle ilerliyor."],["Nous procédons au vote.","nu prosedon o vot","Oylamaya geçiyoruz."]]}
{"w":"réflexion","t":"isim (dişil)","m":"düşünme; yansıma","s":["méditation"],"a":["impulsion"],"e":[["Il demande du temps de réflexion.","il dömand dü tan dö refleksyon","Düşünmek için zaman istiyor."],["La réflexion de la lumière est belle.","la refleksyon dö la lümyer e bel","Işığın yansıması güzel."]]}
{"w":"imposer","t":"fiil","m":"dayatmak; (vergi) koymak","s":["forcer"],"a":["proposer"],"e":[["Il impose ses idées.","il enpoz se zide","Fikirlerini dayatıyor."],["L'État impose les riches.","leta enpoz le riş","Devlet zenginlerden vergi alıyor."]]}
{"w":"adoption","t":"isim (dişil)","m":"evlat edinme; benimseme","s":["acceptation"],"a":["abandon"],"e":[["Ils pensent à l'adoption.","il pans a ladopsyon","Evlat edinmeyi düşünüyorlar."],["L'adoption de la loi est rapide.","ladopsyon dö la lua e rapid","Yasanın kabulü hızlı."]]}
