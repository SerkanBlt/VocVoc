{"w":"Australie","t":"isim (dişil)","m":"Avustralya","s":[],"a":[],"e":[["L'Australie est très loin.","lostrali e tre luen","Avustralya çok uzak."],["Il habite en Australie.","il abit an ostrali","Avustralya'da oturuyor."]]}
{"w":"âne","t":"isim (eril)","m":"eşek","s":[],"a":[],"e":[["L'âne porte un sac.","lan port en sak","Eşek bir çanta taşıyor."],["Il y a un âne dans le champ.","il i a en nan dan lö şan","Tarlada bir eşek var."]]}
