{"w":"supermarché","t":"isim (eril)","m":"süpermarket","s":[],"a":[],"e":[["Je fais les courses au supermarché.","jö fe le kurs o süpermarşe","Alışverişi süpermarkette yapıyorum."],["Le supermarché est ouvert le dimanche.","lö süpermarşe e tuver lö dimanş","Süpermarket pazar günü açık."]]}
{"w":"février","t":"isim (eril)","m":"şubat","s":[],"a":[],"e":[["Février est le mois le plus court.","fevriye e lö mua lö plü kur","Şubat en kısa aydır."],["En février, il fait encore froid.","an fevriye, il fe tankor frua","Şubatta hava hâlâ soğuk."]]}
{"w":"Brésil","t":"isim (eril)","m":"Brezilya","s":[],"a":[],"e":[["Il habite au Brésil.","il abit o brezil","Brezilya'da oturuyor."],["On parle portugais au Brésil.","on parl portüge o brezil","Brezilya'da Portekizce konuşulur."]]}
{"w":"dessiner","t":"fiil","m":"çizmek; resim yapmak","s":[],"a":[],"e":[["J'aime dessiner des animaux.","jem desine de zanimo","Hayvan çizmeyi severim."],["Mon fils dessine un chat.","mon fis desin en şa","Oğlum bir kedi çiziyor."]]}
{"w":"casquette","t":"isim (dişil)","m":"kasket; siperli şapka","s":[],"a":[],"e":[["Il porte une casquette bleue.","il port ün kasket blö","Mavi bir şapka takıyor."],["Où est ma casquette ?","u e ma kasket","Şapkam nerede?"]]}
{"w":"banane","t":"isim (dişil)","m":"muz","s":[],"a":[],"e":[["Je mange une banane au petit-déjeuner.","jö manj ün banan o pöti dejöne","Kahvaltıda bir muz yerim."],["La banane est un fruit jaune.","la banan e ten früi jon","Muz sarı bir meyvedir."]]}
{"w":"ciseaux","t":"isim (eril)","m":"makas","s":[],"a":[],"e":[["Je coupe le papier avec des ciseaux.","jö kup lö papye avek de sizo","Kâğıdı makasla kesiyorum."],["Où sont les ciseaux ?","u son le sizo","Makas nerede?"]]}
{"w":"tortue","t":"isim (dişil)","m":"kaplumbağa","s":[],"a":[],"e":[["La tortue est très lente.","la tortü e tre lant","Kaplumbağa çok yavaş."],["Elle a une petite tortue.","el a ün pötit tortü","Küçük bir kaplumbağası var."]]}
{"w":"mouton","t":"isim (eril)","m":"koyun","s":[],"a":[],"e":[["Les moutons mangent de l'herbe.","le muton manj dö lerb","Koyunlar ot yiyor."],["Il y a des moutons dans le champ.","il i a de muton dan lö şan","Tarlada koyunlar var."]]}
{"w":"jupe","t":"isim (dişil)","m":"etek","s":[],"a":[],"e":[["Elle porte une jupe noire.","el port ün jüp nuar","Siyah bir etek giyiyor."],["Cette jupe est trop courte.","set jüp e tro kurt","Bu etek çok kısa."]]}
{"w":"jambon","t":"isim (eril)","m":"jambon","s":[],"a":[],"e":[["Le jambon est dans le frigo.","lö janbon e dan lö frigo","Jambon buzdolabında."],["Un jambon-beurre, s'il vous plaît.","en janbon bör, sil vu ple","Bir jambonlu sandviç, lütfen."]]}
{"w":"marron","t":"sıfat","m":"kahverengi; kestane","s":[],"a":[],"e":[["Elle a les yeux marron.","el a le zyö maron","Gözleri kahverengi."],["Mon chien est marron.","mon şiyen e maron","Köpeğim kahverengi."]]}
{"w":"coiffeur","t":"isim (eril)","m":"berber; kuaför","s":[],"a":[],"e":[["Je vais chez le coiffeur demain.","jö ve şe lö kuaför dömen","Yarın berbere gidiyorum."],["Mon coiffeur est très gentil.","mon kuaför e tre janti","Kuaförüm çok nazik."]]}
{"w":"armoire","t":"isim (dişil)","m":"dolap","s":[],"a":[],"e":[["L'armoire est dans ma chambre.","larmuar e dan ma şambr","Dolap odamda."],["Ouvre l'armoire, s'il te plaît.","uvr larmuar, sil tö ple","Dolabı aç, lütfen."]]}
{"w":"touriste","t":"isim (eril)","m":"turist","s":[],"a":[],"e":[["Il y a beaucoup de touristes à Paris.","il i a boku dö turist a pari","Paris'te çok turist var."],["Cette touriste cherche le musée.","set turist şerş lö müze","Bu turist müzeyi arıyor."]]}
{"w":"balcon","t":"isim (eril)","m":"balkon","s":[],"a":[],"e":[["J'ai un petit balcon.","je en pöti balkon","Küçük bir balkonum var."],["Nous mangeons sur le balcon.","nu manjon sür lö balkon","Balkonda yemek yiyoruz."]]}
{"w":"addition","t":"isim (dişil)","m":"hesap; toplama","s":[],"a":[],"e":[["L'addition, s'il vous plaît !","ladisyon, sil vu ple","Hesap, lütfen!"],["L'addition est de vingt euros.","ladisyon e dö ven töro","Hesap yirmi avro."]]}
{"w":"grenouille","t":"isim (dişil)","m":"kurbağa","s":[],"a":[],"e":[["La grenouille est verte.","la grönuy e vert","Kurbağa yeşil."],["Il y a des grenouilles dans le lac.","il i a de grönuy dan lö lak","Gölde kurbağalar var."]]}
{"w":"litre","t":"isim (eril)","m":"litre","s":[],"a":[],"e":[["Je bois un litre d'eau par jour.","jö bua en litr do par jur","Günde bir litre su içiyorum."],["Un litre de lait, s'il vous plaît.","en litr dö le, sil vu ple","Bir litre süt, lütfen."]]}
{"w":"sixième","t":"sıfat","m":"altıncı","s":[],"a":[],"e":[["C'est la sixième fois.","se la sizyem fua","Bu altıncı kez."],["Il habite au sixième étage.","il abit o sizyem etaj","Altıncı katta oturuyor."]]}
