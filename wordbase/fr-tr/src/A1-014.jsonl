{"w":"pharmacie","t":"isim (dişil)","m":"eczane","s":[],"a":[],"e":[["La pharmacie est ouverte jusqu'à huit heures.","la farmasi e tuvert jüska üit ör","Eczane sekize kadar açık."],["Je vais à la pharmacie.","jö ve a la farmasi","Eczaneye gidiyorum."]]}
{"w":"chanteur","t":"isim (eril)","m":"şarkıcı","s":[],"a":[],"e":[["Ce chanteur est très connu.","sö şantör e tre konü","Bu şarkıcı çok ünlü."],["Mon frère est chanteur.","mon frer e şantör","Erkek kardeşim şarkıcı."]]}
