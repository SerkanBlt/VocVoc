{"w":"biscuit","t":"isim (eril)","m":"bisküvi","s":[],"a":[],"e":[["Je mange un biscuit avec mon café.","jö manj en bisküi avek mon kafe","Kahvemle bir bisküvi yiyorum."],["Les enfants aiment les biscuits.","le zanfan zem le bisküi","Çocuklar bisküviyi sever."]]}
{"w":"mail","t":"isim (eril)","m":"e-posta (günlük dilde)","s":["e-mail","courriel"],"a":[],"e":[["J'envoie un mail à mon professeur.","janvua en mel a mon profesör","Öğretmenime bir e-posta gönderiyorum."],["Tu as reçu mon mail ?","tü a rösü mon mel","E-postamı aldın mı?"]]}
{"w":"savon","t":"isim (eril)","m":"sabun","s":[],"a":[],"e":[["Je me lave les mains avec du savon.","jö mö lav le men avek dü savon","Ellerimi sabunla yıkıyorum."],["Il n'y a plus de savon.","il ni a plü dö savon","Sabun kalmadı."]]}
{"w":"janvier","t":"isim (eril)","m":"ocak","s":[],"a":[],"e":[["Le premier janvier, c'est le nouvel an.","lö prömye janviye, se lö nuvel an","Bir ocak yılbaşıdır."],["En janvier, il neige souvent.","an janviye, il nej suvan","Ocakta sık sık kar yağar."]]}
{"w":"e-mail","t":"isim (eril)","m":"e-posta","s":["mail","courriel"],"a":[],"e":[["Quelle est ton adresse e-mail ?","kel e ton adres imel","E-posta adresin nedir?"],["Je t'envoie un e-mail ce soir.","jö tanvua en imel sö suar","Sana bu akşam bir e-posta gönderiyorum."]]}
{"w":"jazz","t":"isim (eril)","m":"caz","s":[],"a":[],"e":[["J'écoute du jazz le soir.","jekut dü jaz lö suar","Akşamları caz dinlerim."],["Il joue du piano dans un groupe de jazz.","il ju dü piyano dan zen grup dö jaz","Bir caz grubunda piyano çalıyor."]]}
{"w":"barbecue","t":"isim (eril)","m":"mangal; barbekü","s":[],"a":[],"e":[["Nous faisons un barbecue samedi.","nu fözon en barbökü samdi","Cumartesi mangal yapıyoruz."],["Le barbecue est dans le jardin.","lö barbökü e dan lö jarden","Mangal bahçede."]]}
{"w":"citron","t":"isim (eril)","m":"limon","s":[],"a":[],"e":[["Je mets du citron dans mon thé.","jö me dü sitron dan mon te","Çayıma limon koyuyorum."],["Un jus de citron, s'il vous plaît.","en jü dö sitron, sil vu ple","Bir limon suyu, lütfen."]]}
{"w":"étudiante","t":"isim (dişil)","m":"öğrenci (kız)","s":[],"a":[],"e":[["Elle est étudiante à Lyon.","el e tetüdyant a liyon","O Lyon'da öğrenci."],["Ma sœur est étudiante.","ma sör e tetüdyant","Ablam öğrenci."]]}
{"w":"oreiller","t":"isim (eril)","m":"yastık","s":[],"a":[],"e":[["Je dors avec deux oreillers.","jö dor avek dö zoreye","İki yastıkla uyuyorum."],["L'oreiller est sur le lit.","loreye e sür lö li","Yastık yatağın üstünde."]]}
{"w":"brosse","t":"isim (dişil)","m":"fırça","s":[],"a":[],"e":[["Je prends ma brosse à dents.","jö pran ma bros a dan","Diş fırçamı alıyorum."],["Elle a une brosse pour les cheveux.","el a ün bros pur le şövö","Saçları için bir fırçası var."]],"x":[["brosse à dents","bros a dan","diş fırçası","Ma brosse à dents est bleue.","ma bros a dan e blö","Diş fırçam mavi."]]}
{"w":"pyjama","t":"isim (eril)","m":"pijama","s":[],"a":[],"e":[["Je mets mon pyjama pour dormir.","jö me mon pijama pur dormir","Uyumak için pijamamı giyiyorum."],["Le bébé est en pyjama.","lö bebe e tan pijama","Bebek pijamayla."]]}
{"w":"vaisselle","t":"isim (dişil)","m":"bulaşık; tabak çanak","s":[],"a":[],"e":[["Je fais la vaisselle après le dîner.","jö fe la vesel apre lö dine","Akşam yemeğinden sonra bulaşık yıkıyorum."],["La vaisselle est sale.","la vesel e sal","Bulaşıklar kirli."]],"x":[["faire la vaisselle","fer la vesel","bulaşık yıkamak","Qui fait la vaisselle ?","ki fe la vesel","Bulaşığı kim yıkıyor?"]]}
{"w":"DVD","t":"isim (eril)","m":"DVD","s":[],"a":[],"e":[["Je regarde un DVD.","jö rögard en devede","Bir DVD izliyorum."],["Le DVD est dans le salon.","lö devede e dan lö salon","DVD salonda."]]}
{"w":"éléphant","t":"isim (eril)","m":"fil","s":[],"a":[],"e":[["L'éléphant est un très grand animal.","lelefan e ten tre gran tanimal","Fil çok büyük bir hayvandır."],["Les enfants regardent l'éléphant.","le zanfan rögard lelefan","Çocuklar file bakıyor."]]}
{"w":"chips","t":"isim (dişil)","m":"cips","s":[],"a":[],"e":[["Je mange des chips devant la télé.","jö manj de şips dövan la tele","Televizyon karşısında cips yiyorum."],["Il y a des chips dans le placard.","il i a de şips dan lö plakar","Dolapta cips var."]]}
