{"w":"fanatique","t":"sıfat","m":"fanatik","s":["extrémiste","passionné"],"a":["modéré","tolérant"],"e":[["C'est un supporter fanatique.","se ten süportör fanatik","O fanatik bir taraftar."],["Il tient des propos fanatiques.","il tyen de propo fanatik","Fanatik sözler söylüyor."]]}
{"w":"asphyxie","t":"isim (dişil)","m":"boğulma; havasızlıktan boğulma","s":["étouffement"],"a":[],"e":[["Le gaz provoque l'asphyxie.","lö gaz provok lasfiksi","Gaz boğulmaya yol açıyor."],["Les pompiers sauvent un homme de l'asphyxie.","le ponpye sov en nom dö lasfiksi","İtfaiyeciler bir adamı boğulmaktan kurtarıyor."]]}
{"w":"mutant","t":"isim (eril)","m":"mutant","s":[],"a":[],"e":[["Le mutant a des pouvoirs.","lö mütan a de puvuar","Mutantın güçleri var."],["Les mutants se cachent.","le mütan sö kaş","Mutantlar saklanıyor."]]}
{"w":"charpentier","t":"isim (eril)","m":"marangoz (çatı)","s":[],"a":[],"e":[["Le charpentier construit le toit.","lö şarpantye konstrüi lö tua","Marangoz çatıyı yapıyor."],["Il devient charpentier à vingt ans.","il dövyen şarpantye a ven tan","Yirmi yaşında marangoz oluyor."]]}
{"w":"vandalisme","t":"isim (eril)","m":"vandalizm","s":[],"a":[],"e":[["Le vandalisme détruit les bancs.","lö vandalism detrü le ban","Vandalizm banklara zarar veriyor."],["La ville lutte contre le vandalisme.","la vil lüt kontr lö vandalism","Şehir vandalizmle mücadele ediyor."]]}
{"w":"anonymat","t":"isim (eril)","m":"anonimlik","s":["incognito"],"a":["célébrité"],"e":[["Il garde l'anonymat.","il gard lanonima","Kimliğini gizli tutuyor."],["L'anonymat protège les témoins.","lanonima protej le temuen","Anonimlik tanıkları koruyor."]]}
{"w":"derby","t":"isim (eril)","m":"derbi","s":[],"a":[],"e":[["Le derby attire beaucoup de monde.","lö derbi atir boku dö mond","Derbi çok kişiyi çekiyor."],["Ils regardent le derby à la télé.","il rögard lö derbi a la tele","Derbiyi televizyonda izliyorlar."]]}
{"w":"sobriété","t":"isim (dişil)","m":"ölçülülük; sadelik","s":["modération","simplicité"],"a":["excès"],"e":[["Il vit avec sobriété.","il viv avek sobriyete","Ölçülü yaşıyor."],["La sobriété du décor plaît.","la sobriyete dü dekor ple","Dekorun sadeliği hoşa gidiyor."]]}
{"w":"électoral","t":"sıfat","m":"seçimle ilgili","s":[],"a":[],"e":[["La campagne électorale commence.","la kanpany elektoral komans","Seçim kampanyası başlıyor."],["Il étudie la carte électorale.","il etüdi la kart elektoral","Seçim haritasını inceliyor."]]}
{"w":"altercation","t":"isim (dişil)","m":"tartışma; atışma","s":["dispute","querelle"],"a":["accord"],"e":[["Une altercation éclate dans la rue.","ün alterkasyon eklat dan la rü","Sokakta bir tartışma çıkıyor."],["Il évite l'altercation.","il evit lalterkasyon","Tartışmadan kaçınıyor."]]}
{"w":"allumage","t":"isim (eril)","m":"ateşleme; yakma","s":["démarrage"],"a":["extinction"],"e":[["L'allumage du feu est difficile.","lalümaj dü fö e difisil","Ateşin yakılması zor."],["Le problème vient de l'allumage du moteur.","lö problem vyen dö lalümaj dü motör","Sorun motorun ateşlemesinden kaynaklanıyor."]]}
{"w":"concorde","t":"isim (dişil)","m":"uyum; ahenk","s":["harmonie","paix"],"a":["discorde"],"e":[["La concorde règne dans la famille.","la konkord reny dan la famiy","Ailede uyum hüküm sürüyor."],["Ils cherchent la concorde entre les peuples.","il şerş la konkord antr le pöpl","Halklar arasında uyum arıyorlar."]]}
{"w":"arctique","t":"sıfat","m":"Arktik","s":["polaire"],"a":["antarctique"],"e":[["Le froid arctique gèle tout.","lö frua arktik jel tu","Arktik soğuk her şeyi dondurur."],["L'ours vit dans la région arctique.","lurs viv dan la rejyon arktik","Ayı Arktik bölgesinde yaşıyor."]]}
