{"w":"captivité","t":"isim (dişil)","m":"esaret","s":["détention","emprisonnement"],"a":["liberté"],"e":[["Il vit en captivité depuis trois ans.","il viv an kaptivite döpüi trua zan","Üç yıldır esaret altında yaşıyor."],["Les animaux souffrent en captivité.","le zanimo süfr an kaptivite","Hayvanlar esaret altında acı çekiyor."]]}
{"w":"médiatique","t":"sıfat","m":"medyayla ilgili; medyada ilgi gören","s":["publicitaire"],"a":[],"e":[["Cette affaire est très médiatique.","set afer e tre medyatik","Bu olay medyada çok ilgi görüyor."],["Il cherche une couverture médiatique.","il şerş ün kuvertür medyatik","Medya ilgisi arıyor."]]}
{"w":"pédiatre","t":"isim (eril/dişil)","m":"çocuk doktoru","s":[],"a":[],"e":[["Le pédiatre examine le bébé.","lö pedyatr egzamin lö bebe","Çocuk doktoru bebeği muayene ediyor."],["Elle prend rendez-vous chez le pédiatre.","el pran randevu şe lö pedyatr","Çocuk doktorundan randevu alıyor."]]}
{"w":"équilibré","t":"sıfat","m":"dengeli","s":["stable","harmonieux"],"a":["déséquilibré","instable"],"e":[["Il suit un régime équilibré.","il süi en rejim ekilibre","Dengeli bir diyet izliyor."],["C'est une personne très équilibrée.","se tün person tre zekilibre","O çok dengeli bir insan."]]}
{"w":"craie","t":"isim (dişil)","m":"tebeşir","s":[],"a":[],"e":[["Le prof écrit avec une craie.","lö prof ekri avek ün kre","Öğretmen tebeşirle yazıyor."],["La craie laisse de la poussière blanche.","la kre les dö la pusyer blanş","Tebeşir beyaz toz bırakıyor."]]}
{"w":"traîneau","t":"isim (eril)","m":"kızak","s":[],"a":[],"e":[["Le traîneau glisse sur la neige.","lö treno glis sür la nej","Kızak karda kayıyor."],["Les chiens tirent le traîneau.","le şyen tir lö treno","Köpekler kızağı çekiyor."]]}
{"w":"minuteur","t":"isim (eril)","m":"zamanlayıcı","s":[],"a":[],"e":[["Il règle le minuteur à dix minutes.","il regl lö minütör a di minüt","Zamanlayıcıyı on dakikaya ayarlıyor."],["Le minuteur sonne.","lö minütör son","Zamanlayıcı çalıyor."]]}
{"w":"démarrage","t":"isim (eril)","m":"başlatma; kalkış","s":["lancement","départ"],"a":["arrêt"],"e":[["Le démarrage du moteur est difficile.","lö demaraj dü motör e difisil","Motorun çalıştırılması zor."],["Il réussit son démarrage en côte.","il reüsi son demaraj an kot","Yokuşta kalkışı başarıyla yapıyor."]]}
{"w":"viable","t":"sıfat","m":"yaşayabilir; uygulanabilir","s":["réalisable","durable"],"a":["irréaliste","condamné"],"e":[["Ce projet est viable.","sö proje e vyabl","Bu proje uygulanabilir."],["Le bébé est viable dès la naissance.","lö bebe e vyabl de la nesans","Bebek doğumdan itibaren yaşayabilir."]]}
{"w":"furie","t":"isim (dişil)","m":"öfke; çılgınlık","s":["rage","colère"],"a":["calme","sérénité"],"e":[["Il entre dans une furie noire.","il antr dan zün füri nuar","Kara bir öfkeye kapılıyor."],["La mer se déchaîne avec furie.","la mer sö deşen avek füri","Deniz öfkeyle çalkalanıyor."]]}
{"w":"densité","t":"isim (dişil)","m":"yoğunluk","s":["concentration","épaisseur"],"a":["légèreté"],"e":[["La densité de la population augmente.","la dansite dö la popülasyon ogmant","Nüfus yoğunluğu artıyor."],["La densité de l'eau est plus faible.","la dansite dö lo e plü febl","Suyun yoğunluğu daha düşük."]]}
{"w":"retardement","t":"isim (eril)","m":"gecikme; zaman ayarı","s":["délai"],"a":[],"e":[["La bombe explose à retardement.","la bonb eksploz a rötardöman","Bomba zaman ayarlı patlıyor."],["Il comprend à retardement.","il konpran a rötardöman","Geç anlıyor."]],"x":[["à retardement","a rötardöman","geç; zaman ayarlı","Il réagit à retardement.","il reaji a rötardöman","Geç tepki veriyor."]]}
{"w":"encourageant","t":"sıfat","m":"cesaret verici","s":["stimulant","prometteur"],"a":["décourageant","décevant"],"e":[["C'est un résultat encourageant.","se ten rezülta ankurajan","Bu cesaret verici bir sonuç."],["Ses mots sont encourageants.","se mo son tankurajan","Sözleri cesaret verici."]]}
