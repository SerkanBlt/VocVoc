{"w":"hébreu","t":"isim (eril)","m":"İbranice; İbrani","s":[],"a":[],"e":[["Il apprend l'hébreu.","il aprand lebrö","İbranice öğreniyor."],["Le livre est écrit en hébreu.","lö livr e tekri an nebrö","Kitap İbranice yazılmış."]]}
{"w":"rénovation","t":"isim (dişil)","m":"yenileme","s":["réparation","restauration"],"a":["démolition"],"e":[["La rénovation de la maison coûte cher.","la renovasyon dö la mezon kut şer","Evin yenilenmesi pahalıya mal oluyor."],["Ils font la rénovation de la cuisine.","il fon la renovasyon dö la küizin","Mutfağı yeniliyorlar."]]}
{"w":"galop","t":"isim (eril)","m":"dörtnala","s":[],"a":["pas"],"e":[["Le cheval part au galop.","lö şöval par o galo","At dörtnala kalkıyor."],["Il entend le galop des chevaux.","il natan lö galo de şöval","Atların dörtnala koşusunu duyuyor."]]}
