{"w":"mitrailleuse","t":"isim (dişil)","m":"makineli tüfek","s":[],"a":[],"e":[["Le soldat tire avec une mitrailleuse.","lö solda tir avek ün mitrayöz","Asker makineli tüfekle ateş ediyor."],["La mitrailleuse est lourde.","la mitrayöz e lurd","Makineli tüfek ağır."]]}
{"w":"intrépide","t":"sıfat","m":"yılmaz; korkusuz","s":["courageux","audacieux"],"a":["peureux","timide"],"e":[["C'est un explorateur intrépide.","se ten neksploratör entrepid","O yılmaz bir kaşif."],["Ce jeune garçon est intrépide.","sö jön garson e tentrepid","Bu genç çocuk korkusuz."]]}
{"w":"reconstitution","t":"isim (dişil)","m":"yeniden oluşturma","s":["recréation","restauration"],"a":[],"e":[["La police fait la reconstitution du crime.","la polis fe la rökonstitüsyon dü krim","Polis olayı yeniden canlandırıyor."],["La reconstitution du château est impressionnante.","la rökonstitüsyon dü şato e tenpresyonant","Şatonun yeniden oluşturulması etkileyici."]]}
{"w":"tuberculose","t":"isim (dişil)","m":"verem","s":[],"a":[],"e":[["Il soigne une tuberculose.","il suany ün tüberküloz","Verem tedavisi görüyor."],["La tuberculose touche les poumons.","la tüberküloz tuş le pumon","Verem akciğerleri etkiler."]]}
{"w":"combustible","t":"isim (eril)","m":"yakıt","s":["carburant"],"a":[],"e":[["Le charbon est un combustible.","lö şarbon e ten konbüstibl","Kömür bir yakıttır."],["Le combustible manque en hiver.","lö konbüstibl mank an niver","Kışın yakıt yetmiyor."]]}
{"w":"intendant","t":"isim (eril)","m":"idareci; kâhya","s":["gestionnaire","régisseur"],"a":[],"e":[["L'intendant gère les provisions.","lentandan jer le provizyon","İdareci erzakı yönetiyor."],["Le château a un intendant.","lö şato a en nentandan","Şatonun bir kâhyası var."]]}
{"w":"curieusement","t":"zarf","m":"tuhaf biçimde","s":["bizarrement","étrangement"],"a":["normalement"],"e":[["Curieusement, il n'a rien dit.","küryözman il na ryen di","Tuhaf biçimde hiçbir şey söylemedi."],["Il sourit curieusement.","il suri küryözman","Tuhaf biçimde gülümsüyor."]]}
