{"w":"bagage","t":"isim (eril)","m":"bagaj; valiz","s":["valise"],"a":[],"e":[["Où sont mes bagages ?","u son me bagaj","Bagajlarım nerede?"],["J'ai un petit bagage.","je en pöti bagaj","Küçük bir bagajım var."]]}
