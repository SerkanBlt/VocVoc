{"w":"sucre","t":"isim (eril)","m":"şeker","s":[],"a":[],"e":[["Tu veux du sucre dans ton café ?","tü vö dü sükr dan ton kafe","Kahvene şeker ister misin?"],["Il n'y a plus de sucre.","il ni a plü dö sükr","Şeker kalmadı."]]}
{"w":"étudier","t":"fiil","m":"çalışmak (ders); okumak; incelemek","s":["apprendre"],"a":[],"e":[["J'étudie le français.","jetüdi lö franse","Fransızca çalışıyorum."],["Elle étudie à Paris.","el etüdi a pari","Paris'te okuyor."]],"x":[["étudier à l'université","etüdye a lünivrsite","üniversitede okumak","Ma sœur étudie à l'université.","ma sör etüdi a lünivrsite","Ablam üniversitede okuyor."]]}
{"w":"pizza","t":"isim (dişil)","m":"pizza","s":[],"a":[],"e":[["Je prends une pizza.","jö pran ün pidza","Bir pizza alıyorum."],["La pizza est chaude.","la pidza e şod","Pizza sıcak."]]}
{"w":"soupe","t":"isim (dişil)","m":"çorba","s":["potage"],"a":[],"e":[["La soupe est chaude.","la sup e şod","Çorba sıcak."],["Ma grand-mère fait de la soupe.","ma gran mer fe dö la sup","Büyükannem çorba yapıyor."]],"x":[["soupe du jour","sup dü jur","günün çorbası","La soupe du jour est à l'oignon.","la sup dü jur e ta lonyon","Günün çorbası soğan çorbası."]]}
