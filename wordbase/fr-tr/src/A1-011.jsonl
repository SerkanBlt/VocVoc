{"w":"télévision","t":"isim (dişil)","m":"televizyon","s":["télé"],"a":[],"e":[["Nous regardons la télévision le soir.","nu rögardon la televizyon lö suar","Akşamları televizyon izliyoruz."],["La télévision est allumée.","la televizyon e talüme","Televizyon açık."]]}
{"w":"football","t":"isim (eril)","m":"futbol","s":[],"a":[],"e":[["Le football est un sport populaire.","lö futbol e ten spor popüler","Futbol popüler bir spordur."],["Nous jouons au football le dimanche.","nu juon o futbol lö dimanş","Pazar günleri futbol oynarız."]]}
