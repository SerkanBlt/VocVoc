{"w":"musée","t":"isim (eril)","m":"müze","s":[],"a":[],"e":[["Nous visitons le musée du Louvre.","nu viziton lö müze dü luvr","Louvre Müzesi'ni geziyoruz."],["Le musée est fermé le mardi.","lö müze e ferme lö mardi","Müze salı günleri kapalı."]]}
{"w":"sable","t":"isim (eril)","m":"kum","s":[],"a":[],"e":[["Les enfants jouent dans le sable.","le zanfan ju dan lö sabl","Çocuklar kumda oynuyor."],["Le sable est chaud.","lö sabl e şo","Kum sıcak."]]}
{"w":"beurre","t":"isim (eril)","m":"tereyağı","s":[],"a":[],"e":[["Je mets du beurre sur le pain.","jö me dü bör sür lö pen","Ekmeğe tereyağı sürüyorum."],["Le beurre est dans le frigo.","lö bör e dan lö frigo","Tereyağı buzdolabında."]]}
