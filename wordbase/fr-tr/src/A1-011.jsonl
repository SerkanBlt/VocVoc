{"w":"hiver","t":"isim (eril)","m":"kış","s":[],"a":["été"],"e":[["En hiver, il fait froid.","an iver, il fe frua","Kışın hava soğuktur."],["Nous allons à la montagne en hiver.","nu zalon a la montany an iver","Kışın dağa gidiyoruz."]]}
{"w":"manteau","t":"isim (eril)","m":"palto; mont","s":[],"a":[],"e":[["Il fait froid, mets ton manteau.","il fe frua, me ton manto","Hava soğuk, paltonu giy."],["Son manteau est noir.","son manto e nuar","Paltosu siyah."]]}
