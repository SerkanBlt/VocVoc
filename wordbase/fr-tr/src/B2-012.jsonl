{"w":"maternel","t":"sıfat","m":"anne ile ilgili; anaç","s":["de mère"],"a":["paternel"],"e":[["Elle a un instinct maternel.","el a en nensten maternel","Annelik içgüdüsü var."],["Sa langue maternelle est le français.","sa lang maternel e lö franse","Ana dili Fransızca."]]}
{"w":"gai","t":"sıfat","m":"neşeli","s":["joyeux","enjoué"],"a":["triste","sombre"],"e":[["Elle est toujours gaie.","el e tujur ge","Her zaman neşeli."],["C'est un air très gai.","se ten er tre ge","Bu çok neşeli bir melodi."]]}
