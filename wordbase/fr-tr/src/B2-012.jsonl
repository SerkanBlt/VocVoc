{"w":"hamburger","t":"isim (eril)","m":"hamburger","s":[],"a":[],"e":[["Il commande un hamburger avec des frites.","il komand en anburgör avek de frit","Patates kızartmalı bir hamburger sipariş ediyor."],["Ce restaurant sert de bons hamburgers.","sö restoran ser dö bon anburgör","Bu restoran iyi hamburgerler servis ediyor."]]}
