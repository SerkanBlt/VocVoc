{"w":"rampe","t":"isim (dişil)","m":"rampa; korkuluk","s":[],"a":[],"e":[["Il s'accroche à la rampe de l'escalier.","il sakroş a la ranp dö leskalye","Merdiven korkuluğuna tutunuyor."],["La rampe aide les fauteuils roulants.","la ranp ed le fotöy rulan","Rampa tekerlekli sandalyelere yardımcı oluyor."]]}
{"w":"écarter","t":"fiil","m":"uzaklaştırmak; aralamak","s":["éloigner","séparer"],"a":["rapprocher"],"e":[["Il écarte les rideaux.","il ekarte le rido","Perdeleri aralıyor."],["On écarte cette idée.","on ekart set ide","Bu fikri bir kenara bırakıyoruz."]]}
{"w":"accélérer","t":"fiil","m":"hızlanmak; hızlandırmak","s":["presser","activer"],"a":["ralentir","freiner"],"e":[["La voiture accélère sur l'autoroute.","la vuatür akseler sür lotorut","Araba otoyolda hızlanıyor."],["Il veut accélérer le projet.","il vö akselere lö proje","Projeyi hızlandırmak istiyor."]]}
{"w":"doubler","t":"fiil","m":"ikiye katlamak; geçmek","s":["multiplier par deux","dépasser"],"a":["diviser"],"e":[["Le prix va doubler.","lö pri va duble","Fiyat iki katına çıkacak."],["Il double la voiture devant lui.","il dubl la vuatür dövan lüi","Önündeki arabayı geçiyor."]]}
{"w":"diplômé","t":"sıfat","m":"diplomalı; mezun","s":["titulaire"],"a":[],"e":[["Il est diplômé de l'université de Lyon.","il e diplome dö lünivörsite dö liyon","Lyon Üniversitesi mezunu."],["Elle est diplômée en droit.","el e diplome an drua","Hukuk mezunu."]]}
{"w":"récent","t":"sıfat","m":"yakın zamanlı; yeni","s":["nouveau","dernier"],"a":["ancien"],"e":[["Ce film est très récent.","sö film e tre resan","Bu film çok yeni."],["Il parle d'un événement récent.","il parl den evenman resan","Yakın zamandaki bir olaydan söz ediyor."]]}
{"w":"gala","t":"isim (eril)","m":"gala","s":[],"a":[],"e":[["Elle porte une robe longue au gala.","el port ün rob long o gala","Galada uzun bir elbise giyiyor."],["Le gala de charité a lieu samedi.","lö gala dö şarite a lyö samdi","Hayır galası cumartesi yapılıyor."]]}
{"w":"quotidien","t":"sıfat","m":"günlük","s":["journalier"],"a":["exceptionnel"],"e":[["Il a une routine quotidienne.","il a ün rutin kotidyen","Günlük bir rutini var."],["Le pain est un aliment quotidien.","lö pen e ten alimant kotidyen","Ekmek günlük bir besindir."]]}
{"w":"fortement","t":"zarf","m":"güçlü bir şekilde","s":["vivement","intensément"],"a":["légèrement","faiblement"],"e":[["Il serre fortement la main.","il ser fortöman la men","Eli güçlüce sıkıyor."],["Je vous conseille fortement d'attendre.","jö vu konsey fortöman datandr","Beklemenizi şiddetle tavsiye ederim."]]}
{"w":"nouille","t":"isim (dişil)","m":"erişte; makarna","s":[],"a":[],"e":[["Il mange des nouilles au restaurant chinois.","il manj de nuy o restoran şinua","Çin restoranında erişte yiyor."],["Les nouilles cuisent dans l'eau chaude.","le nuy küiz dan lo şod","Erişteler sıcak suda pişiyor."]]}
{"w":"gravement","t":"zarf","m":"ciddi şekilde; ağır biçimde","s":["sérieusement","sévèrement"],"a":["légèrement"],"e":[["Il est gravement blessé.","il e gravman blese","Ağır yaralı."],["Sa santé est gravement atteinte.","sa sante e gravman atent","Sağlığı ciddi şekilde bozulmuş."]]}
{"w":"hypocrite","t":"sıfat","m":"ikiyüzlü","s":["faux","fourbe"],"a":["sincère","franc"],"e":[["Il est hypocrite avec ses amis.","il e tipokrit avek se zami","Arkadaşlarına karşı ikiyüzlü."],["Quelle réponse hypocrite !","kel repons ipokrit","Ne ikiyüzlü bir cevap!"]]}
{"w":"rassemblement","t":"isim (eril)","m":"toplantı; kalabalık","s":["réunion","attroupement"],"a":["dispersion"],"e":[["Un grand rassemblement a lieu sur la place.","en gran rasanblöman a lyö sür la plas","Meydanda büyük bir toplanma oluyor."],["La police disperse le rassemblement.","la polis dispers lö rasanblöman","Polis kalabalığı dağıtıyor."]]}
{"w":"valet","t":"isim (eril)","m":"uşak; vale (kart)","s":["serviteur","domestique"],"a":[],"e":[["Le valet porte les valises.","lö vale port le valiz","Uşak bavulları taşıyor."],["Il joue le valet de cœur.","il ju lö vale dö kör","Kupa valeyi oynuyor."]]}
{"w":"paysage","t":"isim (eril)","m":"manzara","s":["vue","décor"],"a":[],"e":[["Le paysage de la montagne est beau.","lö peyizaj dö la montany e bo","Dağın manzarası güzel."],["Ils admirent le paysage depuis la fenêtre.","il zadmir lö peyizaj döpüi la fönetr","Manzarayı pencereden seyrediyorlar."]]}
