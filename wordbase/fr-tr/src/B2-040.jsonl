{"w":"punaise","t":"isim (dişil)","m":"raptiye; tahtakurusu","s":["clou","insecte"],"a":[],"e":[["Il fixe l'affiche avec une punaise.","il fiks lafiş avek ün pünez","Afişi bir raptiyeyle tutturuyor."],["Une punaise vit dans le matelas.","ün pünez viv dan lö matla","Şiltede bir tahtakurusu yaşıyor."]]}
{"w":"clément","t":"sıfat","m":"ılıman; merhametli","s":["doux","indulgent"],"a":["rude","sévère"],"e":[["Le temps est clément en automne.","lö tan e kleman an oton","Hava sonbaharda ılıman."],["Le juge est clément avec lui.","lö jüj e kleman avek lüi","Hâkim ona karşı merhametli."]]}
{"w":"décent","t":"sıfat","m":"edepli; makul","s":["convenable","correct"],"a":["indécent","honteux"],"e":[["Il porte une tenue décente.","il port ün tönü desant","Edepli bir kıyafet giyiyor."],["Il gagne un salaire décent.","il gany en saler desan","Makul bir maaş kazanıyor."]]}
{"w":"norme","t":"isim (dişil)","m":"norm; standart","s":["standard","règle"],"a":["exception"],"e":[["Cette règle devient la norme.","set regl dövyen la norm","Bu kural norm haline geliyor."],["Le produit respecte les normes.","lö prodüi respekt le norm","Ürün standartlara uyuyor."]]}
{"w":"caresse","t":"isim (dişil)","m":"okşama","s":["câlin"],"a":["coup"],"e":[["Le chat aime les caresses.","lö şa em le kares","Kedi okşanmayı sever."],["Elle fait une caresse au chien.","el fe ün kares o şyen","Köpeği okşuyor."]]}
{"w":"tempérament","t":"isim (eril)","m":"mizaç; huy","s":["caractère","nature"],"a":[],"e":[["Il a un tempérament calme.","il a en tanperaman kalm","Sakin bir mizacı var."],["Son tempérament fort impressionne.","son tanperaman for enpresyon","Güçlü mizacı etkileyici."]]}
{"w":"immortalité","t":"isim (dişil)","m":"ölümsüzlük","s":["éternité"],"a":["mortalité"],"e":[["Il rêve d'immortalité.","il rev dimortalite","Ölümsüzlüğün hayalini kuruyor."],["L'immortalité n'existe pas.","limortalite negzist pa","Ölümsüzlük yoktur."]]}
{"w":"spot","t":"isim (eril)","m":"spot lambası; reklam filmi","s":["projecteur"],"a":[],"e":[["Un spot éclaire le tableau.","en spot ekler lö tablo","Bir spot lambası tabloyu aydınlatıyor."],["Il tourne un spot publicitaire.","il turn en spot püblisiter","Bir reklam filmi çekiyor."]]}
{"w":"dague","t":"isim (dişil)","m":"hançer","s":["poignard"],"a":[],"e":[["Le chevalier porte une dague.","lö şövalye port ün dag","Şövalye bir hançer taşıyor."],["La dague est cachée sous sa cape.","la dag e kaşe su sa kap","Hançer pelerininin altında saklı."]]}
{"w":"briefing","t":"isim (eril)","m":"bilgilendirme toplantısı","s":["réunion","instruction"],"a":[],"e":[["Le briefing commence à neuf heures.","lö brifing komans a nö vör","Bilgilendirme dokuzda başlıyor."],["Il prépare un briefing pour l'équipe.","il prepar en brifing pur lekip","Takım için bir bilgilendirme hazırlıyor."]]}
{"w":"démocrate","t":"isim (eril/dişil)","m":"demokrat","s":[],"a":["autocrate"],"e":[["Le démocrate défend la liberté.","lö demokrat defan la liberte","Demokrat özgürlüğü savunuyor."],["Ce démocrate vote pour la réforme.","sö demokrat vot pur la reform","Bu demokrat reform için oy veriyor."]]}
{"w":"représailles","t":"isim (dişil)","m":"misilleme","s":["vengeance","riposte"],"a":["pardon"],"e":[["Le pays craint des représailles.","lö pei kren de röprezay","Ülke misillemeden korkuyor."],["Il menace de représailles.","il mönas dö röprezay","Misilleme yapmakla tehdit ediyor."]]}
{"w":"cosmos","t":"isim (eril)","m":"evren; kozmos","s":["univers"],"a":["chaos"],"e":[["Il observe le cosmos avec un télescope.","il opserv lö kosmos avek en teleskop","Evreni bir teleskopla gözlemliyor."],["Le cosmos est immense.","lö kosmos e timans","Evren kocaman."]]}
{"w":"végétarien","t":"sıfat","m":"vejetaryen","s":[],"a":["carnivore"],"e":[["Elle suit un régime végétarien.","el süi en rejim vejetaryen","Vejetaryen bir diyet izliyor."],["Ce restaurant sert un menu végétarien.","sö restoran serv en mönü vejetaryen","Bu restoran vejetaryen bir menü sunuyor."]]}
{"w":"pancarte","t":"isim (dişil)","m":"pankart; levha","s":["panneau","écriteau"],"a":[],"e":[["Il lève une pancarte.","il lev ün pankart","Bir pankart kaldırıyor."],["La pancarte indique la sortie.","la pankart endik la sorti","Levha çıkışı gösteriyor."]]}
{"w":"confrérie","t":"isim (dişil)","m":"tarikat; kardeşlik","s":["association","corporation"],"a":[],"e":[["Il appartient à une confrérie secrète.","il apartyen a ün konfreri sökret","Gizli bir kardeşliğe mensup."],["La confrérie organise une fête.","la konfreri organiz ün fet","Kardeşlik bir şenlik düzenliyor."]]}
{"w":"patriote","t":"isim (eril/dişil)","m":"vatansever","s":["nationaliste"],"a":["traître"],"e":[["Ce patriote aime son pays.","sö patriyot em son pei","Bu vatansever ülkesini seviyor."],["Les patriotes défendent la nation.","le patriyot defand la nasyon","Vatanseverler ulusu savunuyor."]]}
{"w":"poire","t":"isim (dişil)","m":"armut","s":[],"a":[],"e":[["Elle mange une poire juteuse.","el manj ün puar jütöz","Sulu bir armut yiyor."],["Le jus de poire est doux.","lö jü dö puar e du","Armut suyu tatlı."]],"x":[["couper la poire en deux","kupe la puar an dö","orta yolu bulmak","On coupe la poire en deux.","on kup la puar an dö","Orta yolu buluyoruz."]]}
{"w":"actionnaire","t":"isim (eril/dişil)","m":"hissedar","s":[],"a":[],"e":[["L'actionnaire reçoit des dividendes.","laksyoner rösua de dividand","Hissedar temettü alıyor."],["Les actionnaires votent à l'assemblée.","le zaksyoner vot a lasanble","Hissedarlar genel kurulda oy veriyor."]]}
{"w":"perturbation","t":"isim (dişil)","m":"aksama; düzensizlik","s":["dérangement","trouble"],"a":["calme","ordre"],"e":[["Il y a une perturbation sur la ligne.","il i a ün pertürbasyon sür la linny","Hatta bir aksama var."],["La perturbation météo dure deux jours.","la pertürbasyon meteo dür dö jur","Hava bozukluğu iki gün sürüyor."]]}
{"w":"souverain","t":"isim (eril)","m":"hükümdar; egemen","s":["roi","monarque"],"a":["sujet"],"e":[["Le souverain reçoit les ambassadeurs.","lö suveren rösua le zanbasadör","Hükümdar büyükelçileri kabul ediyor."],["Le souverain gouverne avec sagesse.","lö suveren guvern avek sajes","Hükümdar bilgelikle yönetiyor."]]}
{"w":"excentrique","t":"sıfat","m":"tuhaf; sıra dışı","s":["original","bizarre"],"a":["ordinaire","banal"],"e":[["Il porte un chapeau excentrique.","il port en şapo eksantrik","Sıra dışı bir şapka takıyor."],["Son oncle est assez excentrique.","son onkl e tase eksantrik","Amcası oldukça tuhaf."]]}
{"w":"frustration","t":"isim (dişil)","m":"hayal kırıklığı; sinirlilik","s":["déception","dépit"],"a":["satisfaction"],"e":[["Il cache sa frustration.","il kaş sa früstrasyon","Hayal kırıklığını saklıyor."],["La frustration grandit avec l'attente.","la früstrasyon grandi avek latant","Hayal kırıklığı bekledikçe büyüyor."]]}
{"w":"lamentable","t":"sıfat","m":"içler acısı; berbat","s":["déplorable","pitoyable"],"a":["excellent","admirable"],"e":[["Son résultat est lamentable.","son rezülta e lamantabl","Sonucu içler acısı."],["Quelle erreur lamentable !","kel erör lamantabl","Ne berbat bir hata!"]]}
{"w":"bluff","t":"isim (eril)","m":"blöf","s":["feinte","tromperie"],"a":["vérité","franchise"],"e":[["C'est du bluff, il n'a rien.","se dü blöf il na ryen","Bu blöf, hiçbir şeyi yok."],["Son bluff marche à chaque fois.","son blöf marş a şak fua","Blöfü her seferinde işe yarıyor."]]}
{"w":"réflexe","t":"isim (eril)","m":"refleks","s":["automatisme","réaction"],"a":[],"e":[["Il a de bons réflexes.","il a dö bon refleks","İyi reflekslere sahip."],["Le médecin teste ses réflexes.","lö medsen test se refleks","Doktor reflekslerini test ediyor."]]}
{"w":"agrandir","t":"fiil","m":"büyütmek; genişletmek","s":["élargir","étendre"],"a":["rétrécir","réduire"],"e":[["Ils agrandissent la maison.","il zagrandis la mezon","Evi genişletiyorlar."],["Il veut agrandir son jardin.","il vö agrandir son jarden","Bahçesini büyütmek istiyor."]]}
{"w":"clochard","t":"isim (eril)","m":"serseri; evsiz","s":["sans-abri","vagabond"],"a":[],"e":[["Un clochard dort sur un banc.","en kloşar dor sür en ban","Bir evsiz bankta uyuyor."],["Elle donne du pain au clochard.","el don dü pen o kloşar","Evsize ekmek veriyor."]]}
{"w":"notaire","t":"isim (eril/dişil)","m":"noter","s":[],"a":[],"e":[["Le notaire lit le testament.","lö noter li lö testaman","Noter vasiyeti okuyor."],["Ils signent chez le notaire.","il siny şe lö noter","Noterde imza atıyorlar."]]}
{"w":"restaurer","t":"fiil","m":"restore etmek; onarmak","s":["rénover","réparer"],"a":["détruire","abîmer"],"e":[["Ils restaurent le vieux château.","il restor lö viyö şato","Eski şatoyu restore ediyorlar."],["Il restaure un meuble ancien.","il restor en möbl ansyen","Eski bir mobilyayı onarıyor."]]}
{"w":"compartiment","t":"isim (eril)","m":"kompartıman; bölme","s":["case","loge"],"a":[],"e":[["Il range son sac dans le compartiment.","il ranj son sak dan lö konpartiman","Çantasını bölmeye koyuyor."],["Le compartiment du train est vide.","lö konpartiman dü tren e vid","Trenin kompartımanı boş."]]}
{"w":"délinquant","t":"isim (eril)","m":"suçlu; kanun kaçağı","s":["criminel"],"a":[],"e":[["Le juge écoute le délinquant.","lö jüj ekut lö delenkan","Hâkim suçluyu dinliyor."],["Ce délinquant est mineur.","sö delenkan e minör","Bu suçlu reşit değil."]]}
{"w":"mémo","t":"isim (eril)","m":"not; hatırlatma notu","s":["note","pense-bête"],"a":[],"e":[["Il écrit un mémo pour l'équipe.","il ekri en memo pur lekip","Takım için bir not yazıyor."],["Le mémo est sur ton bureau.","lö memo e sür ton büro","Not masanın üzerinde."]]}
{"w":"copier","t":"fiil","m":"kopyalamak; taklit etmek","s":["imiter","reproduire"],"a":["créer","inventer"],"e":[["Il copie le texte du tableau.","il kopi lö tekst dü tablo","Tahtadaki metni kopyalıyor."],["Elle copie la réponse de son voisin.","el kopi la repons dö son vuazen","Komşusunun cevabını kopyalıyor."]]}
{"w":"congélateur","t":"isim (eril)","m":"derin dondurucu","s":["surgélateur"],"a":[],"e":[["Il met la viande au congélateur.","il me la vyand o konjelatör","Eti dondurucuya koyuyor."],["Le congélateur est plein.","lö konjelatör e plen","Dondurucu dolu."]]}
{"w":"contusion","t":"isim (dişil)","m":"çürük; ezilme","s":["bleu","ecchymose"],"a":[],"e":[["Il a une contusion à la jambe.","il a ün kontüzyon a la jamb","Bacağında bir ezik var."],["La contusion fait mal.","la kontüzyon fe mal","Ezik acıtıyor."]]}
{"w":"imprudent","t":"sıfat","m":"dikkatsiz; ihtiyatsız","s":["téméraire","irréfléchi"],"a":["prudent","sage"],"e":[["Il est imprudent au volant.","il e tenprüdan o volan","Direksiyonda dikkatsiz."],["Une réponse imprudente le met en danger.","ün repons enprüdant lö me an danje","Düşüncesiz bir cevap onu tehlikeye atıyor."]]}
{"w":"bandeau","t":"isim (eril)","m":"saç bandı; göz bağı","s":["serre-tête","ruban"],"a":[],"e":[["Elle met un bandeau dans ses cheveux.","el me en bando dan se şövö","Saçına bir toka takıyor."],["Un bandeau couvre ses yeux.","en bando kuvr se zyö","Bir bant gözlerini kapatıyor."]]}
{"w":"hormis","t":"edat","m":"-den başka; hariç","s":["sauf","excepté"],"a":["y compris","avec"],"e":[["Tout le monde est là, hormis Paul.","tu lö mond e la ormi pol","Herkes burada, Paul hariç."],["Hormis lui, personne ne parle.","ormi lüi personn nö parl","Ondan başka kimse konuşmuyor."]]}
{"w":"estimation","t":"isim (dişil)","m":"tahmin; değerlendirme","s":["évaluation","calcul"],"a":[],"e":[["Il demande une estimation du prix.","il dömand ün estimasyon dü pri","Fiyat için bir tahmin istiyor."],["Cette estimation est trop basse.","set estimasyon e tro bas","Bu tahmin çok düşük."]]}
{"w":"opérationnel","t":"sıfat","m":"işler durumda; operasyonel","s":["fonctionnel","prêt"],"a":["hors service","inopérant"],"e":[["Le système est opérationnel.","lö sistem e operasyonel","Sistem çalışır durumda."],["Cette équipe est déjà opérationnelle.","set ekip e deja operasyonel","Bu ekip şimdiden göreve hazır."]]}
{"w":"plaisant","t":"sıfat","m":"hoş; sevimli","s":["agréable","charmant"],"a":["désagréable","pénible"],"e":[["C'est un endroit plaisant.","se ten andrua plezan","Burası hoş bir yer."],["Il est un homme plaisant.","il e ten om plezan","Sevimli bir adam."]]}
{"w":"nourrice","t":"isim (dişil)","m":"dadı; sütanne","s":["gardienne","assistante maternelle"],"a":[],"e":[["La nourrice garde le bébé.","la nuris gard lö bebe","Dadı bebeğe bakıyor."],["Il cherche une nourrice pour son fils.","il şerş ün nuris pur son fis","Oğlu için bir dadı arıyor."]]}
{"w":"organique","t":"sıfat","m":"organik; canlıyla ilgili","s":["biologique","vivant"],"a":["minéral","synthétique"],"e":[["Les déchets organiques servent d'engrais.","le deşe organik serv dangre","Organik atıklar gübre olarak kullanılır."],["Elle étudie la chimie organique.","el etüdi la şimi organik","Organik kimya okuyor."]]}
{"w":"brusquement","t":"zarf","m":"ani bir şekilde; sertçe","s":["soudain","subitement"],"a":["doucement","lentement"],"e":[["La voiture freine brusquement.","la vuatür fren brüskman","Araba aniden fren yapıyor."],["Il se retourne brusquement.","il sö rötürn brüskman","Aniden arkasını dönüyor."]]}
{"w":"essentiellement","t":"zarf","m":"esas olarak; özünde","s":["principalement","surtout"],"a":["accessoirement"],"e":[["Il mange essentiellement des légumes.","il manj esansyelman de legüm","Esas olarak sebze yiyor."],["Ce film parle essentiellement d'amitié.","sö film parl esansyelman damitye","Bu film esas olarak dostluktan söz ediyor."]]}
{"w":"brebis","t":"isim (dişil)","m":"dişi koyun","s":["mouton"],"a":["bélier"],"e":[["La brebis nourrit son agneau.","la bröbi nuri son anyo","Koyun kuzusunu besliyor."],["Le berger compte ses brebis.","lö berje kont se bröbi","Çoban koyunlarını sayıyor."]],"x":[["brebis galeuse","bröbi galöz","ailenin kara koyunu","Il est la brebis galeuse de la famille.","il e la bröbi galöz dö la famiy","O ailenin kara koyunu."]]}
{"w":"fourrière","t":"isim (dişil)","m":"çekilen araç otoparkı; hayvan barınağı","s":["dépôt"],"a":[],"e":[["Sa voiture est à la fourrière.","sa vuatür e ta la furyer","Arabası çekilen araç otoparkında."],["Il paie pour sortir de la fourrière.","il pe pur sortir dö la furyer","Otoparktan çıkarmak için ödeme yapıyor."]]}
{"w":"transplantation","t":"isim (dişil)","m":"organ nakli","s":["greffe"],"a":[],"e":[["Il attend une transplantation du cœur.","il atan ün transplantasyon dü kör","Kalp nakli bekliyor."],["La transplantation réussit bien.","la transplantasyon reüsi byen","Nakil başarıyla sonuçlanıyor."]]}
{"w":"intestin","t":"isim (eril)","m":"bağırsak","s":["boyau"],"a":[],"e":[["Le médecin examine l'intestin.","lö medsen egzamin lentesten","Doktor bağırsağı inceliyor."],["L'intestin absorbe les nutriments.","lentesten apsorb le nütriman","Bağırsak besin maddelerini emiyor."]]}
