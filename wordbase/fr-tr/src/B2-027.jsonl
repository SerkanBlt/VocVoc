{"w":"projection","t":"isim (dişil)","m":"gösterim; yansıtma; tahmin","s":["prévision","diffusion"],"a":[],"e":[["La projection du film commence à huit heures.","la projeksyon dü film komans a üi tör","Filmin gösterimi sekizde başlıyor."],["Les projections montrent une hausse.","le projeksyon montr ün os","Tahminler bir artış gösteriyor."]]}
{"w":"étincelle","t":"isim (dişil)","m":"kıvılcım","s":["flamme","lueur"],"a":[],"e":[["Une étincelle allume le feu.","ün etensel alüm lö fö","Bir kıvılcım ateşi yakıyor."],["Il y a une étincelle dans ses yeux.","il i a ün etensel dan se zyö","Gözlerinde bir parıltı var."]]}
{"w":"smoking","t":"isim (eril)","m":"smokin","s":[],"a":[],"e":[["Il porte un smoking noir au gala.","il port en smokin nuar o gala","Galada siyah bir smokin giyiyor."],["Le marié met son smoking.","lö marye me son smokin","Damat smokinini giyiyor."]]}
{"w":"cowboy","t":"isim (eril)","m":"kovboy","s":[],"a":[],"e":[["Le cowboy monte à cheval.","lö koboy mont a şöval","Kovboy ata biniyor."],["Les enfants jouent aux cowboys.","le zanfan ju o koboy","Çocuklar kovboy oynuyor."]]}
{"w":"scorpion","t":"isim (eril)","m":"akrep","s":[],"a":[],"e":[["Le scorpion vit dans le désert.","lö skorpyon viv dan lö dezer","Akrep çölde yaşıyor."],["Une piqûre de scorpion est dangereuse.","ün pikür dö skorpyon e danjeröz","Akrep sokması tehlikelidir."]]}
