{"w":"banquet","t":"isim (eril)","m":"ziyafet","s":["festin","repas de fête"],"a":[],"e":[["Le banquet de mariage dure toute la nuit.","lö banke dö maryaj dür tut la nüi","Düğün ziyafeti bütün gece sürüyor."],["Ils organisent un grand banquet.","il zorganiz en gran banke","Büyük bir ziyafet düzenliyorlar."]]}
{"w":"allusion","t":"isim (dişil)","m":"ima; telmih","s":["sous-entendu","référence"],"a":[],"e":[["Il fait allusion à son passé.","il fe alüzyon a son pase","Geçmişine ima yapıyor."],["Je ne comprends pas ton allusion.","jö nö kompran pa ton nalüzyon","İmanı anlamıyorum."]]}
{"w":"audacieux","t":"sıfat","m":"cesur; atılgan","s":["hardi","courageux"],"a":["timide","prudent"],"e":[["C'est un projet audacieux.","se ten proje odasyö","Bu cesur bir proje."],["Il a un plan audacieux.","il a en plan odasyö","Cesur bir planı var."]]}
{"w":"marrer","t":"fiil","m":"gülmek; eğlenmek (günlük dil)","s":["rire","rigoler"],"a":["pleurer"],"e":[["On se marre bien avec lui.","on sö mar byen avek lüi","Onunla çok gülüyoruz."],["Il se marre de tout.","il sö mar dö tu","Her şeye gülüyor."]]}
{"w":"composition","t":"isim (dişil)","m":"bileşim; kompozisyon","s":["structure","création"],"a":[],"e":[["La composition de ce plat est simple.","la konpozisyon dö sö pla e senpl","Bu yemeğin bileşimi basit."],["Elle écrit une composition de français.","el ekri ün konpozisyon dö franse","Fransızca kompozisyon yazıyor."]]}
{"w":"inculper","t":"fiil","m":"suçlamak; itham etmek","s":["accuser","poursuivre"],"a":["innocenter","disculper"],"e":[["La police inculpe le suspect.","la polis enkülp lö süspe","Polis şüpheliyi itham ediyor."],["Il est inculpé de vol.","il e tenkülpe dö vol","Hırsızlıkla itham ediliyor."]]}
{"w":"barque","t":"isim (dişil)","m":"kayık","s":["bateau","canot"],"a":[],"e":[["Ils traversent le lac en barque.","il travers lö lak an bark","Gölü kayıkla geçiyorlar."],["La barque est attachée au quai.","la bark e tataşe o ke","Kayık rıhtıma bağlı."]]}
{"w":"divertissement","t":"isim (eril)","m":"eğlence","s":["distraction","loisir"],"a":["travail","ennui"],"e":[["Le cinéma est un bon divertissement.","lö sinema e ten bon divertisman","Sinema iyi bir eğlence."],["Ils cherchent un divertissement pour le soir.","il şerş en divertisman pur lö suar","Akşam için bir eğlence arıyorlar."]]}
{"w":"impitoyable","t":"sıfat","m":"acımasız","s":["cruel","dur"],"a":["clément","tendre"],"e":[["Le juge est impitoyable.","lö jüj e tenpituayabl","Hâkim acımasız."],["C'est un combat impitoyable.","se ten konba enpituayabl","Bu acımasız bir mücadele."]]}
{"w":"songe","t":"isim (eril)","m":"rüya (edebî)","s":["rêve"],"a":["réalité"],"e":[["Il fait un songe étrange.","il fe en sonj etranj","Garip bir rüya görüyor."],["Ce n'était qu'un songe.","sö nete ken sonj","Bu sadece bir rüyaydı."]]}
{"w":"réviser","t":"fiil","m":"gözden geçirmek; tekrar etmek","s":["relire","revoir"],"a":[],"e":[["Il révise ses leçons avant l'examen.","il revize se löson avan legzamen","Sınavdan önce derslerini tekrar ediyor."],["Le mécanicien révise la voiture.","lö mekanisyen revize la vuatür","Tamirci arabanın bakımını yapıyor."]]}
{"w":"extraction","t":"isim (dişil)","m":"çıkarma; çekme","s":["retrait","exploitation"],"a":["insertion"],"e":[["L'extraction du pétrole est coûteuse.","lekstraksyon dü petrol e kutöz","Petrol çıkarımı pahalı."],["Le dentiste fait une extraction.","lö dantist fe ün ekstraksyon","Diş hekimi bir diş çekimi yapıyor."]]}
{"w":"fax","t":"isim (eril)","m":"faks","s":[],"a":[],"e":[["Il envoie un fax au bureau.","il anvua en faks o bürö","Büroya bir faks gönderiyor."],["Le fax est une machine ancienne.","lö faks e tün maşin ansyen","Faks eski bir makine."]]}
{"w":"étroit","t":"sıfat","m":"dar","s":["serré","resserré"],"a":["large","spacieux"],"e":[["La rue est trop étroite.","la rü e tro zetruat","Sokak çok dar."],["Il porte un pantalon étroit.","il port en pantalon etrua","Dar bir pantolon giyiyor."]]}
{"w":"polo","t":"isim (eril)","m":"polo yaka tişört","s":[],"a":[],"e":[["Il porte un polo blanc.","il port en polo blan","Beyaz bir polo yaka giyiyor."],["Ce polo est en coton.","sö polo e tan koton","Bu polo pamuklu."]]}
{"w":"tank","t":"isim (eril)","m":"tank; depo","s":[],"a":[],"e":[["Le tank traverse la rue.","lö tank traver la rü","Tank sokağı geçiyor."],["Le tank est rempli d'eau.","lö tank e ranpli do","Depo suyla dolu."]]}
