{"w":"extinction","t":"isim (dişil)","m":"sönme; nesli tükenme","s":["disparition","fin"],"a":["apparition"],"e":[["Cet animal est en voie d'extinction.","set animal e tan vua dekstenksyon","Bu hayvanın nesli tükenmek üzere."],["L'extinction des lumières a lieu à dix heures.","lekstenksyon de lümyer a lyö a di zör","Işıkların söndürülmesi onda yapılıyor."]]}
{"w":"annuaire","t":"isim (eril)","m":"rehber; yıllık","s":["répertoire","liste"],"a":[],"e":[["Il cherche son nom dans l'annuaire.","il şerş son non dan lanüer","Adını rehberde arıyor."],["L'annuaire de l'école est en ligne.","lanüer dö lekol e tan liny","Okulun rehberi çevrimiçi."]]}
{"w":"exil","t":"isim (eril)","m":"sürgün","s":["bannissement","expatriation"],"a":["retour"],"e":[["Le poète vit en exil.","lö poet viv an egzil","Şair sürgünde yaşıyor."],["Il choisit l'exil pour sa sécurité.","il şuazi legzil pur sa sekürite","Güvenliği için sürgünü seçiyor."]]}
