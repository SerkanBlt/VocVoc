{"w":"diplomatique","t":"sıfat","m":"diplomatik","s":["tactique","poli"],"a":[],"e":[["Les deux pays ont des relations diplomatiques.","le dö pei zon de rölasyon diplomatik","İki ülkenin diplomatik ilişkileri var."],["Il donne une réponse diplomatique.","il don ün repons diplomatik","Diplomatik bir cevap veriyor."]]}
{"w":"suédois","t":"sıfat","m":"İsveçli","s":[],"a":[],"e":[["Il parle suédois.","il parl süedua","İsveççe konuşuyor."],["Le design suédois est célèbre.","lö dizayn süedua e selebr","İsveç tasarımı ünlüdür."]]}
