{"w":"lumineux","t":"sıfat","m":"aydınlık; parlak","s":["brillant","éclatant"],"a":["sombre","obscur"],"e":[["Le salon est très lumineux.","lö salon e tre lüminö","Salon çok aydınlık."],["C'est un sourire lumineux.","se ten surir lüminö","Bu parlak bir gülümseme."]]}
{"w":"animé","t":"sıfat","m":"canlı; hareketli","s":["vivant","vif"],"a":["calme","inanimé"],"e":[["La rue est très animée le soir.","la rü e tre zanime lö suar","Sokak akşamları çok canlı."],["Il regarde un dessin animé.","il rögard en desen anime","Bir çizgi film izliyor."]]}
{"w":"boulette","t":"isim (dişil)","m":"köfte; gaf","s":["boule","erreur"],"a":[],"e":[["Elle prépare des boulettes de viande.","el prepar de bulet dö vyand","Etli köfteler hazırlıyor."],["Il fait une grosse boulette.","il fe ün gros bulet","Büyük bir gaf yapıyor."]]}
{"w":"jean","t":"isim (eril)","m":"kot pantolon","s":[],"a":[],"e":[["Il porte un jean bleu.","il port en jin blö","Mavi bir kot pantolon giyiyor."],["Elle achète un nouveau jean.","el aşet en nuvo jin","Yeni bir kot pantolon alıyor."]]}
{"w":"infraction","t":"isim (dişil)","m":"ihlal; suç","s":["délit","violation"],"a":[],"e":[["Il commet une infraction au code de la route.","il kome tün enfraksyon o kod dö la rut","Trafik kurallarını ihlal ediyor."],["L'infraction est punie d'une amende.","lenfraksyon e püni dün amand","İhlal para cezasıyla cezalandırılıyor."]]}
