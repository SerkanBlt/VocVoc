{"w":"ressentiment","t":"isim (eril)","m":"kin; hınç","s":["rancœur","amertume"],"a":["pardon"],"e":[["Il garde du ressentiment contre son frère.","il gard dü rösantiman kontr son frer","Kardeşine karşı kin besliyor."],["Le ressentiment grandit avec le temps.","lö rösantiman grandi avek lö tan","Hınç zamanla büyüyor."]]}
{"w":"aimant","t":"sıfat","m":"sevgi dolu","s":["affectueux","tendre"],"a":["froid"],"e":[["C'est un père très aimant.","se ten per tre zeman","O çok sevgi dolu bir baba."],["Elle est une mère aimante.","el e tün mer emant","Sevgi dolu bir anne."]]}
{"w":"gronder","t":"fiil","m":"azarlamak; gürlemek","s":["réprimander","disputer"],"a":["féliciter","louer"],"e":[["La mère gronde son fils.","la mer grond son fis","Anne oğlunu azarlıyor."],["Le tonnerre gronde au loin.","lö toner grond o luen","Gök gürültüsü uzaktan gümbürdüyor."]]}
{"w":"débarquement","t":"isim (eril)","m":"karaya çıkarma","s":["arrivée","descente"],"a":["embarquement"],"e":[["Le débarquement a lieu à l'aube.","lö debarköman a lyö a lob","Çıkarma şafakta yapılıyor."],["Les soldats préparent le débarquement.","le solda prepar lö debarköman","Askerler çıkarmaya hazırlanıyor."]]}
{"w":"manipulateur","t":"isim (eril)","m":"manipülatör; hileci","s":["menteur","calculateur"],"a":["honnête"],"e":[["Le manipulateur contrôle son entourage.","lö manipülatör kontrol son anturaj","Manipülatör çevresini kontrol ediyor."],["Il est un manipulateur dangereux.","il e ten manipülatör danjörö","Tehlikeli bir manipülatör."]]}
{"w":"oseille","t":"isim (dişil)","m":"kuzukulağı; (argo) para","s":["plante","argent"],"a":[],"e":[["La soupe à l'oseille est acide.","la sup a lozey e tasid","Kuzukulağı çorbası ekşi."],["Il n'a plus d'oseille ce mois-ci.","il na plü dozey sö mua si","Bu ay parası kalmadı."]]}
{"w":"sanctifier","t":"fiil","m":"kutsamak","s":["consacrer","bénir"],"a":["profaner"],"e":[["Le prêtre sanctifie le lieu.","lö pretr sanktifi lö lyö","Rahip mekânı kutsuyor."],["On sanctifie le nom de Dieu.","on sanktifi lö non dö dyö","Tanrı'nın adı kutsanıyor."]]}
{"w":"écouler","t":"fiil","m":"akıtmak; (mal) satmak","s":["vendre","s'évacuer"],"a":[],"e":[["Il écoule ses marchandises rapidement.","il ekul se marşandiz rapidman","Mallarını hızla satıyor."],["L'eau s'écoule dans le ruisseau.","lo sekul dan lö rüiso","Su dereye akıyor."]]}
{"w":"radieux","t":"sıfat","m":"ışıl ışıl; neşeli","s":["resplendissant","heureux"],"a":["sombre","triste"],"e":[["Elle a un sourire radieux.","el a en surir radyö","Işıl ışıl bir gülümsemesi var."],["Le soleil radieux brille ce matin.","lö soley radyö briy sö maten","Parlak güneş bu sabah ışıldıyor."]]}
{"w":"biblique","t":"sıfat","m":"İncil'e ait","s":[],"a":[],"e":[["Il cite une histoire biblique.","il sit ün istuar biblik","İncil'den bir hikâye anıyor."],["Le déluge est un récit biblique.","lö delüj e ten resi biblik","Tufan İncil'den bir anlatıdır."]]}
{"w":"glaçage","t":"isim (eril)","m":"krema kaplama (pasta)","s":["nappage"],"a":[],"e":[["Le glaçage au chocolat est brillant.","lö glasaj o şokola e briyan","Çikolatalı kaplama parlak."],["Elle prépare le glaçage du gâteau.","el prepar lö glasaj dü gato","Pastanın kaplamasını hazırlıyor."]]}
{"w":"suspicieux","t":"sıfat","m":"şüpheci","s":["méfiant","soupçonneux"],"a":["confiant"],"e":[["Il lance un regard suspicieux.","il lans en rögar süspisyö","Şüpheci bir bakış atıyor."],["Un gardien suspicieux surveille la porte.","en gardyen süspisyö sürvey la port","Şüpheci bir nöbetçi kapıyı gözetliyor."]]}
{"w":"rechute","t":"isim (dişil)","m":"nüks","s":["récidive","reprise"],"a":["guérison"],"e":[["Il fait une rechute de la maladie.","il fe ün röşüt dö la maladi","Hastalığı nüksediyor."],["La rechute est plus grave.","la röşüt e plü grav","Nüks daha ağır."]]}
{"w":"torchon","t":"isim (eril)","m":"mutfak bezi","s":["chiffon"],"a":[],"e":[["Elle sèche la vaisselle avec un torchon.","el seş la vesel avek en torşon","Bulaşıkları bir bezle kurutuyor."],["Le torchon est sale.","lö torşon e sal","Mutfak bezi kirli."]]}
{"w":"climatisation","t":"isim (dişil)","m":"klima","s":["air conditionné"],"a":["chauffage"],"e":[["La climatisation fonctionne bien.","la klimatizasyon fonksyon byen","Klima iyi çalışıyor."],["Il allume la climatisation.","il alüm la klimatizasyon","Klimayı açıyor."]]}
{"w":"canoë","t":"isim (eril)","m":"kano","s":[],"a":[],"e":[["Ils descendent la rivière en canoë.","il desan la rivyer an kanoe","Nehirden kanoyla iniyorlar."],["Le canoë glisse sur l'eau.","lö kanoe glis sür lo","Kano suyun üzerinde kayıyor."]]}
{"w":"dysfonctionnement","t":"isim (eril)","m":"aksama; işlev bozukluğu","s":["panne","défaillance"],"a":["fonctionnement"],"e":[["Un dysfonctionnement bloque le système.","en disfonksyonman blok lö sistem","Bir aksama sistemi kilitliyor."],["Ils étudient le dysfonctionnement.","il zetüdi lö disfonksyonman","Aksamayı inceliyorlar."]]}
{"w":"relique","t":"isim (dişil)","m":"kutsal emanet; yadigâr","s":["souvenir","vestige"],"a":[],"e":[["L'église garde une relique.","legliz gard ün rölik","Kilise bir kutsal emanet saklıyor."],["Cette montre est une relique de famille.","set montr e tün rölik dö famiy","Bu saat bir aile yadigârı."]]}
{"w":"escargot","t":"isim (eril)","m":"salyangoz","s":[],"a":[],"e":[["Il mange des escargots à l'ail.","il manj de zeskargo a lay","Sarımsaklı salyangoz yiyor."],["L'escargot avance lentement.","leskargo avans lantman","Salyangoz yavaşça ilerliyor."]]}
{"w":"affront","t":"isim (eril)","m":"hakaret; yüz kızartıcı davranış","s":["insulte","offense"],"a":["hommage"],"e":[["Il subit un affront public.","il sübi en nafron püblik","Herkesin önünde bir hakarete uğruyor."],["Cette remarque est un affront.","set römark e ten nafron","Bu söz bir hakaret."]]}
{"w":"étourdi","t":"sıfat","m":"dalgın; sersem","s":["distrait","tête en l'air"],"a":["attentif","sérieux"],"e":[["Il est étourdi et oublie ses clés.","il e teturdi e ubli se kle","Dalgın, anahtarlarını unutuyor."],["Un élève étourdi perd ses affaires.","en nelev eturdi per se zafer","Dalgın bir öğrenci eşyalarını kaybeder."]]}
{"w":"gaillard","t":"isim (eril)","m":"güçlü delikanlı","s":["costaud","gars"],"a":[],"e":[["Ce gaillard soulève le sac.","sö gayar sulev lö sak","Bu güçlü delikanlı çuvalı kaldırıyor."],["Quel gaillard !","kel gayar","Ne yiğit adam!"]]}
{"w":"ténébreux","t":"sıfat","m":"karanlık; esrarengiz","s":["sombre","mystérieux"],"a":["lumineux","clair"],"e":[["Il a un regard ténébreux.","il a en rögar tenebrö","Esrarengiz bir bakışı var."],["Un homme ténébreux entre dans la salle.","en nom tenebrö antr dan la sal","Esrarengiz bir adam salona giriyor."]]}
{"w":"acceptation","t":"isim (dişil)","m":"kabul","s":["accord","approbation"],"a":["refus"],"e":[["L'acceptation de la défaite est dure.","lakseptasyon dö la defet e dür","Yenilgiyi kabullenmek zor."],["Il montre son acceptation.","il montr son nakseptasyon","Kabullendiğini gösteriyor."]]}
{"w":"croquette","t":"isim (dişil)","m":"kroket; (köpek) kuru mama","s":["boulette"],"a":[],"e":[["Il donne des croquettes au chien.","il don de kroket o şyen","Köpeğe kuru mama veriyor."],["Les croquettes de poisson sont chaudes.","le kroket dö puason son şod","Balık kroketleri sıcak."]]}
{"w":"lépreux","t":"isim (eril)","m":"cüzamlı","s":[],"a":[],"e":[["Le lépreux vit à l'écart.","lö leprö viv a lekar","Cüzamlı ayrı yaşıyor."],["On soigne les lépreux à l'hôpital.","on suany le leprö a lopital","Cüzamlılar hastanede tedavi ediliyor."]]}
{"w":"marchander","t":"fiil","m":"pazarlık etmek","s":["négocier","discuter"],"a":[],"e":[["Il marchande le prix du tapis.","il marşand lö pri dü tapi","Halının fiyatı için pazarlık ediyor."],["Elle aime marchander au marché.","el em marşande o marşe","Pazarda pazarlık yapmayı seviyor."]]}
{"w":"abbaye","t":"isim (dişil)","m":"manastır; abbey","s":["monastère"],"a":[],"e":[["L'abbaye se trouve sur la colline.","labei sö truv sür la kolin","Manastır tepenin üstünde."],["Les moines vivent à l'abbaye.","le muan viv a labei","Keşişler manastırda yaşıyor."]]}
{"w":"vertueux","t":"sıfat","m":"erdemli","s":["honnête","moral"],"a":["vicieux","corrompu"],"e":[["C'est un homme vertueux.","se ten nom vertüö","O erdemli bir adam."],["Un citoyen vertueux respecte la loi.","en sitüayen vertüö respekt la lua","Erdemli bir vatandaş yasaya saygı gösterir."]]}
{"w":"tourmenté","t":"sıfat","m":"huzursuz; çalkantılı","s":["agité","angoissé"],"a":["serein","calme"],"e":[["C'est un artiste tourmenté.","se ten nartist turmante","O huzursuz bir sanatçı."],["La mer tourmentée effraie les marins.","la mer turmante efre le maren","Çalkantılı deniz denizcileri korkutuyor."]]}
{"w":"prédécesseur","t":"isim (eril)","m":"selef; öncel","s":["ancêtre","précurseur"],"a":["successeur"],"e":[["Il remplace son prédécesseur.","il ranplas son predesesör","Selefinin yerini alıyor."],["Le prédécesseur laisse un bon bilan.","lö predesesör les en bon bilan","Selef iyi bir bilanço bırakıyor."]]}
{"w":"utilisateur","t":"isim (eril)","m":"kullanıcı","s":["usager","client"],"a":[],"e":[["L'utilisateur crée un compte.","lütilizatör kre en kont","Kullanıcı bir hesap oluşturuyor."],["Les utilisateurs aiment cette application.","le zütilizatör em set aplikasyon","Kullanıcılar bu uygulamayı seviyor."]]}
{"w":"rôder","t":"fiil","m":"dolaşmak (şüpheli biçimde)","s":["traîner","errer"],"a":[],"e":[["Un inconnu rôde autour de la maison.","en nenkonü rod otur dö la mezon","Yabancı biri evin çevresinde dolaşıyor."],["Le loup rôde près du village.","lö lu rod pre dü vilaj","Kurt köyün yakınında dolaşıyor."]]}
{"w":"pédiatrie","t":"isim (dişil)","m":"pediatri","s":[],"a":[],"e":[["Elle travaille en pédiatrie.","el travay an pediyatri","Pediatri alanında çalışıyor."],["Le service de pédiatrie est complet.","lö servis dö pediyatri e konple","Pediatri servisi dolu."]]}
{"w":"interner","t":"fiil","m":"hastaneye yatırmak; kapatmak","s":["enfermer","hospitaliser"],"a":["libérer"],"e":[["On interne le malade à l'hôpital.","on entern lö malad a lopital","Hasta hastaneye yatırılıyor."],["La police interne les suspects.","la polis entern le süspe","Polis şüphelileri tutuyor."]]}
{"w":"feuilleton","t":"isim (eril)","m":"dizi; tefrika","s":["série","saga"],"a":[],"e":[["Elle regarde un feuilleton le soir.","el rögard en föyton lö suar","Akşamları bir dizi izliyor."],["Le journal publie un feuilleton.","lö jurnal pübli en föyton","Gazete bir tefrika yayımlıyor."]]}
{"w":"entorse","t":"isim (dişil)","m":"burkulma","s":["foulure"],"a":[],"e":[["Il se fait une entorse à la cheville.","il sö fe ün antors a la şeviy","Ayak bileğini burkuyor."],["L'entorse guérit en deux semaines.","lantors geri an dö sömen","Burkulma iki haftada iyileşiyor."]]}
{"w":"lama","t":"isim (eril)","m":"lama","s":[],"a":[],"e":[["Le lama vit dans les montagnes.","lö lama viv dan le montany","Lama dağlarda yaşıyor."],["Le lama porte des charges.","lö lama port de şarj","Lama yük taşıyor."]]}
{"w":"échéance","t":"isim (dişil)","m":"vade","s":["délai","terme"],"a":[],"e":[["L'échéance du paiement approche.","leşeans dü peman aproş","Ödemenin vadesi yaklaşıyor."],["Il respecte toutes les échéances.","il respekt tut le zeşeans","Bütün vadelere uyuyor."]]}
{"w":"tardif","t":"sıfat","m":"geç","s":["en retard","retardé"],"a":["précoce","hâtif"],"e":[["C'est un repas tardif.","se ten röpa tardif","Bu geç bir yemek."],["Il fait un réveil tardif.","il fe en revey tardif","Geç uyanıyor."]]}
{"w":"inconsciemment","t":"zarf","m":"bilinçsizce","s":["involontairement","machinalement"],"a":["consciemment"],"e":[["Il agit inconsciemment.","il aji enkonsyaman","Bilinçsizce hareket ediyor."],["Elle sourit inconsciemment.","el suri enkonsyaman","Farkına varmadan gülümsüyor."]]}
{"w":"précéder","t":"fiil","m":"önüne geçmek; öncesinde olmak","s":["devancer"],"a":["suivre"],"e":[["Le roi précède son armée.","lö rua presed son narme","Kral ordusunun önünde gidiyor."],["Un orage précède la pluie.","en noraj presed la plüi","Bir fırtına yağmurdan önce gelir."]]}
{"w":"stratagème","t":"isim (eril)","m":"oyun; hile","s":["ruse","manœuvre"],"a":[],"e":[["Il utilise un stratagème pour gagner.","il ütiliz en stratajem pur gane","Kazanmak için bir oyun kullanıyor."],["Ce stratagème trompe l'ennemi.","sö stratajem tronp lenömi","Bu hile düşmanı yanıltıyor."]]}
{"w":"épuiser","t":"fiil","m":"tüketmek; bitirmek","s":["fatiguer","vider"],"a":["reposer","remplir"],"e":[["Le travail l'épuise.","lö travay lepüiz","İş onu tüketiyor."],["Il épuise toutes ses économies.","il epüiz tut se zekonomi","Bütün birikimini tüketiyor."]]}
{"w":"hallucinant","t":"sıfat","m":"inanılmaz; hayret verici","s":["incroyable","extraordinaire"],"a":["banal"],"e":[["Ce paysage est hallucinant.","sö peizaj e talüsinan","Bu manzara inanılmaz."],["Il a une mémoire hallucinante.","il a ün memuar alüsinant","İnanılmaz bir hafızası var."]]}
{"w":"repérage","t":"isim (eril)","m":"yer tespiti; keşif","s":["localisation","détection"],"a":[],"e":[["Le repérage du lieu prend du temps.","lö röperaj dü lyö pran dü tan","Yerin tespiti zaman alıyor."],["Ils font un repérage avant le tournage.","il fon en röperaj avan lö turnaj","Çekimden önce keşif yapıyorlar."]]}
{"w":"schizophrénie","t":"isim (dişil)","m":"şizofreni","s":[],"a":[],"e":[["Il souffre de schizophrénie.","il süfr dö skizofreni","Şizofrenisi var."],["La schizophrénie demande un traitement.","la skizofreni dömand en tretman","Şizofreni tedavi gerektirir."]]}
{"w":"surplus","t":"isim (eril)","m":"fazla; artık","s":["excédent","reste"],"a":["manque"],"e":[["Le surplus de lait est vendu.","lö sürplü dö le e vandü","Fazla süt satılıyor."],["Il vend le surplus au marché.","il van lö sürplü o marşe","Fazlalığı pazarda satıyor."]]}
{"w":"natal","t":"sıfat","m":"doğduğu yer","s":["d'origine"],"a":[],"e":[["Il revient dans son village natal.","il rövyen dan son vilaj natal","Doğduğu köye geri dönüyor."],["Elle aime sa ville natale.","el em sa vil natal","Doğduğu şehri seviyor."]]}
{"w":"ligoter","t":"fiil","m":"bağlamak","s":["attacher","enchaîner"],"a":["délier"],"e":[["Les voleurs ligotent le gardien.","le volör ligot lö gardyen","Hırsızlar nöbetçiyi bağlıyor."],["Ils ligotent ses mains.","il ligot se men","Ellerini bağlıyorlar."]]}
