{"w":"incarcération","t":"isim (dişil)","m":"hapse atılma","s":["emprisonnement","détention"],"a":["libération"],"e":[["Son incarcération dure cinq ans.","son nenkarserasyon dür sank an","Hapis cezası beş yıl sürüyor."],["L'incarcération du suspect est confirmée.","lenkarserasyon dü süspe e konfirme","Şüphelinin tutuklanması onaylandı."]]}
{"w":"dissimulation","t":"isim (dişil)","m":"gizleme; ikiyüzlülük","s":["camouflage","hypocrisie"],"a":["franchise","aveu"],"e":[["Il agit avec dissimulation.","il aji avek disimülasyon","Gizli saklı hareket ediyor."],["La dissimulation des preuves est un délit.","la disimülasyon de pröv e ten deli","Delillerin saklanması bir suçtur."]]}
{"w":"médiateur","t":"isim (eril)","m":"arabulucu","s":["conciliateur","intermédiaire"],"a":[],"e":[["Le médiateur résout le conflit.","lö medyatör rezu lö konfli","Arabulucu çatışmayı çözüyor."],["Un médiateur parle aux deux parties.","en medyatör parl o dö parti","Bir arabulucu iki tarafla konuşuyor."]]}
{"w":"écologique","t":"sıfat","m":"ekolojik; çevre dostu","s":["vert"],"a":["polluant"],"e":[["Il achète une voiture écologique.","il aşet ün vuatür ekolojik","Çevre dostu bir araba satın alıyor."],["C'est un choix écologique.","se ten şua ekolojik","Bu çevre dostu bir seçim."]]}
{"w":"tangible","t":"sıfat","m":"somut; elle tutulur","s":["concret","palpable"],"a":["abstrait","vague"],"e":[["Il demande une preuve tangible.","il dömand ün pröv tanjibl","Somut bir kanıt istiyor."],["Les résultats sont tangibles.","le rezülta son tanjibl","Sonuçlar somut."]]}
{"w":"interphone","t":"isim (eril)","m":"interkom","s":[],"a":[],"e":[["Il appuie sur l'interphone.","il apüi sür lenterfon","İnterkoma basıyor."],["Le gardien répond à l'interphone.","lö gardyen repon a lenterfon","Kapıcı interkoma cevap veriyor."]]}
{"w":"autodéfense","t":"isim (dişil)","m":"meşru müdafaa","s":["légitime défense"],"a":["agression"],"e":[["Il apprend l'autodéfense.","il aprand lotodefans","Kendini savunmayı öğreniyor."],["Elle suit un cours d'autodéfense.","el süi en kur dotodefans","Kendini savunma dersi alıyor."]]}
{"w":"salin","t":"sıfat","m":"tuzlu","s":["salé"],"a":["doux"],"e":[["L'air salin sent la mer.","ler salen san la mer","Tuzlu hava deniz kokuyor."],["La solution saline calme la douleur.","la solüsyon salin kalm la dulör","Tuzlu çözelti ağrıyı dindiriyor."]]}
{"w":"orateur","t":"isim (eril)","m":"hatip; konuşmacı","s":["conférencier","tribun"],"a":[],"e":[["L'orateur parle devant la foule.","loratör parl dövan la ful","Konuşmacı kalabalığın önünde konuşuyor."],["Cet orateur captive le public.","set oratör kaptiv lö püblik","Bu hatip dinleyiciyi büyülüyor."]]}
{"w":"défendeur","t":"isim (eril)","m":"davalı","s":["accusé"],"a":["demandeur"],"e":[["Le défendeur nie les faits.","lö defandör ni le fe","Davalı olayları inkâr ediyor."],["Le juge écoute le défendeur.","lö jüj ekut lö defandör","Hâkim davalıyı dinliyor."]]}
{"w":"agenouiller","t":"fiil","m":"diz çöktürmek (s'agenouiller)","s":["s'incliner"],"a":["se lever"],"e":[["Il s'agenouille devant l'autel.","il sajnuy dövan lotel","Sunağın önünde diz çöküyor."],["Elle s'agenouille pour prier.","el sajnuy pur prie","Dua etmek için diz çöküyor."]]}
{"w":"hisser","t":"fiil","m":"çekmek; yukarı kaldırmak","s":["lever","monter"],"a":["baisser"],"e":[["Les marins hissent la voile.","le maren is la vual","Denizciler yelkeni çekiyor."],["Il hisse le drapeau.","il is lö drapo","Bayrağı çekiyor."]]}
{"w":"lacération","t":"isim (dişil)","m":"yırtık; derin kesik","s":["déchirure","coupure"],"a":[],"e":[["Il a une lacération au bras.","il a ün laserasyon o bra","Kolunda derin bir kesik var."],["La lacération demande des points.","la laserasyon dömand de puen","Kesik dikiş gerektiriyor."]]}
{"w":"indigestion","t":"isim (dişil)","m":"hazımsızlık","s":["mal d'estomac"],"a":[],"e":[["Il a une indigestion après le repas.","il a ün endijestyon apre lö röpa","Yemekten sonra hazımsızlık çekiyor."],["L'indigestion le fait souffrir.","lendijestyon lö fe sufrir","Hazımsızlık onu acı çektiriyor."]]}
{"w":"faction","t":"isim (dişil)","m":"hizip; nöbet","s":["clan","groupe"],"a":[],"e":[["Le parti se divise en deux factions.","lö parti sö divizi an dö faksyon","Parti iki hizibe bölünüyor."],["Le soldat est en faction.","lö solda e tan faksyon","Asker nöbette."]]}
{"w":"stimulation","t":"isim (dişil)","m":"uyarım","s":["excitation","encouragement"],"a":["inhibition"],"e":[["La stimulation du cerveau aide la mémoire.","la stimülasyon dü serveo ed la memuar","Beynin uyarılması hafızaya yardım ediyor."],["Il reçoit une stimulation musicale.","il rösua ün stimülasyon müzikal","Müzikal bir uyarım alıyor."]]}
{"w":"intrigant","t":"sıfat","m":"entrikacı; merak uyandırıcı","s":["manipulateur","mystérieux"],"a":["honnête"],"e":[["C'est un homme intrigant.","se ten nom entrigan","O entrikacı bir adam."],["Un personnage intrigant dirige l'affaire.","en personaj entrigan dirij lafer","Gizemli bir kişi işi yönetiyor."]]}
{"w":"buffle","t":"isim (eril)","m":"manda","s":[],"a":[],"e":[["Le buffle vit près de l'eau.","lö büfl viv pre dö lo","Manda suyun yakınında yaşar."],["Le buffle tire la charrue.","lö büfl tir la şarü","Manda sabanı çekiyor."]]}
{"w":"insubordination","t":"isim (dişil)","m":"itaatsizlik","s":["désobéissance","rébellion"],"a":["obéissance"],"e":[["Le soldat est puni pour insubordination.","lö solda e püni pur ensübordinasyon","Asker itaatsizlikten cezalandırılıyor."],["L'insubordination est grave dans l'armée.","lensübordinasyon e grav dan larme","Ordu içinde itaatsizlik ciddi bir suçtur."]]}
{"w":"méticuleux","t":"sıfat","m":"titiz","s":["minutieux","soigneux"],"a":["négligent","brouillon"],"e":[["Il est méticuleux dans son travail.","il e metikülö dan son travay","İşinde titiz."],["C'est un artisan méticuleux.","se ten nartizan metikülö","O titiz bir zanaatkâr."]]}
{"w":"mamelon","t":"isim (eril)","m":"meme ucu; yuvarlak tepe","s":["téton","colline"],"a":[],"e":[["Le bébé tète le mamelon.","lö bebe tet lö mamlon","Bebek meme ucunu emiyor."],["Le mamelon boisé domine la vallée.","lö mamlon buaze domin la vale","Ormanlık tepe vadiye hâkim."]]}
{"w":"corridor","t":"isim (eril)","m":"koridor","s":["couloir","passage"],"a":[],"e":[["Il marche dans le corridor.","il marş dan lö koridor","Koridorda yürüyor."],["Le corridor mène à la salle.","lö koridor men a la sal","Koridor salona çıkıyor."]]}
{"w":"regorger","t":"fiil","m":"dolup taşmak","s":["abonder","déborder"],"a":["manquer"],"e":[["Le marché regorge de fruits.","lö marşe regorj dö früi","Pazar meyveyle dolup taşıyor."],["La ville regorge de touristes en été.","la vil regorj dö turist an ete","Şehir yazın turistle dolup taşıyor."]]}
{"w":"pelote","t":"isim (dişil)","m":"yumak; top","s":["boule","écheveau"],"a":[],"e":[["Le chat joue avec une pelote de laine.","lö şa ju avek ün pölot dö len","Kedi bir yün yumağıyla oynuyor."],["Elle enroule le fil en pelote.","el anrul lö fil an pölot","İpliği yumak haline getiriyor."]]}
{"w":"disgrâce","t":"isim (dişil)","m":"gözden düşme","s":["déchéance","chute"],"a":["faveur"],"e":[["Le ministre tombe en disgrâce.","lö ministr tonb an disgras","Bakan gözden düşüyor."],["Sa disgrâce surprend la cour.","sa disgras sürpran la kur","Gözden düşmesi sarayı şaşırtıyor."]]}
{"w":"mixeur","t":"isim (eril)","m":"mikser; blender","s":[],"a":[],"e":[["Il mélange les fruits au mixeur.","il melanj le früi o miksör","Meyveleri blenderda karıştırıyor."],["Le mixeur fait beaucoup de bruit.","lö miksör fe boku dö brüi","Blender çok gürültü yapıyor."]]}
{"w":"présomptueux","t":"sıfat","m":"kendini beğenmiş; küstah","s":["prétentieux","arrogant"],"a":["modeste","humble"],"e":[["C'est un jeune présomptueux.","se ten jön prezonptüö","O kendini beğenmiş bir genç."],["Il est présomptueux de croire cela.","il e prezonptüö dö kruar sla","Buna inanmak küstahlık."]]}
{"w":"valeureux","t":"sıfat","m":"yiğit","s":["courageux","brave"],"a":["lâche"],"e":[["Le valeureux chevalier défend le roi.","lö valörö şövalye defan lö rua","Yiğit şövalye kralı savunuyor."],["Ces soldats valeureux gagnent la bataille.","se solda valörö gany la bataiy","Bu yiğit askerler savaşı kazanıyor."]]}
{"w":"calamar","t":"isim (eril)","m":"kalamar","s":[],"a":[],"e":[["Il mange des calamars frits.","il manj de kalamar fri","Kızarmış kalamar yiyor."],["Le calamar vit dans la mer.","lö kalamar viv dan la mer","Kalamar denizde yaşar."]]}
{"w":"sinus","t":"isim (eril)","m":"sinüs","s":[],"a":[],"e":[["Il a mal aux sinus.","il a mal o sinüs","Sinüsleri ağrıyor."],["Le sinus est une cavité du crâne.","lö sinüs e tün kavite dü kran","Sinüs kafatasındaki bir boşluktur."]]}
{"w":"irréfutable","t":"sıfat","m":"çürütülemez","s":["indiscutable","certain"],"a":["discutable","douteux"],"e":[["Il présente une preuve irréfutable.","il prezant ün pröv irefütabl","Çürütülemez bir kanıt sunuyor."],["Son argument est irréfutable.","son nargüman e tirefütabl","Argümanı çürütülemez."]]}
{"w":"monopole","t":"isim (eril)","m":"tekel","s":["exclusivité","privilège"],"a":["concurrence"],"e":[["L'État a le monopole du tabac.","leta a lö monopol dü taba","Devletin tütün tekeli var."],["L'entreprise perd son monopole.","lantröpriz per son monopol","Şirket tekelini kaybediyor."]]}
{"w":"monarchie","t":"isim (dişil)","m":"monarşi","s":[],"a":["république"],"e":[["La monarchie existe encore dans ce pays.","la monarşi egzist ankor dan sö pei","Bu ülkede monarşi hâlâ var."],["Il défend la monarchie.","il defan la monarşi","Monarşiyi savunuyor."]]}
{"w":"délirer","t":"fiil","m":"sayıklamak; çılgınca konuşmak","s":["divaguer","extravaguer"],"a":["raisonner"],"e":[["Le malade délire à cause de la fièvre.","lö malad delir a koz dö la fyevr","Hasta ateşten sayıklıyor."],["Tu délires si tu crois ça !","tü delir si tü krua sa","Buna inanıyorsan çıldırmışsın!"]]}
{"w":"damnation","t":"isim (dişil)","m":"lanet; cehennemlik oluş","s":["perdition","condamnation"],"a":["salut","rédemption"],"e":[["Il craint la damnation éternelle.","il kren la damnasyon eternel","Sonsuz lanetten korkuyor."],["La damnation est un thème de ce roman.","la damnasyon e ten tem dö sö roman","Lanetlenme bu romanın bir teması."]]}
{"w":"coloré","t":"sıfat","m":"renkli","s":["vif","haut en couleur"],"a":["terne","incolore"],"e":[["Le marché est très coloré.","lö marşe e tre kolore","Pazar çok renkli."],["Il porte une chemise colorée.","il port ün şömiz kolore","Renkli bir gömlek giyiyor."]]}
{"w":"vraisemblablement","t":"zarf","m":"büyük olasılıkla","s":["probablement","sans doute"],"a":["improbablement"],"e":[["Il est vraisemblablement parti.","il e vresanblablöman parti","Büyük olasılıkla gitmiş."],["Vraisemblablement, il pleuvra demain.","vresanblablöman il plövra dömen","Büyük olasılıkla yarın yağmur yağacak."]]}
{"w":"perforer","t":"fiil","m":"delmek","s":["percer","trouer"],"a":["boucher"],"e":[["La balle perfore le mur.","la bal perfor lö mür","Kurşun duvarı deliyor."],["Il perfore le papier avec une aiguille.","il perfor lö papye avek ün egüiy","Kâğıdı bir iğneyle deliyor."]]}
{"w":"privilégié","t":"sıfat","m":"ayrıcalıklı","s":["favorisé","avantagé"],"a":["défavorisé"],"e":[["Il vient d'un milieu privilégié.","il vyen dön milyö privilejye","Ayrıcalıklı bir çevreden geliyor."],["Ils ont une place privilégiée.","il zon ün plas privilejye","Ayrıcalıklı bir yerleri var."]]}
{"w":"certifier","t":"fiil","m":"onaylamak; tasdik etmek","s":["garantir","attester"],"a":["démentir"],"e":[["Le notaire certifie la copie.","lö noter sertifi la kopi","Noter kopyayı onaylıyor."],["Je vous certifie que c'est vrai.","jö vu sertifi kö se vre","Size bunun doğru olduğunu garanti ederim."]]}
{"w":"oméga","t":"isim (eril)","m":"omega","s":[],"a":["alpha"],"e":[["Oméga est la dernière lettre grecque.","omega e la dernyer letr grek","Omega son Yunan harfidir."],["Les omégas sont bons pour le cœur.","le zomega son bon pur lö kör","Omegalar kalp için iyidir."]]}
{"w":"synagogue","t":"isim (dişil)","m":"sinagog","s":[],"a":[],"e":[["Ils prient à la synagogue.","il pri a la sinagog","Sinagogda dua ediyorlar."],["La synagogue se trouve près du marché.","la sinagog sö truv pre dü marşe","Sinagog pazarın yakınında."]]}
{"w":"innocenter","t":"fiil","m":"aklamak","s":["disculper","acquitter"],"a":["accuser","condamner"],"e":[["Le tribunal innocente l'accusé.","lö tribünal inosant lakuze","Mahkeme sanığı aklıyor."],["La preuve innocente le suspect.","la pröv inosant lö süspe","Kanıt şüpheliyi aklıyor."]]}
{"w":"rectifier","t":"fiil","m":"düzeltmek","s":["corriger","réparer"],"a":["fausser"],"e":[["Il rectifie son erreur.","il rektifi son nerör","Hatasını düzeltiyor."],["Le prof rectifie la phrase.","lö prof rektifi la fraz","Öğretmen cümleyi düzeltiyor."]]}
{"w":"démanteler","t":"fiil","m":"dağıtmak; sökmek","s":["détruire","démonter"],"a":["construire"],"e":[["La police démantèle le réseau.","la polis demantel lö rezo","Polis şebekeyi dağıtıyor."],["Ils démantèlent la vieille usine.","il demantel la viyey üzin","Eski fabrikayı söküyorlar."]]}
{"w":"encadrer","t":"fiil","m":"çerçevelemek; yönetmek","s":["entourer","superviser"],"a":[],"e":[["Il encadre la photo.","il ankadr la foto","Fotoğrafı çerçeveliyor."],["Un moniteur encadre les enfants.","en monitör ankadr le zanfan","Bir eğitmen çocukları yönetiyor."]]}
{"w":"contracter","t":"fiil","m":"kasmak; (hastalık, borç) edinmek","s":["serrer","attraper"],"a":["relâcher"],"e":[["Il contracte les muscles.","il kontrakt le müskl","Kaslarını geriyor."],["Elle contracte une dette.","el kontrakt ün det","Bir borca giriyor."]]}
{"w":"opposant","t":"isim (eril)","m":"muhalif","s":["adversaire","contestataire"],"a":["partisan"],"e":[["L'opposant critique le gouvernement.","lopozan kritik lö guvernömen","Muhalif hükümeti eleştiriyor."],["Les opposants manifestent.","le zopozan manifest","Muhalifler gösteri yapıyor."]]}
{"w":"éveil","t":"isim (eril)","m":"uyanış","s":["réveil","naissance"],"a":["sommeil"],"e":[["L'éveil de la nature a lieu au printemps.","levey dö la natür a lyö o prentan","Doğanın uyanışı ilkbaharda oluyor."],["Il raconte l'éveil de sa conscience.","il rakont levey dö sa konsyans","Bilincinin uyanışını anlatıyor."]]}
{"w":"prodigue","t":"sıfat","m":"savurgan; cömert","s":["dépensier","généreux"],"a":["avare","économe"],"e":[["C'est un fils prodigue.","se ten fis prodig","O savurgan bir oğul."],["Il est prodigue de conseils.","il e prodig dö konsey","Öğüt vermekte cömert."]]}
