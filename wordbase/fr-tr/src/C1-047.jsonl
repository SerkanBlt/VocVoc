{"w":"téléchargement","t":"isim (eril)","m":"indirme","s":[],"a":["téléversement"],"e":[["Le téléchargement est rapide.","lö teleşarjöman e rapid","İndirme hızlı."],["Il lance le téléchargement du fichier.","il lans lö teleşarjöman dü fişye","Dosyanın indirilmesini başlatıyor."]]}
{"w":"autonomie","t":"isim (dişil)","m":"özerklik; bağımsızlık","s":["indépendance","liberté"],"a":["dépendance"],"e":[["Il réclame son autonomie.","il reklam son notonomi","Bağımsızlığını talep ediyor."],["La batterie a une autonomie de dix heures.","la batri a ün otonomi dö di zör","Pilin on saatlik ömrü var."]],"x":[["autonomie de la batterie","otonomi dö la batri","batarya ömrü","L'autonomie de la batterie est de dix heures.","lotonomi dö la batri e dö di zör","Batarya ömrü on saat."]]}
{"w":"livret","t":"isim (eril)","m":"kitapçık; cüzdan","s":["carnet","brochure"],"a":[],"e":[["Il ouvre un livret d'épargne.","il uvr en livre depany","Bir tasarruf hesabı açıyor."],["Le livret explique les règles.","lö livre eksplik le regl","Kitapçık kuralları açıklıyor."]]}
{"w":"alléger","t":"fiil","m":"hafifletmek","s":["soulager","diminuer"],"a":["alourdir"],"e":[["Il allège son sac.","il alej son sak","Çantasını hafifletiyor."],["Le gouvernement allège les impôts.","lö guvernömen alej le zempo","Hükümet vergileri hafifletiyor."]]}
{"w":"grillage","t":"isim (eril)","m":"tel örgü","s":["clôture","treillis"],"a":[],"e":[["Un grillage entoure le jardin.","en grilaj antur lö jarden","Bahçeyi bir tel örgü çeviriyor."],["Le chien passe sous le grillage.","lö şyen pas su lö grilaj","Köpek tel örgünün altından geçiyor."]]}
{"w":"indistinct","t":"sıfat","m":"belirsiz; seçilemeyen","s":["flou","vague"],"a":["distinct","clair"],"e":[["On entend un bruit indistinct.","on natan en brüi endisten","Belirsiz bir ses duyuluyor."],["Un son indistinct vient du couloir.","en son endisten vyen dü kuluar","Koridordan belirsiz bir ses geliyor."]]}
{"w":"scientifiquement","t":"zarf","m":"bilimsel olarak","s":[],"a":[],"e":[["Cette théorie est scientifiquement prouvée.","set teori e syantifikman pruve","Bu teori bilimsel olarak kanıtlanmış."],["Il explique scientifiquement le phénomène.","il eksplik syantifikman lö fenomen","Olayı bilimsel olarak açıklıyor."]]}
{"w":"havre","t":"isim (eril)","m":"liman; sığınak","s":["refuge","abri"],"a":[],"e":[["Ce village est un havre de paix.","sö vilaj e ten avr dö pe","Bu köy bir huzur limanı."],["Le bateau trouve un havre sûr.","lö bato truv en avr sür","Tekne güvenli bir liman buluyor."]]}
{"w":"persuasion","t":"isim (dişil)","m":"ikna","s":["conviction"],"a":["dissuasion"],"e":[["Il utilise la persuasion pour gagner.","il ütiliz la persüazyon pur gane","Kazanmak için ikna gücünü kullanıyor."],["Son pouvoir de persuasion est grand.","son puvuar dö persüazyon e gran","İkna gücü büyük."]]}
{"w":"boudin","t":"isim (eril)","m":"kan sosisi","s":[],"a":[],"e":[["Il mange du boudin noir.","il manj dü buden nuar","Kan sosisi yiyor."],["Le boudin se cuit à la poêle.","lö buden sö küi a la pual","Kan sosisi tavada pişirilir."]]}
{"w":"ensoleillé","t":"sıfat","m":"güneşli","s":["lumineux","clair"],"a":["nuageux","sombre"],"e":[["Le jardin est ensoleillé.","lö jarden e tansoleye","Bahçe güneşli."],["C'est une journée ensoleillée.","se tün jurne ansoleye","Bu güneşli bir gün."]]}
{"w":"emblème","t":"isim (eril)","m":"amblem; simge","s":["symbole","logo"],"a":[],"e":[["La rose est l'emblème du parti.","la roz e lanblem dü parti","Gül partinin amblemi."],["Le drapeau est l'emblème du pays.","lö drapo e lanblem dü pei","Bayrak ülkenin simgesi."]]}
{"w":"feindre","t":"fiil","m":"numara yapmak","s":["simuler","prétendre"],"a":["révéler"],"e":[["Il feint la surprise.","il fen la sürpriz","Şaşırmış numarası yapıyor."],["Elle feint de dormir.","el fen dö dormir","Uyuyormuş numarası yapıyor."]],"x":[["feindre l'ignorance","fendr linyorans","bilmezlikten gelmek","Il feint l'ignorance.","il fen linyorans","Bilmezlikten geliyor."]]}
