{"w":"charmer","t":"fiil","m":"büyülemek","s":["séduire","enchanter"],"a":["repousser"],"e":[["Il charme son public.","il şarm son püblik","Seyircisini büyülüyor."],["Cette musique charme tout le monde.","set müzik şarm tu lö mond","Bu müzik herkesi büyülüyor."]]}
{"w":"tsunami","t":"isim (eril)","m":"tsunami","s":["raz-de-marée"],"a":[],"e":[["Le tsunami détruit la côte.","lö tsunami detrü la kot","Tsunami kıyıyı yok ediyor."],["Le tsunami arrive après le séisme.","lö tsunami ariv apre lö seism","Tsunami depremden sonra geliyor."]]}
