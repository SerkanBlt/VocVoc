{"w":"rémission","t":"isim (dişil)","m":"remisyon; hastalığın geçici gerilemesi","s":["guérison","pardon"],"a":["rechute"],"e":[["Le cancer est en rémission.","lö kanser e tan remisyon","Kanser remisyonda."],["La rémission dure deux ans.","la remisyon dür dö zan","Remisyon iki yıl sürüyor."]]}
{"w":"volaille","t":"isim (dişil)","m":"kümes hayvanı","s":[],"a":[],"e":[["Elle achète de la volaille au marché.","el aşet dö la volay o marşe","Pazardan tavuk eti alıyor."],["La volaille cuit au four.","la volay küi o fur","Kümes hayvanı fırında pişiyor."]]}
