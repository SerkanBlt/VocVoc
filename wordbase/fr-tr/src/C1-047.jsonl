{"w":"feinte","t":"isim (dişil)","m":"hile; aldatmaca","s":["ruse","tromperie"],"a":[],"e":[["Il fait une feinte au match.","il fe ün fent o maç","Maçta bir aldatma hareketi yapıyor."],["Sa tristesse est une feinte.","sa tristes e tün fent","Üzüntüsü bir numara."]]}
{"w":"zèbre","t":"isim (eril)","m":"zebra","s":[],"a":[],"e":[["Le zèbre a des rayures noires.","lö zebr a de reyür nuar","Zebranın siyah çizgileri var."],["Le zèbre vit en Afrique.","lö zebr viv an nafrik","Zebra Afrika'da yaşar."]]}
{"w":"secousse","t":"isim (dişil)","m":"sarsıntı","s":["choc","tremblement"],"a":[],"e":[["Une secousse secoue la maison.","ün sökus sök la mezon","Bir sarsıntı evi sallıyor."],["La secousse dure dix secondes.","la sökus dür di sögond","Sarsıntı on saniye sürüyor."]]}
