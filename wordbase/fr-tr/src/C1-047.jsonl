{"w":"pronostic","t":"isim (eril)","m":"tahmin","s":["prévision","prédiction"],"a":[],"e":[["Le médecin fait un pronostic favorable.","lö medsen fe en pronostik favorabl","Doktor olumlu bir öngörüde bulunuyor."],["Les experts font un pronostic pour le match.","le zekspör fon en pronostik pur lö maç","Uzmanlar maç için tahminde bulunuyor."]],"x":[["pronostic vital engagé","pronostik vital angaje","hayati tehlike var","Le pronostic vital du blessé est engagé.","lö pronostik vital dü blese e tangaje","Yaralının hayati tehlikesi var."]]}
{"w":"morve","t":"isim (dişil)","m":"sümük","s":[],"a":[],"e":[["Le bébé a de la morve au nez.","lö bebe a dö la morv o ne","Bebeğin burnunda sümük var."],["Il essuie la morve de son enfant.","il esüi la morv dö son nanfan","Çocuğunun sümüğünü siliyor."]]}
{"w":"métabolisme","t":"isim (eril)","m":"metabolizma","s":[],"a":[],"e":[["Le sport accélère le métabolisme.","lö spor akselere lö metabolism","Spor metabolizmayı hızlandırıyor."],["Son métabolisme est lent.","son metabolism e lan","Metabolizması yavaş."]]}
{"w":"déguerpir","t":"fiil","m":"tüymek","s":["fuir","s'enfuir"],"a":["rester"],"e":[["Les voleurs déguerpissent vite.","le volör degerpis vit","Hırsızlar hızla tüyüyor."],["Il déguerpit en voyant la police.","il degerpi an vuayan la polis","Polisi görünce tüyüyor."]]}
