{"w":"chauffer","t":"fiil","m":"ısıtmak; ısınmak","s":[],"a":["refroidir"],"e":[["Je chauffe le lait pour le café.","jö şof lö le pur lö kafe","Kahve için sütü ısıtıyorum."],["Le soleil chauffe la maison.","lö solay şof la mezon","Güneş evi ısıtıyor."]]}
{"w":"stage","t":"isim (eril)","m":"staj; kurs","s":[],"a":[],"e":[["Il fait un stage dans une banque.","il fe en staj dan zün bank","Bir bankada staj yapıyor."],["Le stage dure deux mois.","lö staj dür dö mua","Staj iki ay sürüyor."]]}
{"w":"photographie","t":"isim (dişil)","m":"fotoğraf; fotoğrafçılık","s":["photo"],"a":[],"e":[["Cette photographie est très ancienne.","set fotografi e tre zansyen","Bu fotoğraf çok eski."],["Elle étudie la photographie.","el etüdi la fotografi","Fotoğrafçılık okuyor."]]}
{"w":"tonton","t":"isim (eril)","m":"amca; dayı (günlük dil)","s":["oncle"],"a":[],"e":[["Mon tonton habite à Marseille.","mon tonton abit a marsey","Amcam Marsilya'da oturuyor."],["Les enfants adorent leur tonton.","le zanfan ador lör tonton","Çocuklar amcalarına bayılıyor."]]}
{"w":"plume","t":"isim (dişil)","m":"tüy; kalem (tüy)","s":[],"a":[],"e":[["L'oiseau perd une plume.","luazo per ün plüm","Kuş bir tüy kaybediyor."],["Il écrit avec une plume.","il ekri avek ün plüm","Bir tüy kalemle yazıyor."]]}
{"w":"féliciter","t":"fiil","m":"tebrik etmek","s":[],"a":[],"e":[["Je te félicite pour ton diplôme.","jö tö felisit pur ton diplom","Diplomun için seni tebrik ediyorum."],["Le professeur félicite les élèves.","lö profesör felisit le zelev","Öğretmen öğrencileri tebrik ediyor."]]}
{"w":"logiciel","t":"isim (eril)","m":"yazılım","s":[],"a":[],"e":[["J'installe un nouveau logiciel.","jenstal en nuvo lojisyel","Yeni bir yazılım kuruyorum."],["Ce logiciel est très facile.","sö lojisyel e tre fasil","Bu yazılım çok kolay."]]}
