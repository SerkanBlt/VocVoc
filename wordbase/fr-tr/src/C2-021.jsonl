{"w":"fredonner","t":"fiil","m":"mırıldanmak (şarkı)","s":["chantonner"],"a":["crier"],"e":[["Il fredonne en se douchant.","il frödon an sö duşan","Duş alırken mırıldanıyor."],["Elle fredonne une vieille chanson.","el frödon ün vyey şanson","Eski bir şarkıyı mırıldanıyor."]]}
{"w":"grouiller","t":"fiil","m":"kaynaşmak; hareket halinde olmak","s":["pulluler","fourmiller"],"a":["être désert"],"e":[["Les fourmis grouillent sur le sol.","le furmi gruy sür lö sol","Karıncalar yerde kaynaşıyor."],["Le marché grouille de monde.","lö marşe gruy dö mond","Pazar insan kaynıyor."]],"x":[["grouille-toi !","gruy tua","çabuk ol! (konuşma dili)","Grouille-toi, on va rater le train !","gruy tua on va rate lö tren","Çabuk ol, trene yetişemeyeceğiz!"]]}
{"w":"bruyamment","t":"zarf","m":"gürültülü biçimde","s":["tapageusement"],"a":["silencieusement","discrètement"],"e":[["Les enfants rient bruyamment.","le zanfan ri brüyaman","Çocuklar gürültüyle gülüyor."],["Il mange bruyamment.","il manj brüyaman","Gürültüyle yemek yiyor."]]}
{"w":"génome","t":"isim (eril)","m":"genom","s":["patrimoine génétique"],"a":[],"e":[["Les chercheurs séquencent le génome humain.","le şerşör sekans lö jenom ümen","Araştırmacılar insan genomunu dizilendiriyor."],["Le génome contient toute l'information génétique.","lö jenom kontyen tut lenformasyon jenetik","Genom tüm genetik bilgiyi içerir."]]}
{"w":"tuile","t":"isim (dişil)","m":"kiremit; (konuşma dili) talihsizlik","s":["ardoise","pépin"],"a":[],"e":[["Une tuile tombe du toit.","ün tüil tonb dü tua","Çatıdan bir kiremit düşüyor."],["Quelle tuile ! Ma voiture est en panne.","kel tüil ma vuatür e tan pan","Ne talihsizlik! Arabam bozuldu."]]}
{"w":"retournement","t":"isim (eril)","m":"ani dönüş; tersine dönme","s":["revirement","renversement"],"a":["continuité"],"e":[["Le retournement de situation surprend tout le monde.","lö rötürnöman dö sitüasyon sürpran tu lö mond","Durumun ani tersine dönmesi herkesi şaşırtıyor."],["Le match connaît un retournement spectaculaire.","lö maç kone en rötürnöman spektaküler","Maç muhteşem bir dönüş yaşıyor."]]}
{"w":"rigoureux","t":"sıfat","m":"titiz; sert (iklim)","s":["strict","exact"],"a":["laxiste","doux"],"e":[["Le professeur est rigoureux.","lö profesör e rigurö","Öğretmen titiz."],["Un hiver rigoureux commence.","en niver rigurö komans","Sert bir kış başlıyor."]]}
{"w":"étrangleur","t":"isim (eril)","m":"boğucu (katil)","s":["assassin"],"a":[],"e":[["L'étrangleur frappe encore dans la ville.","letranglör frap ankor dan la vil","Boğucu katil şehirde yine saldırıyor."],["La police cherche l'étrangleur.","la polis şerş letranglör","Polis boğucu katili arıyor."]]}
