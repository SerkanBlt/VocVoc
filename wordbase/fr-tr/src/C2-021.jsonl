{"w":"rosbif","t":"isim (eril)","m":"rosto biftek","s":[],"a":[],"e":[["Il découpe le rosbif.","il dekup lö rosbif","Rosto bifteği dilimliyor."],["Le rosbif est servi avec des pommes de terre.","lö rosbif e servi avek de pom dö ter","Rosto biftek patatesle servis ediliyor."]]}
{"w":"prude","t":"sıfat","m":"aşırı ağırbaşlı; fazla titiz","s":["pudibond","collet monté"],"a":["libéré","dévergondé"],"e":[["Elle est un peu prude.","el e ten pö prüd","Biraz fazla ağırbaşlı."],["Ne sois pas prude, c'est juste un film.","nö sua pa prüd se jüst en film","Bu kadar ağırbaşlı olma, sadece bir film."]]}
{"w":"museau","t":"isim (eril)","m":"hayvan burnu; ağız burun bölgesi","s":["gueule","nez"],"a":[],"e":[["Le chien pose son museau sur mes genoux.","lö şyen poz son müzo sür me jönu","Köpek burnunu dizime koyuyor."],["Le renard lève le museau.","lö rönar lev lö müzo","Tilki burnunu kaldırıyor."]]}
{"w":"bagarrer","t":"fiil","m":"kavga etmek (konuşma dili)","s":["se battre","se disputer"],"a":["se réconcilier"],"e":[["Les garçons se bagarrent dans la cour.","le garson sö bagar dan la kur","Çocuklar avluda kavga ediyor."],["Il s'est bagarré avec son frère.","il se bagare avek son frer","Kardeşiyle kavga etti."]]}
{"w":"vénérable","t":"sıfat","m":"saygıdeğer","s":["respectable","honorable"],"a":["méprisable"],"e":[["Le vénérable professeur prend sa retraite.","lö venerabl profesör pran sa rötret","Saygıdeğer profesör emekli oluyor."],["Cette vénérable institution a trois siècles.","set venerabl enstitüsyon a trua syekl","Bu saygın kurum üç yüzyıllık."]]}
{"w":"antidouleur","t":"isim (eril)","m":"ağrı kesici","s":["analgésique"],"a":[],"e":[["Il prend un antidouleur.","il pran en nantidulör","Bir ağrı kesici alıyor."],["Cet antidouleur agit en vingt minutes.","set antidulör aji an ven minüt","Bu ağrı kesici yirmi dakikada etki ediyor."]]}
{"w":"sculpter","t":"fiil","m":"heykel yapmak; oymak","s":["tailler","ciseler"],"a":[],"e":[["Il sculpte une statue dans le marbre.","il skülpt ün statü dan lö marbr","Mermerden bir heykel yontuyor."],["Elle sculpte le bois avec patience.","el skülpt lö bua avek pasyans","Ahşabı sabırla oyuyor."]]}
{"w":"vecteur","t":"isim (eril)","m":"vektör; taşıyıcı","s":["porteur","véhicule"],"a":[],"e":[["Le moustique est un vecteur de maladies.","lö mustik e ten vektör dö maladi","Sivrisinek hastalık taşıyıcısıdır."],["Internet est un vecteur d'information.","enternet e ten vektör denformasyon","İnternet bir bilgi aktarım aracıdır."]]}
