{"w":"ingénieur","t":"isim (eril/dişil)","m":"mühendis","s":[],"a":[],"e":[["Mon père est ingénieur.","mon per e tenjenyör","Babam mühendis."],["Cet ingénieur travaille pour une grande société.","set enjenyör travay pur ün grand sosyete","Bu mühendis büyük bir şirkette çalışıyor."]]}
{"w":"soda","t":"isim (eril)","m":"gazlı içecek","s":[],"a":[],"e":[["Je bois un soda.","jö bua en soda","Gazlı bir içecek içiyorum."],["Les enfants aiment le soda.","le zanfan em lö soda","Çocuklar gazlı içeceği sever."]]}
{"w":"requin","t":"isim (eril)","m":"köpekbalığı","s":[],"a":[],"e":[["Le requin nage dans la mer.","lö röken naj dan la mer","Köpekbalığı denizde yüzüyor."],["Il a peur des requins.","il a pör de röken","Köpekbalıklarından korkuyor."]]}
