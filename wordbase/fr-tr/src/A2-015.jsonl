{"w":"bougie","t":"isim (dişil)","m":"mum","s":[],"a":[],"e":[["Elle allume une bougie.","el alüm ün buji","Bir mum yakıyor."],["Il y a dix bougies sur le gâteau.","il i a di buji sür lö gato","Pastanın üstünde on mum var."]]}
{"w":"baignoire","t":"isim (dişil)","m":"küvet","s":[],"a":[],"e":[["Le bébé est dans la baignoire.","lö bebe e dan la benyuar","Bebek küvette."],["La baignoire est pleine d'eau chaude.","la benyuar e plen do şod","Küvet sıcak suyla dolu."]]}
{"w":"familial","t":"sıfat","m":"ailevi; aileye ait","s":[],"a":[],"e":[["Nous avons un repas familial le dimanche.","nu zavon en röpa familyal lö dimanş","Pazar günleri aile yemeğimiz var."],["C'est une voiture familiale.","set ün vuatür familyal","Bu bir aile arabası."]]}
