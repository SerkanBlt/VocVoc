{"w":"plafond","t":"isim (eril)","m":"tavan","s":[],"a":[],"e":[["Le plafond de la chambre est blanc.","lö plafon dö la şanbr e blan","Odanın tavanı beyaz."],["Il y a une lampe au plafond.","il i a ün lanp o plafon","Tavanda bir lamba var."]]}
{"w":"poème","t":"isim (eril)","m":"şiir","s":[],"a":[],"e":[["Il écrit un poème pour elle.","il ekri en poem pur el","Onun için bir şiir yazıyor."],["Ce poème est très beau.","sö poem e tre bo","Bu şiir çok güzel."]]}
{"w":"muscle","t":"isim (eril)","m":"kas","s":[],"a":[],"e":[["Il fait du sport pour ses muscles.","il fe dü spor pur se müskl","Kasları için spor yapıyor."],["J'ai mal aux muscles.","je mal o müskl","Kaslarım ağrıyor."]]}
{"w":"détester","t":"fiil","m":"nefret etmek","s":[],"a":["adorer"],"e":[["Je déteste le froid.","jö detest lö frua","Soğuktan nefret ediyorum."],["Il déteste attendre.","il detest atandr","Beklemekten nefret ediyor."]]}
{"w":"irlandais","t":"sıfat","m":"İrlandalı; İrlanda","s":[],"a":[],"e":[["Il a un ami irlandais.","il a en nami irlande","İrlandalı bir arkadaşı var."],["La musique irlandaise est très belle.","la müzik irlandez e tre bel","İrlanda müziği çok güzel."]]}
{"w":"météo","t":"isim (dişil)","m":"hava durumu","s":[],"a":[],"e":[["La météo annonce de la pluie.","la meteo anons dö la plüi","Hava durumu yağmur bildiriyor."],["Je regarde la météo avant de partir.","jö rögard la meteo avan dö partir","Gitmeden önce hava durumuna bakıyorum."]]}
{"w":"horloge","t":"isim (dişil)","m":"duvar saati","s":[],"a":[],"e":[["L'horloge de la gare est grande.","lorloj dö la gar e grand","İstasyonun saati büyük."],["Il regarde l'horloge.","il rögard lorloj","Saate bakıyor."]]}
{"w":"pirate","t":"isim (eril)","m":"korsan","s":[],"a":[],"e":[["Le pirate a un bateau noir.","lö pirat a en bato nuar","Korsanın siyah bir gemisi var."],["Les enfants jouent aux pirates.","le zanfan ju o pirat","Çocuklar korsan oynuyor."]]}
{"w":"peindre","t":"fiil","m":"boyamak; resim yapmak","s":[],"a":[],"e":[["Il peint le mur en blanc.","il pen lö mür an blan","Duvarı beyaza boyuyor."],["Elle aime peindre des paysages.","el em pendr de peizaj","Manzara resmi yapmayı seviyor."]]}
{"w":"informatique","t":"isim (dişil)","m":"bilişim; bilgisayar bilimi","s":[],"a":[],"e":[["Il étudie l'informatique à l'université.","il etüdi lenformatik a lüniversite","Üniversitede bilişim okuyor."],["Mon frère travaille dans l'informatique.","mon frer travay dan lenformatik","Kardeşim bilişim sektöründe çalışıyor."]]}
{"w":"marteau","t":"isim (eril)","m":"çekiç","s":[],"a":[],"e":[["Il frappe le clou avec un marteau.","il frap lö klu avek en marto","Çiviye çekiçle vuruyor."],["Le marteau est dans la boîte à outils.","lö marto e dan la buat a uti","Çekiç alet kutusunda."]]}
{"w":"ouvrier","t":"isim (eril)","m":"işçi","s":[],"a":[],"e":[["L'ouvrier travaille à l'usine.","luvriye travay a lüzin","İşçi fabrikada çalışıyor."],["Les ouvriers construisent un immeuble.","le zuvriye konstrüiz en nimöbl","İşçiler bir apartman yapıyor."]]}
{"w":"promenade","t":"isim (dişil)","m":"yürüyüş; gezinti","s":[],"a":[],"e":[["Nous faisons une promenade au bord de la mer.","nu fözon ün promnad o bor dö la mer","Deniz kıyısında bir yürüyüş yapıyoruz."],["La promenade est agréable.","la promnad e tagreabl","Yürüyüş keyifli."]],"x":[["promenade en bateau","promnad an bato","tekne gezisi","Nous faisons une promenade en bateau.","nu fözon ün promnad an bato","Tekne gezisi yapıyoruz."]]}
{"w":"tache","t":"isim (dişil)","m":"leke","s":[],"a":[],"e":[["Il y a une tache sur ma chemise.","il i a ün taş sür ma şömiz","Gömleğimde bir leke var."],["Cette tache est difficile à enlever.","set taş e difisil a anlöve","Bu lekeyi çıkarmak zor."]]}
{"w":"absent","t":"sıfat","m":"yok; devamsız","s":[],"a":["présent"],"e":[["L'élève est absent aujourd'hui.","lelev e tabsan ojurdüi","Öğrenci bugün yok."],["Elle est absente depuis lundi.","el e tabsant dö püi lendi","Pazartesiden beri yok."]]}
{"w":"fleuve","t":"isim (eril)","m":"büyük nehir","s":[],"a":[],"e":[["La Seine est un fleuve.","la sen e ten flöv","Seine bir nehirdir."],["Le fleuve traverse plusieurs villes.","lö flöv travers plüzyör vil","Nehir birkaç şehri boydan boya geçiyor."]]}
{"w":"cuire","t":"fiil","m":"pişirmek; pişmek","s":[],"a":[],"e":[["Je cuis le riz dix minutes.","jö küi lö ri di minüt","Pirinci on dakika pişiriyorum."],["Le gâteau cuit au four.","lö gato küi o fur","Pasta fırında pişiyor."]]}
{"w":"sonner","t":"fiil","m":"çalmak (zil, telefon)","s":[],"a":[],"e":[["Le téléphone sonne.","lö telefon son","Telefon çalıyor."],["La cloche sonne à midi.","la kloş son a midi","Çan öğlen çalıyor."]]}
{"w":"fatigue","t":"isim (dişil)","m":"yorgunluk","s":[],"a":[],"e":[["Il tombe de fatigue.","il tonb dö fatig","Yorgunluktan düşüyor."],["La fatigue est normale après le voyage.","la fatig e normal apre lö vuayaj","Yolculuktan sonra yorgunluk normal."]]}
{"w":"visiteur","t":"isim (eril)","m":"ziyaretçi","s":[],"a":[],"e":[["Le visiteur attend à l'accueil.","lö vizitör atan a lakoy","Ziyaretçi danışmada bekliyor."],["Le musée a beaucoup de visiteurs.","lö müze a boku dö vizitör","Müzenin çok ziyaretçisi var."]]}
{"w":"photographe","t":"isim (eril/dişil)","m":"fotoğrafçı","s":[],"a":[],"e":[["Le photographe prend une photo.","lö fotograf pran ün foto","Fotoğrafçı bir fotoğraf çekiyor."],["Ma sœur est photographe.","ma sör e fotograf","Kız kardeşim fotoğrafçı."]]}
{"w":"sonnerie","t":"isim (dişil)","m":"zil sesi","s":[],"a":[],"e":[["La sonnerie de mon téléphone est forte.","la sonri dö mon telefon e fort","Telefonumun zil sesi yüksek."],["La sonnerie de l'école retentit.","la sonri dö lekol rötanti","Okul zili çalıyor."]]}
