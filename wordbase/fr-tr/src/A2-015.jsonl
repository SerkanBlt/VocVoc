{"w":"jumeau","t":"isim (eril)","m":"ikiz","s":[],"a":[],"e":[["Mon frère jumeau s'appelle Paul.","mon frer jümo sapel pol","İkiz kardeşimin adı Paul."],["Les jumeaux se ressemblent beaucoup.","le jümo sö rösanbl boku","İkizler birbirine çok benziyor."]]}
{"w":"destination","t":"isim (dişil)","m":"varış yeri; destinasyon","s":[],"a":[],"e":[["Quelle est votre destination ?","kel e votr destinasyon","Varış yeriniz neresi?"],["Cette destination est très populaire.","set destinasyon e tre popüler","Bu destinasyon çok popüler."]]}
{"w":"nid","t":"isim (eril)","m":"yuva","s":[],"a":[],"e":[["L'oiseau fait un nid.","luazo fe en ni","Kuş bir yuva yapıyor."],["Il y a un nid dans l'arbre.","il i a en ni dan larbr","Ağaçta bir yuva var."]]}
{"w":"dépenser","t":"fiil","m":"harcamak","s":[],"a":["économiser"],"e":[["Il dépense trop d'argent.","il depans tro darjan","Çok para harcıyor."],["Nous dépensons moins ce mois.","nu depanson muen sö mua","Bu ay daha az harcıyoruz."]]}
{"w":"atelier","t":"isim (eril)","m":"atölye","s":[],"a":[],"e":[["Le peintre travaille dans son atelier.","lö pentr travay dan son natelye","Ressam atölyesinde çalışıyor."],["Il y a un atelier de cuisine ce soir.","il i a en natelye dö küizin sö suar","Bu akşam bir yemek atölyesi var."]]}
{"w":"balade","t":"isim (dişil)","m":"gezinti","s":["promenade"],"a":[],"e":[["Nous faisons une balade en forêt.","nu fözon ün balad an fore","Ormanda bir gezinti yapıyoruz."],["La balade dure une heure.","la balad dür ün ör","Gezinti bir saat sürüyor."]]}
{"w":"opéra","t":"isim (eril)","m":"opera","s":[],"a":[],"e":[["Nous allons à l'opéra ce soir.","nu zalon a lopera sö suar","Bu akşam operaya gidiyoruz."],["Elle chante dans un opéra.","el şant dan zen opera","Bir operada şarkı söylüyor."]]}
{"w":"échanger","t":"fiil","m":"değiştirmek; takas etmek","s":[],"a":[],"e":[["Nous échangeons nos numéros.","nu zeşanjon no nümero","Numaralarımızı değiş tokuş ediyoruz."],["Je veux échanger ce pull.","jö vö eşanje sö pül","Bu kazağı değiştirmek istiyorum."]]}
{"w":"fillette","t":"isim (dişil)","m":"küçük kız","s":[],"a":[],"e":[["La fillette joue avec son chat.","la fiyet ju avek son şa","Küçük kız kedisiyle oynuyor."],["Cette fillette a six ans.","set fiyet a siz an","Bu küçük kız altı yaşında."]]}
