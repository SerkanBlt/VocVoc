{"w":"pompier","t":"isim (eril)","m":"itfaiyeci","s":[],"a":[],"e":[["Les pompiers arrivent vite.","le ponpye ariv vit","İtfaiyeciler çabuk geliyor."],["Il rêve de devenir pompier.","il rev dö dövnir ponpye","İtfaiyeci olmayı hayal ediyor."]]}
{"w":"bracelet","t":"isim (eril)","m":"bilezik","s":[],"a":[],"e":[["Elle porte un bracelet en argent.","el port en brasle an narjan","Gümüş bir bilezik takıyor."],["Ce bracelet est un cadeau.","sö brasle e ten kado","Bu bilezik bir hediye."]]}
