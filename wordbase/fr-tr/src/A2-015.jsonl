{"w":"festival","t":"isim (eril)","m":"festival","s":[],"a":[],"e":[["Nous allons au festival de musique.","nu zalon o festival dö müzik","Müzik festivaline gidiyoruz."],["Le festival dure trois jours.","lö festival dür trua jur","Festival üç gün sürüyor."]]}
{"w":"câlin","t":"isim (eril)","m":"kucaklama; sarılma","s":[],"a":[],"e":[["Je fais un câlin à mon fils.","jö fe en kalen a mon fis","Oğluma sarılıyorum."],["Le bébé veut un câlin.","lö bebe vö en kalen","Bebek sarılmak istiyor."]]}
{"w":"sieste","t":"isim (dişil)","m":"öğle uykusu; şekerleme","s":[],"a":[],"e":[["Je fais une sieste après le déjeuner.","jö fe ün siyest apre lö dejöne","Öğle yemeğinden sonra şekerleme yapıyorum."],["La sieste est agréable en été.","la siyest e tagreabl an nete","Şekerleme yazın hoş."]]}
