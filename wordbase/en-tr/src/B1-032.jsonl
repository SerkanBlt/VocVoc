{"w":"dump","t":"fiil","m":"atmak; boşaltmak; terk etmek","s":[],"a":[],"e":[["Don't dump trash here.","dont damp treş hir","Buraya çöp atma."],["He dumped his girlfriend.","hi dampt hiz görlfrend","Sevgilisini terk etti."]]}
{"w":"approach","t":"fiil","m":"yaklaşmak; ele almak","s":[],"a":["leave"],"e":[["A car approached us.","ı kar ıproçt as","Bir araba bize yaklaştı."],["Winter is approaching.","vintır iz ıproçing","Kış yaklaşıyor."]]}
{"w":"bless","t":"fiil","m":"kutsamak; hayır dua etmek","s":[],"a":["curse"],"e":[["Bless you! Do you have a cold?","bles yu! du yu hev ı kold?","Çok yaşa! Nezle misin?"],["May God bless your family.","mey gad bles yor femıli","Allah ailenizi korusun."]]}
{"w":"rip","t":"fiil","m":"yırtmak; sökmek","s":["tear"],"a":["mend"],"e":[["Don't rip the paper.","dont rip zı peypır","Kâğıdı yırtma."],["He ripped his shirt.","hi ript hiz şört","Gömleğini yırttı."]],"x":[["rip off","rip of","kazıklamak","That shop rips off tourists.","zet şap rips of turists","O dükkân turistleri kazıklıyor."]]}
{"w":"bust","t":"fiil","m":"kırmak; baskın yapmak","s":["break"],"a":["fix"],"e":[["I busted my phone screen.","ay bastid may fon skrin","Telefonumun ekranını kırdım."],["The police busted a drug gang.","zı polis bastid ı drag geng","Polis bir uyuşturucu çetesine baskın yaptı."]]}
{"w":"fry","t":"fiil","m":"kızartmak","s":[],"a":["boil"],"e":[["Fry the onions in oil.","fray zi anyınz in oyl","Soğanları yağda kavur."],["She will fry two eggs.","şi vil fray tu egz","İki yumurta pişirecek."]]}
{"w":"grill","t":"fiil","m":"ızgarada pişirmek","s":[],"a":[],"e":[["We grill fish on Sundays.","vi gril fiş an sandeyz","Pazarları balığı ızgarada pişiririz."],["He grilled the chicken.","hi grild zı çikın","Tavuğu ızgarada pişirdi."]]}
{"w":"roast","t":"fiil","m":"fırında pişirmek; kavurmak","s":[],"a":["boil"],"e":[["Roast the chicken for an hour.","rost zı çikın for en aur","Tavuğu bir saat fırında pişir."],["We roasted nuts on the fire.","vi rostid nats an zı fayır","Ateşte kuruyemiş kavurduk."]]}
{"w":"hike","t":"fiil","m":"doğa yürüyüşü yapmak","s":["trek"],"a":[],"e":[["We like to hike in the mountains.","vi layk tı hayk in zı mauntınz","Dağlarda yürüyüş yapmayı severiz."],["They hiked ten kilometers.","zey haykt ten kilamitırz","On kilometre yürüdüler."]]}
{"w":"ski","t":"fiil","m":"kayak yapmak","s":[],"a":[],"e":[["I ski every winter.","ay ski evri vintır","Her kış kayak yaparım."],["Can you ski?","ken yu ski?","Kayak yapabiliyor musun?"]]}
{"w":"skate","t":"fiil","m":"paten yapmak","s":[],"a":[],"e":[["She skates on the ice.","şi skeyts an zi ays","Buzda paten yapıyor."],["Let's skate after school.","lets skeyt eftır skul","Okuldan sonra paten yapalım."]]}
{"w":"jog","t":"fiil","m":"hafif tempoyla koşmak","s":["run"],"a":["walk"],"e":[["I jog in the park every morning.","ay cag in zı park evri morning","Her sabah parkta koşarım."],["He jogs before work.","hi cagz bifor vörk","İşten önce koşuya çıkıyor."]]}
{"w":"wrestle","t":"fiil","m":"güreşmek; boğuşmak","s":[],"a":[],"e":[["The boys wrestle on the grass.","zı boyz resıl an zı gres","Çocuklar çimenlerde güreşiyor."],["He wrestled with the problem.","hi resıld viz zı prablım","Sorunla boğuştu."]]}
{"w":"referee","t":"fiil","m":"hakemlik yapmak","s":[],"a":[],"e":[["Who will referee the game?","hu vil refıri zı geym?","Maça kim hakemlik yapacak?"],["He refereed the final.","hi refırid zı faynıl","Finalde hakemlik yaptı."]]}
{"w":"afterwards","t":"zarf","m":"sonradan; daha sonra","s":["later"],"a":["beforehand"],"e":[["We ate and went home afterwards.","vi eyt end vent hom eftırvırdz","Yemek yedik, sonra eve gittik."],["Afterwards, I felt better.","eftırvırdz, ay felt betır","Sonradan kendimi daha iyi hissettim."]]}
{"w":"someday","t":"zarf","m":"bir gün; ileride","s":["one day"],"a":[],"e":[["Someday I will visit Japan.","samdey ay vil vizit cıpen","Bir gün Japonya'yı ziyaret edeceğim."],["She hopes to be a doctor someday.","şi hops tı bi ı daktır samdey","Bir gün doktor olmayı umuyor."]]}
{"w":"sometime","t":"zarf","m":"bir ara; bir zaman","s":[],"a":[],"e":[["Call me sometime.","kol mi samtaym","Bir ara beni ara."],["Let's meet sometime next week.","lets mit samtaym nekst vik","Gelecek hafta bir ara buluşalım."]]}
{"w":"anytime","t":"zarf","m":"her zaman; istediğin zaman","s":[],"a":[],"e":[["Come over anytime.","kam ovır enitaym","İstediğin zaman uğra."],["You can call me anytime.","yu ken kol mi enitaym","Beni istediğin zaman arayabilirsin."]]}
