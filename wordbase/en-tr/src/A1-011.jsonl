{"w":"holiday","t":"isim","m":"tatil; bayram","s":["vacation"],"a":[],"e":[["We are on holiday this week.","vi ar an halidey zis vik","Bu hafta tatildeyiz."],["Monday is a holiday.","mandey iz ı halidey","Pazartesi tatil."]],"x":[["on holiday","an halidey","tatilde","They are on holiday in Spain.","zey ar an halidey in speyn","İspanya'da tatildeler."]]}
{"w":"monday","t":"isim","m":"pazartesi","s":[],"a":[],"e":[["I start work on Monday.","ay start vörk an mandey","Pazartesi işe başlıyorum."],["Monday is my busy day.","mandey iz may bizi dey","Pazartesi yoğun günüm."]]}
{"w":"tuesday","t":"isim","m":"salı","s":[],"a":[],"e":[["The meeting is on Tuesday.","zı miting iz an tyuzdey","Toplantı salı günü."],["I have English class on Tuesday.","ay hev ingliş kles an tyuzdey","Salı günü İngilizce dersim var."]]}
{"w":"wednesday","t":"isim","m":"çarşamba","s":[],"a":[],"e":[["We play football on Wednesday.","vi pley futbol an venzdey","Çarşamba günü futbol oynarız."],["Today is Wednesday.","tıdey iz venzdey","Bugün çarşamba."]]}
{"w":"thursday","t":"isim","m":"perşembe","s":[],"a":[],"e":[["The shop is closed on Thursday.","zı şap iz klozd an sörzdey","Dükkân perşembe günü kapalı."],["See you on Thursday!","si yu an sörzdey!","Perşembe görüşürüz!"]]}
{"w":"friday","t":"isim","m":"cuma","s":[],"a":[],"e":[["I am free on Friday.","ay em fri an fraydey","Cuma günü boşum."],["Friday is my favorite day.","fraydey iz may feyvırit dey","Cuma en sevdiğim gün."]]}
{"w":"saturday","t":"isim","m":"cumartesi","s":[],"a":[],"e":[["We go to the market on Saturday.","vi go tı zı markıt an setırdey","Cumartesi günü pazara gideriz."],["Saturday is a nice day.","setırdey iz ı nays dey","Cumartesi güzel bir gün."]]}
{"w":"sunday","t":"isim","m":"pazar","s":[],"a":[],"e":[["We visit my grandmother on Sunday.","vi vizit may grendmazır an sandey","Pazar günü büyükannemi ziyaret ederiz."],["I sleep late on Sunday.","ay slip leyt an sandey","Pazar günü geç uyurum."]]}
{"w":"january","t":"isim","m":"ocak","s":[],"a":[],"e":[["January is very cold.","cenyueri iz veri kold","Ocak çok soğuktur."],["My birthday is in January.","may börsdey iz in cenyueri","Doğum günüm ocak ayında."]]}
{"w":"february","t":"isim","m":"şubat","s":[],"a":[],"e":[["February is a short month.","februeri iz ı şort mans","Şubat kısa bir aydır."],["It snows in February.","it snoz in februeri","Şubatta kar yağar."]]}
{"w":"march","t":"isim","m":"mart","s":[],"a":[],"e":[["Spring starts in March.","spring starts in març","İlkbahar mart ayında başlar."],["The weather is windy in March.","zı vezır iz vindi in març","Mart ayında hava rüzgârlıdır."]]}
{"w":"april","t":"isim","m":"nisan","s":[],"a":[],"e":[["It often rains in April.","it ofın reynz in eypril","Nisanda sık sık yağmur yağar."],["My brother was born in April.","may brazır vaz born in eypril","Erkek kardeşim nisanda doğdu."]]}
{"w":"june","t":"isim","m":"haziran","s":[],"a":[],"e":[["School ends in June.","skul endz in cun","Okul haziranda biter."],["June is warm and sunny.","cun iz vorm end sani","Haziran sıcak ve güneşlidir."]]}
{"w":"july","t":"isim","m":"temmuz","s":[],"a":[],"e":[["July is the hottest month.","culay iz zı hatist mans","Temmuz en sıcak aydır."],["We go on holiday in July.","vi go an halidey in culay","Temmuzda tatile çıkarız."]]}
{"w":"august","t":"isim","m":"ağustos","s":[],"a":[],"e":[["We swim in the sea in August.","vi svim in zı si in ogıst","Ağustosta denizde yüzeriz."],["August is very hot here.","ogıst iz veri hat hir","Ağustos burada çok sıcaktır."]]}
{"w":"september","t":"isim","m":"eylül","s":[],"a":[],"e":[["School starts in September.","skul starts in septembır","Okul eylülde başlar."],["September is not too hot.","septembır iz nat tu hat","Eylül çok sıcak değildir."]]}
{"w":"october","t":"isim","m":"ekim","s":[],"a":[],"e":[["The leaves fall in October.","zı livz fol in aktobır","Yapraklar ekimde düşer."],["My birthday is in October.","may börsdey iz in aktobır","Doğum günüm ekim ayında."]]}
{"w":"november","t":"isim","m":"kasım","s":[],"a":[],"e":[["It is cold and rainy in November.","it iz kold end reyni in novembır","Kasımda hava soğuk ve yağmurludur."],["We travel in November.","vi trevıl in novembır","Kasımda seyahat ederiz."]]}
{"w":"december","t":"isim","m":"aralık","s":[],"a":[],"e":[["December is the last month.","disembır iz zı lest mans","Aralık son aydır."],["It snows in December.","it snoz in disembır","Aralıkta kar yağar."]]}
{"w":"spring","t":"isim","m":"ilkbahar; bahar","s":[],"a":["autumn"],"e":[["The flowers come out in spring.","zı flauırz kam aut in spring","Çiçekler ilkbaharda açar."],["Spring is my favorite season.","spring iz may feyvırit sizın","İlkbahar en sevdiğim mevsim."]]}
{"w":"summer","t":"isim","m":"yaz","s":[],"a":["winter"],"e":[["It is hot in summer.","it iz hat in samır","Yazın hava sıcaktır."],["We go to the beach in summer.","vi go tı zı biç in samır","Yazın plaja gideriz."]]}
{"w":"autumn","t":"isim","m":"sonbahar; güz","s":["fall"],"a":["spring"],"e":[["The leaves are yellow in autumn.","zı livz ar yelo in otım","Yapraklar sonbaharda sarıdır."],["Autumn is cool and rainy.","otım iz kul end reyni","Sonbahar serin ve yağmurludur."]]}
{"w":"winter","t":"isim","m":"kış","s":[],"a":["summer"],"e":[["It snows in winter.","it snoz in vintır","Kışın kar yağar."],["Winter is very cold here.","vintır iz veri kold hir","Kış burada çok soğuktur."]]}
{"w":"weather","t":"isim","m":"hava; hava durumu","s":[],"a":[],"e":[["The weather is nice today.","zı vezır iz nays tıdey","Bugün hava güzel."],["What is the weather like?","vat iz zı vezır layk?","Hava nasıl?"]]}
{"w":"sun","t":"isim","m":"güneş","s":[],"a":["moon"],"e":[["The sun is very hot.","zı san iz veri hat","Güneş çok sıcak."],["The sun comes up at six.","zı san kamz ap et siks","Güneş altıda doğar."]]}
{"w":"wind","t":"isim","m":"rüzgâr","s":[],"a":[],"e":[["The wind is very strong today.","zı vind iz veri strong tıdey","Bugün rüzgâr çok kuvvetli."],["There is no wind at the beach.","zer iz no vind et zı biç","Plajda rüzgâr yok."]]}
{"w":"cloud","t":"isim","m":"bulut","s":[],"a":[],"e":[["There is a big cloud in the sky.","zer iz ı big klaud in zı skay","Gökyüzünde büyük bir bulut var."],["Dark clouds mean rain.","dark klaudz min reyn","Kara bulutlar yağmur demektir."]]}
{"w":"money","t":"isim","m":"para","s":[],"a":[],"e":[["I don't have much money.","ay dont hev maç mani","Fazla param yok."],["How much money do you need?","hau maç mani du yu nid?","Ne kadar paraya ihtiyacın var?"]]}
{"w":"price","t":"isim","m":"fiyat","s":[],"a":[],"e":[["What is the price of this shirt?","vat iz zı prays ıv zis şört?","Bu gömleğin fiyatı ne kadar?"],["The prices are very low.","zı praysiz ar veri lo","Fiyatlar çok düşük."]]}
{"w":"job","t":"isim","m":"iş; meslek","s":["work"],"a":[],"e":[["She has a good job.","şi hez ı gud cab","İyi bir işi var."],["I am looking for a job.","ay em lukıng for ı cab","İş arıyorum."]]}
{"w":"thing","t":"isim","m":"şey; eşya","s":[],"a":[],"e":[["What is that thing?","vat iz zet sing?","Şu şey ne?"],["I have many things to do.","ay hev meni singz tı du","Yapacak çok şeyim var."]]}
{"w":"way","t":"isim","m":"yol; yöntem","s":[],"a":[],"e":[["Which way is the station?","viç vey iz zı steyşın?","İstasyon hangi yönde?"],["This is a good way to learn.","zis iz ı gud vey tı lörn","Bu, öğrenmek için iyi bir yol."]],"x":[["on the way","an zı vey","yolda","I am on the way home.","ay em an zı vey hom","Eve doğru yoldayım."]]}
{"w":"word","t":"isim","m":"kelime; söz","s":[],"a":[],"e":[["I don't know this word.","ay dont no zis vörd","Bu kelimeyi bilmiyorum."],["Write five words on the paper.","rayt fayv vördz an zı peypır","Kâğıda beş kelime yaz."]]}
{"w":"number","t":"isim","m":"sayı; numara","s":[],"a":[],"e":[["What is your phone number?","vat iz yor fon nambır?","Telefon numaran ne?"],["Seven is my lucky number.","seven iz may laki nambır","Yedi benim şanslı sayım."]]}
{"w":"question","t":"isim","m":"soru","s":[],"a":["answer"],"e":[["I have a question.","ay hev ı kveşçın","Bir sorum var."],["Please answer the question.","pliz ensır zı kveşçın","Lütfen soruyu cevaplayın."]],"x":[["ask a question","esk ı kveşçın","soru sormak","Can I ask a question?","ken ay esk ı kveşçın?","Bir soru sorabilir miyim?"]]}
{"w":"problem","t":"isim","m":"sorun; problem","s":[],"a":["solution"],"e":[["I have a problem with my phone.","ay hev ı prablım viz may fon","Telefonumla ilgili bir sorunum var."],["That is not a problem.","zet iz nat ı prablım","Bu bir sorun değil."]],"x":[["no problem","no prablım","sorun değil","Thanks! No problem.","senks! no prablım","Teşekkürler! Sorun değil."]]}
{"w":"idea","t":"isim","m":"fikir; düşünce","s":[],"a":[],"e":[["That is a good idea.","zet iz ı gud aydia","Bu iyi bir fikir."],["I have no idea.","ay hev no aydia","Hiçbir fikrim yok."]]}
{"w":"life","t":"isim","m":"hayat; yaşam","s":[],"a":["death"],"e":[["Life is beautiful.","layf iz byutiful","Hayat güzeldir."],["He has a happy life.","hi hez ı hepi layf","Mutlu bir hayatı var."]]}
{"w":"game","t":"isim","m":"oyun; maç","s":[],"a":[],"e":[["The children play a game.","zı çildrın pley ı geym","Çocuklar bir oyun oynuyor."],["Let's watch the game tonight.","lets vaç zı geym tınayt","Bu akşam maçı izleyelim."]]}
{"w":"music","t":"isim","m":"müzik","s":[],"a":[],"e":[["I like Turkish music.","ay layk törkiş myuzik","Türk müziğini severim."],["Turn off the music, please.","törn of zı myuzik, pliz","Müziği kapat, lütfen."]]}
{"w":"song","t":"isim","m":"şarkı","s":[],"a":[],"e":[["This is my favorite song.","zis iz may feyvırit song","Bu benim en sevdiğim şarkı."],["She sings a song for her baby.","şi singz ı song for hör beybi","Bebeği için bir şarkı söylüyor."]]}
{"w":"film","t":"isim","m":"film","s":["movie"],"a":[],"e":[["The film starts at eight.","zı film starts et eyt","Film sekizde başlıyor."],["It is a very good film.","it iz ı veri gud film","Çok iyi bir film."]]}
{"w":"movie","t":"isim","m":"film; sinema filmi","s":["film"],"a":[],"e":[["Let's watch a movie tonight.","lets vaç ı muvi tınayt","Bu akşam bir film izleyelim."],["That movie is very funny.","zet muvi iz veri fani","O film çok komik."]]}
{"w":"photo","t":"isim","m":"fotoğraf","s":["picture"],"a":[],"e":[["Can you take a photo of us?","ken yu teyk ı foto ıv as?","Bizim fotoğrafımızı çekebilir misin?"],["I have a photo of my family.","ay hev ı foto ıv may femili","Ailemin bir fotoğrafı var."]]}
{"w":"team","t":"isim","m":"takım; ekip","s":[],"a":[],"e":[["Our team plays on Saturday.","aur tim pleyz an setırdey","Takımımız cumartesi oynuyor."],["She works in a small team.","şi vörks in ı smol tim","Küçük bir ekipte çalışıyor."]]}
{"w":"news","t":"isim","m":"haber","s":[],"a":[],"e":[["I watch the news every evening.","ay vaç zı nuz evri ivning","Her akşam haberleri izlerim."],["That is good news!","zet iz gud nuz!","Bu iyi haber!"]]}
{"w":"newspaper","t":"isim","m":"gazete","s":[],"a":[],"e":[["My father reads the newspaper.","may fazır ridz zı nuzpeypır","Babam gazete okur."],["I buy a newspaper every morning.","ay bay ı nuzpeypır evri morning","Her sabah bir gazete alırım."]]}
{"w":"letter","t":"isim","m":"mektup; harf","s":[],"a":[],"e":[["I write a letter to my aunt.","ay rayt ı letır tı may ent","Teyzeme bir mektup yazarım."],["There are twenty-six letters in English.","zer ar tventi siks letırz in ingliş","İngilizcede yirmi altı harf var."]]}
{"w":"language","t":"isim","m":"dil","s":[],"a":[],"e":[["English is a useful language.","ingliş iz ı yusful lengvic","İngilizce faydalı bir dildir."],["How many languages do you speak?","hau meni lengvicız du yu spik?","Kaç dil konuşuyorsun?"]]}
{"w":"sport","t":"isim","m":"spor","s":[],"a":[],"e":[["Football is my favorite sport.","futbol iz may feyvırit sport","Futbol en sevdiğim spor."],["Do you play a sport?","du yu pley ı sport?","Herhangi bir spor yapıyor musun?"]]}
