{"w":"downtown","t":"zarf","m":"şehir merkezinde; şehir merkezine","s":[],"a":[],"e":[["I work downtown.","ay vörk dauntaun","Şehir merkezinde çalışıyorum."],["Let's go downtown on Saturday.","lets go dauntaun an setırdey","Cumartesi şehir merkezine gidelim."]]}
{"w":"nearby","t":"zarf","m":"yakında; yakınlarda","s":["close"],"a":["far"],"e":[["Is there a bank nearby?","iz zer ı benk nirbay?","Yakınlarda bir banka var mı?"],["They live nearby.","zey liv nirbay","Yakında oturuyorlar."]]}
{"w":"even","t":"zarf","m":"hatta; bile","s":[],"a":[],"e":[["Even children can do this.","ivın çildrın ken du zis","Bunu çocuklar bile yapabilir."],["It is even colder today.","it iz ivın koldır tıdey","Bugün hava daha da soğuk."]],"x":[["even if","ivın if","-se bile","I will go even if it rains.","ay vil go ivın if it reyns","Yağmur yağsa bile gideceğim."]]}
{"w":"rather","t":"zarf","m":"oldukça; biraz","s":["quite"],"a":[],"e":[["The film was rather long.","zı film vaz razır long","Film oldukça uzundu."],["It is rather cold in here.","it iz razır kold in hir","Burası biraz soğuk."]],"x":[["would rather","vud razır","tercih ederdi","I would rather stay home tonight.","ay vud razır stey hom tınayt","Bu akşam evde kalmayı tercih ederim."]]}
{"w":"fairly","t":"zarf","m":"epeyce; oldukça","s":["quite"],"a":[],"e":[["The test was fairly easy.","zı test vaz ferli izi","Sınav epeyce kolaydı."],["He speaks English fairly well.","hi spiks ingliş ferli vel","İngilizceyi oldukça iyi konuşur."]]}
{"w":"extremely","t":"zarf","m":"son derece; aşırı","s":["very"],"a":[],"e":[["It is extremely hot today.","it iz ikstrimli hat tıdey","Bugün hava son derece sıcak."],["She was extremely happy.","şi vaz ikstrimli hepi","Son derece mutluydu."]]}
{"w":"absolutely","t":"zarf","m":"kesinlikle; tamamen","s":["totally"],"a":[],"e":[["You are absolutely right.","yu ar ebsılutli rayt","Kesinlikle haklısın."],["I absolutely love this song.","ay ebsılutli lav zis song","Bu şarkıya bayılıyorum."]]}
{"w":"highly","t":"zarf","m":"son derece; çok","s":[],"a":[],"e":[["He is a highly respected doctor.","hi iz ı hayli rispektid daktır","O çok saygın bir doktor."],["I highly recommend this book.","ay hayli rekımend zis buk","Bu kitabı şiddetle tavsiye ederim."]]}
{"w":"deeply","t":"zarf","m":"derinden; derin derin","s":[],"a":[],"e":[["Breathe deeply.","briz dipli","Derin nefes al."],["She was deeply moved by the story.","şi vaz dipli muvd bay zı stori","Hikâyeden derinden etkilendi."]]}
{"w":"nowadays","t":"zarf","m":"bugünlerde; günümüzde","s":[],"a":[],"e":[["Nowadays, everyone has a phone.","naudeyz, evrivan hez ı fon","Günümüzde herkesin telefonu var."],["Nowadays I walk to work.","naudeyz ay vok tı vörk","Bugünlerde işe yürüyerek gidiyorum."]]}
{"w":"weekly","t":"zarf","m":"haftalık; haftada bir","s":[],"a":[],"e":[["The class meets weekly.","zı kles mits vikli","Ders haftada bir toplanır."],["We talk to our grandmother weekly.","vi tok tu aur grendmazır vikli","Büyükannemizle haftada bir konuşuruz."]]}
{"w":"monthly","t":"zarf","m":"aylık; ayda bir","s":[],"a":[],"e":[["We pay the rent monthly.","vi pey zı rent mansli","Kirayı aylık öderiz."],["The magazine comes out monthly.","zı megızin kamz aut mansli","Dergi ayda bir çıkar."]]}
{"w":"yearly","t":"zarf","m":"yıllık; yılda bir","s":["annually"],"a":[],"e":[["The festival is held yearly.","zı festıvıl iz held yirli","Festival yılda bir yapılır."],["We visit my uncle yearly.","vi vizit may ankıl yirli","Amcamı yılda bir ziyaret ederiz."]]}
