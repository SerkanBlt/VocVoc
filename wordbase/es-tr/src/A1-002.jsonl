{"w":"dar","t":"fiil","m":"vermek","s":[],"a":[],"e":[["Te doy mi número.","te doy mi numero.","Sana numaramı veriyorum."],["Ella da clases de inglés.","eya da klases de ingles.","O İngilizce ders veriyor."]],"x":[["dar un paseo","dar un paseo","gezintiye çıkmak","Damos un paseo por el parque.","damos un paseo por el parke.","Parkta gezintiye çıkıyoruz."]]}
{"w":"el","t":"belirleyici","m":"(eril belirli tanımlık)","s":[],"a":[],"e":[["El libro está aquí.","el libro esta aki.","Kitap burada."],["El niño juega en el parque.","el ninyo huega en el parke.","Çocuk parkta oynuyor."]]}
{"w":"la","t":"belirleyici","m":"(dişil belirli tanımlık)","s":[],"a":[],"e":[["La casa es grande.","la kasa es grande.","Ev büyük."],["La mujer lee la carta.","la muher lee la karta.","Kadın mektubu okuyor."]]}
{"w":"un","t":"belirleyici","m":"bir (eril)","s":[],"a":[],"e":[["Tengo un perro.","tengo un pero.","Bir köpeğim var."],["Es un buen día.","es un buen dia.","Güzel bir gün."]]}
{"w":"una","t":"belirleyici","m":"bir (dişil)","s":[],"a":[],"e":[["Quiero una manzana.","kyero una mansana.","Bir elma istiyorum."],["Vivo en una ciudad pequeña.","bibo en una syudad pekenya.","Küçük bir şehirde yaşıyorum."]]}
{"w":"mi","t":"belirleyici","m":"benim","s":[],"a":[],"e":[["Mi casa es pequeña.","mi kasa es pekenya.","Evim küçük."],["Mi hermana tiene diez años.","mi ermana tyene dyes anyos.","Kız kardeşim on yaşında."]]}
{"w":"tu","t":"belirleyici","m":"senin","s":[],"a":[],"e":[["¿Dónde está tu casa?","donde esta tu kasa?","Evin nerede?"],["Tu madre te llama.","tu madre te yama.","Annen seni çağırıyor."]]}
{"w":"su","t":"belirleyici","m":"onun; onların; sizin (nazik hitap)","s":[],"a":[],"e":[["Su coche es nuevo.","su koçe es nuebo.","Arabası yeni."],["Ellos venden su casa.","eyos benden su kasa.","Onlar evlerini satıyor."]]}
{"w":"nuestro","t":"belirleyici","m":"bizim","s":[],"a":[],"e":[["Nuestro perro es grande.","nuestro pero es grande.","Köpeğimiz büyük."],["Esta es nuestra casa.","esta es nuestra kasa.","Burası bizim evimiz."]]}
{"w":"este","t":"belirleyici","m":"bu","s":[],"a":[],"e":[["Este libro es bueno.","este libro es bueno.","Bu kitap iyi."],["Me gusta esta ciudad.","me gusta esta syudad.","Bu şehri seviyorum."]]}
{"w":"ese","t":"belirleyici","m":"şu; o","s":[],"a":[],"e":[["Ese hombre es mi tío.","ese ombre es mi tio.","O adam benim amcam."],["¿Cuánto cuesta esa camisa?","kuanto kuesta esa kamisa?","Şu gömlek ne kadar?"]]}
{"w":"aquel","t":"belirleyici","m":"şu (uzaktaki); o","s":[],"a":[],"e":[["Aquel edificio es muy alto.","akel edifisyo es mui alto.","Şu bina çok yüksek."],["Aquella casa es de mi abuelo.","akeya kasa es de mi abuelo.","Şu ev büyükbabamın."]]}
{"w":"esto","t":"zamir","m":"bu","s":[],"a":[],"e":[["¿Qué es esto?","ke es esto?","Bu ne?"],["Esto me gusta mucho.","esto me gusta muço.","Bunu çok beğendim."]]}
{"w":"eso","t":"zamir","m":"şu; bu (konuşulan şey)","s":[],"a":[],"e":[["Eso es verdad.","eso es berdad.","Bu doğru."],["No hables de eso.","no ables de eso.","Bundan söz etme."]],"x":[["por eso","por eso","bu yüzden","Estoy cansado, por eso me voy.","estoy kansado, por eso me boy.","Yorgunum, bu yüzden gidiyorum."]]}
{"w":"uno","t":"sayı","m":"bir; biri","s":[],"a":[],"e":[["Uno, dos, tres.","uno, dos, tres.","Bir, iki, üç."],["Uno de mis amigos es médico.","uno de mis amigos es mediko.","Arkadaşlarımdan biri doktor."]]}
{"w":"dos","t":"sayı","m":"iki","s":[],"a":[],"e":[["Tengo dos gatos.","tengo dos gatos.","İki kedim var."],["Son las dos.","son las dos.","Saat iki."]]}
{"w":"tres","t":"sayı","m":"üç","s":[],"a":[],"e":[["Tres más tres son seis.","tres mas tres son seys.","Üç artı üç altı eder."],["Tengo tres hijos.","tengo tres ihos.","Üç çocuğum var."]]}
{"w":"cuatro","t":"sayı","m":"dört","s":[],"a":[],"e":[["Hay cuatro sillas.","ay kuatro siyas.","Dört sandalye var."],["Son las cuatro y media.","son las kuatro i medya.","Saat dört buçuk."]]}
{"w":"cinco","t":"sayı","m":"beş","s":[],"a":[],"e":[["Tengo cinco euros.","tengo sinko euros.","Beş avrom var."],["Mi hijo tiene cinco años.","mi iho tyene sinko anyos.","Oğlum beş yaşında."]]}
{"w":"seis","t":"sayı","m":"altı","s":[],"a":[],"e":[["Seis personas viven aquí.","seys personas biben aki.","Burada altı kişi yaşıyor."],["Cuesta seis euros.","kuesta seys euros.","Altı avro."]]}
{"w":"siete","t":"sayı","m":"yedi","s":[],"a":[],"e":[["Siete días tiene la semana.","syete dias tyene la semana.","Haftanın yedi günü var."],["Me levanto a las siete.","me lebanto a las syete.","Saat yedide kalkarım."]]}
{"w":"ocho","t":"sayı","m":"sekiz","s":[],"a":[],"e":[["Son las ocho.","son las oço.","Saat sekiz."],["Tengo ocho libros.","tengo oço libros.","Sekiz kitabım var."]]}
{"w":"nueve","t":"sayı","m":"dokuz","s":[],"a":[],"e":[["Nueve más uno son diez.","nuebe mas uno son dyes.","Dokuz artı bir on eder."],["Llego a las nueve.","yego a las nuebe.","Saat dokuzda gelirim."]]}
{"w":"diez","t":"sayı","m":"on","s":[],"a":[],"e":[["Diez personas vienen.","dyes personas byenen.","On kişi geliyor."],["Cuesta diez euros.","kuesta dyes euros.","On avro."]]}
{"w":"once","t":"sayı","m":"on bir","s":[],"a":[],"e":[["Mi hijo tiene once años.","mi iho tyene onse anyos.","Oğlum on bir yaşında."],["Son las once.","son las onse.","Saat on bir."]]}
{"w":"doce","t":"sayı","m":"on iki","s":[],"a":[],"e":[["Hay doce huevos.","ay dose uebos.","On iki yumurta var."],["Almuerzo a las doce.","almuerso a las dose.","Saat on ikide öğle yemeği yerim."]]}
{"w":"trece","t":"sayı","m":"on üç","s":[],"a":[],"e":[["Tiene trece años.","tyene trese anyos.","On üç yaşında."],["Hoy es día trece.","oy es dia trese.","Bugün ayın on üçü."]]}
{"w":"catorce","t":"sayı","m":"on dört","s":[],"a":[],"e":[["Somos catorce en la clase.","somos katorse en la klase.","Sınıfta on dört kişiyiz."],["Tengo catorce libros.","tengo katorse libros.","On dört kitabım var."]]}
{"w":"quince","t":"sayı","m":"on beş","s":[],"a":[],"e":[["Quince minutos más.","kinse minutos mas.","On beş dakika daha."],["Mi hermano tiene quince años.","mi ermano tyene kinse anyos.","Erkek kardeşim on beş yaşında."]]}
{"w":"dieciséis","t":"sayı","m":"on altı","s":[],"a":[],"e":[["Tengo dieciséis años.","tengo dyesiseys anyos.","On altı yaşındayım."],["Hay dieciséis alumnos.","ay dyesiseys alumnos.","On altı öğrenci var."]]}
{"w":"diecisiete","t":"sayı","m":"on yedi","s":[],"a":[],"e":[["Tiene diecisiete años.","tyene dyesisyete anyos.","On yedi yaşında."],["Somos diecisiete.","somos dyesisyete.","On yedi kişiyiz."]]}
{"w":"dieciocho","t":"sayı","m":"on sekiz","s":[],"a":[],"e":[["Tiene dieciocho años.","tyene dyesyoço anyos.","On sekiz yaşında."],["Son dieciocho euros.","son dyesyoço euros.","On sekiz avro."]]}
{"w":"diecinueve","t":"sayı","m":"on dokuz","s":[],"a":[],"e":[["Tiene diecinueve años.","tyene dyesinuebe anyos.","On dokuz yaşında."],["Hay diecinueve sillas.","ay dyesinuebe siyas.","On dokuz sandalye var."]]}
{"w":"veinte","t":"sayı","m":"yirmi","s":[],"a":[],"e":[["Veinte euros, por favor.","beynte euros, por fabor.","Yirmi avro, lütfen."],["Tengo veinte años.","tengo beynte anyos.","Yirmi yaşındayım."]]}
{"w":"treinta","t":"sayı","m":"otuz","s":[],"a":[],"e":[["Son treinta minutos en tren.","son treynta minutos en tren.","Trenle otuz dakika."],["Cuesta treinta euros.","kuesta treynta euros.","Otuz avro."]]}
{"w":"cuarenta","t":"sayı","m":"kırk","s":[],"a":[],"e":[["Hay cuarenta alumnos.","ay kuarenta alumnos.","Kırk öğrenci var."],["Mi tía tiene cuarenta años.","mi tia tyene kuarenta anyos.","Teyzem kırk yaşında."]]}
{"w":"cincuenta","t":"sayı","m":"elli","s":[],"a":[],"e":[["Somos cincuenta personas.","somos sinkuenta personas.","Elli kişiyiz."],["Cuesta cincuenta euros.","kuesta sinkuenta euros.","Elli avro."]]}
{"w":"sesenta","t":"sayı","m":"altmış","s":[],"a":[],"e":[["Una hora tiene sesenta minutos.","una ora tyene sesenta minutos.","Bir saat altmış dakikadır."],["Mi abuelo tiene sesenta años.","mi abuelo tyene sesenta anyos.","Büyükbabam altmış yaşında."]]}
{"w":"setenta","t":"sayı","m":"yetmiş","s":[],"a":[],"e":[["Mi abuela tiene setenta años.","mi abuela tyene setenta anyos.","Büyükannem yetmiş yaşında."],["Son setenta euros.","son setenta euros.","Yetmiş avro."]]}
{"w":"ochenta","t":"sayı","m":"seksen","s":[],"a":[],"e":[["Mi vecino tiene ochenta años.","mi besino tyene oçenta anyos.","Komşum seksen yaşında."],["Hay ochenta libros.","ay oçenta libros.","Seksen kitap var."]]}
{"w":"noventa","t":"sayı","m":"doksan","s":[],"a":[],"e":[["Hay noventa sillas.","ay nobenta siyas.","Doksan sandalye var."],["El tren va a noventa kilómetros por hora.","el tren ba a nobenta kilometros por ora.","Tren saatte doksan kilometreyle gidiyor."]]}
{"w":"cien","t":"sayı","m":"yüz","s":[],"a":[],"e":[["Cien euros, por favor.","syen euros, por fabor.","Yüz avro, lütfen."],["Cien personas esperan.","syen personas esperan.","Yüz kişi bekliyor."]]}
{"w":"mil","t":"sayı","m":"bin","s":[],"a":[],"e":[["Tiene mil libros.","tyene mil libros.","Bin kitabı var."],["Mil personas viven aquí.","mil personas biben aki.","Burada bin kişi yaşıyor."]],"x":[["mil gracias","mil grasyas","binlerce teşekkürler","Mil gracias por tu ayuda.","mil grasyas por tu ayuda.","Yardımın için binlerce teşekkürler."]]}
{"w":"primero","t":"sayı","m":"birinci; ilk","s":[],"a":["último"],"e":[["Es el primero de la fila.","es el primero de la fila.","Sıranın ilki o."],["Mi primera clase es a las ocho.","mi primera klase es a las oço.","İlk dersim saat sekizde."]]}
{"w":"segundo","t":"sayı","m":"ikinci","s":[],"a":[],"e":[["Vivo en el segundo piso.","bibo en el segundo piso.","İkinci katta oturuyorum."],["Es la segunda vez.","es la segunda bes.","Bu ikinci kez."]]}
{"w":"tercero","t":"sayı","m":"üçüncü","s":[],"a":[],"e":[["Es el tercero de la lista.","es el tersero de la lista.","Listenin üçüncüsü o."],["Mi tercera clase es inglés.","mi tersera klase es ingles.","Üçüncü dersim İngilizce."]]}
{"w":"cero","t":"sayı","m":"sıfır","s":[],"a":[],"e":[["Cero más uno es uno.","sero mas uno es uno.","Sıfır artı bir birdir."],["Hace cero grados.","ase sero grados.","Sıfır derece."]],"x":[["desde cero","desde sero","sıfırdan","Empiezo desde cero.","empyeso desde sero.","Sıfırdan başlıyorum."]]}
{"w":"qué","t":"zamir","m":"ne","s":[],"a":[],"e":[["¿Qué quieres comer?","ke kyeres komer?","Ne yemek istiyorsun?"],["¿Qué hora es?","ke ora es?","Saat kaç?"]],"x":[["¿qué tal?","ke tal?","nasılsın?; ne haber?","Hola, ¿qué tal?","ola, ke tal?","Merhaba, ne haber?"]]}
{"w":"quién","t":"zamir","m":"kim","s":[],"a":[],"e":[["¿Quién es ella?","kyen es eya?","O kim?"],["¿Con quién vives?","kon kyen bibes?","Kiminle yaşıyorsun?"]]}
{"w":"cómo","t":"zarf","m":"nasıl","s":[],"a":[],"e":[["¿Cómo estás?","komo estas?","Nasılsın?"],["¿Cómo te llamas?","komo te yamas?","Adın ne?"]]}
