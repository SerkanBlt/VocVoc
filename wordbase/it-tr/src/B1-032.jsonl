{"w":"mentire","t":"fiil","m":"yalan söylemek","s":[],"a":[],"e":[["Non mentirmi, dimmi la verità.","","Bana yalan söyleme, doğruyu söyle."],["Il bambino mente sempre sui compiti.","","Çocuk ödevleri konusunda hep yalan söylüyor."]]}
{"w":"nascondere","t":"fiil","m":"saklamak; gizlemek","s":["celare"],"a":["mostrare"],"e":[["Ho nascosto il regalo nell'armadio.","","Hediyeyi dolaba sakladım."],["Non nascondere i tuoi sentimenti.","","Duygularını gizleme."]],"x":[["nascondersi dietro un dito","","gerçeği görmezden gelmek","Inutile nascondersi dietro un dito.","","Gerçeği görmezden gelmenin anlamı yok."]]}
{"w":"perquisire","t":"fiil","m":"üstünü aramak; arama yapmak","s":[],"a":[],"e":[["La polizia ha perquisito la casa.","","Polis evde arama yaptı."],["Gli agenti perquisiscono il sospettato.","","Polisler şüphelinin üstünü arıyor."]]}
{"w":"ricattare","t":"fiil","m":"şantaj yapmak","s":[],"a":[],"e":[["Lo hanno ricattato con delle foto.","","Onu fotoğraflarla şantaj yaptılar."],["Non lasciarti ricattare da nessuno.","","Kimsenin seni şantajla yönlendirmesine izin verme."]]}
{"w":"rapire","t":"fiil","m":"kaçırmak","s":["sequestrare"],"a":[],"e":[["Hanno rapito il figlio dell'imprenditore.","","İş insanının oğlunu kaçırdılar."],["La musica ci ha rapito il cuore.","","Müzik kalbimizi çaldı."]]}
{"w":"rapimento","t":"isim (eril)","m":"kaçırma; adam kaçırma","s":["sequestro"],"a":[],"e":[["La polizia indaga sul rapimento.","","Polis kaçırma olayını soruşturuyor."],["Il rapimento è durato tre giorni.","","Kaçırılma üç gün sürdü."]]}
{"w":"rivedere","t":"fiil","m":"tekrar görmek; gözden geçirmek","s":["ripassare"],"a":[],"e":[["Spero di rivederti presto.","","Seni yakında tekrar görmeyi umuyorum."],["Devo rivedere gli appunti prima dell'esame.","","Sınavdan önce notları gözden geçirmem gerek."]],"x":[["rivedere i propri piani","","planları gözden geçirmek","Con la pioggia dobbiamo rivedere i nostri piani.","","Yağmurla birlikte planlarımızı gözden geçirmeliyiz."]]}
{"w":"sopportare","t":"fiil","m":"katlanmak; dayanmak; çekmek","s":["tollerare"],"a":[],"e":[["Non sopporto il rumore.","","Gürültüye dayanamıyorum."],["Come fai a sopportare questo caldo?","","Bu sıcağa nasıl dayanıyorsun?"]]}
{"w":"sopravvivere","t":"fiil","m":"hayatta kalmak; sağ çıkmak","s":["resistere"],"a":["morire"],"e":[["Pochi sono sopravvissuti all'incidente.","","Çok azı kazadan sağ çıktı."],["Senza acqua non si sopravvive molto.","","Susuz fazla yaşanmaz."]]}
{"w":"sorvegliare","t":"fiil","m":"gözetlemek; denetlemek; göz kulak olmak","s":["controllare"],"a":[],"e":[["La maestra sorveglia i bambini nel cortile.","","Öğretmen avluda çocuklara göz kulak oluyor."],["Le telecamere sorvegliano l'ingresso.","","Kameralar girişi gözetliyor."]]}
{"w":"spiare","t":"fiil","m":"gözetlemek; casusluk yapmak","s":["osservare"],"a":[],"e":[["Ha spiato i vicini dalla finestra.","","Komşuları pencereden gözetledi."],["Quella ditta spia i concorrenti.","","O firma rakiplerine casusluk yapıyor."]]}
{"w":"suonare","t":"fiil","m":"çalmak; çalmak (zil); ses vermek","s":[],"a":[],"e":[["Mio padre suona la chitarra.","","Babam gitar çalıyor."],["Il telefono suona da dieci minuti.","","Telefon on dakikadır çalıyor."]],"x":[["suonare il campanello","","kapı zilini çalmak","Hanno suonato il campanello alle otto.","","Saat sekizde kapı zilini çaldılar."]]}
{"w":"testimoniare","t":"fiil","m":"tanıklık etmek; kanıtlamak","s":["deporre"],"a":[],"e":[["Domani testimonierò in tribunale.","","Yarın mahkemede tanıklık edeceğim."],["Queste foto testimoniano la sua presenza.","","Bu fotoğraflar onun orada olduğunu kanıtlıyor."]]}
{"w":"tradimento","t":"isim (eril)","m":"ihanet; aldatma","s":["infedeltà"],"a":["fedeltà"],"e":[["Non perdona il tradimento di un amico.","","Bir arkadaşın ihanetini affetmez."],["Il tradimento ha distrutto il matrimonio.","","Aldatma evliliği bitirdi."]]}
{"w":"uccisione","t":"isim (dişil)","m":"öldürme; cinayet","s":["omicidio"],"a":[],"e":[["L'uccisione del testimone ha scioccato tutti.","","Tanığın öldürülmesi herkesi şoke etti."],["La legge vieta l'uccisione degli animali protetti.","","Yasa korunan hayvanların öldürülmesini yasaklıyor."]]}
